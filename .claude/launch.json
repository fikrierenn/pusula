{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blazor-dash",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "dashboard"
      ],
      "port": 5112,
      "autoPort": false
    },
    {
      "name": "blazor-dash-test",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "dashboard",
        "--urls",
        "http://0.0.0.0:5113"
      ],
      "port": 5113,
      "autoPort": false
    },
    {
      "name": "blazor-dash-prod",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "dashboard",
        "--no-launch-profile",
        "-e",
        "ASPNETCORE_ENVIRONMENT=Production",
        "--",
        "--urls",
        "http://127.0.0.1:5114",
        "--Kestrel:Certificates:Default:Path=",
        "--Kestrel:Certificates:Default:KeyPath="
      ],
      "port": 5114,
      "autoPort": false
    },
    {
      "name": "panel-yayin",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ASPNETCORE_ENVIRONMENT=Production&& set BKM_ENV_DOSYA=C:\\dev\\pusula\\.env&& dotnet C:\\Temp\\panel-yayin\\GmDashboard.dll --contentRoot C:\\Temp\\panel-yayin --urls http://127.0.0.1:5114 --Kestrel:Certificates:Default:Path= --Kestrel:Certificates:Default:KeyPath="
      ],
      "port": 5114,
      "autoPort": false
    },
    {
      "name": "vardiya-app",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "vardiya-app",
        "--urls",
        "http://0.0.0.0:5120"
      ],
      "port": 5120,
      "autoPort": false
    }
  ]
}