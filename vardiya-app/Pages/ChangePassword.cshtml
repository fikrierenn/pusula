@page
@model BkmVardiya.Pages.ChangePasswordModel
@{ ViewData["Title"] = "Şifre değiştir"; }

<h1>Şifre değiştir</h1>

@if (Model.Forced)
{
    <div role="alert">
        <strong>İlk girişte şifre değiştirmek zorunludur.</strong>
        Size verilen geçici şifre yalnız bir kez kullanılır.
    </div>
}

@if (Model.Error is not null)
{
    <div role="alert">@Model.Error</div>
}

<form method="post">
    <div>
        <label for="mevcut">Mevcut şifre</label>
        <input id="mevcut" name="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
    </div>
    <div>
        <label for="yeni">Yeni şifre</label>
        <input id="yeni" name="NewPassword" type="password" autocomplete="new-password" required />
        <small>En az 10 karakter.</small>
    </div>
    <div>
        <label for="yeni2">Yeni şifre (tekrar)</label>
        <input id="yeni2" name="NewPasswordAgain" type="password" autocomplete="new-password" required />
    </div>
    <button type="submit">Değiştir</button>
</form>
