@page
@model BkmVardiya.Pages.IndexModel
@using Bkm.Shared.Models
@{
    ViewData["Title"] = "Vardiya / Mesai";
}

@* Plan 48 Adım 5 — rapor ekranı dashboard'dan taşındı.
   Tasarım sistemi Solum (solum.css); DaisyUI KULLANILMAZ.
   Metinler Türkçe, kod İngilizce (turkish-ui.md). *@

<h1>Vardiya / Mesai</h1>
<p class="solum-card-sub">
    PDKS + vardiya planı · hesap <b>bkm.sp_Vrd_KisiGunDoldur</b> ·
    süreler dakika tabanlı, gece mesaisi ertesi güne sarkar ·
    uyum ölçütleri <b>4857</b> (m.63 · m.68 · m.69 · m.46)
</p>

@if (Model.Error is not null)
{
    <div class="solum-alert solum-alert-bad" role="alert">
        <strong>Rapor okunamadı.</strong>
        <div>@Model.Error</div>
    </div>
}
else if (Model.Cutoffs.Count == 0)
{
    @* Boş nüfus "sorun yok" DEĞİL. İki ayrı sebebi var ve ikisi de sessizce
       "temiz" görünürdü — ayırt edilebilir yazılıyor. *@
    <div class="solum-alert solum-alert-warn" role="alert">
        <strong>Görüntülenecek kesim yok.</strong>
        <div>
            Bu <b>“mesai sorunu yok”</b> demek değildir. İki sebebi olabilir:
            hesap hiç koşmamıştır (<code>bkm.Vrd_KisiGun</code> boş), ya da
            şube kapsamınız boştur. İkincisi için İnsan Kaynakları ile görüşün.
        </div>
    </div>
}
else
{
    <form method="get" class="solum-toolbar">
        <label class="solum-field">
            <span>Kesim</span>
            <select name="Cutoff" class="solum-select" onchange="this.form.submit()">
                @foreach (var c in Model.Cutoffs)
                {
                    var key = BkmVardiya.Pages.IndexModel.CutoffKey(c);
                    <option value="@key" selected="@(key == Model.Cutoff)">
                        @c.CutoffFrom.ToString("dd.MM.yyyy") – @c.CutoffTo.ToString("dd.MM.yyyy")
                        · @c.PersonDays.ToString("N0") kişi-gün
                    </option>
                }
            </select>
        </label>

        <label class="solum-field">
            <span>Şube</span>
            <select name="Branch" class="solum-select" onchange="this.form.submit()">
                <option value="">Tümü</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Branch" selected="@(b.Branch == Model.Branch)">@b.Branch</option>
                }
            </select>
        </label>

        <label class="solum-field">
            <span>Personel / TC</span>
            <input name="Search" value="@Model.Search" class="solum-input" placeholder="ara…" />
        </label>

        <label class="solum-field">
            <span>Süzgeç</span>
            <span>
                <input type="checkbox" name="OnlyDeviations" value="true" checked="@Model.OnlyDeviations" />
                Yalnız sapma/not taşıyanlar
            </span>
        </label>

        <button type="submit" class="solum-btn solum-btn-primary">Uygula</button>
    </form>

    <partial name="_Kpi" model="Model" />
    <partial name="_Compliance" model="Model" />
    <partial name="_OvertimeSource" model="Model" />
    <partial name="_Branches" model="Model" />
    <partial name="_Rows" model="Model" />
}
