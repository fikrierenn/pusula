@page
@model BkmVardiya.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<h1>Şifre Sıfırla</h1>

<p>
    Geçici şifre üretilir ve <strong>yalnız bir kez burada</strong> gösterilir.
    Kullanıcı ilk girişte değiştirmek zorundadır.
</p>

@if (Model.Error is not null)
{
    <div role="alert"><strong>@Model.Error</strong></div>
}

@if (Model.TempPassword is not null)
{
    <div role="status">
        <p><strong>@Model.UserName</strong> için geçici şifre:</p>
        <p><code style="font-size:1.4rem">@Model.TempPassword</code></p>
        <p>Bu sayfadan ayrıldığınızda bir daha gösterilmez. Kaydetmeyin, iletin.</p>
    </div>
}

<form method="post">
    <div>
        <label for="kullanici">Kullanıcı</label>
        <select id="kullanici" name="UserName" required>
            <option value="">— seçin —</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u">@u</option>
            }
        </select>
    </div>
    <button type="submit">Şifreyi sıfırla</button>
</form>
