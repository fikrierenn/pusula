@page "/"
@inject VardiyaQueries Q

@* Plan 48 Adım 3 — iskelet doğrulama sayfası.
   Amacı tek şey KANITLAMAK: ortak kütüphane (lib/Bkm.Shared) bu uygulamadan
   çalışıyor, kesimler okunuyor. Gerçek rapor ekranı Adım 5'te gelir. *@

<PageTitle>BKM Vardiya</PageTitle>

<h1 class="text-2xl font-semibold mb-1">Vardiya Yönetimi</h1>
<p class="text-base-content/60 mb-4">
    İskelet sürüm. Onay akışı Adım 6, rapor ekranı Adım 5, giriş Adım 4.
</p>

@if (_hata is not null)
{
    @* Hata YUTULMAZ — ekranda görünür (error-handling.md: sessiz fallback yok). *@
    <div class="alert alert-error">
        <div>
            <div class="font-semibold">Kesimler okunamadı</div>
            <div class="text-sm opacity-80">@_hata</div>
        </div>
    </div>
}
else if (_kesimler is null)
{
    <span class="loading loading-spinner"></span>
}
else if (_kesimler.Count == 0)
{
    <div class="alert alert-warning">
        Yazılmış kesim yok — <code>bkm.sp_Vrd_KisiGunDoldur</code> hiç koşmamış.
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="table table-zebra bg-base-100">
            <thead>
                <tr>
                    <th>Kesim başı</th>
                    <th>Kesim sonu</th>
                    <th>Sayım başı</th>
                    <th class="text-right">Kişi-gün</th>
                    <th class="text-right">Şube</th>
                    <th>Yazılma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in _kesimler)
                {
                    <tr>
                        <td>@k.KesimBas.ToString("dd.MM.yyyy")</td>
                        <td>@k.KesimBit.ToString("dd.MM.yyyy")</td>
                        <td>@k.SayimBas.ToString("dd.MM.yyyy")</td>
                        <td class="text-right">@k.KisiGun.ToString("N0")</td>
                        <td class="text-right">@k.SubeSay</td>
                        <td class="text-base-content/60">@k.Yazilma.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<VrdKesim>? _kesimler;
    private string? _hata;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _kesimler = await Q.KesimlerAsync();
        }
        catch (Exception ex)
        {
            // Kullanıcıya teknik detay değil, ekranda görünür bir başarısızlık
            // (security-principles.md: stack trace sızmaz — mesaj yeterli tanı verir).
            _hata = ex.Message;
        }
    }
}
