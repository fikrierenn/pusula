<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Vardiya Yönetim Uygulaması — plan 48.
       GMY panelinden AYRI: kendi portu, kendi auth'u, kendi kullanıcı tablosu.
       Ortak olan yalnız veri katmanı (lib/Bkm.Shared) ve hesap SP'si.
       Arayüz ve kimlik omurgası: Solum (D:\Dev\Solum) — Razor Pages. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BkmVardiya</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- KIMLIK/ACL BOGAZI DERLEYICIYE ZORLATILIR (plan 48 / V-11).
         Olculdu: bu uygulamada 5 Dapper cagrisi / 2 dosya vardi ve hepsi kimlik-ACL
         (Vrd_Roles · Vrd_UserRoles · Vrd_KullaniciSube · Vrd_Sube · SolumPermissionGrant).
         "Riski dusuk" sanilan bu taraf, olculunce BESINCI parametre-adi kaymasini
         tasiyordu: Seed'in ACL yazmasi calismiyordu.
         Muafiyet TEK dosya: Security/AuthSql.cs (.editorconfig).
         ⚠ Yasak, VAR OLAN bogazi zorunlu kilar — yoktan bogaz yaratmaz (Solum'un on kosulu). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lib\Bkm.Shared\Bkm.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solum ortak katmani (D:\Dev\Solum) — ayri depo, ProjectReference ile.
         Solum ekibinin onerisi (18.09.2026, solum-be): mevcut iki tuketici de
         boyle bagliyor; restore yok, ara durum gorunur ve kirici dokunus
         oncesi tuketiciye haber veriliyor. Yerel NuGet beslemesi de makineye
         bagli oldugu icin ustunlugu yoktu.
         Tasarim sistemi Solum'un kendi solum.css'i; DaisyUI/Tailwind KULLANILMAZ
         (iki tasarim sistemi cakisir). -->
    <ProjectReference Include="..\..\Solum\src\Solum.Web\Solum.Web.csproj" />
    <ProjectReference Include="..\..\Solum\src\Solum.Identity\Solum.Identity.csproj" />
    <ProjectReference Include="..\..\Solum\src\Solum.Sql.SqlServer\Solum.Sql.SqlServer.csproj" />
  </ItemGroup>

</Project>
