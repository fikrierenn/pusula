@* DaisyUI native modal — drill paneli. modal-open ile açılır, backdrop tık kapatır. *@
<div class="modal modal-bottom sm:modal-middle z-[200] @(Open ? "modal-open" : "")" role="dialog">
    <div class="modal-box @MaxWidthCls w-full max-h-[88vh] sm:max-h-[85vh]">
        @* Grip = mobilde geniş tıkla-kapat alanı (parmak içgüdüsel buraya gider). *@
        <button class="block w-full pt-1 pb-2 sm:hidden" @onclick="Close" aria-label="Kapat">
            <span class="block w-12 h-1.5 bg-base-300 rounded-full mx-auto"></span>
        </button>
        <div class="flex items-center justify-between sticky top-0 bg-base-100 z-10 pb-3 mb-3 border-b border-base-200 -mx-6 px-6 pt-1">
            <h3 class="text-lg font-bold text-primary m-0">@Title</h3>
            <button class="btn btn-circle btn-ghost h-11 w-11 min-h-11" @onclick="Close" aria-label="Kapat"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        @ChildContent
    </div>
    <div class="modal-backdrop" @onclick="Close"></div>
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Size { get; set; } = "md";  // sm=2xl · md=3xl · lg=5xl · xl=7xl

    private string MaxWidthCls => Size switch {
        "sm" => "max-w-2xl",
        "lg" => "max-w-5xl",
        "xl" => "max-w-7xl",
        _    => "max-w-3xl"
    };

    private async Task Close() => await OpenChanged.InvokeAsync(false);
}
