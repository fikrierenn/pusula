@* Mobil app ikon-satır listesi (mockup .row/.pay) — renkli ikon + ad+alt / sağ tutar + opsiyonel trend/chevron.
   Kimlikli varlık listeleri için (mağaza/il/kasiyer/ölü-stok/müşteri/ödeme). Dağılım için AppRankBars. plan-09. *@
@typeparam TItem

<div class="flex flex-col gap-2.5">
    @foreach (var it in (Items ?? Array.Empty<TItem>()))
    {
        var item = it;
        var (ibg, ifg) = IconColor(item);
        var click = OnRowClick.HasDelegate;
        <div class="flex items-center gap-3 bg-base-100 border border-base-200 rounded-2xl px-4 py-3 shadow-sm @(click ? "cursor-pointer transition-transform active:scale-[.98] hover:-translate-y-0.5 hover:shadow-md" : "")"
             @onclick="@(() => OnRowClick.InvokeAsync(item))">
            <div class="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 @ibg @ifg">
                <i data-lucide="@Icon(item)" class="w-[22px] h-[22px]"></i>
            </div>
            <div class="min-w-0 flex-1">
                <div class="text-[14px] font-bold text-base-content/90 truncate">@Name(item)</div>
                <div class="text-xs text-base-content/55 truncate">@Sub(item)</div>
            </div>
            <div class="text-right shrink-0">
                <div class="text-[16px] font-extrabold tracking-tight whitespace-nowrap">@Amount(item)</div>
                @if (Trend is not null)
                {
                    var t = Trend(item);
                    if (t is not null)
                    {
                        <div class="text-[11px] font-bold inline-flex items-center gap-0.5 justify-end @t.Value.Cls"><i data-lucide="@t.Value.Ico" class="w-3 h-3"></i>@t.Value.Text</div>
                    }
                }
            </div>
            @if (click)
            {
                <i data-lucide="chevron-right" class="w-[18px] h-[18px] text-base-content/30 shrink-0"></i>
            }
        </div>
    }
    @if (Items is null || !Items.Any())
    {
        <div class="text-base-content/50 text-[13px] py-2">Veri yok.</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter, EditorRequired] public Func<TItem, string> Name { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> Sub { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> Amount { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> Icon { get; set; } = default!;   // lucide adı
    /// <summary>İkon dairesi rengi: (bgClass, textClass). Varsayılan primary tint.</summary>
    [Parameter] public Func<TItem, (string Bg, string Fg)> IconColor { get; set; } = _ => ("bg-primary/10", "text-primary");
    [Parameter] public Func<TItem, (string Text, string Ico, string Cls)?>? Trend { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }
}
