@inherits LayoutComponentBase
@using GmDashboard.Components.Shared
@using GmDashboard.Models
@implements IDisposable
@inject GmDashboard.Data.GorevService Gorevler
@inject GmDashboard.Data.NotifState Notif
@inject GmDashboard.Data.PerfState Perf
@inject NavigationManager Nav

<div class="drawer lg:drawer-open min-h-screen">
    <input id="bkm-drawer" type="checkbox" class="drawer-toggle" @bind="_drawerOpen" />

    @* ── ANA İÇERİK TARAFI ── *@
    <div class="drawer-content flex flex-col min-h-screen bg-base-200">

        @* ── Üst bar (navbar) ── *@
        <header class="navbar sticky top-0 z-30 bg-base-100 shadow-sm px-4 min-h-14">
            @* Hamburger: sadece masaüstünde drawer toggle (mobilde alt nav var, gerek yok) *@
            <label for="bkm-drawer" class="btn btn-ghost btn-sm btn-square hidden lg:hidden" title="Menü">
                <i data-lucide="menu"></i>
            </label>
            <span class="font-bold text-base text-base-content">BKM Yönetim Paneli</span>
            <div class="ml-auto flex items-center gap-2">
                @* Zil = bildirim merkezi (dönem uyarıları — Home üretir). *@
                <button class="btn btn-ghost btn-sm btn-square relative" @onclick="() => _notifOpen = true" title="Uyarılar">
                    <i data-lucide="bell"></i>
                    @if (Notif.Alerts.Count > 0)
                    {
                        <span class="badge badge-error badge-xs absolute top-1 right-1">@Notif.Alerts.Count</span>
                    }
                </button>
                @* CFO menüsü — Görevler + Asistan (mobilde alt nav'da yok). *@
                <div class="dropdown dropdown-end">
                    <div tabindex="0" role="button" class="flex items-center gap-1.5 font-semibold text-sm bg-base-200 rounded-lg px-2.5 py-1.5 cursor-pointer">
                        <i data-lucide="user"></i><span>CFO</span>
                    </div>
                    <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-50 w-48 p-2 shadow-lg border border-base-200 mt-2">
                        <li>
                            <a @onclick="GoGorevler">
                                <i data-lucide="check-square"></i>Görevler
                                @if (_acikGorev > 0)
                                {
                                    <span class="badge badge-primary badge-sm ml-auto">@_acikGorev</span>
                                }
                            </a>
                        </li>
                        <li><a @onclick='() => Nav.NavigateTo("tahmin")'><i data-lucide="sparkles"></i>Hedef Tahmin</a></li>
                        <li><a @onclick='() => Nav.NavigateTo("asistan")'><i data-lucide="message-square"></i>Asistan</a></li>
                        <li>
                            <form method="post" action="/auth/logout" class="p-0 m-0">
                                <button type="submit" class="flex items-center gap-2 w-full"><i data-lucide="log-out"></i>Çıkış Yap</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="flex-1 p-4 min-w-0 pb-20 lg:pb-4">
            @Body
        </main>

        <footer class="px-5 py-3 text-xs text-base-content/40 border-t border-base-200 bg-base-100 hidden lg:flex items-center gap-2">
            <span>BKM Kitap · BKM-Asistan v1 · © 2026</span>
            @if (Perf.LastMs > 0)
            {
                <span class="ml-auto flex items-center gap-1 @PerfTone">
                    <i data-lucide="timer" class="w-3.5 h-3.5"></i>
                    @Perf.LastPage @(Perf.LastMs >= 1000 ? $"{Perf.LastMs / 1000.0:0.0} sn" : $"{Perf.LastMs} ms")
                </span>
            }
        </footer>

        @* ── MOBİL ALT NAVİGASYON (app-tarzı tab bar) — sadece mobilde, masaüstü sidebar değişmez ── *@
        @* btm-nav: NavRegistry tek-kaynaktan türer (plan-12 WS-3) *@
        <nav class="btm-nav lg:hidden z-40 bg-base-100 border-t border-base-300 shadow-[0_-2px_8px_rgba(0,0,0,.06)]">
            @foreach (var item in NavRegistry.BottomNav)
            {
                <NavLink href="@item.Href" Match="item.Match" ActiveClass="active text-primary">
                    <i data-lucide="@item.Icon"></i><span class="btm-nav-label text-[10px]">@item.BtmLabel</span>
                </NavLink>
            }
            <label for="bkm-drawer" class="cursor-pointer flex flex-col items-center justify-center gap-0.5">
                <i data-lucide="menu"></i><span class="btm-nav-label text-[10px]">Diğer</span>
            </label>
        </nav>
    </div>

    @* ── SIDEBAR (drawer-side) ── *@
    <aside class="drawer-side z-40">
        <label for="bkm-drawer" class="drawer-overlay"></label>
        <div class="w-60 min-h-full bg-neutral text-neutral-content flex flex-col">
            <div class="flex items-center gap-2.5 px-4 pt-4 pb-3">
                <span class="badge badge-primary badge-lg font-extrabold tracking-wide">BKM</span>
                <span class="font-bold text-sm">Yönetim Paneli</span>
            </div>

            @* Sidebar: NavRegistry tek-kaynaktan türer, grup başlıklı (plan-12 WS-3) *@
            <ul class="menu flex-1 px-3 gap-0.5">
                @foreach (var grp in NavRegistry.Sections)
                {
                    <li class="menu-title text-neutral-content/50">@grp</li>
                    @foreach (var item in NavRegistry.Items.Where(i => i.Section == grp))
                    {
                        <li>
                            <NavLink href="@item.Href" Match="item.Match" @onclick="CloseDrawer" ActiveClass="active">
                                <i data-lucide="@item.Icon"></i><span>@item.Label</span>
                                @if (item.GorevBadge && _acikGorev > 0)
                                {
                                    <span class="badge badge-primary badge-sm ml-auto">@_acikGorev</span>
                                }
                            </NavLink>
                        </li>
                    }
                }
            </ul>
        </div>
    </aside>
</div>

<Modal @bind-Open="_notifOpen" Title="Uyarılar">
    <div class="text-base-content/50 text-xs mb-3">@Notif.Context · @(Notif.Alerts.Count) uyarı</div>
    <div class="flex flex-col">
        @foreach (var a in Notif.Alerts)
        {
            var (abg, afg) = AlertTone(a.Tone);
            <div class="flex items-start gap-3 py-3 border-b border-base-200 last:border-b-0">
                <span class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0 @abg @afg"><i data-lucide="@a.Ico" class="w-[18px] h-[18px]"></i></span>
                <div class="min-w-0 flex-1">
                    <div class="text-[13px] font-bold text-base-content/90">@a.Title</div>
                    <div class="text-[11.5px] text-base-content/55 leading-snug">@a.Desc</div>
                </div>
            </div>
        }
        @if (Notif.Alerts.Count == 0)
        {
            <div class="text-base-content/50 text-[13px] py-3 text-center">Aktif uyarı yok — Genel Bakış'ı açınca güncel uyarılar burada.</div>
        }
    </div>
</Modal>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><i data-lucide="x" class="w-4 h-4"></i></span>
</div>

@code {
    private bool _drawerOpen;
    private bool _notifOpen;
    private int _acikGorev;

    protected override void OnInitialized()
    {
        try { _acikGorev = Gorevler.Listele(acikOnly: true).Count; }
        catch { _acikGorev = 0; }
        Notif.Changed += OnNotifChanged;
        Perf.Changed += OnNotifChanged;
    }

    // Home uyarıları / perf güncellenince footer + zil rozetini tazele.
    private async void OnNotifChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose() { Notif.Changed -= OnNotifChanged; Perf.Changed -= OnNotifChanged; }

    // Yükleme süresi tonu: <2sn yeşil, 2-5sn sarı, >5sn kırmızı.
    private string PerfTone => Perf.LastMs < 2000 ? "text-success" : Perf.LastMs < 5000 ? "text-warning" : "text-error";

    private void CloseDrawer() => _drawerOpen = false;
    private void GoGorevler() { CloseDrawer(); Nav.NavigateTo("gorevler"); }

    // Bildirim tonu → (bg, fg) DaisyUI token.
    private static (string Bg, string Fg) AlertTone(string tone) => tone switch
    {
        "error" => ("bg-error/10", "text-error"),
        "success" => ("bg-success/10", "text-success"),
        _ => ("bg-warning/10", "text-warning"),
    };
}
