@inherits LayoutComponentBase
@inject GmDashboard.Data.GorevService Gorevler
@inject NavigationManager Nav

<div class="drawer lg:drawer-open min-h-screen">
    <input id="bkm-drawer" type="checkbox" class="drawer-toggle" @bind="_drawerOpen" />

    @* ── ANA İÇERİK TARAFI ── *@
    <div class="drawer-content flex flex-col min-h-screen bg-base-200">

        @* ── Üst bar (navbar) ── *@
        <header class="navbar sticky top-0 z-30 bg-base-100 shadow-sm px-4 min-h-14">
            <label for="bkm-drawer" class="btn btn-ghost btn-sm btn-square lg:hidden" title="Menü">
                <i data-lucide="menu"></i>
            </label>
            <span class="font-bold text-base text-base-content ml-1">BKM Yönetim Paneli</span>
            <div class="ml-auto flex items-center gap-3">
                <button class="btn btn-ghost btn-sm btn-square relative" @onclick="GoGorevler" title="Açık görevler">
                    <i data-lucide="bell"></i>
                    @if (_acikGorev > 0)
                    {
                        <span class="badge badge-primary badge-xs absolute top-1 right-1">@_acikGorev</span>
                    }
                </button>
                <span class="flex items-center gap-1.5 font-semibold text-sm bg-base-200 rounded-lg px-2.5 py-1.5" title="CFO">
                    <i data-lucide="user"></i>
                    <span>CFO</span>
                </span>
            </div>
        </header>

        <main class="flex-1 p-4 min-w-0 pb-20 lg:pb-4">
            @Body
        </main>

        <footer class="px-5 py-3 text-xs text-base-content/40 border-t border-base-200 bg-base-100 hidden lg:block">
            BKM Kitap · BKM-Asistan v1 · © 2026
        </footer>

        @* ── MOBİL ALT NAVİGASYON (app-tarzı tab bar) — sadece mobilde, masaüstü sidebar değişmez ── *@
        <nav class="btm-nav btm-nav-sm lg:hidden z-40 bg-base-100 border-t border-base-300 shadow-[0_-2px_8px_rgba(0,0,0,.06)]">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active text-primary">
                <i data-lucide="layout-dashboard"></i><span class="btm-nav-label text-[10px]">Genel</span>
            </NavLink>
            <NavLink href="eticaret" ActiveClass="active text-primary">
                <i data-lucide="shopping-cart"></i><span class="btm-nav-label text-[10px]">E-ticaret</span>
            </NavLink>
            <NavLink href="operasyon" ActiveClass="active text-primary">
                <i data-lucide="store"></i><span class="btm-nav-label text-[10px]">Operasyon</span>
            </NavLink>
            <NavLink href="envanter" ActiveClass="active text-primary">
                <i data-lucide="package"></i><span class="btm-nav-label text-[10px]">Envanter</span>
            </NavLink>
            <NavLink href="musteri" ActiveClass="active text-primary">
                <i data-lucide="users"></i><span class="btm-nav-label text-[10px]">Müşteri</span>
            </NavLink>
        </nav>
    </div>

    @* ── SIDEBAR (drawer-side) ── *@
    <aside class="drawer-side z-40">
        <label for="bkm-drawer" class="drawer-overlay"></label>
        <div class="w-60 min-h-full bg-neutral text-neutral-content flex flex-col">
            <div class="flex items-center gap-2.5 px-4 pt-4 pb-3">
                <span class="badge badge-primary badge-lg font-extrabold tracking-wide">BKM</span>
                <span class="font-bold text-sm">Yönetim Paneli</span>
            </div>

            <ul class="menu flex-1 px-3 gap-0.5">
                <li class="menu-title text-neutral-content/50">ANALİTİK</li>
                <li>
                    <NavLink href="" Match="NavLinkMatch.All" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="layout-dashboard"></i><span>Genel Bakış</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="eticaret" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="shopping-cart"></i><span>E-ticaret</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="operasyon" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="store"></i><span>Operasyon</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="envanter" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="package"></i><span>Envanter</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="musteri" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="users"></i><span>Müşteri</span>
                    </NavLink>
                </li>

                <li class="menu-title text-neutral-content/50">ASİSTAN</li>
                <li>
                    <NavLink href="asistan" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="message-square"></i><span>Asistan</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="gorevler" @onclick="CloseDrawer" ActiveClass="active">
                        <i data-lucide="check-square"></i><span>Görevler</span>
                        @if (_acikGorev > 0)
                        {
                            <span class="badge badge-primary badge-sm ml-auto">@_acikGorev</span>
                        }
                    </NavLink>
                </li>
            </ul>
        </div>
    </aside>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen;
    private int _acikGorev;

    protected override void OnInitialized()
    {
        try { _acikGorev = Gorevler.Listele(acikOnly: true).Count; }
        catch { _acikGorev = 0; }
    }

    private void CloseDrawer() => _drawerOpen = false;
    private void GoGorevler() { CloseDrawer(); Nav.NavigateTo("gorevler"); }
}
