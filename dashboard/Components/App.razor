<!DOCTYPE html>
<html lang="tr" data-theme="corporate">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GmDashboard.styles.css"]" />
    @* PWA — ana ekrana ekle, standalone app *@
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4063e6" />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="BKM Panel" />
    <meta name="mobile-web-app-capable" content="yes" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Lucide ikonlarını her render sonrası yeniden çiz (Blazor interactive DOM değişir)
        function drawIcons() { if (window.lucide) window.lucide.createIcons(); }
        drawIcons();
        const _ico = new MutationObserver(() => { clearTimeout(window.__ico); window.__ico = setTimeout(drawIcons, 60); });
        _ico.observe(document.body, { childList: true, subtree: true });
        // PWA service worker (install prompt + standalone)
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/service-worker.js').catch(() => {});

        // Sunucu kapanınca circuit kopar; telefon takılı kalmasın → /healthz poll, sunucu dönünce otomatik reload.
        // ReconnectModal "failed" branch'i de bunu çağırır (window.__bkmRecover).
        window.__bkmRecover = function () {
            if (window.__bkmRecovering) return;
            window.__bkmRecovering = true;
            (function tick() {
                fetch('/healthz', { cache: 'no-store' })
                    .then(r => { if (r.ok) location.reload(); else setTimeout(tick, 2000); })
                    .catch(() => setTimeout(tick, 2000));
            })();
        };
        // Sarı #blazor-error-ui görünür olunca (unhandled error / sunucu kill) recovery başlat.
        (function () {
            const ui = document.getElementById('blazor-error-ui');
            if (!ui) return;
            new MutationObserver(() => {
                if (ui.style.display && ui.style.display !== 'none') window.__bkmRecover();
            }).observe(ui, { attributes: true, attributeFilter: ['style'] });
        })();
    </script>
</body>

</html>
