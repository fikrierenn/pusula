@page "/operasyon"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject Queries Queries
@inject RefQueries Ref
@inject PerfState Perf
@inject IJSRuntime JS
@inject ILogger<Operasyon> Logger
@inject PersistentComponentState AppState
@rendermode InteractiveServer

<PageTitle>Operasyon — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">@_aralik</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">Operasyon</h1>
</div>
<AppPeriodPills Period="_period" PeriodChanged="SetPeriod" Busy="_loading" CssClass="mb-4 lg:max-w-md" />
@if (_period == "ozel")
{
    <div class="flex gap-2 mb-4 flex-wrap">
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBas" @bind:after="LoadAsync" />
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBit" @bind:after="LoadAsync" />
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    <AppKpiCarousel Id="opkpi" Items="@(new List<KpiCardData>
    {
        new("Toplam İşlem", Num(_data.Fis), "from-primary to-primary/80", "mağaza fiş"),
        new("Kasiyer", Num(_data.Kasiyer.Count), "from-info to-info/80", "aktif kasiyer"),
        new("En Yoğun Saat", _data.Saat.Count > 0 ? $"{_data.Saat.OrderByDescending(h => h.Fis).First().Saat:00}:00" : "—", "from-success to-success/80", "fiş zirvesi"),
        new("COD İade Zararı", _ops is not null ? Tl(_ops.CodZarar) : "—", "from-error to-error/80", "60g kargo×2"),
        new("Depo Bugün", _wms?.BugunAdet is not null ? Num(_wms.BugunAdet.Value) : "veri yok", "from-warning to-warning/80", _wms?.BugunIslem is not null ? $"{_wms.BugunIslem} toplama emri" : "bugün kayıt yok"),
    })" />

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Saat Bazlı Yoğunluk (@_aralik)<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-md bg-base-200 text-base-content/55 ml-auto">mağaza · online hariç</span></h3><p class="text-[11px] text-base-content/50 mb-2">fiş yoğunluğu + net ciro (saat bazlı, KDV-hariç)</p>
            <AppRankBars TItem="HourBar" Items="@(_data.Saat.OrderByDescending(h => h.Fis).Take(8))"
                         Label="@(h => $"{h.Saat:00}:00–{(h.Saat + 1):00}:00")" Value="@(h => (decimal)h.Fis)"
                         ValueText="@(h => $"{Num(h.Fis)} fiş · {Tl(h.Net)}")" />
            @{ var enCiro = _data.Saat.Count > 0 ? _data.Saat.OrderByDescending(h => h.Net).First() : null; }
            @if (enCiro is not null)
            {
                <div class="text-[11px] text-base-content/50 mt-2">Ciro zirvesi <b>@($"{enCiro.Saat:00}:00")</b> (@Tl(enCiro.Net)) · fiş≠ciro: sepet derinliği saate göre değişir.</div>
            }</div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kasiyer Performansı (@_aralik) — @_data.Kasiyer.Count kişi</h3>
            <AppDataTable TItem="KasiyerRow" Items="_data.Kasiyer"
                          Primary="@(k => k.Ad)" Sub="@(k => k.Magaza)"
                          MetricMain="@(k => Tl(k.Net))" MetricSub="@(k => $"{Num(k.Fis)} fiş")"
                          Badge="@(k => KasDeltaBadge(k))">
                <Details Context="k">
                    <div class="grid grid-cols-3 gap-2 text-[12px]">
                        <div><div class="text-base-content/50 text-[10px]">Fiş</div><div class="font-semibold tabular-nums">@Num(k.Fis)</div></div>
                        <div><div class="text-base-content/50 text-[10px]">Sepet</div><div class="font-semibold tabular-nums">@Num(k.Atv) ₺</div></div>
                        <div><div class="text-base-content/50 text-[10px]">İade</div><div class="font-semibold tabular-nums @(k.Iade > 0 ? "text-error" : "")">@k.Iade</div></div>
                    </div>
                </Details>
            </AppDataTable>
            <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                <span class="font-bold">TOPLAM (@_data.Kasiyer.Count kasiyer)</span>
                <span class="font-bold tabular-nums">@Tl(_data.Kasiyer.Sum(k => k.Net))</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">İşgücü Verimi — ₺/Çalışılan Saat (SPLH, son 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 0)
            {
                <AppDataTable TItem="SplhRow" Items="_ops.Splh"
                              Primary="@(s => s.Magaza)"
                              MetricMain="@(s => s.Saat > 0 ? Num((int)Math.Round(s.NetCiro / s.Saat)) + " ₺/s" : "—")"
                              MetricSub="@(s => s.Saat > 0 ? (s.Fis / s.Saat).ToString("0.0") + " fiş/saat" : "—")"
                              Badge="@(s => ($"👤{s.Personel}", "bg-base-200 text-base-content/50"))" />
            }
            else
            {
                <p class="text-base-content/50 text-xs mb-2">PDKS verisi alınamadı (linked server).</p>
            }
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kayıp İşgücü Potansiyeli (SPLH benchmark, 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 1)
            {
                var bench = _ops.Splh.Where(s => s.Saat > 0).Max(s => s.NetCiro / s.Saat);
                var benchAd = _ops.Splh.First(s => s.Saat > 0 && s.NetCiro / s.Saat == bench).Magaza;
                var splhAktif = _ops.Splh.Where(x => x.Saat > 0).ToList();
                decimal toplamKayip = splhAktif.Sum(s => (bench - s.NetCiro / s.Saat) * s.Saat);
                <AppDataTable TItem="SplhRow" Items="splhAktif"
                              Primary="@(s => s.Magaza)"
                              MetricMain="@(s => { var k = (bench - s.NetCiro / s.Saat) * s.Saat; return k > 0 ? Tl(k) : "—"; })"
                              MetricSub="@(s => "verim " + Num((int)Math.Round(s.NetCiro / s.Saat)) + " ₺/s")"
                              Badge="@(s => { var verim = s.NetCiro / s.Saat; return verim == bench ? ("★ benchmark", "bg-base-200 text-base-content/50") : ("−" + Num((int)Math.Round(bench - verim)), "bg-error/10 text-error"); })" />
                <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                    <span class="font-semibold text-base-content/70">@benchAd seviyesine çıkılsa (30g)</span>
                    <span class="font-bold tabular-nums text-error">@Tl(toplamKayip)</span>
                </div>
                <div class="text-base-content/50 text-[11px] mt-1">En verimli mağaza (@benchAd) ₺/saat referans; diğerleri o seviyede çalışsa kazanılacak ek ciro. Atıl saat + devamsızlık boyutu PDKS plan keşfi sonrası eklenecek.</div>
            }
            else
            {
                <p class="text-base-content/50 text-xs mb-2">SPLH verisi yok (PDKS).</p>
            }
        </div>
        @if (_wms is not null && _wms.Trend.Count > 0)
        {
            var wmsMax = _wms.Trend.Max(t => t.Adet);
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Depo Toplama Verimi — Son 14 Gün (adet)</h3>
                <AppRankBars TItem="DepoWmsTrend" Items="@(_wms.Trend)"
                             Label="@(t => t.Gun.ToString("dd MMM", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")))"
                             Value="@(t => t.Adet)"
                             ValueText="@(t => $"{Num(t.Adet)} adet · {t.Islem} emir")" />
            </div>
        }
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kapıda Ödeme — Teslim/İade (olgun 60g)</h3>
            @if (_ops is not null)
            {
                <AppDataTable TItem="CodRow" Items="@(_ops.Cod.OrderBy(x => x.Tip == "COD" ? 0 : 1))"
                              Primary="@(c => c.Tip)"
                              MetricMain="@(c => Num(c.Siparis))"
                              MetricSub="@(c => "sipariş")"
                              Sub="@(c => c.Siparis > 0 ? "teslim %" + Math.Round(100m * c.Teslim / c.Siparis, 1) : "teslim —")"
                              Badge="@(c => { var iadePct = c.Siparis > 0 ? Math.Round(100m * c.Iade / c.Siparis, 1) : 0; return c.Tip == "COD" ? ($"iade %{iadePct}", "bg-error/10 text-error") : ($"iade %{iadePct}", "bg-success/10 text-success"); })" />
                <div class="pt-2.5 mt-1 border-t-2 border-base-200 text-[13px] text-error">
                    COD iade zararı (60g): <span class="font-bold">@Tl(_ops.CodZarar)</span> <span class="text-base-content/50">(kargo ×2)</span>
                </div>
            }
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3 flex items-center gap-1.5">
                Manuel İndirim Kırılımı — 2026
                <span class="text-[11px] font-normal text-base-content/50 ml-1">SPC.Source=1 · RefundReasons.Type=1 · sebep seç → Mağaza×Ay detay</span>
            </h3>
            @if (_kumbaraLoading)
            {
                <div class="text-xs text-base-content/40 animate-pulse">Yükleniyor...</div>
            }
            else if (_manuel.Count == 0)
            {
                <div class="text-xs text-base-content/40">Veri yok (2026 başından itibaren).</div>
            }
            else
            {
                @* --- SEBEP ÖZETİ --- *@
                var sebepler = _manuel.GroupBy(r => r.Sebep)
                    .Select(g => (
                        Sebep:    g.Key,
                        Brut:     g.Sum(x => x.Brut),
                        Indirim:  g.Sum(x => x.Indirim),
                        Net:      g.Sum(x => x.Net),
                        Fis:      g.Sum(x => x.FisSayisi)))
                    .OrderByDescending(x => x.Indirim).ToList();
                var toplamBrut = sebepler.Sum(s => s.Brut);
                var toplamInd  = sebepler.Sum(s => s.Indirim);
                var toplamNet  = sebepler.Sum(s => s.Net);
                var toplamFis  = sebepler.Sum(s => s.Fis);
                <div class="overflow-x-auto mb-3">
                <table class="table table-xs w-full">
                    <thead><tr class="text-[11px] text-base-content/60">
                        <th>İndirim Sebebi</th>
                        <th class="text-right">Brüt</th>
                        <th class="text-right">İndirim</th>
                        <th class="text-right">İnd.%</th>
                        <th class="text-right">Net</th>
                        <th class="text-right">Fiş</th>
                        <th class="text-right">Ort.İnd/Fiş</th>
                        <th class="text-right">Pay</th>
                        <th class="w-5"></th>
                    </tr></thead>
                    <tbody>
                    @foreach (var s in sebepler)
                    {
                        var sebep    = s.Sebep;
                        var indPct   = s.Brut > 0 ? Math.Round(s.Indirim / s.Brut * 100, 1) : 0;
                        var payPct   = toplamInd > 0 ? Math.Round(s.Indirim / toplamInd * 100, 1) : 0;
                        var ortFis   = s.Fis > 0 ? Math.Round(s.Indirim / s.Fis, 0) : 0;
                        var active   = _selSebep == sebep;
                        var indColor = indPct > 30 ? "text-error font-semibold" : indPct > 15 ? "text-warning" : "text-base-content/60";
                        <tr class="cursor-pointer hover:bg-base-200/60 @(active ? "bg-warning/10" : "")" @onclick="@(() => _selSebep = active ? null : sebep)">
                            <td class="font-medium text-[12px] @(sebep.Contains("Kumbara") ? "text-warning" : "")">@sebep</td>
                            <td class="text-right text-[12px] text-base-content/60">@Tl(s.Brut)</td>
                            <td class="text-right text-[12px] text-error font-semibold">@Tl(s.Indirim)</td>
                            <td class="text-right text-[12px] @indColor">%@indPct</td>
                            <td class="text-right text-[12px] text-base-content/70">@Tl(s.Net)</td>
                            <td class="text-right text-[12px] text-base-content/60">@Num(s.Fis)</td>
                            <td class="text-right text-[12px] text-base-content/60">@Tl(ortFis)</td>
                            <td class="text-right text-[12px] text-base-content/50">%@payPct</td>
                            <td class="text-[10px] text-base-content/40">@(active ? "▲" : "▼")</td>
                        </tr>
                        @if (active)
                        {
                            @* --- MAĞAZA × AY DETAY (tıklanan sebep) --- *@
                            var detay    = _manuel.Where(r => r.Sebep == sebep).ToList();
                            var aylarD   = detay.Select(r => r.Ay).Distinct().OrderBy(a => a).ToList();
                            var magazalarD = detay.Select(r => r.Magaza).Distinct().OrderBy(m => m).ToList();
                            <tr class="bg-base-200/40">
                                <td colspan="9" class="p-0">
                                <div class="overflow-x-auto p-2">
                                <table class="table table-xs w-full text-[11px]">
                                    <thead><tr class="text-base-content/50">
                                        <th>Ay</th>
                                        @foreach (var mag in magazalarD)
                                        {
                                            <th class="text-right">@mag Brüt</th>
                                            <th class="text-right">İnd.</th>
                                            <th class="text-right">%</th>
                                            <th class="text-right">Fiş</th>
                                        }
                                        <th class="text-right font-semibold">Top.İnd.</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var ay in aylarD)
                                    {
                                        var satirlar = detay.Where(r => r.Ay == ay).ToList();
                                        <tr>
                                            <td class="font-medium">@ay</td>
                                            @foreach (var mag in magazalarD)
                                            {
                                                var r = satirlar.FirstOrDefault(x => x.Magaza == mag);
                                                <td class="text-right text-base-content/60">@(r is null ? "—" : Tl(r.Brut))</td>
                                                <td class="text-right text-error">@(r is null ? "—" : Tl(r.Indirim))</td>
                                                <td class="text-right @(r is not null && r.IndirimPct > 30 ? "text-error font-semibold" : r is not null && r.IndirimPct > 15 ? "text-warning" : "text-base-content/50")">@(r is null ? "—" : $"%{r.IndirimPct}")</td>
                                                <td class="text-right text-base-content/50">@(r is null ? "—" : Num(r.FisSayisi))</td>
                                            }
                                            <td class="text-right font-semibold text-error">@Tl(satirlar.Sum(r => r.Indirim))</td>
                                        </tr>
                                    }
                                    </tbody>
                                    <tfoot><tr class="font-bold border-t border-base-300">
                                        <td>TOPLAM</td>
                                        @foreach (var mag in magazalarD)
                                        {
                                            var m2 = mag;
                                            var mg = detay.Where(r => r.Magaza == m2).ToList();
                                            var mB = mg.Sum(r => r.Brut); var mI = mg.Sum(r => r.Indirim);
                                            <td class="text-right text-base-content/60">@Tl(mB)</td>
                                            <td class="text-right text-error">@Tl(mI)</td>
                                            <td class="text-right @(mB > 0 && mI/mB*100 > 30 ? "text-error" : "text-base-content/50")">@(mB > 0 ? $"%{Math.Round(mI/mB*100,1)}" : "—")</td>
                                            <td class="text-right text-base-content/50">@Num(mg.Sum(r=>r.FisSayisi))</td>
                                        }
                                        <td class="text-right text-error">@Tl(detay.Sum(r => r.Indirim))</td>
                                    </tr></tfoot>
                                </table>
                                </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                    <tfoot><tr class="font-bold text-[12px] border-t-2 border-base-200">
                        <td>TOPLAM</td>
                        <td class="text-right text-base-content/60">@Tl(toplamBrut)</td>
                        <td class="text-right text-error">@Tl(toplamInd)</td>
                        <td class="text-right @(toplamBrut > 0 && toplamInd/toplamBrut*100 > 15 ? "text-error" : "")">@(toplamBrut > 0 ? $"%{Math.Round(toplamInd/toplamBrut*100,1)}" : "—")</td>
                        <td class="text-right text-base-content/70">@Tl(toplamNet)</td>
                        <td class="text-right">@Num(toplamFis)</td>
                        <td class="text-right">@Tl(toplamFis > 0 ? Math.Round(toplamInd / toplamFis, 0) : 0)</td>
                        <td class="text-right">%100</td>
                        <td></td>
                    </tr></tfoot>
                </table>
                </div>
                <div class="text-base-content/50 text-[11px]">İnd.%>30 kırmızı · >15 turuncu · Satıra tıkla → Mağaza×Ay detay (Brüt/İnd./%).</div>
            }
        </div>
    </div>
}


@code {
    private string _period = "gunluk";
    private DateTime? _ozelBas = DateTime.Today.AddDays(-7);
    private DateTime? _ozelBit = DateTime.Today.AddDays(-1);
    private bool _loading = true;
    private string? _error;
    private PeriodSummary? _data;
    private OpsData? _ops;
    private DepoWmsData? _wms;
    private string _aralik = "";
    private Dictionary<string, decimal?> _kasDelta = new();   // B-57 kasiyer net delta (Magaza|Ad → %)
    private IReadOnlyList<KumbaraAyRow> _kumbara = [];
    private IReadOnlyList<ManuelIndirimRow> _manuel = [];
    private bool _kumbaraLoading = true;
    private string? _selSebep;   // açık sebep drill

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);
        if (AppState.TryTakeFromJson<PeriodSummary>("ops_data", out var d) &&
            AppState.TryTakeFromJson<OpsData>("ops_ops", out var ops))
        {
            _data = d; _ops = ops;
            if (AppState.TryTakeFromJson<DepoWmsData>("ops_wms", out var wms)) _wms = wms;
            _loading = false; StateHasChanged();
            return;
        }
        await LoadAsync();
    }

    private Task PersistData()
    {
        if (_data is not null) AppState.PersistAsJson("ops_data", _data);
        if (_ops is not null) AppState.PersistAsJson("ops_ops", _ops);
        if (_wms is not null) AppState.PersistAsJson("ops_wms", _wms);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private (DateOnly, DateOnly) OzelAralik()
    {
        var b = DateOnly.FromDateTime(_ozelBas ?? DateTime.Today.AddDays(-7));
        var e = DateOnly.FromDateTime(_ozelBit ?? DateTime.Today.AddDays(-1));
        if (e < b) e = b;
        return (b, e.AddDays(1));
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    private async Task LoadAsync()
    {
        var sw = PerfState.Start();
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                "ozel" => OzelAralik(),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            // B-57 önceki eş-uzunluk dönem (kasiyer delta)
            int len = endExcl.DayNumber - start.DayNumber;
            var pStart = start.AddDays(-len);
            var tData = Queries.GetPeriodAsync(start, endExcl);
            var tOps = Ref.GetOpsAsync(dun);
            var tKas = Queries.GetKasiyerDeltaAsync(start, endExcl, pStart, start);
            var tWms = Ref.GetDepoWmsAsync();
            await Task.WhenAll(tData, tOps, tKas, tWms);   // herhangi biri patlarsa burada throw → dış catch
            _data = tData.Result;
            _kasDelta = tKas.Result.ToDictionary(k => k.Magaza + "|" + k.Ad, k => k.DeltaPct);
            _ops = tOps.Result;   // B-85: ölü iç try/catch kaldırıldı (WhenAll await sonrası .Result throw etmez)
            _wms = tWms.Result;
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = "Veri yüklenirken hata oluştu."; }
        finally { _loading = false; Perf.Report("Operasyon", sw); StateHasChanged(); }

        // Manuel indirim + Kumbara — ağır JOIN, arka planda yükle (B-98)
        try
        {
            var tKumbara = Ref.GetKumbaraAsync();
            var tManuel = Ref.GetManuelIndirimAsync();
            await Task.WhenAll(tKumbara, tManuel);
            _kumbara = tKumbara.Result;
            _manuel = tManuel.Result;
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Manuel indirim verisi alınamadı"); _kumbara = []; _manuel = []; }
        finally { _kumbaraLoading = false; StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null)
        {
            try
            {
                var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
                await charts.InvokeVoidAsync("heroDots", "opkpi", "opkpiDots");   // KPI carousel dot senkronu
            }
            catch { /* prerender — sonraki render'da bağlanır */ }
        }
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    // B-57 kasiyer net delta badge (önceki eş döneme göre). Yok → "yeni" nötr.
    private (string Text, string Cls) KasDeltaBadge(KasiyerRow k)
    {
        var d = _kasDelta.GetValueOrDefault(k.Magaza + "|" + k.Ad);
        if (d is null) return ("yeni", "bg-base-200 text-base-content/55");
        var s = d.Value.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
        return (s, d > 0 ? "bg-success/15 text-success" : d < 0 ? "bg-error/15 text-error" : "bg-base-200 text-base-content/55");
    }
}
