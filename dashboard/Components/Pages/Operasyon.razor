@page "/operasyon"
@using GmDashboard.Data
@using GmDashboard.Models
@inject Queries Queries
@inject RefQueries Ref
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Operasyon — BKM GM</PageTitle>

<div class="hd">
    <h1>Operasyon</h1>
    <span class="tar">@_aralik</span>
    <select class="period" @bind="_period" @bind:after="LoadAsync">
        <option value="gunluk">Günlük (dün)</option>
        <option value="haftalik">Haftalık (son 7 gün)</option>
        <option value="ay">Aylık (MTD)</option>
    </select>
</div>

@if (_loading)
{
    <p class="muted">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="err">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    <div class="row">
        <div class="panel"><h3>Saat Bazlı Yoğunluk (dönem)</h3><div class="chart-box"><canvas id="ch_saat"></canvas></div></div>
        <div class="panel panel-wide"><h3>Kasiyer Performansı (dönem) — @_data.Kasiyer.Count kişi</h3>
            <table>
                <tr><td><b>Kasiyer</b></td><td class="r"><b>Fiş</b></td><td class="r"><b>Net Ciro</b></td><td class="r"><b>Sepet</b></td><td class="r"><b>İade</b></td></tr>
                @{
                    string? curM = null;
                }
                @foreach (var k in _data.Kasiyer)
                {
                    if (k.Magaza != curM)
                    {
                        curM = k.Magaza;
                        <tr class="grp"><td colspan="5">@curM</td></tr>
                    }
                    <tr><td>@k.Ad</td><td class="r">@Num(k.Fis)</td><td class="r"><b>@Tl(k.Net)</b></td><td class="r">@Num(k.Atv) ₺</td><td class="r">@k.Iade</td></tr>
                }
                <tr class="tot"><td>TOPLAM (@_data.Kasiyer.Count kasiyer)</td><td class="r">@Num(_data.Kasiyer.Sum(k => k.Fis))</td>
                    <td class="r"><b>@Tl(_data.Kasiyer.Sum(k => k.Net))</b></td><td class="r"></td><td class="r">@_data.Kasiyer.Sum(k => k.Iade)</td></tr>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="panel"><h3>İşgücü Verimi — ₺/Çalışılan Saat (SPLH, son 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 0)
            {
                <table>
                    <tr><td><b>Mağaza</b></td><td class="r"><b>₺/saat</b></td><td class="r"><b>Fiş/saat</b></td><td class="r"><b>Personel</b></td></tr>
                    @foreach (var s in _ops.Splh)
                    {
                        <tr><td>@s.Magaza</td><td class="r"><b>@(s.Saat > 0 ? Num((int)Math.Round(s.NetCiro / s.Saat)) : "—")</b></td>
                            <td class="r">@(s.Saat > 0 ? (s.Fis / s.Saat).ToString("0.0") : "—")</td><td class="r">@s.Personel</td></tr>
                    }
                </table>
            }
            else
            {
                <p class="muted" style="font-size:12px">PDKS verisi alınamadı (linked server).</p>
            }
        </div>
        <div class="panel"><h3>Kayıp İşgücü Potansiyeli (SPLH benchmark, 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 1)
            {
                var bench = _ops.Splh.Where(s => s.Saat > 0).Max(s => s.NetCiro / s.Saat);
                var benchAd = _ops.Splh.First(s => s.Saat > 0 && s.NetCiro / s.Saat == bench).Magaza;
                decimal toplamKayip = 0;
                <table>
                    <tr><td><b>Mağaza</b></td><td class="r"><b>₺/saat</b></td><td class="r"><b>Fark</b></td><td class="r"><b>Kayıp Potansiyel</b></td></tr>
                    @foreach (var s in _ops.Splh.Where(x => x.Saat > 0))
                    {
                        var verim = s.NetCiro / s.Saat;
                        var kayip = (bench - verim) * s.Saat;
                        toplamKayip += kayip;
                        <tr><td>@s.Magaza</td><td class="r">@Num((int)Math.Round(verim))</td>
                            <td class="r">@(verim == bench ? "★ benchmark" : "−" + Num((int)Math.Round(bench - verim)))</td>
                            <td class="r" style="color:@(kayip > 0 ? "#dc2626" : "#16a34a")">@(kayip > 0 ? Tl(kayip) : "—")</td></tr>
                    }
                    <tr><td colspan="3" style="font-size:12px">@benchAd seviyesine çıkılsa (30g):</td><td class="r" style="color:#dc2626"><b>@Tl(toplamKayip)</b></td></tr>
                </table>
                <div class="muted" style="font-size:11px">En verimli mağaza (@benchAd) ₺/saat referans; diğerleri o seviyede çalışsa kazanılacak ek ciro. Atıl saat + devamsızlık boyutu PDKS plan keşfi sonrası eklenecek.</div>
            }
            else
            {
                <p class="muted" style="font-size:12px">SPLH verisi yok (PDKS).</p>
            }
        </div>
        <div class="panel"><h3>Kapıda Ödeme — Teslim/İade (olgun 60g)</h3>
            @if (_ops is not null)
            {
                <table>
                    <tr><td><b>Tip</b></td><td class="r"><b>Sipariş</b></td><td class="r"><b>Teslim %</b></td><td class="r"><b>İade %</b></td></tr>
                    @foreach (var c in _ops.Cod.OrderBy(x => x.Tip == "COD" ? 0 : 1))
                    {
                        <tr><td>@c.Tip</td><td class="r">@Num(c.Siparis)</td>
                            <td class="r">%@(c.Siparis > 0 ? Math.Round(100m * c.Teslim / c.Siparis, 1) : 0)</td>
                            <td class="r" style="color:@(c.Tip == "COD" ? "#dc2626" : "#16a34a")">%@(c.Siparis > 0 ? Math.Round(100m * c.Iade / c.Siparis, 1) : 0)</td></tr>
                    }
                    <tr><td colspan="4" style="color:#dc2626;font-size:12px">COD iade zararı (60g): <b>@Tl(_ops.CodZarar)</b> (kargo ×2)</td></tr>
                </table>
            }
        </div>
    </div>
}

@code {
    private string _period = "gunluk";
    private bool _loading = true;
    private string? _error;
    private PeriodSummary? _data;
    private OpsData? _ops;
    private string _aralik = "";
    private IJSObjectReference? _charts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try { _ops = await Ref.GetOpsAsync(DateOnly.FromDateTime(DateTime.Today).AddDays(-1)); }
        catch (Exception ex) { _error ??= ex.Message; }
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            _data = await Queries.GetPeriodAsync(start, endExcl);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); await DrawAsync(); }
    }

    private async Task DrawAsync()
    {
        if (_data is null) return;
        try
        {
            _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _charts.InvokeVoidAsync("barDual", "ch_saat",
                _data.Saat.Select(h => $"{h.Saat:00}"), _data.Saat.Select(h => h.Fis), _data.Saat.Select(h => h.Net));
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _data is not null) await DrawAsync();
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
