@page "/operasyon"
@using GmDashboard.Data
@using GmDashboard.Models
@inject Queries Queries
@inject RefQueries Ref
@inject PerfState Perf
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Operasyon — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">@_aralik</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">Operasyon</h1>
</div>
<AppPeriodPills Period="_period" PeriodChanged="SetPeriod" Busy="_loading" CssClass="mb-4 lg:max-w-md" />
@if (_period == "ozel")
{
    <div class="flex gap-2 mb-4 flex-wrap">
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBas" @bind:after="LoadAsync" />
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBit" @bind:after="LoadAsync" />
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    <AppKpiCarousel Id="opkpi" Items="@(new List<KpiCardData>
    {
        new("Toplam İşlem", Num(_data.Fis), "from-primary to-primary/80", "mağaza fiş"),
        new("Kasiyer", Num(_data.Kasiyer.Count), "from-info to-info/80", "aktif kasiyer"),
        new("En Yoğun Saat", _data.Saat.Count > 0 ? $"{_data.Saat.OrderByDescending(h => h.Fis).First().Saat:00}:00" : "—", "from-success to-success/80", "fiş zirvesi"),
        new("COD İade Zararı", _ops is not null ? Tl(_ops.CodZarar) : "—", "from-error to-error/80", "60g kargo×2"),
        new("Depo Bugün", _wms is not null ? Num(_wms.BugunAdet) : "—", "from-warning to-warning/80", $"{(_wms?.BugunIslem ?? 0)} toplama emri"),
    })" />

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Saat Bazlı Yoğunluk (@_aralik)<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded-md bg-base-200 text-base-content/55 ml-auto">mağaza · online hariç</span></h3><p class="text-[11px] text-base-content/50 mb-2">fiş yoğunluğu (saat bazlı)</p>
            <AppRankBars TItem="HourBar" Items="@(_data.Saat.OrderByDescending(h => h.Fis).Take(6))"
                         Label="@(h => $"{h.Saat:00}:00–{(h.Saat + 1):00}:00")" Value="@(h => (decimal)h.Fis)"
                         ValueText="@(h => $"{Num(h.Fis)} fiş")" /></div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kasiyer Performansı (@_aralik) — @_data.Kasiyer.Count kişi</h3>
            <AppDataTable TItem="KasiyerRow" Items="_data.Kasiyer"
                          Primary="@(k => k.Ad)" Sub="@(k => k.Magaza)"
                          MetricMain="@(k => Tl(k.Net))" MetricSub="@(k => $"{Num(k.Fis)} fiş")"
                          Badge="@(k => KasDeltaBadge(k))">
                <Details Context="k">
                    <div class="grid grid-cols-3 gap-2 text-[12px]">
                        <div><div class="text-base-content/50 text-[10px]">Fiş</div><div class="font-semibold tabular-nums">@Num(k.Fis)</div></div>
                        <div><div class="text-base-content/50 text-[10px]">Sepet</div><div class="font-semibold tabular-nums">@Num(k.Atv) ₺</div></div>
                        <div><div class="text-base-content/50 text-[10px]">İade</div><div class="font-semibold tabular-nums @(k.Iade > 0 ? "text-error" : "")">@k.Iade</div></div>
                    </div>
                </Details>
            </AppDataTable>
            <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                <span class="font-bold">TOPLAM (@_data.Kasiyer.Count kasiyer)</span>
                <span class="font-bold tabular-nums">@Tl(_data.Kasiyer.Sum(k => k.Net))</span>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">İşgücü Verimi — ₺/Çalışılan Saat (SPLH, son 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 0)
            {
                <AppDataTable TItem="SplhRow" Items="_ops.Splh"
                              Primary="@(s => s.Magaza)"
                              MetricMain="@(s => s.Saat > 0 ? Num((int)Math.Round(s.NetCiro / s.Saat)) + " ₺/s" : "—")"
                              MetricSub="@(s => s.Saat > 0 ? (s.Fis / s.Saat).ToString("0.0") + " fiş/saat" : "—")"
                              Badge="@(s => ($"👤{s.Personel}", "bg-base-200 text-base-content/50"))" />
            }
            else
            {
                <p class="text-base-content/50 text-xs mb-2">PDKS verisi alınamadı (linked server).</p>
            }
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kayıp İşgücü Potansiyeli (SPLH benchmark, 30g)</h3>
            @if (_ops is not null && _ops.Splh.Count > 1)
            {
                var bench = _ops.Splh.Where(s => s.Saat > 0).Max(s => s.NetCiro / s.Saat);
                var benchAd = _ops.Splh.First(s => s.Saat > 0 && s.NetCiro / s.Saat == bench).Magaza;
                var splhAktif = _ops.Splh.Where(x => x.Saat > 0).ToList();
                decimal toplamKayip = splhAktif.Sum(s => (bench - s.NetCiro / s.Saat) * s.Saat);
                <AppDataTable TItem="SplhRow" Items="splhAktif"
                              Primary="@(s => s.Magaza)"
                              MetricMain="@(s => { var k = (bench - s.NetCiro / s.Saat) * s.Saat; return k > 0 ? Tl(k) : "—"; })"
                              MetricSub="@(s => "verim " + Num((int)Math.Round(s.NetCiro / s.Saat)) + " ₺/s")"
                              Badge="@(s => { var verim = s.NetCiro / s.Saat; return verim == bench ? ("★ benchmark", "bg-base-200 text-base-content/50") : ("−" + Num((int)Math.Round(bench - verim)), "bg-error/10 text-error"); })" />
                <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                    <span class="font-semibold text-base-content/70">@benchAd seviyesine çıkılsa (30g)</span>
                    <span class="font-bold tabular-nums text-error">@Tl(toplamKayip)</span>
                </div>
                <div class="text-base-content/50 text-[11px] mt-1">En verimli mağaza (@benchAd) ₺/saat referans; diğerleri o seviyede çalışsa kazanılacak ek ciro. Atıl saat + devamsızlık boyutu PDKS plan keşfi sonrası eklenecek.</div>
            }
            else
            {
                <p class="text-base-content/50 text-xs mb-2">SPLH verisi yok (PDKS).</p>
            }
        </div>
        @if (_wms is not null && _wms.Trend.Count > 0)
        {
            var wmsMax = _wms.Trend.Max(t => t.Adet);
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Depo Toplama Verimi — Son 14 Gün (adet)</h3>
                <AppRankBars TItem="DepoWmsTrend" Items="@(_wms.Trend)"
                             Label="@(t => t.Gun.ToString("dd MMM", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")))"
                             Value="@(t => t.Adet)"
                             ValueText="@(t => $"{Num(t.Adet)} adet · {t.Islem} emir")" />
            </div>
        }
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kapıda Ödeme — Teslim/İade (olgun 60g)</h3>
            @if (_ops is not null)
            {
                <AppDataTable TItem="CodRow" Items="@(_ops.Cod.OrderBy(x => x.Tip == "COD" ? 0 : 1))"
                              Primary="@(c => c.Tip)"
                              MetricMain="@(c => Num(c.Siparis))"
                              MetricSub="@(c => "sipariş")"
                              Sub="@(c => c.Siparis > 0 ? "teslim %" + Math.Round(100m * c.Teslim / c.Siparis, 1) : "teslim —")"
                              Badge="@(c => { var iadePct = c.Siparis > 0 ? Math.Round(100m * c.Iade / c.Siparis, 1) : 0; return c.Tip == "COD" ? ($"iade %{iadePct}", "bg-error/10 text-error") : ($"iade %{iadePct}", "bg-success/10 text-success"); })" />
                <div class="pt-2.5 mt-1 border-t-2 border-base-200 text-[13px] text-error">
                    COD iade zararı (60g): <span class="font-bold">@Tl(_ops.CodZarar)</span> <span class="text-base-content/50">(kargo ×2)</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private string _period = "gunluk";
    private DateTime? _ozelBas = DateTime.Today.AddDays(-7);
    private DateTime? _ozelBit = DateTime.Today.AddDays(-1);
    private bool _loading = true;
    private string? _error;
    private PeriodSummary? _data;
    private OpsData? _ops;
    private DepoWmsData? _wms;
    private string _aralik = "";
    private Dictionary<string, decimal?> _kasDelta = new();   // B-57 kasiyer net delta (Magaza|Ad → %)

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private (DateOnly, DateOnly) OzelAralik()
    {
        var b = DateOnly.FromDateTime(_ozelBas ?? DateTime.Today.AddDays(-7));
        var e = DateOnly.FromDateTime(_ozelBit ?? DateTime.Today.AddDays(-1));
        if (e < b) e = b;
        return (b, e.AddDays(1));
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    private async Task LoadAsync()
    {
        var sw = PerfState.Start();
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                "ozel" => OzelAralik(),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            // B-57 önceki eş-uzunluk dönem (kasiyer delta)
            int len = endExcl.DayNumber - start.DayNumber;
            var pStart = start.AddDays(-len);
            var tData = Queries.GetPeriodAsync(start, endExcl);
            var tOps = Ref.GetOpsAsync(dun);
            var tKas = Queries.GetKasiyerDeltaAsync(start, endExcl, pStart, start);
            var tWms = Ref.GetDepoWmsAsync();
            await Task.WhenAll(tData, tOps, tKas, tWms);
            _data = tData.Result;
            _kasDelta = tKas.Result.ToDictionary(k => k.Magaza + "|" + k.Ad, k => k.DeltaPct);
            try { _ops = tOps.Result; } catch (Exception ex) { _error ??= ex.Message; }
            try { _wms = tWms.Result; } catch { /* WMS erişilemez */ }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; Perf.Report("Operasyon", sw); StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null)
        {
            try
            {
                var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
                await charts.InvokeVoidAsync("heroDots", "opkpi", "opkpiDots");   // KPI carousel dot senkronu
            }
            catch { /* prerender — sonraki render'da bağlanır */ }
        }
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    // B-57 kasiyer net delta badge (önceki eş döneme göre). Yok → "yeni" nötr.
    private (string Text, string Cls) KasDeltaBadge(KasiyerRow k)
    {
        var d = _kasDelta.GetValueOrDefault(k.Magaza + "|" + k.Ad);
        if (d is null) return ("yeni", "bg-base-200 text-base-content/55");
        var s = d.Value.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
        return (s, d > 0 ? "bg-success/15 text-success" : d < 0 ? "bg-error/15 text-error" : "bg-base-200 text-base-content/55");
    }
}
