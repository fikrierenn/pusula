@page "/eticaret"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject Queries Queries
@inject EticQueries Etic
@inject PerfState Perf
@inject IJSRuntime JS
@inject ILogger<Eticaret> Logger
@inject PersistentComponentState AppState
@rendermode InteractiveServer

<PageTitle>E-ticaret — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">@_aralik</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">E-ticaret</h1>
</div>
<AppPeriodPills Period="_period" PeriodChanged="SetPeriod" Busy="_loading" CssClass="mb-4 lg:max-w-md" />
@if (_period == "ozel")
{
    <div class="flex gap-2 mb-4 flex-wrap">
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBas" @bind:after="LoadAsync" />
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBit" @bind:after="LoadAsync" />
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    <AppKpiCarousel Id="ekpi" Items="@(new List<KpiCardData>
    {
        new("Net Ciro (online)", Tl(_data.Eticaret), "from-primary to-primary/80", $"{Num(_data.ESip)} sipariş"),
        new("Net Sipariş", Num(_data.ESip), "from-info to-info/80", "iptal/iade hariç"),
        new("Sepet Ort.", Tl(_data.ESip > 0 ? Math.Round(_data.Eticaret / _data.ESip) : 0), "from-success to-success/80", "online ortalama"),
        new("İptal / İade", Num(_data.Etic.Sum(e => e.Ipt)), "from-error to-error/80", "iptal+iade sipariş"),
    })" />

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kanal — NET (@_aralik)</h3>
            @{ var kanalTot = _data.Etic.Sum(e => e.Ciro); }
            <AppRankBars TItem="EticChannel" Items="_data.Etic"
                         Label="@(e => e.Ad)" Value="@(e => e.Ciro)" ValueText="@(e => $"{Tl(e.Ciro)} · %{(kanalTot > 0 ? Math.Round(100 * e.Ciro / kanalTot) : 0)}")" /></div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kargo Firma (@_aralik)</h3>
            @{ var kargoFirmaTot = _data.Kargo.Sum(k => k.Adet); }
            <AppRankBars TItem="NameCount" Items="_data.Kargo"
                         Label="@(k => k.Ad)" Value="@(k => (decimal)k.Adet)" ValueText="@(k => $"{Num(k.Adet)} · %{(kargoFirmaTot > 0 ? Math.Round(100m * k.Adet / kargoFirmaTot) : 0)}")" /></div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">İl Dağılımı (@_aralik)</h3>
            @{ var ilTot = _data.Il.Sum(x => x.Adet); var ilTop = _data.Il.Take(3).ToList(); var ilRest = _data.Il.Skip(3).ToList(); }
            <AppIconRow TItem="NameCount" Items="ilTop"
                        Name="@(x => x.Ad)"
                        Sub="@(x => $"%{(ilTot > 0 ? Math.Round(100m * x.Adet / ilTot) : 0)} pay")"
                        Amount="@(x => Num(x.Adet))"
                        Icon="@(_ => "map-pin")"
                        IconColor="@(_ => ("bg-primary/10", "text-primary"))" />
            @if (ilRest.Count > 0)
            {
                <details class="group mt-1">
                    <summary class="list-none cursor-pointer select-none py-2 flex items-center gap-1.5 text-[12px] font-medium text-primary"><i data-lucide="chevron-down" class="w-4 h-4 transition-transform group-open:rotate-180"></i>+@ilRest.Count il daha</summary>
                    <AppIconRow TItem="NameCount" Items="ilRest"
                                Name="@(x => x.Ad)"
                                Sub="@(x => $"%{(ilTot > 0 ? Math.Round(100m * x.Adet / ilTot) : 0)} pay")"
                                Amount="@(x => Num(x.Adet))"
                                Icon="@(_ => "map-pin")"
                                IconColor="@(_ => ("bg-primary/10", "text-primary"))" />
                </details>
            }</div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kargo Performansı (@_aralik) — @_kargoPerf.Count firma</h3>
            <AppDataTable TItem="KargoPerf" Items="_kargoPerf"
                          Primary="@(k => k.Kargo)"
                          Sub="@(k => $"{Num(k.Adet)} sipariş · teslim {(k.TeslimGun is null ? "—" : k.TeslimGun.Value.ToString("0.0") + "g")}")"
                          MetricMain="@(k => k.CikisIsGunu is null ? "—" : $"{k.CikisIsGunu.Value:0.0}g")"
                          MetricSub="@(k => k.CikisTakvim is null ? "" : $"takvim {k.CikisTakvim.Value:0.0}g")"
                          Badge="@(k => k.CikisIsGunu >= 3 ? ("yavaş", "bg-error/10 text-error") : k.CikisIsGunu <= 2 ? ("hızlı", "bg-success/10 text-success") : ("orta", "bg-base-200 text-base-content/50"))" />
            <div class="text-base-content/50 text-[11px] mt-2"><b>Çıkış İş Günü</b> = depo gerçek (hafta sonu+tatil hariç) — ana metrik. Takvim = müşteri algısı. Teslim = kargo→müşteri. İş günü ≥3 kırmızı, ≤2 yeşil.</div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Bekleyen Gün — Kargoya Çıkmamış (anlık)</h3>
            @{ var bekToplam = _bekleyen.Sum(b => b.Adet); }
            <AppRankBars TItem="BekleyenBucket" Items="_bekleyen"
                         Label="@(b => b.Bucket)" Value="@(b => (decimal)b.Adet)" ValueText="@(b => $"{Num(b.Adet)} · %{(bekToplam > 0 ? Math.Round(100m * b.Adet / bekToplam) : 0)}")" />
            <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                <span class="font-bold">TOPLAM bekleyen</span><span class="font-bold tabular-nums">@Num(bekToplam)</span>
            </div>
            <div class="text-base-content/50 text-[11px] mt-2">SENDDATE boş + normal statü. Sipariş tarihinden bugüne yaş. 4g+ = SLA riski.</div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Günlük Kargo Çıkışı (@_aralik) — sipariş → kargoya teslim gün</h3>
            @{ var kgTop = _kargoGun.Sum(k => k.Adet); }
            <AppRankBars TItem="KargoGun" Items="_kargoGun"
                         Label="@(k => k.Gun == 0 ? "Aynı gün" : $"{k.Gun}. gün")" Value="@(k => (decimal)k.Adet)" ValueText="@(k => $"{Num(k.Adet)} · %{(kgTop > 0 ? Math.Round(100m * k.Adet / kgTop) : 0)}")" />
            <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
                <span class="font-bold">TOPLAM çıkan</span><span class="font-bold tabular-nums">@Num(kgTop)</span>
            </div>
            <div class="text-base-content/50 text-[11px] mt-2">DATEDIFF(gün, sipariş, kargoya teslim). 4. gün+ = yavaş çıkış.</div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">İl Teslimat Performansı — Top 15 (çıkış @_aralik) — @_ilTeslimat.Count il</h3>
            <AppDataTable TItem="IlTeslimat" Items="_ilTeslimat"
                          Primary="@(i => i.Sehir)"
                          Sub="@(i => $"{Num(i.Adet)} sipariş · teslim {i.TeslimGun:0.0}g")"
                          MetricMain="@(i => $"{i.CikisIsGunu:0.0}g")"
                          MetricSub="@(i => $"takvim {i.CikisTakvim:0.0}g")"
                          Badge="@(i => i.CikisIsGunu >= 3 ? ("yavaş", "bg-error/10 text-error") : i.CikisIsGunu <= 2 ? ("hızlı", "bg-success/10 text-success") : ("orta", "bg-base-200 text-base-content/50"))" />
            <div class="text-base-content/50 text-[11px]"><b>Çıkış Takvim</b> = müşteri algısı (ham gün, hafta sonu+tatil dahil). <b>Çıkış İş Günü</b> = depo gerçek performansı (Pzt-Cuma çalışma). Teslim = kargo→müşteri (takvim, il+mesafe). Toplam (algı) = takvim çıkış + teslim = müşterinin beklediği süre. İş günü ≥3 kırmızı / ≤2 yeşil, teslim ≤1,5g yeşil. STATUS=1005 teslim olmuş.</div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Aylık Çıkış Trendi — Depo Kargoya-Verme (son 13 ay)</h3>
            @{
                var ayLast = _ayKargo.Count > 0 ? _ayKargo[^1].CikisIsGunu : 0m;
                var ayAvg  = _ayKargo.Count > 0 ? _ayKargo.Average(a => a.CikisIsGunu) : 0m;
                var ayWow  = WowOf(ayLast, ayAvg);
            }
            <div class="flex items-center gap-2 mb-2">
                <div class="text-2xl font-extrabold tracking-tight whitespace-nowrap">@ayLast.ToString("0.0") iş günü</div>
                @if (ayWow is not null)
                {
                    var tc = TrendIco(ayWow.Value);
                    <span class="text-xs font-bold inline-flex items-center gap-0.5 @tc.cls" title="13 ay ortalamasına göre"><i data-lucide="@tc.ico" class="w-3.5 h-3.5"></i>@Pct(ayWow.Value)</span>
                }
                <div class="text-[11px] text-base-content/45 ml-auto text-right">son ay · ort @ayAvg.ToString("0.0")</div>
            </div>
            <AppAreaChart TItem="AyKargo" Items="_ayKargo" Name="Çıkış İş Günü" Color="@_pColor" Height="110"
                          XValue="@(a => (object)a.Ay)" YValue="@(a => (decimal?)a.CikisIsGunu)" />
            <AppIconRow TItem="AyKargo" Items="_ayKargo"
                        Name="@(a => a.Ay)"
                        Sub="@(a => $"{Num(a.Siparis)} sipariş · takvim {a.CikisTakvim:0.0}g")"
                        Amount="@(a => $"{a.CikisIsGunu:0.0}g")"
                        Icon="@(_ => "calendar")"
                        IconColor="@(a => a.CikisIsGunu >= 3 ? ("bg-error/10", "text-error") : a.CikisIsGunu <= 2 ? ("bg-success/10", "text-success") : ("bg-base-200", "text-base-content/60"))"
                        OnRowClick="@(a => OpenAyDetay(a))" />
            <div class="text-base-content/50 text-[11px]">Grafik = <b>iş günü</b> trend (depo gerçek). Takvim = müşteri algısı. Yoğun aylarda iş günü artar (kapasite darboğazı) — örn. yılbaşı. ≥3 iş günü kırmızı, ≤2 yeşil.</div>
        </div>
    </div>

    @if (_cod is not null)
    {
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kapıda Ödeme (COD) — İade Maliyeti (@_aralik)</h3>
                <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-3">
                    <div><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">COD Sipariş</div><div class="text-[22px] font-extrabold tracking-tight">@Num(_cod.Siparis)</div></div>
                    <div><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">Teslim</div><div class="text-[22px] font-extrabold tracking-tight text-success">@Num(_cod.Teslim)</div></div>
                    <div><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">İade</div><div class="text-[22px] font-extrabold tracking-tight @(_cod.IadeOran >= 10 ? "text-error" : "text-warning")">@Num(_cod.Iade) · %@_cod.IadeOran</div></div>
                    <div><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">İade Kargo Maliyeti</div><div class="text-[22px] font-extrabold tracking-tight text-error">@Tl(_cod.IadeMaliyet)</div></div>
                    <div><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">Kapıda Bedel (pass-through)</div><div class="text-[22px] font-extrabold tracking-tight text-base-content/60">@Tl(_cod.KapidaBedel)</div></div>
                </div>
                <div class="text-base-content/50 text-[11px] mt-3">İade maliyeti = <b>2×kargo bedeli</b> (gidiş+geri getirme) — teslim edilmeyen COD sipariş, <b>BKM yutar</b>. Kapıda bedel (SERVICEPRICE) firmaya ödenen pass-through, kâr değil. COD iade oranı coğrafya-bağımlı (Doğu yüksek). PAYDEFREF=-3, çıkış dönemine göre.</div>
            </div>
            <!-- B-56 COD il bazlı iade riski -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
                <h3 class="text-sm font-semibold text-base-content/90 mb-3 flex items-center gap-1.5"><i data-lucide="map-pin" class="w-4 h-4 text-error"></i>COD İade Riski — İl Bazlı (en yüksek, @_aralik)</h3>
                <AppDataTable TItem="CodIl" Items="_codIl"
                              Primary="@(c => c.Sehir)" Sub="@(c => $"{Num(c.Siparis)} COD sipariş")"
                              MetricMain="@(c => $"{Num(c.Iade)} iade")"
                              Badge="@(c => ($"%{c.Oran}", c.Oran >= 15 ? "bg-error/15 text-error" : c.Oran >= 10 ? "bg-warning/15 text-warning" : "bg-base-200 text-base-content/55"))" />
                <div class="text-base-content/50 text-[11px] mt-3">≥20 COD siparişli iller · iade oranına göre sıralı. Yüksek-riskli illerde COD kapatma/ön-ödeme teşviki değerlendirilebilir.</div>
            </div>
        </div>

    @if (_eticKtgr.Count > 0 || _funnel.Count > 0)
    {
        var topCiro = _eticKtgr.Sum(r => r.NetCiro);
        var topSiparis = _funnel.Sum(r => r.Siparis);
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
            @if (_eticKtgr.Count > 0)
            {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
                <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Online Kategori Mix — @_aralik</h3>
                <AppRankBars TItem="EticKategoriRow"
                             Items="@_eticKtgr"
                             Label="@(r => r.Kategori)"
                             Value="@(r => r.NetCiro)"
                             ValueText="@(r => $"{Tl(r.NetCiro)}  %{(topCiro > 0 ? r.NetCiro * 100 / topCiro : 0):0.0} · {Num(r.Siparis)} sipariş")"
                             OnRowClick="OpenKtgrDetay" />
                <div class="text-base-content/50 text-[11px] mt-2">JOKER net ciro (SELLINGPRICE × adet). Kategori = J_ITEMS logo grubu (DerinSIS Kategori3 grain). Tanımsız = kategorisiz ürün. Satıra dokun → ürün kırılımı.</div>
            </div>
            }
            @if (_funnel.Count > 0)
            {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Sipariş Durum Dağılımı — @_aralik</h3>
                <AppDataTable TItem="EticFunnelRow"
                              Items="@_funnel"
                              Primary="@(r => r.Asama.Substring(2))"
                              MetricMain="@(r => Num(r.Siparis) + " sipariş")"
                              MetricSub="@(r => Tl(r.ToplamCiro))"
                              Badge="@(r => r.Asama[0] switch {
                                  '3' => ($"%{(topSiparis > 0 ? r.Siparis * 100m / topSiparis : 0):0.0}", "bg-success/15 text-success"),
                                  '4' => ($"%{(topSiparis > 0 ? r.Siparis * 100m / topSiparis : 0):0.0}", "bg-warning/15 text-warning"),
                                  '5' => ($"%{(topSiparis > 0 ? r.Siparis * 100m / topSiparis : 0):0.0}", "bg-error/15 text-error"),
                                  _ => ($"%{(topSiparis > 0 ? r.Siparis * 100m / topSiparis : 0):0.0}", "bg-base-200 text-base-content/60"),
                              })" />
                <div class="text-base-content/50 text-[11px] mt-2">J_ORDERS.STATUS → 6 aşama. Kargo verildi = teslimata çıkmış. İptal+İade toplam kayıp sinyali.</div>
            </div>
            }
        </div>
    }

    @if (_ktgrYil.Count > 0)
    {
        <div class="mb-3">
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5"><i data-lucide="chart-column" class="w-4 h-4 text-primary"></i>Kategori Yıl Trendi — @DateTime.Today.Year (aylık net ciro)</h3>
                <AppStackedBarChart TItem="EticKategoriAyRow" Items="@YilLumped()" Height="320"
                                    Series="@(r => r.Kategori)" XValue="@(r => (object)AyAd(r.Ay))" YValue="@(r => (decimal?)r.NetCiro)" />
                <div class="text-base-content/50 text-[11px] mt-2">Aylık net ciro, kategori bazlı yığılmış (en büyük 7 + Diğer). Mevcut yıl Oca→bugün, ORDERDATE bazlı.</div>
            </div>
        </div>
    }
    }

    <Modal @bind-Open="_modalGun" Title="@(_selAy?.Ay + " — Günlük Çıkış Detayı")">
        @if (_selAy is not null)
        {
            <div class="text-base-content/50 text-xs mb-2">@_selAy.Ay · @Num(_selAy.Siparis) sipariş · çıkış takvim @_selAy.CikisTakvim.ToString("0.0")g / iş günü @_selAy.CikisIsGunu.ToString("0.0")g</div>
            <AppDataTable TItem="GunKargo" Items="_gunKargo"
                          Primary="@(g => GunAdi(g.Gun))"
                          Sub="@(g => g.Gun)"
                          MetricMain="@(g => $"{g.CikisIsGunu:0.0}g")"
                          MetricSub="@(g => Num(g.Siparis) + " sipariş")"
                          Badge="@(g => g.CikisIsGunu >= 3 ? ("yavaş", "bg-error/10 text-error") : g.CikisIsGunu <= 2 ? ("hızlı", "bg-success/10 text-success") : ("orta", "bg-base-200 text-base-content/50"))" />
            <div class="text-base-content/50 text-[11px] mt-2">Çıkış iş günü = hafta sonu + tatil hariç. Düşük-sipariş gün = resmi/dini tatil (depo kapalı).</div>
        }
    </Modal>

    <Modal @bind-Open="_modalKtgr" Title="@(_selKtgr?.Kategori + " — Ürün Kırılımı")">
        @if (_selKtgr is not null)
        {
            <div class="text-base-content/50 text-xs mb-2">@_aralik · @Tl(_selKtgr.NetCiro) net ciro · @Num(_selKtgr.Siparis) sipariş · @Num(_selKtgr.Adet) adet</div>
            @if (_ktgrUrun.Count > 0)
            {
                <AppDataTable TItem="EticKategoriUrunRow" Items="_ktgrUrun"
                              Primary="@(u => u.Urun)"
                              Sub="@(u => $"{Num(u.Siparis)} sipariş · {Num(u.Adet)} adet")"
                              MetricMain="@(u => Tl(u.NetCiro))" />
                <div class="text-base-content/50 text-[11px] mt-2">En yüksek net ciro ilk 30 ürün. Net ciro = SELLINGPRICE × adet.</div>
            }
            else
            {
                <div class="text-base-content/50 text-[13px] py-4 text-center">Yükleniyor…</div>
            }
        }
    </Modal>
}

@code {
    private string _period = "gunluk";
    private DateTime? _ozelBas = DateTime.Today.AddDays(-7);
    private DateTime? _ozelBit = DateTime.Today.AddDays(-1);
    private bool _loading = true;
    private string? _error;
    private string _aralik = "";
    private PeriodSummary? _data;
    private IReadOnlyList<KargoPerf> _kargoPerf = [];
    private IReadOnlyList<BekleyenBucket> _bekleyen = [];
    private IReadOnlyList<KargoGun> _kargoGun = [];
    private IReadOnlyList<IlTeslimat> _ilTeslimat = [];
    private IReadOnlyList<AyKargo> _ayKargo = [];
    private CodOzet? _cod;
    private IReadOnlyList<CodIl> _codIl = [];   // B-56 il bazlı COD risk
    private IReadOnlyList<EticKategoriRow> _eticKtgr = [];   // B-59 kategori mix
    private IReadOnlyList<EticFunnelRow> _funnel = [];        // B-64 sipariş durum huni
    private string _pColor = "";   // DaisyUI --p (grafik rengi, OnAfterRender'da köprüden)
    private bool _modalGun;
    private AyKargo? _selAy;
    private IReadOnlyList<GunKargo> _gunKargo = [];
    private bool _modalKtgr;
    private EticKategoriRow? _selKtgr;
    private IReadOnlyList<EticKategoriUrunRow> _ktgrUrun = [];
    private DateOnly _start, _endExcl;   // kategori drill için aktif dönem
    private IReadOnlyList<EticKategoriAyRow> _ktgrYil = [];   // kategori × ay yıl trendi (yığılmış grafik)

    private static readonly string[] _aylar = { "Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara" };
    private static string AyAd(int ay) => ay is >= 1 and <= 12 ? _aylar[ay - 1] : ay.ToString();

    // Yığılmış grafik için: en büyük 7 kategori + kalan "Diğer", aya göre sıralı.
    private IReadOnlyList<EticKategoriAyRow> YilLumped()
    {
        if (_ktgrYil.Count == 0) return [];
        var top = _ktgrYil.GroupBy(r => r.Kategori)
            .Select(g => (Kat: g.Key, Tot: g.Sum(x => x.NetCiro)))
            .OrderByDescending(x => x.Tot).Take(7).Select(x => x.Kat).ToHashSet();
        return _ktgrYil
            .Select(r => top.Contains(r.Kategori) ? r : r with { Kategori = "Diğer" })
            .GroupBy(r => (r.Ay, r.Kategori))
            .Select(g => new EticKategoriAyRow(g.Key.Ay, g.Key.Kategori, g.Sum(x => x.NetCiro)))
            .OrderBy(r => r.Ay)
            .ToList();
    }

    private async Task OpenAyDetay(AyKargo a)
    {
        _selAy = a; _modalGun = true; _gunKargo = []; StateHasChanged();
        try { _gunKargo = await Etic.GetGunKargoAsync(a.AyKod); }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { StateHasChanged(); }
    }

    private async Task OpenKtgrDetay(EticKategoriRow k)
    {
        _selKtgr = k; _modalKtgr = true; _ktgrUrun = []; StateHasChanged();
        try { _ktgrUrun = await Etic.GetEticKategoriUrunAsync(k.Kategori, _start, _endExcl); }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { StateHasChanged(); }
    }

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);
        if (AppState.TryTakeFromJson<PeriodSummary>("etc_data", out var d) &&
            AppState.TryTakeFromJson<List<BekleyenBucket>>("etc_bekleyen", out var bek) &&
            AppState.TryTakeFromJson<List<EticKategoriRow>>("etc_ktgr", out var ktgr) &&
            AppState.TryTakeFromJson<List<EticFunnelRow>>("etc_funnel", out var funnel))
        {
            _data = d; _bekleyen = bek ?? []; _eticKtgr = ktgr ?? []; _funnel = funnel ?? [];
            if (AppState.TryTakeFromJson<List<KargoPerf>>("etc_kargo", out var kp)) _kargoPerf = kp ?? [];
            if (AppState.TryTakeFromJson<CodOzet>("etc_cod", out var cod)) _cod = cod;
            if (AppState.TryTakeFromJson<List<EticKategoriAyRow>>("etc_ktgryil", out var ky)) _ktgrYil = ky ?? [];
            _loading = false; StateHasChanged();
            return;
        }
        await LoadAsync();
    }

    private Task PersistData()
    {
        if (_data is not null) AppState.PersistAsJson("etc_data", _data);
        AppState.PersistAsJson("etc_bekleyen", _bekleyen);
        AppState.PersistAsJson("etc_ktgr", _eticKtgr);
        AppState.PersistAsJson("etc_funnel", _funnel);
        AppState.PersistAsJson("etc_kargo", _kargoPerf);
        if (_cod is not null) AppState.PersistAsJson("etc_cod", _cod);
        AppState.PersistAsJson("etc_ktgryil", _ktgrYil);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private (DateOnly, DateOnly) OzelAralik()
    {
        var b = DateOnly.FromDateTime(_ozelBas ?? DateTime.Today.AddDays(-7));
        var e = DateOnly.FromDateTime(_ozelBit ?? DateTime.Today.AddDays(-1));
        if (e < b) e = b;
        return (b, e.AddDays(1));
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    private async Task LoadAsync()
    {
        var sw = PerfState.Start();
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                "ozel" => OzelAralik(),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _start = start; _endExcl = endExcl;   // kategori drill aktif dönemi
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            var tData      = Queries.GetPeriodAsync(start, endExcl);
            var tKargoPerf = Etic.GetKargoPerfAsync(start, endExcl);
            var tKargoGun  = Etic.GetKargoGunAsync(start, endExcl);
            var tIl        = Etic.GetIlTeslimatAsync(start, endExcl);
            var tAyKargo   = Etic.GetAyKargoAsync();      // son 13 ay (dönemsiz)
            var tCod       = Etic.GetCodOzetAsync(start, endExcl);
            var tCodIl     = Etic.GetCodIlAsync(start, endExcl);   // B-56
            var tBekleyen  = Etic.GetBekleyenAsync();    // anlık (dönemsiz)
            var tEticKtgr  = Etic.GetEticKategoriAsync(start, endExcl);   // B-59
            var tFunnel    = Etic.GetFunnelAsync(start, endExcl);          // B-64
            var tKtgrYil   = Etic.GetEticKategoriYilAsync();   // kategori × ay yıl trendi (dönemsiz)
            await Task.WhenAll(tData, tKargoPerf, tKargoGun, tIl, tAyKargo, tCod, tCodIl, tBekleyen, tEticKtgr, tFunnel, tKtgrYil);
            _data = tData.Result; _kargoPerf = tKargoPerf.Result; _kargoGun = tKargoGun.Result;
            _ilTeslimat = tIl.Result; _ayKargo = tAyKargo.Result; _cod = tCod.Result; _codIl = tCodIl.Result; _bekleyen = tBekleyen.Result;
            _eticKtgr = tEticKtgr.Result;
            _funnel = tFunnel.Result;
            _ktgrYil = tKtgrYil.Result;
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; Perf.Report("E-ticaret", sw); StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // DaisyUI primary'yi grafik rengine köprüle (tema-bağlı, hardcode yok).
            try
            {
                var theme = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-colors.js");
                var c = await theme.InvokeAsync<Dictionary<string, string>>("daisyColors");
                if (c.TryGetValue("p", out var p) && _pColor != p) { _pColor = p; StateHasChanged(); }
            }
            catch { /* tema okunamazsa component fallback'i kullanır */ }
        }
        if (_data is not null)
        {
            try
            {
                var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
                await charts.InvokeVoidAsync("heroDots", "ekpi", "ekpiDots");   // KPI carousel dot senkronu
            }
            catch { /* prerender — sonraki render'da bağlanır */ }
        }
    }

    private static readonly string[] _gunler = { "Pazar", "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi" };
    private static string GunAdi(string ddMMyyyy) =>
        DateTime.TryParseExact(ddMMyyyy, "dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? _gunler[(int)d.DayOfWeek] : "";

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    // WoW / trend helpers (ch_aykargo başlık rozeti için).
    private static decimal? WowOf(decimal cur, decimal prev) => prev > 0 ? Math.Round(100 * (cur - prev) / prev, 1) : null;
    private static string Pct(decimal v) => v.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
    private static (string ico, string cls) TrendIco(decimal pct)
    {
        if (pct == 0) return ("minus", "text-base-content/40");
        return pct > 0 ? ("trending-up", "text-success") : ("trending-down", "text-error");
    }
}
