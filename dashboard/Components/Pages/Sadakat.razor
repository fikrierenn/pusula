@page "/sadakat"
@using GmDashboard.Data
@using GmDashboard.Models
@inject SadakatQueries Sada
@inject PerfState Perf
@rendermode InteractiveServer

<PageTitle>Sadakat — BKM GM</PageTitle>
<div class="flex items-center gap-3 mb-5 flex-wrap">
    <h1 class="text-2xl font-bold tracking-tight m-0">Müşteri Sadakat & Tutma</h1>
    <span class="text-sm font-semibold text-base-content/50">son 12 ay · EncoreMerkez yazarkasa · Faz 3</span>
</div>

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else
{
    var toplamCiro = _pareto.Sum(p => p.ToplamCiro);
    var ilk10PctCiro = _pareto.FirstOrDefault()?.ToplamCiro ?? 0;
    var ilk10PctMus = _pareto.FirstOrDefault()?.MusteriSayisi ?? 0;
    var toplamMus = _pareto.Sum(p => p.MusteriSayisi);

    <AppKpiCarousel Id="sadakatkpi" Items="@(new List<KpiCardData>
    {
        new("Tekrar Alış", _tekrar != null ? Pct(_tekrar.TekrarMusteri, _tekrar.ToplamMusteri) : "—", "from-primary to-primary/80", $"Frq>1 · {Num(_tekrar?.TekrarMusteri ?? 0)} müşteri"),
        new("2. Alış Süresi", _tekrar != null ? (_tekrar.OrtGun2Alis + " gün") : "—", "from-info to-info/80", "ilk → 2. alış ort. gün"),
        new("Win-Back Hedef", Num(_winBack.Count) + " müşteri", "from-error to-error/80", "90g hareketsiz · yıl içi aktif · frq≥3"),
        new("Pareto %10", Pct(ilk10PctCiro, toplamCiro), "from-warning to-warning/80", $"ilk {Num(ilk10PctMus)} müşteri"),
        new("Win-Back Ciro", Tl(_winBack.Sum(r => r.ToplCiro)), "from-success to-success/80", "yeniden kazanılabilir ₺"),
    })" />

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Müşteri Konsantrasyonu — Pareto (son 12 ay, %10'ar dilim)</h3>
            @{
                decimal kumulatif = 0;
            }
            <AppDataTable TItem="ParetoRow"
                          Items="@_pareto"
                          Primary="@(r => $"Dilim {r.Dilim} — üst %{r.Dilim * 10}")"
                          MetricMain="@(r => Tl(r.ToplamCiro))"
                          MetricSub="@(r => Num(r.MusteriSayisi) + " müşteri")"
                          Badge="@(r => {
                              kumulatif += r.ToplamCiro;
                              var pct = toplamCiro > 0 ? kumulatif * 100m / toplamCiro : 0;
                              return ($"kümül. %{pct:0.0}", r.Dilim <= 2 ? "bg-error/15 text-error" : r.Dilim <= 4 ? "bg-warning/15 text-warning" : "bg-base-200 text-base-content/60");
                          })" />
            <div class="text-base-content/50 text-[11px] mt-2">Kümülatif % = o dilim dahil tüm üst dilimler. Yüksek konsantrasyon = az müşteriye yüksek bağımlılık riski.</div>
        </div>
    </div>

    @if (_kartli.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Sadakat Kartı Etkisi — son 12 ay</h3>
            <AppDataTable TItem="KartliRow"
                          Items="@_kartli"
                          Primary="@(r => r.Tip)"
                          MetricMain="@(r => Tl(r.NetCiro))"
                          MetricSub="@(r => $"{Num(r.Musteri)} müşteri · {Num(r.FisSayisi)} fiş")"
                          Badge="@(r => ($"ATV {Tl(r.AtvMusteri)}", r.Tip == "Kartlı" ? "bg-success/15 text-success" : "bg-base-200 text-base-content/60"))" />
            <div class="text-base-content/50 text-[11px] mt-2">Kartsız = CustomersId>0 ama CardNumber boş (kurumsal/toptan). Kartlı = "2025…" kart. ATV = yıllık müşteri başı ciro.</div>
        </div>
    </div>
    }

    @if (_rfmGecis.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">RFM Segment Geçiş Matrisi — Mar25–Mar26 → Haz25–Haz26</h3>
            <AppDataTable TItem="RfmGecisRow"
                          Items="@_rfmGecis"
                          Primary="@(r => r.EskiSeg.Substring(2))"
                          Sub="@(r => "→ " + r.YeniSeg.Substring(2))"
                          MetricMain="@(r => Num(r.Musteri) + " müşteri")"
                          Badge="@(r => {
                              int eski = int.Parse(r.EskiSeg[0].ToString());
                              int yeni = int.Parse(r.YeniSeg[0].ToString());
                              if (eski == yeni) return ("stabil", "bg-base-200 text-base-content/50");
                              if (yeni < eski) return ("▲ iyileşme", "bg-success/15 text-success");
                              return ("▼ kötüleşme", "bg-error/15 text-error");
                          })" />
            <div class="text-base-content/50 text-[11px] mt-2">Dönem 1 = Mar25–Mar26 · Dönem 2 = Haz25–Haz26 (üst üste 3 aylık kayma). Kötüleşme = numara artışı (1=Şampiyon, 5=Kayıp).</div>
        </div>
    </div>
    }

    @if (_winBack.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Win-Back Listesi — 90g+ hareketsiz, yıl içi aktif, en yüksek ciro (Top 200)</h3>
            <AppDataTable TItem="WinBackRow"
                          Items="@_winBack"
                          Primary="@(r => r.Ad.Length > 0 ? r.Ad : "(isimsiz)")"
                          Sub="@(r => r.Tel)"
                          MetricMain="@(r => Tl(r.ToplCiro))"
                          MetricSub="@(r => $"{r.Frq} alış · {r.GunIdle}g önce")"
                          Badge="@(r => r.GunIdle >= 180
                              ? ($"{r.GunIdle}g idle", "bg-error/15 text-error")
                              : ($"{r.GunIdle}g idle", "bg-warning/15 text-warning"))" />
            <div class="text-base-content/50 text-[11px] mt-2">Kart numarası: kayıtta var ise kişisel teslimat (SMS/çağrı). Son satış yıl içinde, son 90 günde yok, min 3 alış min 500₺ toplam.</div>
        </div>
    </div>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<WinBackRow> _winBack = [];
    private IReadOnlyList<ParetoRow> _pareto = [];
    private IReadOnlyList<KartliRow> _kartli = [];
    private TekrarAlisOzet? _tekrar;
    private IReadOnlyList<RfmGecisRow> _rfmGecis = [];

    protected override async Task OnInitializedAsync()
    {
        var sw = PerfState.Start();
        try
        {
            var tWb = Sada.GetWinBackAsync();
            var tPar = Sada.GetParetoAsync();
            var tKrt = Sada.GetKartliAsync();
            var tTek = Sada.GetTekrarAlisAsync();
            var tGec = Sada.GetRfmGecisAsync();
            await Task.WhenAll(tWb, tPar, tKrt, tTek, tGec);
            _winBack = tWb.Result;
            _pareto = tPar.Result;
            _kartli = tKrt.Result;
            _tekrar = tTek.Result;
            _rfmGecis = tGec.Result;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; Perf.Report("Sadakat", sw); StateHasChanged(); }
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    private static string Pct(decimal pay, decimal top) => top > 0 ? $"%{pay * 100m / top:0.0}" : "—";
}
