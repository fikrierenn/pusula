@page "/satis-analizi/urun/{StkId:int}"
@using GmDashboard.Data
@using GmDashboard.Models
@inject SatisAnaliziQueries Q
@inject NavigationManager Nav
@inject ILogger<SatisAnaliziUrun> Logger
@rendermode InteractiveServer

@* Ürün drill — AYRI SAYFA, modal DEĞİL.
   Gerekçe (repo dersi): modal-üstü-modal Blazor'da çalışmıyor (ikinci modal aynı z-index'te
   arkada kalıyor) ve buradan hareket geçmişine gidilmesi gerekiyor. Filtre bağlamı query ile taşınır.

   Drill BEŞ SORUYA cevap verir (dashboard-oneri danışması 09.09):
     1. Ne kadar bağlı, nerede?      2. Ne kadar hızlı eriyor?
     3. YENİDEN ALMAM GEREKİR Mİ?    4. Bu stok neden burada (yaş/tazelik)?
     5. Mağaza dengesizliği var mı → transfer mi alım mı? *@

<PageTitle>@(_urun?.StkAd ?? "Ürün") — Satış Analizi</PageTitle>

<div class="flex items-center gap-2 mb-3 flex-wrap">
    <button class="btn btn-ghost btn-sm" @onclick="Geri">← Listeye dön</button>
    <span class="text-xs text-base-content/50">kesim @_kesim.ToString("dd.MM.yyyy") · sezon @_sezonYil</span>
</div>

@if (_hata is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_hata</p>
}
else if (_urun is null)
{
    <p class="text-base-content/50">@(_yukleniyor ? "Yükleniyor…" : "Bu kesimde bu ürün tabanda yok.")</p>
}
else
{
    var u = _urun;

    <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl p-[18px] mb-3">
        <h1 class="text-xl font-bold tracking-tight m-0">@u.StkAd</h1>
        <div class="flex gap-x-4 gap-y-1 flex-wrap text-xs text-base-content/70 mt-1.5">
            <span>stkID <b class="font-mono">@u.StkId</b></span>
            <span>barkod <b class="font-mono">@(u.BarkodAna ?? "—")</b></span>
            @*  Kategori3 AYRI sözlük (urnKtgr2), ürün ağacı AYRI (KatAna→Kat1→…).
                Başlıkta ikisi de duruyor ama ARALARINDA "›" YOK — o işaret hiyerarşi
                iddiasıdır ve burada hiyerarşi yoktur. Ağaç yolu tek kaynaktan
                (SatisAnaliziHucre "katyol") geliyor; listeyle AYNI metin.            *@
            <span>@u.Kategori3</span>
            @{ var yol = SatisAnaliziHucre.Metin(u, "katyol"); }
            @if (!string.IsNullOrWhiteSpace(yol))
            {
                <span class="text-base-content/40">·</span>
                <span>@yol</span>
            }
            <span>yayınevi <b>@(u.Yayinevi ?? "—")</b></span>
            @if (!string.IsNullOrWhiteSpace(u.Yazar) && u.Yazar != "Genel")
            {
                <span>yazar <b>@u.Yazar</b></span>
            }
            <span>fiyat <b class="font-mono">@u.SatisFiyat.ToString("N0") ₺</b></span>
        </div>
    </div>

    @* ── 3. SORU EN ÜSTTE: yeniden almam gerekir mi? Drill'in asıl cevabı. ──────── *@
    <div class="card bg-base-100 border-2 @KararRengi shadow-sm rounded-2xl p-[18px] mb-3">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
        @* SOL YARI — ürün görseli (kullanıcı isteği 09.09: "resim çok küçük, sipariş kararı
           kısmını yarıya böl resmi oraya koy").
           Kaynak: ent.tsoft_urun → cdn.bkmkitap.com (sema bridges.yaml tsoft-urun-resim).
           ⚠ referrerpolicy="no-referrer" ŞART — CDN hotlink korumalı, referer'lı istek
           placeholder döner. Slug %0,2 vakada ürünle uyuşmuyor → karara dayanak yapılmaz. *@
        <div class="flex items-center justify-center bg-base-200 rounded-xl border border-base-300 p-2 min-h-[220px]">
            @if (_resimUrl is not null)
            {
                <img src="@_resimUrl" alt="@u.StkAd" loading="lazy" referrerpolicy="no-referrer"
                     class="max-h-[260px] w-auto object-contain rounded-lg"
                     onerror="this.parentElement.innerHTML='<span class=\'text-xs text-base-content/50\'>görsel yüklenemedi</span>'" />
            }
            else
            {
                <span class="text-xs text-base-content/50">görsel yok</span>
            }
        </div>

        @* SAĞ YARI — karar cümlesi + dört ölçü *@
        <div class="min-w-0">
        <div class="text-[11px] uppercase tracking-wider font-bold text-primary mb-1">
            Sipariş kararı
        </div>
        <p class="text-base font-semibold m-0 leading-snug">@KararCumlesi(u)</p>
        @* Negatif stok karar kartinda da uyarılır: "Stok Nerede"ye inmeden görülsün. *@
        @if (u.StokFsm < 0 || u.StokOzluce < 0 || u.StokIstyolu < 0 || u.MerkezStok < 0)
        {
            <div class="alert alert-error text-xs mt-2 py-2 items-start">
                <div>
                    <b>Eksi stok var</b> —
                    @string.Join(" · ", new[]
                    {
                        u.StokFsm < 0 ? $"FSM {u.StokFsm:N0}" : null,
                        u.StokOzluce < 0 ? $"Özlüce {u.StokOzluce:N0}" : null,
                        u.StokIstyolu < 0 ? $"İst.Yolu {u.StokIstyolu:N0}" : null,
                        u.MerkezStok < 0 ? $"Merkez {u.MerkezStok:N0}" : null,
                    }.Where(x => x is not null)).
                    <span class="block opacity-80 mt-0.5">
                        Sayım/hareket hatası. Toplam stok ve gün-stok bu eksiyle hesaplandığı için
                        <b>karara dayanak yapılmadan düzeltilmeli</b>.
                    </span>
                </div>
            </div>
        }
        @* NEDEN BU EKRAN BOŞ — kullanıcı 09.09: "bunda hiçbir bilgi yok gibi" (stkID 235636).
           Kartların çoğu şartı sağlamadığı için ÇİZİLMİYOR (tükenme mağaza stoğu ister, maliyet
           alış faturası ister, temin süresi ODAK ister). Sessiz boşluk "bozuk" gibi okunuyordu →
           eksikliğin GEREKÇESİ yazılır. Ölçüldü: bu durumda 3.494 çeşit / 28,11M ₺ etiket değeri. *@
        @{
            var eksik = new List<string>();
            if (u.MagazaStok <= 0) eksik.Add("mağaza rafında stok yok → raf gün-stoğu ve tükenme hesaplanamıyor");
            if (u.SatisToplam <= 0) eksik.Add("365 günde satış yok → satış hızı ve aylık desen boş");
            if (_maliyet?.BirimMaliyet is null) eksik.Add("alış faturası bulunamadı → maliyet ve marj yok");
            if (u.LeadTime is null) eksik.Add("ODAK temin süresi veride yok → sipariş noktası yok");
        }
        @if (eksik.Count >= 3)
        {
            <div class="alert alert-warning text-xs mt-2 py-2 items-start">
                <div>
                    <b>Bu ürün hakkında gösterilecek çok az veri var</b> — ekran boş değil, ürün hareketsiz:
                    <ul class="list-disc ms-4 mt-1 mb-0 space-y-0.5">
                        @foreach (var e in eksik) { <li>@e</li> }
                    </ul>
                    @if (u.MerkezStok > 0)
                    {
                        <span class="block mt-1">
                            Merkezde <b class="font-mono">@u.MerkezStok.ToString("N0")</b> adet duruyor
                            (etiket değeri <b class="font-mono">@u.ToplamStokTutar.ToString("N0") ₺</b>).
                            @if (u.IlkGirisTarihi is { } ig)
                            {
                                <text>Rafa son girişi @ig.ToString("dd.MM.yyyy").</text>
                            }
                            Karar alım değil <b>tasfiye/iade</b> tarafında.
                        </span>
                    }
                </div>
            </div>
        }
        @if (_acikSiparis is { } sip)
        {
            @* Kurulun "en kritik eksik" dediği madde: elde stok varken sipariş de verilmiş olabilir. *@
            <div class="alert alert-warning text-xs mt-2 py-2 items-start">
                <div>
                    <b>Açık alış siparişi var:</b> son 120 günde @sip.Belge belgede
                    <b class="font-mono">@(sip.SiparisAdet?.ToString("N0") ?? "?")</b> adet sipariş edilmiş
                    (son @(sip.SonSiparis?.ToString("dd.MM.yyyy") ?? "—")).
                    <span class="block opacity-80 mt-0.5">
                        Yalnız <b>satın alma</b> siparişi (Alış + Yerel Alım). İç transfer, müşteri
                        siparişi ve alış iade emri sayılmaz — düzeltilene kadar sayılıyordu ve
                        gösterilen adedin %86'sı satın alma değildi (ölçüldü 10.09.2026).
                        Bu adet <b>sipariş edilen</b>dir, "yolda kalan" değil: karşılanma oranı
                        veriden ölçülemiyor (<code>ehSevkAdet</code> satırların %100'ünde boş).
                        Yeni alım kararı bunun üstüne verilir.
                    </span>
                </div>
            </div>
        }
        @if (_tedarik is { AlisVar: true } td && (td.OdakDisi || td.Karisik))
        {
            <div class="alert alert-warning text-xs mt-2 py-2 items-start">
                <div>
                    <b>Tedarik kaynağı:</b> son alış @(td.SonAlis?.ToString("dd.MM.yyyy") ?? "—") —
                    <b>@(td.SonTedarikci ?? "?")</b>.
                    @if (td.OdakDisi)
                    {
                        <span class="block opacity-80 mt-0.5">
                            Bu ürünü ODAK'tan almıyoruz; yukarıdaki <b>ODAK temin süresi bu ürün için
                            geçerli değil</b> ve sipariş noktası hesaplanmıyor. Gerçek temin süresi
                            bu tedarikçiden ölçülmeli — veride hazır bir alanı yok.
                        </span>
                    }
                    else
                    {
                        <span class="block opacity-80 mt-0.5">
                            ODAK'tan (@td.OdakAdet.ToString("N0") adet) ve başka tedarikçiden
                            (@td.DigerAdet.ToString("N0") adet) alınmış — ODAK süresi yalnız ODAK
                            partisi için geçerli.
                        </span>
                    }
                </div>
            </div>
        }
        <div class="grid grid-cols-2 gap-3 mt-3">
            <div>
                <div class="text-[11px] text-base-content/60">ODAK temin</div>
                <div class="text-lg font-bold font-mono @(_tedarik?.OdakDisi == true ? "text-base-content/40 line-through" : "")">
                    @(u.LeadTime?.ToString() ?? "—") <span class="text-xs font-normal">gün</span>
                </div>
                @* ⚠ TEMİN SÜRESİNİN GEÇERLİLİĞİ — kullanıcı uyarısı 09.09: "ürünler odaktan
                   gelmiyorsa temin süresi bilgisi anlamsız". leadTime ODAK'ın KATALOG süresi;
                   ürünü başka tedarikçiden alıyorsak bizim tedarik süremiz DEĞİL.
                   ÖLÇÜLDÜ: %4 ODAK dışı (yanıltıcı), %49'unda son 365g alış yok (doğrulanamaz). *@
                <div class="text-[10px] mt-0.5 @(_tedarik?.OdakDisi == true ? "text-error"
                                                 : _tedarik?.AlisVar != true ? "text-warning"
                                                 : _tedarik.Karisik ? "text-warning"
                                                 : "text-base-content/40")">
                    @if (u.LeadTime is null)
                    {
                        <text>veride yok</text>
                    }
                    else if (_tedarik is null || !_tedarik.AlisVar)
                    {
                        <text>son 365g <b>alış yok</b> — doğrulanamıyor</text>
                    }
                    else if (_tedarik.OdakDisi)
                    {
                        <text><b>ODAK'tan ALMIYORUZ</b> → bu süre geçersiz</text>
                    }
                    else if (_tedarik.Karisik)
                    {
                        <text>ODAK + başka tedarikçi — kısmen geçerli</text>
                    }
                    else
                    {
                        <text>ODAK'tan alınıyor ✓</text>
                    }
                </div>
            </div>
            @* ODAK stoğu yalnız ODAK'tan aldığımız üründe anlamlı — almadığımızda tedarikçi
               envanteri karar için bilgi taşımıyor, kutu gizlenir (budama 09.09). *@
            @if (_tedarik?.OdakDisi != true)
            {
                <div>
                    <div class="text-[11px] text-base-content/60">ODAK'ta stok</div>
                    <div class="text-lg font-bold font-mono">@u.OdakStok.ToString("N0")</div>
                    <div class="text-[10px] text-base-content/40">tedarikçi · bizim değil</div>
                </div>
            }
            <div>
                @* ⚠ RAF BAZINDA (kapsam asimetrisi düzeltmesi 09.09). Eskiden pay mağaza+merkez
                   stoğu, payda yalnız mağaza satışıydı → rakam "stok yeter" yönünde sapıyordu.
                   Merkez kendi çıkış hızıyla "Stok Nerede" kartında ayrı; İKİSİ TOPLANMAZ. *@
                <div class="text-[11px] text-base-content/60">Raf gün-stoğu</div>
                <div class="text-lg font-bold font-mono @(GunStok(u) is > 400 ? "text-error" : "")">
                    @(GunStok(u)?.ToString("N0") ?? "—")
                </div>
                <div class="text-[10px] text-base-content/40">
                    mağaza stoğu ÷ mağaza satışı
                    (@(u.EtkinGun >= 365 ? "365 gün" : $"{u.EtkinGun} gün raf"))
                </div>
            </div>
        </div>
        </div>
      </div>
    </div>

    @* ── TÜKENME (sezon ayrımlı) — kullanıcı isteği 09.09 ─────────────────────────
       Düz 365g ortalama sezonu ve sezon dışını aynı kefeye koyuyordu. Burada iki hız AYRI
       ölçülür ve tükenme takvim üzerinde ileri simüle edilir (her gün kendi dönem hızı).
       ⚠ Tükenme tarihi ÇIKARIM: geçmiş hızın tekrarı varsayımı. Hızlar ÖLÇÜLDÜ. *@
    @if (_hiz is { } hz && u.MagazaStok > 0)
    {
        @* ⚠ RAF stoğu eritilir, ToplamStok DEĞİL (kapsam asimetrisi 09.09): hızlar mağaza
           defterinden ölçülüyor, o hızla merkez stoğunu eritmek tükenmeyi çok geç gösteriyordu. *@
        var tuk = hz.Tukenme(u.MagazaStok, _kesim);
        var sezonBas = new DateOnly(_kesim.Month >= 8 ? _kesim.Year + 1 : _kesim.Year, 8, 1);
        <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl p-[18px] mb-3">
            <div class="flex items-baseline gap-2 mb-3 flex-wrap">
                <h3 class="text-sm font-bold m-0">Ne Zaman Tükenir</h3>
                <span class="badge badge-sm badge-ghost">sezon = Ağustos–Ekim</span>
                <span class="badge badge-sm badge-ghost">raf stoğu · merkez hariç</span>
                @if (hz.RafKisa)
                {
                }
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <div class="text-[11px] text-base-content/60">Sezonda günlük</div>
                    <div class="text-xl font-extrabold font-mono text-primary">@hz.SezonHiz.ToString("N2")</div>
                    <div class="text-[11px] text-base-content/60">
                        @hz.SezonAdet.ToString("N0") adet / @hz.SezonGun gün
                        @if (hz.SezonuTamGormedi)
                        {
                            <span class="text-warning">· sezonun 92 gününü tam görmedi</span>
                        }
                    </div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">Sezon dışı günlük</div>
                    <div class="text-xl font-extrabold font-mono text-info">@hz.DisiHiz.ToString("N2")</div>
                    <div class="text-[11px] text-base-content/60">@hz.DisiAdet.ToString("N0") adet / @hz.DisiGun gün</div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">Sezon ağırlığı</div>
                    <div class="text-xl font-extrabold font-mono @(hz.OranGuvenilir ? "" : "text-base-content/40")">
                        @(!hz.OranGuvenilir || hz.Kat is null ? "—" : hz.Kat.Value.ToString("N1") + "×")
                    </div>
                    <div class="text-[11px] text-base-content/60">
                        @(!hz.OranGuvenilir ? $"veri az ({hz.Toplam:N0} adet) — oran güvenilmez"
                          : hz.Kat is null ? "sezon dışı satış yok"
                          : hz.Kat.Value >= 1.5m ? "sezonluk ürün"
                          : hz.Kat.Value <= 0.67m ? "sezon dışı daha hızlı"
                          : "sezon farkı zayıf")
                    </div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">
                        Tükenme <span class="badge badge-xs badge-ghost align-middle">tahmin</span>
                    </div>
                    <div class="text-xl font-extrabold font-mono @(tuk is { Gun: <= 30 } ? "text-error" : tuk is null ? "text-warning" : "")">
                        @(tuk is { } t2 ? t2.Tarih.ToString("MMM yyyy") : "2 yılda yok")
                    </div>
                    <div class="text-[11px] text-base-content/60">
                        @(tuk is { } t3 ? t3.Gun.ToString("N0") + " gün sonra" : "bu hızla bitmiyor")
                    </div>
                </div>
            </div>

            @{
                // Sezona kadar erime: kesim → 1 Ağustos arası günlerin hızları düşülür.
                decimal sezonaKalan = u.MagazaStok;
                for (var g = _kesim.AddDays(1); g < sezonBas; g = g.AddDays(1))
                    sezonaKalan -= g.Month is 8 or 9 or 10 ? hz.SezonHiz : hz.DisiHiz;
                sezonaKalan = Math.Max(0, sezonaKalan);
                var ihtiyac = hz.SezonIhtiyaci;
                var acik = ihtiyac - sezonaKalan;
            }
            @* ⚠ SEZON AÇIĞI YALNIZ SEZONLUK ÜRÜNDE ANLAMLI (09.09 düzeltme).
               İlk sürüm her üründe "gelecek sezon açığı" yazıyordu ve YANILTIYORDU: ölçülen
               vaka stkID 1672852 — sezon ağırlığı 0,7× (sezon dışı daha hızlı), stok Nisan
               2027'de tükeniyor, yani sezona kadar zaten bitiyor ve arada normal akışta
               yeniden sipariş edilecek. Orada "açık 5.848 adet" bir alım ihtiyacı DEĞİL.
               Sürekli devreden malda doğru soru sezon değil SİPARİŞ NOKTASI'dır. *@
            @if (hz.OranGuvenilir && hz.Kat >= 1.5m && hz.SezonHiz > 0)
            {
                <div class="text-xs mt-3 pt-3 border-t border-base-200 leading-relaxed">
                    <b>Sezonluk ürün.</b> Gelecek sezon (@sezonBas.ToString("dd.MM.yyyy") başlangıçlı
                    92 gün) bu hızla <b class="font-mono">@ihtiyac.ToString("N0")</b> adet ister.
                    Sezon başına kadar eldeki stoktan <b class="font-mono">@sezonaKalan.ToString("N0")</b>
                    adet kalır.
                    @if (acik > 0)
                    {
                        <span class="text-error font-semibold">
                            Açık @acik.ToString("N0") adet@(u.LeadTime is { } lt2 ? $" · ODAK temin {lt2} gün" : "").
                        </span>
                    }
                    else
                    {
                        <span class="text-success font-semibold">
                            Sezon karşılanıyor, üstüne @((-acik).ToString("N0")) adet fazla kalır.
                        </span>
                    }
                </div>
            }
            else if (!hz.OranGuvenilir)
            {
                <div class="text-xs mt-3 pt-3 border-t border-base-200 leading-relaxed">
                    365 günde toplam <b class="font-mono">@hz.Toplam.ToString("N0")</b> adet satmış.
                    Bu hacimde sezon/sezon-dışı ayrımı ve tükenme tahmini <b>yapılmıyor</b> —
                    tek bir satış oranı ikiye katlıyor. Karar, satış hızı yerine
                    stoğun kendisine bakılarak verilir (rafta @u.MagazaStok.ToString("N0") adet).
                </div>
            }
            @* ⚠ TEMİN SÜRESİ GEÇERSİZSE SİPARİŞ NOKTASI HESAPLANMAZ (09.09). Ürünü ODAK'tan
               almıyorsak ODAK'ın katalog süresiyle sipariş tarihi basmak uydurmadır — aynı
               disiplin "leadTime veride yok" durumunda da uygulanıyor. *@
            else if (tuk is { } t4 && u.LeadTime is { } lt && _tedarik?.OdakDisi != true)
            {
                @* Sürekli devreden / sezon farkı zayıf ürün: sipariş noktası.
                   Temin süresi boyunca eriyecek adet + yarısı emniyet payı (ÇIKARIM — hedef
                   servis seviyesi politikası tanımlı değil; OneriSiparisKtg3Ondeger politika tablosu
                   10.09.2026'da kullanıcı kararıyla İPTAL edildi). *@

                    decimal teminIhtiyaci = 0m;
                    for (var g = t4.Tarih.AddDays(-lt); g < t4.Tarih; g = g.AddDays(1))
                        teminIhtiyaci += g.Month is 8 or 9 or 10 ? hz.SezonHiz : hz.DisiHiz;
                    var siparisNoktasi = Math.Round(teminIhtiyaci * 1.5m, 0);
                    var siparisGunu = t4.Tarih.AddDays(-(int)Math.Ceiling(lt * 1.5));
                <div class="text-xs mt-3 pt-3 border-t border-base-200 leading-relaxed">
                    <b>Sürekli devreden ürün</b> (sezon farkı @(hz.Kat is null ? "—" : hz.Kat.Value.ToString("N1") + "×")).
                    Sezon açığı yerine sipariş noktası bakılır: temin @lt gün sürüyor, o sürede
                    <b class="font-mono">@teminIhtiyaci.ToString("N0")</b> adet erir.
                    Stok <b class="font-mono">@siparisNoktasi.ToString("N0")</b> adede düşünce
                    (yaklaşık <b>@siparisGunu.ToString("dd.MM.yyyy")</b>) sipariş verilmeli.
                    <span class="opacity-80">Emniyet payı %50 alındı — hedef servis seviyesi politikası
                    henüz tanımlı değil.</span>
                </div>
            }
            @if (tuk is not null && u.LeadTime is null && !(hz.OranGuvenilir && hz.Kat >= 1.5m))
            {
                @* ⚠ SESSİZ VARSAYIM KALDIRILDI (kurul bulgusu 09.09): burada `LeadTime ?? 5`
                   vardı — temin süresi bilinmeyen üründe hiçbir şey söylemeden 5 gün uydurup
                   üstüne SİPARİŞ TARİHİ basıyordu. Canlı yakalandı: ekran aynı anda
                   "ODAK temin — gün" (bilinmiyor) ve "temin 5 gün sürüyor" yazıyordu.
                   Maliyet/KDV'de uygulanan disiplin ("bilinmiyorsa hesaplama") burada da geçerli. *@
                <div class="alert alert-warning text-xs mt-3 py-2 items-start">
                    <div>
                        @* Gerekçe yukarıda (temin kutusu + tedarik satırı) yazılı — burada
                           TEKRAR EDİLMEZ, yalnız sonucu söylenir (budama 09.09). *@
                        <b>Sipariş noktası hesaplanmadı</b> — temin süresi bilinmiyor.
                        Varsayılan süre uydurulmuyor.
                    </div>
                </div>
            }
            @* Metodoloji paragrafi KAPSAM BANDINA taşındı (budama 09.09) — ölçüldü/çıkarım
               ayrımı ekranda "tahmin" rozetiyle korunuyor, ayrıntısı bantta. *@
        </div>
    }

    @* ── 1. + 5. SORU: ne kadar bağlı, nerede · mağaza dengesizliği ──────────────
       Budama 09.09: eskiden "Satış" kartıyla yan yanaydı; Satış içeriği aylık grafik kartına
       birleşti (ikisi de "ne hızla eriyor" sorusuydu) → bu kart TAM GENİŞLİK. *@
    <div class="mb-3">
        <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl p-[18px]">
            <h3 class="text-sm font-bold mb-3">Stok Nerede</h3>
            @{ var enBuyuk = Math.Max(1, new[] { u.StokFsm, u.StokOzluce, u.StokIstyolu, u.MerkezStok }.Max()); }
            @* mekan kodu da taşınır: "kaç gündür satmıyor" bilgisi mekan bazında eşleşecek. *@
            @foreach (var (ad, adet, satis, mekan) in new[]
            {
                ("FSM", u.StokFsm, (int?)u.SatisFsm, 1),
                ("Özlüce", u.StokOzluce, u.SatisOzluce, 4477),
                ("İst.Yolu", u.StokIstyolu, u.SatisIstyolu, 4478),
                ("Merkez depo (WMS)", u.MerkezStok, (int?)u.MerkezCikis, 12),
            })
            {
                <div class="mb-2.5">
                    <div class="flex justify-between text-xs mb-1">
                        <span>@ad</span>
                        <span class="font-mono">
                            @adet.ToString("N0")
                            @if (satis is not null)
                            {
                                <span class="text-base-content/40">
                                    · @(ad.StartsWith("Merkez") ? "çıkış" : "satış") @satis.Value.ToString("N0")
                                </span>
                            }
                        </span>
                    </div>
                    <div class="h-2 rounded-full bg-base-200 overflow-hidden">
                        <div class="h-full rounded-full @(adet < 0 ? "bg-error" : "bg-primary")"
                             style="width:@(Math.Min(100, Math.Abs(adet) * 100.0 / enBuyuk).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    @* STOK VAR AMA SATMIYOR — kullanıcı isteği 09.09: "mağaza bazlı stok var ama
                       şu kadar gündür satmıyor bilgisi". Toplam 365g satış bir mağazanın ölü
                       rafını gizler; ölçülen örnek stkID 1723863: FSM 14 gün, diğer ikisi 19 gün.
                       Yalnız mağazalar — merkez depo perakende satmaz, oradaki çıkış toptandır. *@
                    @* NEGATİF STOK MEKAN BAZINDA SÖYLENİR (kullanıcı 09.09: "mağaza bazlı
                       eksik diye de söylemek lazım"). Toplam pozitifken tek rafın eksi olması
                       eskiden hiçbir yerde görünmüyordu — ölçüldü: 187 çeşit / 4,89M ₺. *@
                    @if (adet < 0)
                    {
                        <div class="text-[11px] mt-0.5 text-error font-semibold">
                            eksi stok @adet.ToString("N0") — fiziksel olarak imkânsız,
                            sayım/hareket hatası. Bu rakam toplama giriyor.
                        </div>
                    }
                    @* ⚠ ŞART DÜZELTİLDİ 09.09 (kullanıcı: "1666147 son satış tarihi gelmemiş").
                       Eski şart `adet > 0` idi ve RAFI BOŞ üründe satırı hiç çizmiyordu — oysa
                       asıl sinyal orada: o üründe 3 rafın hepsi 0, merkezde 393 adet var, en son
                       228 gün önce satılmış (ölçüldü). "Satıyordu, rafı boşaldı, transfer
                       edilmedi" = kayıp satış. Artık satış VARSA da çizilir. *@
                    else if (mekan != 12 && (adet > 0 || _magazaSonSatis?.Any(x => x.Mekan == mekan) == true))
                    {
                        var son = _magazaSonSatis?.FirstOrDefault(x => x.Mekan == mekan);
                        <div class="text-[11px] mt-0.5 @(son is null || son.GunOnce >= 90 ? "text-error"
                                                        : son.GunOnce >= 30 ? "text-warning"
                                                        : "text-base-content/50")">
                            @if (son is null)
                            {
                                <text>bu mağazada <b>hiç satılmamış</b> — @adet.ToString("N0") adet duruyor</text>
                            }
                            else if (adet <= 0)
                            {
                                @* Raf boş ama satmış: transfer edilmemiş kayıp satış sinyali. *@
                                <text><b>rafta yok</b> — son satış @son.SonSatis.ToString("dd.MM.yyyy")
                                    (@son.GunOnce.ToString("N0") gün önce)@(u.MerkezStok > 0
                                        ? $", merkezde {u.MerkezStok:N0} adet var" : "")</text>
                            }
                            else if (son.GunOnce <= 0)
                            {
                                <text>bugün satmış</text>
                            }
                            else
                            {
                                <text><b>@son.GunOnce.ToString("N0") gündür satmıyor</b>
                                    (son satış @son.SonSatis.ToString("dd.MM.yyyy"))</text>
                            }
                        </div>
                    }
                </div>
            }
            @* Merkez çıkışı TEK SATIR (budama 09.09: "bu tarz gereksiz bilgiler vermeyelim").
               Kaldırılan ders cümleleri kapsam bandında duruyor: çıkışın tüketici talebi olmadığı,
               sıçramalı olduğu için merkez gün-stoğunun hesaplanmadığı. Kartta yalnız OLGU:
               kaç adet, kaç günde, kime. Karşı taraf ÜRÜN BAZINDA ölçülür (evren ortalaması
               değil — stkID 1666147'de çıkışın tamamı ODAK'a gitmişti, grup payı %0). *@
            @if (u.MerkezCikis > 0)
            {
                <div class="text-xs text-base-content/60 mt-1 pt-2 border-t border-base-200">
                    Merkez çıkışı <b class="font-mono">@u.MerkezCikis.ToString("N0")</b> adet /
                    <b class="font-mono">@u.MerkezCikisGun</b> gün@(u.MerkezCikisSicramali ? " (sıçramalı)" : "")
                    @if (_merkezKarsi is { Count: > 0 })
                    {
                        <text>· @string.Join(" · ", _merkezKarsi.Select(k => $"{k.FirmaAd} {k.Adet:N0}"))</text>
                    }
                </div>
            }
            else if (u.MerkezStok > 0)
            {
                <div class="text-xs text-warning mt-1 pt-2 border-t border-base-200">
                    Merkezde @u.MerkezStok.ToString("N0") adet var, 365 günde <b>hiç çıkış yok</b>.
                </div>
            }
            @* WMS ADRESLERİ — merkez sayısının nerede durduğu. Kısa: adres başına tek satır,
               en fazla 6; ürün ortalama 1,8 adreste (ölçüldü), en çok 27. *@
            @if (_depoAdres is { Adresler.Count: > 0 } da)
            {
                <div class="text-[11px] mt-1 pt-2 border-t border-base-200">
                    <div class="text-base-content/60 mb-0.5">Merkez depoda nerede</div>
                    @* HAYALET STOK UYARISI — WMS pozitif, ERP defteri ≤ 0.
                       Ölçüldü 09.09: 349 çeşit / 3.757 adet bu durumda; 261'inde merkez satışı
                       var. Mekanizma: satış ERP'de kesilmiş, WMS'ten düşülmemiş (stkID 248104
                       izlendi). Kitap tarafında yığılı: Akademi %90, Kitap %61. *@
                    @if (da.Hayalet)
                    {
                        <div class="alert alert-error text-[11px] py-1.5 mb-1 items-start">
                            <div>
                                <b>Bu sayı şüpheli.</b> WMS @da.WmsToplam.ToString("N0") adet diyor
                                ama ERP merkez defteri @da.DefterNet.ToString("N0").
                                Satış ERP'de kesilip WMS'ten düşülmemiş olabilir — mal fiilen
                                olmayabilir. Sayım yapılmadan karara dayanak alınmamalı.
                            </div>
                        </div>
                    }
                    @foreach (var ad in da.Adresler.Take(6))
                    {
                        <div class="flex gap-2 flex-wrap @(ad.MerkezStoka == 0 ? "text-warning" : "text-base-content/70")">
                            <span class="font-semibold">@ad.AlanTip</span>
                            <span class="font-mono">@(ad.Adres ?? "—")</span>
                            <span class="text-base-content/40">palet @(ad.PaletID?.ToString() ?? "—")</span>
                            <span class="font-mono">@ad.Adet.ToString("N0") adet</span>
                            @* ⚠ "palete konuldu" — MAL KABUL TARİHİ DEĞİL. Ölçüldü 09.09
                               (stkID 248104): 10.07.2026 hareketi belgesiz iç taşımaydı
                               (piIrsID=0, raf paleti → GR01), depoya yeni giriş değildi. *@
                            @if (ad.PaleteGiris is { } pg)
                            {
                                <span class="text-base-content/40">palete konuldu @pg.ToString("dd.MM.yyyy")</span>
                            }
                            @if (ad.MerkezStoka == 0)
                            {
                                <span>· merkez stoğuna dahil değil</span>
                            }
                        </div>
                    }
                    @if (da.Adresler.Count > 6)
                    {
                        <div class="text-base-content/40">+@(da.Adresler.Count - 6) adres daha</div>
                    }
                </div>
            }
            @if (Dengesiz(u))
            {
                <div class="alert alert-info text-xs mt-1 py-2">
                    Mağazaların stok/satış oranı arasında en az 3 kat fark var →
                    önce <b>transfer</b> sorusu, sonra alım.
                </div>
            }
        </div>
    </div>

    @* ── AYLIK SATIŞ — 365 günlük pencerenin ay ay dağılımı ──────────────────────
       NEDEN: sezon kapsaması tek başına yanıltıyor. Ölçüldü 09.09: bir üründe kapsama 8,5x
       görünürken zirve Ocak-Mart çıktı (ürün sezonluk değil). Aylık desen bunu düzeltiyor.
       Çizgi değil SÜTUN: 12 nokta için çizgi sahte süreklilik hissi verir. *@
    @if (_aylik is { Count: > 0 })
    {
        <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl p-[18px] mb-3">
            <div class="flex items-baseline gap-2 mb-3 flex-wrap">
                <h3 class="text-sm font-bold m-0">Aylık Satış ve Alış</h3>
                <span class="text-xs text-base-content/60">
                    zirve <b>@ZirveAy()</b> · satış @_aylik.Sum(x => x.Adet).ToString("N0") · alış @((_aylikAlis ?? []).Sum(x => x.Adet).ToString("N0")) adet
                </span>
            </div>

            @* Budama 09.09: ayrı "Satış" kartından BURAYA taşındı — ikisi de "ne hızla eriyor"
               sorusunu cevaplıyordu, iki kart gereksizdi. Sezon ÇUBUKLARI geri gelmedi:
               sezon ayları aşağıdaki grafikte koyu sütunla zaten görünüyor. *@
            <div class="text-xs text-base-content/60 mb-3 flex gap-x-4 gap-y-1 flex-wrap">
                <span>365 gün
                    <b class="font-mono text-base-content">@u.SatisToplam.ToString("N0")</b> adet ·
                    günlük <b class="font-mono text-base-content">@u.GunlukOrtalamaSatis.ToString("N2")</b>
                    @if (u.RafKisa)
                    {
                        <span class="text-warning">(@u.EtkinGun günlük raf süresine bölündü)</span>
                    }
                </span>
                @if (u.SezonToplam > 0)
                {
                    <span>geçen sezon
                        <b class="font-mono text-base-content">@u.SezonToplam.ToString("N0")</b> adet
                        @if (u.SezonKapsama is { } sk)
                        {
                            <text>· stok sezonun <b class="font-mono text-base-content">@sk.ToString("N1")</b> katı</text>
                        }
                    </span>
                }
            </div>
            @* İKİ AYRI GRAFİK, HER SERİ KENDİ ÖLÇEĞİNDE.
               ⚠ İlk sürüm ikisini aynı eksende yan yana çiziyordu ve OKUNMUYORDU — ölçüldü
               09.09: bir üründe alış 9.960 / satış 18 = 450 kat fark → satış çubuklarının hepsi
               %2'ye çöküyor, tek alış çubuğu ekranı kaplıyor. İki seri kıyaslanamaz ölçekte
               olduğu için karşılaştırma ÇUBUK YÜKSEKLİĞİYLE değil SAYIYLA yapılır. *@
            @{
                var alisSeri = _aylikAlis ?? [];
                var alisHarita = alisSeri.ToDictionary(x => x.Ay, x => x.Adet);
                var satisMax = Math.Max(1, _aylik.Max(x => x.Adet));
                var stokSeri = _aylikStok ?? [];
                var stokMax = Math.Max(1, stokSeri.Select(x => x.Adet).DefaultIfEmpty(0).Max());
                var alisMax = Math.Max(1, alisHarita.Values.DefaultIfEmpty(0).Max());
            }

            <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold mb-1">
                Satış · en yüksek ay @satisMax.ToString("N0") adet
                @if (stokSeri.Count > 1)
                {
                    <span class="text-base-content normal-case tracking-normal">
                        — çizgi: mağaza stoğu (en yüksek @stokMax.ToString("N0"))
                    </span>
                }
            </div>
            <div class="relative h-24 mb-1">
            @* STOK ÇİZGİSİ — satış çubuklarının ÜSTÜNE bindirilir. KENDİ ölçeğinde (başlıkta
               yazılı), çünkü stok adedi satış adediyle kıyaslanamaz. SVG: 13 nokta için gerçek
               çizgi gerekiyor, CSS çubukla çizilemez. pointer-events-none → çubuk title'ı çalışır. *@
            @if (stokSeri.Count > 1)
            {
                var stokNokta = StokNoktalari(stokSeri, stokMax);
                <svg class="absolute inset-0 w-full h-full pointer-events-none overflow-visible z-10"
                     viewBox="0 0 100 100" preserveAspectRatio="none">
                    @* ⚠ 3 KATMAN ŞART. İlk sürüm tek 0.7px çizgiydi ve GÖRÜNMEDİ (kullanıcı 09.09):
                       çubukların üstünde kıl kadar hat ayırt edilmiyor. Şimdi: base-100 halo (arka
                       plandan ayırır) + kalın çizgi + her ayda nokta. non-scaling-stroke sayesinde
                       viewBox esnemesi kalınlığı bozmaz. *@
                    <polyline fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round"
                              class="text-base-100" vector-effect="non-scaling-stroke"
                              points="@stokNokta" />
                    @* Renk NÖTR koyu (base-content), primary/info DEĞİL: çubuklar zaten mavi
                       (primary 269° / info 232°), aynı hueda çizgi çubuğun içinde kayboluyordu.
                       Ölçüldü 09.09: secondary = oklch(.65 .055 257) → mavi çubukla ayrışmıyor.
                       Nötr koyu hem anlam olarak doğru (stok seviyesi iyi/kötü değil, referans). *@
                    <polyline fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"
                              class="text-base-content" vector-effect="non-scaling-stroke"
                              points="@stokNokta" />
                </svg>
                @* Noktalar SVG dışında: viewBox esnemesi daireyi ovale çevirir, o yüzden
                   yüzde-konumlu div. *@
                @for (var i = 0; i < stokSeri.Count; i++)
                {
                    var n = stokSeri[i];
                    var xy = StokKonum(stokSeri, stokMax, i);
                    <div class="absolute w-2.5 h-2.5 rounded-full bg-base-content border-2 border-base-100 z-10 -translate-x-1/2 -translate-y-1/2"
                         style="left:@xy.Item1%;top:@xy.Item2%"
                         title="@n.Ay.ToString("MMMM yyyy") — mağaza stoğu @n.Adet.ToString("N0")"></div>
                }
            }
            <div class="flex items-end gap-1.5 h-full">
                @foreach (var a in _aylik)
                {
                    var sezonAyiMi = a.Ay.Month is 8 or 9 or 10;
                    <div class="flex-1 flex flex-col items-center justify-end h-full min-w-0"
                         title="@a.Ay.ToString("MMMM yyyy") — satış @a.Adet.ToString("N0")">
                        <span class="text-[10px] font-mono mb-0.5 truncate w-full text-center">
                            @(a.Adet > 0 ? a.Adet.ToString("N0") : "")
                        </span>
                        <div class="w-full rounded-t @(sezonAyiMi ? "bg-primary" : "bg-info")"
                             style="height:@(a.Adet <= 0 ? "0" : Math.Max(3, a.Adet * 100.0 / satisMax).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                }
            </div>
            </div>

            <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold mb-1 mt-3">
                Alış (mal kabulü) · en yüksek ay @alisMax.ToString("N0") adet
            </div>
            <div class="flex items-end gap-1.5 h-24">
                @foreach (var a in _aylik)
                {
                    var alis = alisHarita.GetValueOrDefault(a.Ay);
                    <div class="flex-1 flex flex-col items-center justify-end h-full min-w-0"
                         title="@a.Ay.ToString("MMMM yyyy") — alış @alis.ToString("N0")">
                        <span class="text-[10px] font-mono mb-0.5 truncate w-full text-center">
                            @(alis > 0 ? alis.ToString("N0") : "")
                        </span>
                        <div class="w-full rounded-t bg-warning"
                             style="height:@(alis <= 0 ? "0" : Math.Max(3, alis * 100.0 / alisMax).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        <span class="text-[10px] text-base-content/60 mt-1">@a.Ay.ToString("MMM")</span>
                    </div>
                }
            </div>
            <div class="flex gap-4 text-[11px] mt-1.5 flex-wrap">
                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-primary inline-block"></span>satış · sezon ayı</span>
                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-info inline-block"></span>satış</span>
                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-warning inline-block"></span>alış</span>
                <span class="flex items-center gap-1"><span class="w-4 h-1 rounded bg-base-content inline-block"></span>mağaza stoğu (ay sonu · merkez depo HARİÇ)</span>
                <span class="text-base-content/50">her seri ayrı ölçekte</span>
            </div>
            @* Uzun açıklama BUDANDI 09.09 — "koyu sütun = sezon ayı" legend'da yazılı,
               zirvenin sezon dışında olması yukarıdaki "sezon ağırlığı" ölçüsünde görünüyor. *@
        </div>
    }

    @* ── GİRİŞ MALİYETİ — "bağlanan para" burada gerçek oluyor ────────────────────
       Kanonik tanım: son 5 alış faturası ağırlıklı birim (sema birim_maliyet MLYT).
       Maliyet kaydı yoksa 0 GÖSTERİLMEZ — "kayıt yok" yazılır (0 marjı %100 gösterirdi). *@
    <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl p-[18px] mb-3">
        <div class="flex items-baseline gap-2 mb-3 flex-wrap">
            <h3 class="text-sm font-bold m-0">Giriş Maliyeti ve Bağlanan Para</h3>
            @if (_maliyet?.BirimMaliyet is not null)
            {
                <span class="badge badge-sm badge-ghost">son @_maliyet.FaturaSayisi alış faturası</span>
            }
        </div>
        @if (_maliyet?.BirimMaliyet is { } bm && bm > 0)
        {
            @* ── KDV TABANI ────────────────────────────────────────────────────────────
               ÖLÇÜLDÜ 09.09.2026 (kurul danışması sonrası, "kdv kısmına dikkat et"):
                 · Alış maliyeti (fatAyr.ehTutarN) KDV **HARİÇ** — KDV ayrı kolonda
                   (ehTutarKDV; 12.501,00 tutarın yanında 2.500,20 = tam %20).
                 · Satış fiyatı (urn.fiyatS) KDV **DAHİL** — POS'ta 89.888 satırın
                   89.888'inde VatTotal = TotalPrice × oran/(100+oran), yani KDV fiyatın
                   İÇİNDEN çıkıyor (üstüne eklenmiyor). TotalPrice = fiyatS.
               → İki taraf AYNI tabana çekilmeden marj hesaplanamaz. Satış KDV'den arındırılır.
               Oran ÜRÜN BAZINDA (urn.KDVs → kdvYuzde_vw); sabit oran varsayımı YASAK. *@
                var oran = _maliyet.KdvOran;
                decimal? netSatis = oran is not null && u.SatisFiyat > 0
                    ? u.SatisFiyat / (1m + oran.Value / 100m)
                    : null;
                var birimKar = netSatis - bm;
                // YUKARIDAN AŞAĞI (satış üzerinden) = brüt marj. Perakendede "marj" budur.
                var brutMarj = netSatis > 0 ? birimKar / netSatis * 100m : null;
                // AŞAĞIDAN YUKARI (maliyet üzerinden) = markup. Satınalma pazarlığının dili.
                var markup = bm > 0 ? birimKar / bm * 100m : null;
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <div class="text-[11px] text-base-content/60">Birim maliyet</div>
                    <div class="text-xl font-extrabold font-mono">@bm.ToString("N2") ₺</div>
                    <div class="text-[11px] text-base-content/60">
                        KDV hariç · son alış @(_maliyet.SonAlis?.ToString("dd.MM.yyyy") ?? "—")
                    </div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">Satış (KDV hariç)</div>
                    <div class="text-xl font-extrabold font-mono">
                        @(netSatis?.ToString("N2") ?? "—") ₺
                    </div>
                    <div class="text-[11px] text-base-content/60">
                        etiket @u.SatisFiyat.ToString("N0") ₺ · KDV @(oran?.ToString() ?? "?")%
                    </div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">Birim brüt kâr</div>
                    <div class="text-xl font-extrabold font-mono @(birimKar is null ? "" : birimKar < 0 ? "text-error" : "text-success")">
                        @(birimKar?.ToString("N2") ?? "—") ₺
                    </div>
                    <div class="text-[11px] text-base-content/60">satış − maliyet</div>
                </div>
                <div>
                    <div class="text-[11px] text-base-content/60">Bağlanan para</div>
                    <div class="text-xl font-extrabold font-mono text-primary">
                        @((u.ToplamStok * bm).ToString("N0")) ₺
                    </div>
                    <div class="text-[11px] text-base-content/60">@u.ToplamStok.ToString("N0") adet × maliyet</div>
                </div>
            </div>

            @* İKİ YÖN — kullanıcı isteği 09.09: "yukarıdan aşağı, aşağıdan yukarı marj".
               Aynı kârın iki farklı paydası; ikisi de KDV-HARİÇ tabanda. Bağıntı:
               markup = marj/(1−marj) · marj = markup/(1+markup). *@
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3 pt-3 border-t border-base-200">
                <div class="rounded-xl bg-base-200/60 p-3">
                    <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                        Yukarıdan aşağı · brüt marj
                    </div>
                    <div class="text-2xl font-extrabold font-mono @(brutMarj is null ? "" : brutMarj < 0 ? "text-error" : brutMarj < 20 ? "text-warning" : "text-success")">
                        @(brutMarj is null ? "—" : "%" + brutMarj.Value.ToString("N1"))
                    </div>
                    <div class="text-[11px] text-base-content/60 mt-0.5">
                        kâr ÷ satış — 100 ₺ satışta @(birimKar is null || netSatis is null or 0
                            ? "—" : (birimKar.Value / netSatis!.Value * 100m).ToString("N1")) ₺ kâr
                    </div>
                </div>
                <div class="rounded-xl bg-base-200/60 p-3">
                    <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                        Aşağıdan yukarı · maliyet üstüne (markup)
                    </div>
                    <div class="text-2xl font-extrabold font-mono @(markup is null ? "" : markup < 0 ? "text-error" : "text-info")">
                        @(markup is null ? "—" : "%" + markup.Value.ToString("N1"))
                    </div>
                    <div class="text-[11px] text-base-content/60 mt-0.5">
                        kâr ÷ maliyet — maliyetin üstüne bu kadar konmuş
                    </div>
                </div>
            </div>
@if (oran is null)
            {
                <div class="alert alert-warning text-xs mt-3 py-2">
                    <b>KDV oranı çözülemedi</b> (<code>urn.KDVs</code> → <code>kdvYuzde_vw</code>
                    eşleşmiyor) → marj HESAPLANMADI. Satış fiyatı KDV dahil, maliyet KDV hariç;
                    oran bilinmeden ikisi aynı tabana çekilemez. Yaklaşık marj gösterilmiyor.
                </div>
            }
            @if (u.SatisFiyat > 0 && netSatis is not null && bm > netSatis)
            {
                <div class="alert alert-error text-xs mt-3 py-2">
                    Maliyet, KDV'siz satış fiyatının ÜSTÜNDE — ya fiyat güncellenmemiş ya maliyet
                    kaydı kirli. Karara dayanak yapılmadan kontrol edilmeli.
                </div>
            }
        }
        else
        {
            <p class="text-sm text-base-content/70 m-0">
                <b>Maliyet kaydı yok.</b> Bu ürün için alış faturası bulunamadı
                (<code>fat.eTip=0</code>, iptal hariç) → birim maliyet hesaplanamıyor.
                Sıfır <b>gösterilmiyor</b>: 0 maliyet marjı %100 gibi okutur.
            </p>
        }
        @* ── GERÇEKLEŞEN FİYATLA KÂR/MARJ (kullanıcı isteği 09.09) ──────────────────
           Üstteki kutular KART fiyatına dayanır; burası POS'ta FİİLEN alınan paraya.
           ÖLÇÜLDÜ 09.09 (90 gün, panel evreni): POS brütü kart fiyatına EŞİT (%95,4-99,5 →
           urn.fiyatS gerçekten raf fiyatı) ama gerçekleşen NET çok altında — Kitap %71,1 ·
           Çocuk Kitabı %72,3 · Elektronik %77,3 · Kırtasiye %80,3 · Oyuncak %88,6 · Dergi %98,0.
           Panel stok değeri kart fiyatıyla 1.022,2M ₺, kategori oranlarıyla 807,3M ₺ →
           214,9M ₺ (%21,03) şişme. ⇒ KART MARJI İYİMSER; karar bu kutuya bakılarak verilir.

           ⚠ MALİYET KARTININ İÇİNDE DEĞİL, DIŞINDA: içine konunca yalnız alış faturası olan
           ürünlerde görünüyordu (ölçüldü — stkID 1739183'te fatura yok, yalnız irsaliye var).
           Ortalama fiyat ve indirim maliyetten BAĞIMSIZ bilgidir; kâr/marj hücreleri maliyet
           yoksa "—" olur ve sebebi yazılır. Satılmamış üründe POS kaydı yoktur → kutu hiç
           gösterilmez (0 marj uydurulmaz). *@
        @if (_gerceklesen is { } gp && gp.Adet > 0)
        {
            var bm2 = _maliyet?.BirimMaliyet;                  @* null = alış faturası yok *@
            var maliyetVar = bm2 is > 0;
            @* Kart marjı — karşılaştırma için burada YENİDEN hesaplanır (blok kendi kendine
               yetsin diye). Aynı tanım: satış KDV'den arındırılır, maliyet KDV hariç. *@
            var oran2 = _maliyet?.KdvOran;
            decimal? kartNet = oran2 is { } o2 && o2 >= 0 && u.SatisFiyat > 0
                ? u.SatisFiyat / (1m + o2 / 100m) : null;
            decimal? kartMarj = maliyetVar && kartNet is { } kn && kn > 0
                ? (kn - bm2!.Value) / kn * 100m : null;
            <div class="mt-3 pt-3 border-t border-base-200">
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                        Gerçekleşen fiyatla (POS · 365 gün · iade hariç)
                    </span>
                    <span class="badge badge-sm badge-ghost">@gp.Adet.ToString("N0") adet satıldı</span>
                    @if (!maliyetVar)
                    {
                        <span class="badge badge-sm badge-warning">maliyet kaydı yok</span>
                    }
                </div>
                <div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
                    <div class="rounded-xl bg-base-200/60 p-3">
                        <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                            Ort. satış fiyatı
                        </div>
                        <div class="text-xl font-extrabold font-mono">@gp.BirimKdvDahil.ToString("N2") ₺</div>
                        <div class="text-[11px] text-base-content/60 mt-0.5">
                            KDV dahil · kart @u.SatisFiyat.ToString("N2") ₺
                            @if (gp.KartOrani(u.SatisFiyat) is { } ko)
                            {
                                <span class="@(ko < 0.9m ? "text-warning font-semibold" : "")">
                                    (kartın %@((ko * 100m).ToString("N0")) kadarı)
                                </span>
                            }
                        </div>
                    </div>
                    <div class="rounded-xl bg-base-200/60 p-3">
                        <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                            Birim kâr
                        </div>
                        <div class="text-xl font-extrabold font-mono @(maliyetVar && gp.BirimKar(bm2) < 0 ? "text-error" : "")">
                            @(gp.BirimKar(bm2) is { } bk ? bk.ToString("N2") + " ₺" : "—")
                        </div>
                        <div class="text-[11px] text-base-content/60 mt-0.5">
                            KDV hariç @gp.BirimKdvHaric.ToString("N2") ₺
                            @(maliyetVar ? "− maliyet " + bm2!.Value.ToString("N2") + " ₺"
                                         : "· alış faturası yok → kâr hesaplanamadı")
                        </div>
                    </div>
                    <div class="rounded-xl bg-base-200/60 p-3">
                        <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                            Gerçekleşen brüt marj
                        </div>
                        <div class="text-2xl font-extrabold font-mono @(gp.Marj(bm2) is not { } mj ? "" : mj < 0 ? "text-error" : mj < 0.20m ? "text-warning" : "text-success")">
                            @(gp.Marj(bm2) is { } mj2 ? "%" + (mj2 * 100m).ToString("N1") : "—")
                        </div>
                        <div class="text-[11px] text-base-content/60 mt-0.5">
                            markup %@(gp.Markup(bm2) is { } mk ? (mk * 100m).ToString("N1") : "—")
                            @if (kartMarj is { } km && gp.Marj(bm2) is { } mj3)
                            {
                                <span class="block">
                                    kart marjı %@km.ToString("N1") →
                                    <b class="@((mj3 * 100m) < km ? "text-warning" : "text-success")">
                                        @(((mj3 * 100m) - km).ToString("+0.0;-0.0")) puan
                                    </b>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="rounded-xl bg-base-200/60 p-3">
                        <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                            365 günlük kâr
                        </div>
                        <div class="text-xl font-extrabold font-mono @(maliyetVar && gp.ToplamKar(bm2) < 0 ? "text-error" : "")">
                            @(gp.ToplamKar(bm2) is { } tk ? tk.ToString("N0") + " ₺" : "—")
                        </div>
                        <div class="text-[11px] text-base-content/60 mt-0.5">
                            satılan @gp.Adet.ToString("N0") adet × birim kâr
                        </div>
                    </div>
                    @* YAPILAN İNDİRİM ORANI — kullanıcı isteği 09.09: "yapılan indirim oranı da olmalı".
                       Kendi hücresi: marjı düşüren asıl kalem bu. POS'un KENDİ indirim kolonundan
                       (DiscountTotalDirect = TOPLAM indirim; Campaign onun ALT KÜMESİ — ikisi
                       TOPLANMAZ, sql-server-conventions § İndirim Kolonları).
                       Kampanya payı = kampanya indirimi ÷ toplam indirim: fiyat kararı mı
                       kampanya kararı mı ayrımı. *@
                    <div class="rounded-xl bg-base-200/60 p-3">
                        <div class="text-[11px] uppercase tracking-wider text-base-content/60 font-semibold">
                            Yapılan indirim
                        </div>
                        <div class="text-2xl font-extrabold font-mono @(gp.IndirimOrani is not { } ind ? "" : ind >= 0.25m ? "text-error" : ind >= 0.10m ? "text-warning" : "")">
                            @(gp.IndirimOrani is { } ind2 ? "%" + (ind2 * 100m).ToString("N1") : "—")
                        </div>
                        <div class="text-[11px] text-base-content/60 mt-0.5">
                            @if (gp.IndirimOrani is { } ind3 && ind3 > 0)
                            {
                                <span>brüt @gp.BrutKdvDahil.ToString("N0") ₺ → net @gp.NetKdvDahil.ToString("N0") ₺</span>
                                @if (gp.KampanyaPayi is { } kp)
                                {
                                    <span class="block">
                                        %@((kp * 100m).ToString("N0"))'ı kampanya indirimi
                                        @(kp >= 0.99m ? "(tamamı)" : kp <= 0.01m ? "(elle indirim)" : "")
                                    </span>
                                }
                            }
                            else
                            {
                                <span>indirimsiz satılmış</span>
                            }
                        </div>
                    </div>
                </div>
                @if (gp.Marj(bm2) is { } mjU && mjU < 0)
                {
                    <div class="alert alert-error text-xs mt-3 py-2">
                        <b>Gerçekleşen fiyat maliyetin ALTINDA</b> — bu ürün satıldıkça zarar
                        yazıyor. Kart marjı pozitif göründüğü için tek başına yanıltıcı.
                    </div>
                }
            </div>
        }
        <p class="text-xs text-base-content/50 mt-3 mb-0 pt-2 border-t border-base-200">
            Maliyet: son @(_maliyet?.FaturaSayisi ?? 0) alış faturasının ağırlıklı birimi (<code>SUM(tutar)/SUM(adet)</code>,
            fatura bazında, KDV hariç). Satış KDV'den arındırıldı (oran ürün bazında).
            <b>Bu LİSTE marjıdır</b> — kampanya, iade ve sezon-sonu indirimi içinde yok.
        </p>
    </div>

    @* ── 4. SORU: bu stok neden burada? (yaş / tazelik) ──────────────────────────
       Budama 09.09: dört büyük kutu yerine TEK SATIR. Tarihler teşhis bilgisidir, karar
       ölçüsü değil — ayrı kart olmayı hak etmiyordu (kullanıcı: "gereksiz açıklamalarda var"). *@
    <div class="card bg-base-100 border border-base-300 shadow-sm rounded-2xl px-[18px] py-3 mb-3">
        <div class="flex gap-x-4 gap-y-1 flex-wrap items-center text-xs">
            <span class="badge badge-sm font-semibold @DurumBadge(u)">@DurumEtiketi(u)</span>
            <span class="text-base-content/60">kart açılışı
                <b class="text-base-content">@(u.AcilisTarihi?.ToString("dd.MM.yyyy") ?? "—")</b>
                @if (u.YasYil is { } yy) { <text>(@yy.ToString("N1") yıl)</text> }
            </span>
            <span class="text-base-content/60">rafa ilk giriş
                <b class="text-base-content">@(u.IlkGirisTarihi?.ToString("dd.MM.yyyy") ?? "hiç girmemiş")</b>
            </span>
            <span class="text-base-content/60">son mal kabulü
                <b class="text-base-content">@(u.SonGirisTarihi?.ToString("dd.MM.yyyy") ?? "—")</b>
                @if (SonPartiYeniMi(u)) { <span class="text-info font-semibold">· yeni parti</span> }
            </span>
        </div>
    </div>

    <details class="collapse collapse-arrow bg-warning/15 border border-warning/40 rounded-2xl">
        <summary class="collapse-title text-xs font-semibold py-2.5 min-h-0 cursor-pointer">
            Bu ekrandaki sayıların sınırları (aç)
        </summary>
        <div class="collapse-content text-xs">
            <ul class="list-disc ml-4 space-y-0.5 pb-1">
                <li>Merkez depo stoğu <b>anlık</b> (WMS geçmiş tutmuyor); mağaza stoğu kesim tarihine göre.</li>
                <li>ODAK stoğu <b>bizim envanterimiz değil</b> — tedarikçi (grup şirketi) elindeki mal.
                    Tazeliği ölçülemiyor (kaynak tabloda damga yok).</li>
                <li>Liste/KPI tutarları <b>etiket fiyatıyla</b> (KDV dahil); maliyet ve marj yalnız aşağıdaki maliyet kartında.</li>
                <li>365 günlük satış <b>3 mağaza</b>; merkez depo çıkışı ve e-ticaret sayılmıyor.</li>
                <li>Satın alan kişi (alıcı) veride izli değil → bu ekran kimseye <b>atıf yapmaz</b>.</li>
            </ul>
        </div>
    </details>
}

@code {
    [Parameter] public int StkId { get; set; }
    [SupplyParameterFromQuery(Name = "kesim")] public string? KesimQ { get; set; }
    [SupplyParameterFromQuery(Name = "sezon")] public int? SezonQ { get; set; }

    /// <summary>
    /// Panelin filtre durumu (URL-kodlu sorgu dizesi). "Listeye dön" bunu geri verir →
    /// kullanıcı aynı görünüme döner. Yoksa çıplak listeye dönülür.
    /// </summary>
    [SupplyParameterFromQuery(Name = "geri")] public string? GeriQ { get; set; }

    private SatisAnaliziSatir? _urun;
    private UrunMaliyet? _maliyet;
    /// <summary>POS'ta FİİLEN gerçekleşen satış (365g, iade hariç) — kart fiyatı değil.</summary>
    private UrunGerceklesen? _gerceklesen;
    private IReadOnlyList<AylikSatis>? _aylik;
    private IReadOnlyList<AylikSatis>? _aylikAlis;
    private IReadOnlyList<AylikSatis>? _aylikStok;
    private UrunHiz? _hiz;
    private IReadOnlyList<MagazaSonSatis>? _magazaSonSatis;
    private UrunTedarik? _tedarik;
    private IReadOnlyList<MerkezKarsiTaraf>? _merkezKarsi;
    private DepoAdresSonuc? _depoAdres;
    private AcikSiparis? _acikSiparis;
    private string? _resimUrl;
    private AkranOzet? _akran;
    private DateOnly _kesim = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
    private int _sezonYil = DateTime.Today.Year - 1;
    private bool _yukleniyor = true;
    private string? _hata;

    protected override async Task OnParametersSetAsync()
    {
        if (DateOnly.TryParse(KesimQ, out var d)) _kesim = d;
        if (SezonQ is > 2000) _sezonYil = SezonQ.Value;

        _yukleniyor = true; _hata = null;
        try
        {
            _urun = await Q.GetUrunAsync(StkId, _kesim, _sezonYil);
            if (_urun is not null)
            {
                _akran = await Q.GetAkranAsync(_urun.Kategori1, _kesim, _sezonYil);
                _maliyet = await Q.GetMaliyetAsync(StkId);
                _gerceklesen = await Q.GetGerceklesenAsync(StkId, _kesim);
                _aylik = await Q.GetAylikSatisAsync(StkId, _kesim);
                _aylikAlis = await Q.GetAylikAlisAsync(StkId, _kesim);
                _aylikStok = await Q.GetAylikStokAsync(StkId, _kesim);
                _hiz = await Q.GetHizAsync(StkId, _kesim, _urun?.IlkGirisTarihi);
                _magazaSonSatis = await Q.GetMagazaSonSatisAsync(StkId, _kesim);
                _tedarik = await Q.GetTedarikAsync(StkId, _kesim);
                _merkezKarsi = await Q.GetMerkezKarsiTarafAsync(StkId, _kesim);
                _depoAdres = await Q.GetDepoAdresAsync(StkId);
                _acikSiparis = await Q.GetAcikSiparisAsync(StkId, _kesim);
                _resimUrl = await Q.GetResimUrlAsync(StkId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ürün drill yüklenemedi (stkID {StkId})", StkId);
            _hata = "Beklenmedik bir hata oluştu. Lütfen sistem yöneticisine bildirin.";
        }
        finally { _yukleniyor = false; }
    }

    /// <summary>
    /// Listeye dön — panelin filtre durumunu geri vererek. <c>geri</c> yoksa çıplak liste
    /// (eski davranış); varsa kullanıcı bıraktığı görünüme döner.
    /// </summary>
    private void Geri() => Nav.NavigateTo(
        string.IsNullOrWhiteSpace(GeriQ) ? "/satis-analizi" : $"/satis-analizi?{GeriQ}");

    /// <summary>
    /// Stok çizgisinin SVG nokta dizisi (viewBox 0 0 100 100). x eşit aralıklı, y ters çevrilir
    /// (SVG'de y aşağı artar). Negatif bakiye 0'a kırpılır — çizgi eksene taşmasın (negatif stok
    /// veri kiri, ayrı yerde gösterilir).
    /// </summary>
    /// <summary>
    /// Bir noktanın yüzde konumu (sol, üst). Çizginin polyline'ı ile AYNI formül — ayrışmasın
    /// diye tek yerden türetilir.
    /// </summary>
    private static (string, string) StokKonum(IReadOnlyList<AylikSatis> seri, int enBuyuk, int i)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var x = seri.Count < 2 ? 50.0 : i * (100.0 / (seri.Count - 1));
        var y = 100.0 - Math.Clamp(seri[i].Adet, 0, enBuyuk) * 100.0 / enBuyuk;
        return (x.ToString("0.##", ci), y.ToString("0.##", ci));
    }

    private static string StokNoktalari(IReadOnlyList<AylikSatis> seri, int enBuyuk)
    {
        if (seri.Count < 2) return "";
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var adim = 100.0 / (seri.Count - 1);
        return string.Join(" ", seri.Select((n, i) =>
        {
            var y = 100.0 - Math.Clamp(n.Adet, 0, enBuyuk) * 100.0 / enBuyuk;
            return (i * adim).ToString("0.##", ci) + "," + y.ToString("0.##", ci);
        }));
    }

    /// <summary>En çok satan ay — sezonluk mu değil mi sorusunun tek satırlık cevabı.</summary>
    private string ZirveAy()
    {
        if (_aylik is null || _aylik.Count == 0) return "—";
        var z = _aylik.MaxBy(x => x.Adet);
        return z is null || z.Adet <= 0 ? "satış yok" : z.Ay.ToString("MMMM yyyy");
    }

    /// <summary>
    /// Gün-stok — hesap <see cref="SatisAnaliziSatir.GunStok"/>'ta (etkin güne göre).
    /// Burada YENİDEN hesaplanmaz: iki yerde iki formül olursa ekran kendi içinde ayrışır.
    /// </summary>
    private static decimal? GunStok(SatisAnaliziSatir u) => u.GunStok;

    /// <summary>
    /// YENİ ÜRÜN mü — değerlendirmeye hazır değil demek için ölçüt.
    ///
    /// ⚠ DÜZELTME (kurul incelemesi 09.09): ilk sürüm tazeliği SON MAL KABULÜNE bağlıyordu ve
    /// YANLIŞTI. Ölçülen vaka: bir ürün 07.07.2025'ten beri mağazada, 365 günde 31.407 adet
    /// satmış, ama son partisi 2 gün önce geldiği için "değerlendirmeye hazır değil" görünüyordu.
    /// Sonuç: HIZLI DEVREDEN her ürün sürekli sipariş aldığı için hiç değerlendirilemez olur.
    ///
    /// Doğrusu: ürünün MAĞAZADAKİ İLK GİRİŞİ 90 günden yeniyse yeni üründür (satacak zamanı
    /// olmamıştır). Son partinin tazeliği ayrı bilgi — ekranda gösterilir, karar ölçütü değildir.
    /// </summary>
    private static bool YeniUrunMu(SatisAnaliziSatir u) =>
        u.IlkGirisTarihi is { } ig && (DateTime.Today - ig).TotalDays <= 90;

    /// <summary>Son partisi yeni mi — bilgi amaçlı, karar ölçütü DEĞİL.</summary>
    private static bool SonPartiYeniMi(SatisAnaliziSatir u) =>
        u.SonGirisTarihi is { } sg && (DateTime.Today - sg).TotalDays <= 90;

    /// <summary>
    /// Mağaza dengesizliği — ORAN bazlı.
    ///
    /// ⚠ DÜZELTME (kurul incelemesi 09.09): ilk ölçüt <c>min stok &lt;= 0</c> idi ve gerçek
    /// dengesizliği kaçırıyordu. Ölçülen vaka: FSM 599 stok / 11.987 satış (satışının ~1/20'si),
    /// İst.Yolu 1.056 / 6.657 (~1/6) — hiçbir mağazada stok sıfır değil ama dağılım satışla
    /// uyumsuz. Doğrusu: mağazaların "stok / satış" oranı arasında en az 3 kat fark.
    /// Satışı olmayan mağaza kıyasa girmez (0'a bölme + yanlış sinyal).
    /// </summary>
    private static bool Dengesiz(SatisAnaliziSatir u)
    {
        var oranlar = new[]
        {
            (stok: u.StokFsm, satis: u.SatisFsm),
            (stok: u.StokOzluce, satis: u.SatisOzluce),
            (stok: u.StokIstyolu, satis: u.SatisIstyolu),
        }
        .Where(x => x.satis > 0)
        .Select(x => (double)x.stok / x.satis)
        .ToArray();

        if (oranlar.Length < 2) return false;
        var enAz = oranlar.Min();
        var enCok = oranlar.Max();
        // Stok hiç yoksa (0 oran) tek başına sinyal: o mağaza satıyor ama stoğu yok.
        return enAz <= 0 || enCok >= enAz * 3;
    }

    /// <summary>Kararın tek cümlesi — iddia değil olgu (sunum-dili).</summary>
    private static string KararCumlesi(SatisAnaliziSatir u)
    {
        var gun = GunStok(u);
        if (u.ToplamStok <= 0 && u.SezonToplam > 0)
            return u.OdakStok > 0
                ? $"Stok yok, geçen sezon {u.SezonToplam:N0} adet sattı. ODAK'ta {u.OdakStok:N0} adet var, temin {u.LeadTime?.ToString() ?? "?"} gün."
                : $"Stok yok, geçen sezon {u.SezonToplam:N0} adet sattı. ODAK'ta da yok.";
        // ⚠ SIRA: yeni-ürün kontrolü stok/satış dengesinden SONRA gelir. İlk sürümde önce
        // geliyordu ve 220 günlük stoğu olan hızlı devreden ürüne "erken" diyordu (09.09 düzeltme).
        if (YeniUrunMu(u) && u.SatisToplam <= 0)
            return "Mağazaya 90 gün içinde girdi ve henüz satış yok — satacak zamanı olmadı.";
        if (u.SatisToplam <= 0 && u.ToplamStok > 0)
            return $"365 günde satış yok, stokta {u.ToplamStok:N0} adet duruyor" +
                   (u.YasYil is { } y ? $" (ürün {y:N1} yıl önce açılmış)." : ".");
        if (u.SezonToplam > 0 && u.ToplamStok > 5 * u.SezonToplam)
            return u.LeadTime is { } lt && lt <= 5
                ? $"Stok sezon satışının {u.SezonKapsama:N1} katı; ODAK'tan temin {lt} gün."
                : $"Stok sezon satışının {u.SezonKapsama:N1} katı.";
        return gun is null
            ? "Satış yok; gün-stok hesaplanamıyor."
            : $"Eldeki stok {gun:N0} günlük satışa denk.";
    }

    private string KararRengi => _urun is null ? "border-base-200"
        : _urun.ToplamStok <= 0 && _urun.SezonToplam > 0 ? "border-error"
        : YeniUrunMu(_urun) && _urun.SatisToplam <= 0 ? "border-info"
        : _urun.SatisToplam <= 0 && _urun.ToplamStok > 0 ? "border-error"
        : _urun.SezonToplam > 0 && _urun.ToplamStok > 5 * _urun.SezonToplam ? "border-warning"
        : "border-success";

    private static string DurumEtiketi(SatisAnaliziSatir u) =>
        u.ToplamStok < 0 || u.SatisFiyat <= 0 ? "veri kirli"
        : YeniUrunMu(u) && u.SatisToplam <= 0 ? "yeni ürün"
        : u.ToplamStok <= 0 && u.SezonToplam > 0 ? "stoksuz sezon ürünü"
        : u.SatisToplam <= 0 && u.ToplamStok > 0 ? "hareketsiz"
        : u.SezonToplam > 0 && u.ToplamStok > 5 * u.SezonToplam ? "aşırı stok"
        : "normal";

    private static string DurumBadge(SatisAnaliziSatir u) => DurumEtiketi(u) switch
    {
        "veri kirli" => "badge-warning",
        "yeni ürün" => "badge-info",
        "stoksuz sezon ürünü" => "badge-error",
        "hareketsiz" => "badge-error",
        "aşırı stok" => "badge-warning",
        _ => "badge-success",
    };

}
