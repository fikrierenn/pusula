@page "/magaza/{Id:int}"
@using GmDashboard.Data
@using GmDashboard.Models
@inject MagazaQueries Mag
@inject RefQueries Ref
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Mağaza Detay — BKM GM</PageTitle>

<div class="flex items-center gap-2 mb-4">
    <button class="w-9 h-9 rounded-xl bg-base-100 border border-base-200 flex items-center justify-center shrink-0" @onclick='() => Nav.NavigateTo("")' aria-label="Geri"><i data-lucide="chevron-left" class="w-5 h-5"></i></button>
    <div class="min-w-0">
        <div class="text-xs text-base-content/50">Mağaza detay · @_aralik</div>
        <h1 class="text-2xl font-bold tracking-tight m-0 truncate">@(_d?.Ad ?? Mekan(Id))</h1>
    </div>
</div>
<AppPeriodPills Period="_period" PeriodChanged="SetPeriod" ShowOzel="false" />

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_d is not null)
{
    <div class="mb-5">
        <div id="hero" class="carousel carousel-center w-full gap-3.5 lg:grid lg:grid-cols-4 lg:gap-3 lg:overflow-visible">
            @KpiCard("Net Ciro", Tl(_d.Net), "from-primary to-primary/80", _period == "ay" && _d.GerPct is not null ? $"hedef %{_d.GerPct} (MTD)" : "dönem net")
            @KpiCard("Fiş", Num(_d.Fis), "from-info to-info/80", $"sepet {Num(_d.Atv)} ₺")
            @KpiCard("UPT", _d.Upt.ToString("0.00"), "from-success to-success/80", "ürün / fiş (sepet adedi)")
            @KpiCard("İade", Tl(_d.Iade), "from-error to-error/80", $"oran %{_d.IadeOran}")
        </div>
        <div id="heroDots" class="flex justify-center items-center gap-1.5 mt-3 lg:hidden">
            <span class="hero-dot hero-dot-on"></span><span class="hero-dot"></span><span class="hero-dot"></span><span class="hero-dot"></span>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0">
            <h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="credit-card" class="w-[18px] h-[18px] text-primary"></i>Ödeme Tipi Mix</h3>
            <AppIconRow TItem="OdemeGrup" Items="_d.Odeme"
                Name="@(o => o.Grup)"
                Sub="@(o => $"%{o.Pay} · {Num(o.Islem)} işlem")"
                Amount="@(o => Tl(o.Tutar))"
                Icon="@(o => o.Grup.Contains("Kredi", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("Banka", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("Kart", StringComparison.OrdinalIgnoreCase) ? "credit-card"
                             : o.Grup.Contains("Nakit", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("TÜRK", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("TL", StringComparison.OrdinalIgnoreCase) ? "banknote"
                             : o.Grup.Contains("Hediye", StringComparison.OrdinalIgnoreCase) ? "gift"
                             : o.Grup.Contains("İade", StringComparison.OrdinalIgnoreCase) ? "receipt"
                             : "wallet")"
                IconColor="@(o => o.Grup.Contains("Kredi", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("Banka", StringComparison.OrdinalIgnoreCase) ? ("bg-primary/10", "text-primary")
                             : o.Grup.Contains("Nakit", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("TÜRK", StringComparison.OrdinalIgnoreCase) || o.Grup.Contains("TL", StringComparison.OrdinalIgnoreCase) ? ("bg-success/10", "text-success")
                             : o.Grup.Contains("Hediye", StringComparison.OrdinalIgnoreCase) ? ("bg-warning/10", "text-warning")
                             : ("bg-base-200", "text-base-content/60"))"
                OnRowClick="@(o => OpenOdeme(o))" />
            <div class="text-[11px] text-base-content/40 mt-3">Kart grubuna tıkla → banka detayı. Nakit (TL) kasa mutabakatı. Para üstü hariç.</div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0">
            <h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="ticket-percent" class="w-[18px] h-[18px] text-primary"></i>Kampanya Yükü</h3>
            @{
                var kYuk = _d.Net > 0 ? Math.Round(100 * _d.KampToplamIndirim / _d.Net, 1) : 0;
                decimal kMax = _d.Kampanya.Count > 0 ? _d.Kampanya.Max(k => k.Indirim) : 0;
            }
            <!-- Yük özeti (inverted pyramid: en kritik sayı tepede) -->
            <div class="rounded-xl bg-neutral text-neutral-content px-4 py-3">
                <div class="text-[10px] font-bold uppercase tracking-widest opacity-50">Toplam İndirim Yükü</div>
                <div class="flex items-end justify-between gap-3 mt-1">
                    <div>
                        <div class="text-2xl font-extrabold leading-none">@Tl(_d.KampToplamIndirim)</div>
                        <div class="text-[10px] opacity-60 mt-1">brüt @Tl(_d.KampToplamBrut) → net @Tl(_d.KampToplamBrut - _d.KampToplamIndirim) · @Num(_d.KampToplamFis) fiş</div>
                    </div>
                    <div class="flex flex-col items-end gap-0.5 shrink-0">
                        <span class="text-sm font-extrabold px-2.5 py-1 rounded-xl @KampYukRozet(kYuk)">%@kYuk</span>
                        <span class="text-[9px] opacity-50">net ciroya oran</span>
                    </div>
                </div>
            </div>
            <!-- Eşik çubuğu (sağlıklı→dikkat→kritik) -->
            <div class="h-1.5 rounded-full bg-gradient-to-r from-success via-warning to-error relative mt-2.5 mb-1">
                <div class="absolute -top-1 h-3.5 w-1 rounded bg-base-content shadow" style="left:@EsikPct(kYuk)"></div>
            </div>
            <div class="flex justify-between text-[9px] text-base-content/40 mb-3"><span>sağlıklı &lt;%12</span><span>eşik %15</span><span>kritik &gt;%20</span></div>
            <!-- Kampanya kırılımı -->
            @foreach (var k in _d.Kampanya)
            {
                var kc = k; var tikla = k.Detay.Count > 1;
                <div class="flex items-center gap-2.5 py-2 border-b border-base-200 last:border-b-0 @(tikla ? "cursor-pointer hover:bg-base-200/40 rounded-lg -mx-1.5 px-1.5 transition-colors" : "")" @onclick="@(() => OpenKamp(kc))">
                    <div class="w-8 h-8 rounded-xl bg-error/10 text-error flex items-center justify-center shrink-0"><i data-lucide="tag" class="w-4 h-4"></i></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-[13px] font-semibold text-base-content/85 truncate">@k.Ad@(tikla ? " ▸" : "")</div>
                        <div class="text-[10px] text-base-content/50 truncate mt-0.5">brüt @Tl(k.Brut) → net @Tl(k.Brut - k.Indirim) · @Num(k.Fis) fiş</div>
                        <div class="h-[3px] rounded-full bg-base-200 overflow-hidden mt-1"><div class="h-full rounded-full bg-error/40" style="width:@PctW(k.Indirim, kMax)"></div></div>
                    </div>
                    <div class="flex flex-col items-end gap-0.5 shrink-0">
                        <span class="text-[13px] font-extrabold text-error">−@Tl(k.Indirim)</span>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md @KampOranPill(k.Oran)">%@k.Oran</span>
                    </div>
                </div>
            }
            @if (_d.Kampanya.Count == 0)
            {
                <div class="text-base-content/50 text-[13px] py-2">Kampanya yok.</div>
            }
            <div class="text-[11px] text-base-content/40 mt-3">Yük = toplam indirim / net ciro. Oran = indirim / kampanyalı kalem brüt (3al2öde ~%25-26). (manuel/kodsuz) = set indirimi.</div>
        </div>
    </div>

    <h2 class="text-lg font-bold tracking-tight mb-3 mt-2">Kategori Dağılımı</h2>
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-3">
        @{ var katTot = _d.Kategori.Sum(k => k.Ciro); }
        <AppRankBars TItem="CategorySlice" Items="_d.Kategori"
                     Label="@(k => k.Ad)" Value="@(k => k.Ciro)"
                     ValueText="@(k => $"{Tl(k.Ciro)} · %{(katTot > 0 ? Math.Round(100 * k.Ciro / katTot) : 0)}")"
                     OnRowClick="@(k => OpenUrun(k.Ad))" />
        <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200 text-[13px]">
            <span class="font-bold">TOPLAM</span>
            <span class="font-bold tabular-nums">@Tl(katTot)</span>
        </div>
        <div class="text-[11px] text-base-content/40 mt-2">Kategoriye tıkla → ürün listesi.</div>
    </div>

    <p class="text-[11px] text-base-content/40 mt-4">Dönüşüm oranı (G8) kapı sayıcı verisine bağlı — şimdilik yalnız FSM (CSV). Panele eklenecek: B-40 devam.</p>

    <Modal @bind-Open="_modalUrun" Title="@(_selKat + " — Ürünler")">
        <div class="text-base-content/50 text-xs mb-2">@(_d?.Ad ?? Mekan(Id)) · @_aralik · ilk 100 · badge: stok · ~kaç gün yeter (≤7g kırmızı)</div>
        @if (_urunLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else
        {
            <AppDataTable TItem="UrunRow" Items="_urunler"
                          Primary="@(u => u.Ad)" Sub="@(u => $"Kod {u.Kod} · {UrunOrtSatis(u)}")"
                          MetricMain="@(u => Tl(u.Ciro))" MetricSub="@(u => $"{Num(u.Satis)} adet")"
                          Badge="@(u => UrunStok(u))" />
        }
    </Modal>

    <Modal @bind-Open="_modalOdeme" Title="@(_selOdeme?.Grup + " — Banka / Alt Kalem Detayı")">
        @if (_selOdeme is not null)
        {
            <div class="text-base-content/50 text-xs mb-2">@_aralik · @Tl(_selOdeme.Tutar) · @Num(_selOdeme.Islem) işlem · %@_selOdeme.Pay</div>
            <AppDataTable TItem="OdemeRow" Items="_selOdeme.Detay"
                          Primary="@(b => b.Tip)"
                          MetricMain="@(b => Tl(b.Tutar))" MetricSub="@(b => $"{Num(b.Islem)} işlem")"
                          Badge="@(b => ($"%{(_selOdeme!.Tutar > 0 ? Math.Round(100 * b.Tutar / _selOdeme.Tutar, 1) : 0)}", "bg-base-200 text-base-content/50"))" />
        }
    </Modal>

    <Modal @bind-Open="_modalKamp" Title="@(_selKamp?.Ad + " — Kampanya Detayı")">
        @if (_selKamp is not null)
        {
            <div class="text-base-content/50 text-xs mb-2">@_aralik · indirim @Tl(_selKamp.Indirim) · oran %@_selKamp.Oran</div>
            <AppDataTable TItem="KampanyaRow" Items="_selKamp.Detay"
                          Primary="@(d => d.Ad)" Sub="@(d => $"brüt {Tl(d.Brut)} → net {Tl(d.Brut - d.Indirim)} · {Num(d.Fis)} fiş")"
                          MetricMain="@(d => $"−{Tl(d.Indirim)}")"
                          Badge="@(d => ($"%{d.Oran}", KampOranPill(d.Oran)))" />
        }
    </Modal>
}

@code {
    [Parameter] public int Id { get; set; }

    private string _period = "ay";
    private bool _loading = true;
    private string? _error;
    private string _aralik = "";
    private MagazaDetay? _d;
    private bool _modalUrun;
    private bool _urunLoading;
    private string _selKat = "";
    private DateOnly _start, _endExcl;   // ürün drill aynı dönemi kullansın
    private IReadOnlyList<UrunRow> _urunler = [];
    private bool _modalOdeme;
    private OdemeGrup? _selOdeme;
    private bool _modalKamp;
    private KampanyaGrup? _selKamp;

    private void OpenOdeme(OdemeGrup o) { _selOdeme = o; _modalOdeme = true; }
    private void OpenKamp(KampanyaGrup k) { if (k.Detay.Count > 1) { _selKamp = k; _modalKamp = true; } }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _start = start; _endExcl = endExcl;
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            _d = await Mag.GetDetayAsync(Id, start, endExcl);
            if (_d is null) _error = "Geçersiz mağaza.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task OpenUrun(string kategori)
    {
        _selKat = kategori; _modalUrun = true; _urunLoading = true; _urunler = []; StateHasChanged();
        try { _urunler = await Ref.GetUrunlerAsync(kategori, Id, _start, _endExcl); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _urunLoading = false; StateHasChanged(); }
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    private IJSObjectReference? _charts;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_d is null) return;
        try
        {
            _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _charts.InvokeVoidAsync("heroDots", "hero", "heroDots");
        }
        catch { /* prerender'da JS hazır değil — sonraki render'da bağlanır */ }
    }

    // Oransal genişlik — invariant (Türkçe virgül CSS'i bozar), 0-100 clamp.
    private static string PctW(decimal v, decimal max)
    {
        var pct = max > 0 ? Math.Round(100 * v / max, 1) : 0;
        return Math.Min(Math.Max(pct, 0), 100).ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    // Kampanya yükü rozeti (indirim/net ciro): >20 kritik, >15 dikkat, else sağlıklı.
    private static string KampYukRozet(decimal yuk) => yuk > 20 ? "bg-error text-error-content" : yuk > 15 ? "bg-warning text-warning-content" : "bg-success text-success-content";
    // Kampanya satır oran pill'i (indirim derinliği): >35 kırmızı, >15 sarı, else nötr.
    private static string KampOranPill(decimal oran) => oran > 35 ? "bg-error/15 text-error" : oran > 15 ? "bg-warning/15 text-warning" : "bg-base-200 text-base-content/50";
    // Eşik çubuğu marker konumu (0-25% ölçek → 2-98 clamp), invariant.
    private static string EsikPct(decimal yuk) => Math.Min(Math.Max((double)yuk / 25 * 100, 2), 98).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";

    // Gradient KPI kartı (carousel item) — Home hero dili.
    private RenderFragment KpiCard(string label, string value, string gradient, string sub) => @<div class="carousel-item w-[86%] lg:w-auto">
        <div class="w-full h-full rounded-3xl px-5 py-5 bg-gradient-to-br @gradient text-white shadow-lg flex flex-col">
            <div class="opacity-80 text-[11px] uppercase tracking-wider font-semibold">@label</div>
            <div class="text-[32px] font-extrabold leading-tight tracking-tight whitespace-nowrap mt-2">@value</div>
            <div class="text-xs opacity-85 mt-1">@sub</div>
        </div>
    </div>;

    private static string Mekan(int id) => id switch { 1 => "FSM", 4477 => "Özlüce", 4478 => "İst.Yolu", _ => "?" };
    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    // Ürün drill: dönem gün sayısı → ort. günlük satış + stok kaç gün yeter (envanter sinyali).
    private int DonemGun => Math.Max(1, _endExcl.DayNumber - _start.DayNumber);
    private string UrunOrtSatis(UrunRow u) => (u.Satis / (double)DonemGun).ToString("#,##0.0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " adet/gün";
    private (string Text, string Cls) UrunStok(UrunRow u)
    {
        if (u.Bakiye <= 0) return ("tükendi", "bg-error/15 text-error");
        var daily = u.Satis / (double)DonemGun;
        if (daily <= 0) return ($"{Num(u.Bakiye)} stok", "bg-base-200 text-base-content/50");
        var cover = (int)Math.Round(u.Bakiye / daily);
        var cls = cover <= 7 ? "bg-error/15 text-error" : cover <= 21 ? "bg-warning/15 text-warning" : "bg-base-200 text-base-content/55";
        return ($"{Num(u.Bakiye)} · ~{Num(cover)}g", cls);
    }
}
