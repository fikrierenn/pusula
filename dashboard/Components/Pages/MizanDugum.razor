@using GmDashboard.Models

@* Mizan ağacı tek düğüm (recursive). AcikSeviye = otomatik açık derinlik; manuel tıkla override eder. *@
<tr class="hover @(Node.YaprakMi ? "" : "cursor-pointer")" @onclick="Topla">
    <td class="font-mono whitespace-nowrap" style="padding-left:@((Node.Seviye - 1) * 16 + 8)px">
        @if (!Node.YaprakMi)
        {
            <span class="inline-block w-3 text-base-content/50">@(Acik ? "▾" : "▸")</span>
        }
        else
        {
            <span class="inline-block w-3"></span>
        }
        <span class="@(Node.Seviye <= 2 ? "font-bold" : Node.Seviye == 3 ? "font-semibold" : "")">@Node.Kod</span>
    </td>
    <td class="max-w-[340px] truncate @(Node.Seviye <= 2 ? "font-bold" : Node.Seviye == 3 ? "font-semibold" : "text-base-content/80")" title="@Node.Ad">@Node.Ad</td>
    <td class="text-right tabular-nums">@Tl(Node.Borc)</td>
    <td class="text-right tabular-nums">@Tl(Node.Alacak)</td>
    <td class="text-right tabular-nums font-semibold @Cls(Node.Bakiye)">@Tl(Node.Bakiye)</td>
</tr>
@if (Acik)
{
    @foreach (var c in Node.Cocuklar)
    {
        <MizanDugum Node="c" AcikSeviye="AcikSeviye" />
    }
}

@code {
    [Parameter, EditorRequired] public MizanNode Node { get; set; } = default!;
    [Parameter] public int AcikSeviye { get; set; } = 3;   // bu seviyeye kadar otomatik açık (Seviye < AcikSeviye)
    private bool? _override;
    private int _sonAcikSeviye = -1;

    protected override void OnParametersSet()
    {
        if (AcikSeviye != _sonAcikSeviye) { _override = null; _sonAcikSeviye = AcikSeviye; }   // seviye değişti → manuel sıfırla
    }

    private bool Acik => _override ?? (Node.Seviye < AcikSeviye);
    private void Topla() { if (!Node.YaprakMi) _override = !Acik; }

    private static string Cls(decimal b) => b > 0 ? "text-base-content" : b < 0 ? "text-info" : "text-base-content/40";
    private static string Tl(decimal v) => v == 0 ? "—" : v.ToString("#,##0.00", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
