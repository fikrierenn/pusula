@page "/satinalma/analiz"
@using GmDashboard.Data
@using GmDashboard.Models
@using System.Globalization
@inject SatinalmaQueries Satinalma
@inject AyarService Ayar
@inject NavigationManager Nav
@inject ILogger<SatinalmaAnaliz> Logger
@rendermode InteractiveServer

<PageTitle>Alım Analizi — BKM GM</PageTitle>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
        <div class="text-xs text-base-content/50">Aylık alım kararları · Hediyelik / Kırtasiye / Oyuncak</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">Alım Analizi</h1>
    </div>
    <div class="flex items-center gap-2">
        <select class="select select-bordered select-sm w-44" @bind="_ay0" @bind:after="Yukle" disabled="@_loading">
            @foreach (var (deger, etiket) in _aylar)
            {
                <option value="@deger">@etiket</option>
            }
        </select>
    </div>
</div>

@if (_loading)
{
    <div class="flex items-center gap-3 py-10 text-base-content/50 text-sm">
        <span class="loading loading-spinner loading-md"></span>
        <div>
            <div class="font-medium text-base-content/70">Hesaplanıyor…</div>
            <div class="text-xs">Stok + satış + tükenme modeli (~6 sn, sonra anlık)</div>
        </div>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-error text-sm"><i data-lucide="alert-triangle" class="w-4 h-4"></i><span>@_error</span></div>
}
else if (_rows.Count == 0)
{
    <div class="text-base-content/50 text-sm py-10 text-center">Bu ay için alım kaydı yok.</div>
}
else
{
    @* ── İçgörü bandı ── *@
    <div class="rounded-lg bg-base-200/60 border border-base-300 px-4 py-2.5 mb-4 text-sm flex items-center gap-2 flex-wrap">
        <i data-lucide="lightbulb" class="w-4 h-4 text-warning shrink-0"></i>
        <span>
            <b>@Num(_rows.Count)</b> üründe <b>@Tl(_rows.Sum(r => (decimal)r.AlisTutar))</b> alım.
            @if (Say("FAZLA") + Say("ÖLÜ-ALIM") > 0)
            {
                <span>Dikkat: <b class="text-error">@Num(MateryalSayi) materyal fazla</b> (@Tl(MateryalBagli) bağlı, ≥@Tl(_tolerans)) · <b class="text-error">@Num(Say("ÖLÜ-ALIM")) ölü-alım</b>. @Num(OnemsizSayi) düşük-öncelik ayrıldı.
                @if (RatchetSayi > 0)
                {
                    <span> · <b class="text-error">@Num(RatchetSayi) tekrar eden alım</b> (≥3 ayda alım + stok kapsamı eşik üstü)@(TersSayi > 0 ? $", {TersSayi}'inde sipariş↑ satış↓" : "")</span>
                }
                @if (StockoutSayi > 0)
                {
                    <span> · <b class="text-warning">@Num(StockoutSayi) üründe stok yokluğu</b> (karşı-metrik)</span>
                }</span>
            }
            else
            {
                <span class="text-success">Kritik fazla/ölü-alım yok.</span>
            }
        </span>
    </div>

    @* ── KPI kartları ── *@
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
        <div class="rounded-xl bg-base-100 border border-base-300 p-3.5 flex items-start gap-3">
            <div class="rounded-lg bg-primary/10 text-primary p-2 shrink-0"><i data-lucide="shopping-cart" class="w-5 h-5"></i></div>
            <div class="min-w-0">
                <div class="text-xs text-base-content/50">Toplam Alış</div>
                <div class="text-xl font-bold leading-tight truncate">@Tl(_rows.Sum(r => (decimal)r.AlisTutar))</div>
                <div class="text-[11px] text-base-content/50">@Num(_rows.Count) ürün</div>
            </div>
        </div>
        <div class="rounded-xl bg-base-100 border border-error/30 p-3.5 flex items-start gap-3">
            <div class="rounded-lg bg-error/10 text-error p-2 shrink-0"><i data-lucide="alert-triangle" class="w-5 h-5"></i></div>
            <div class="min-w-0">
                <div class="text-xs text-base-content/50">Materyal Fazla · Bağlı Para</div>
                <div class="text-xl font-bold leading-tight text-error truncate">@Tl(MateryalBagli)</div>
                <div class="text-[11px] text-base-content/50">@Num(MateryalSayi) üründe donmuş (≥@Tl(_tolerans))</div>
            </div>
        </div>
        <div class="rounded-xl bg-base-100 border border-error/30 p-3.5 flex items-start gap-3">
            <div class="rounded-lg bg-error/10 text-error p-2 shrink-0"><i data-lucide="skull" class="w-5 h-5"></i></div>
            <div class="min-w-0">
                <div class="text-xs text-base-content/50">Ölü-Alım</div>
                <div class="text-xl font-bold leading-tight text-error">@Num(Say("ÖLÜ-ALIM"))</div>
                <div class="text-[11px] text-base-content/50" title="Ölü-alım bağlı para = ay-sonu TAM stok × birim maliyet. Fazla'nın bağlı parası (sezon-sonrası kalan) ile AYNI TANIM DEĞİL — toplanmaz, ayrı okunur.">@Tl(OluBagliToplam) bağlı · stok vardı, 12 ay satmadı</div>
            </div>
        </div>
        <div class="rounded-xl bg-base-100 border border-success/30 p-3.5 flex items-start gap-3">
            <div class="rounded-lg bg-success/10 text-success p-2 shrink-0"><i data-lucide="check-circle" class="w-5 h-5"></i></div>
            <div class="min-w-0">
                <div class="text-xs text-base-content/50">Sağlıklı Oran</div>
                <div class="text-xl font-bold leading-tight text-success">%@SaglikPct</div>
                <div class="text-[11px] text-base-content/50" title="Payda = hüküm verilebilir ürünler (GENÇ hariç — yeni ürün, karar için erken). GENÇ paydaya katılırsa oran yapay yükselir.">@Num(HukumEvren) hüküm verilebilir üründe</div>
            </div>
        </div>
    </div>

    @* ── Sekme barı ── *@
    <div role="tablist" class="tabs tabs-bordered w-full mb-3">
        <a role="tab" class="tab flex-1 @(_tab == 0 ? "tab-active font-semibold text-primary" : "")" @onclick="() => _tab = 0">Ürünler</a>
        <a role="tab" class="tab flex-1 @(_tab == 1 ? "tab-active font-semibold text-primary" : "")" @onclick="() => _tab = 1">Kategori</a>
        <a role="tab" class="tab flex-1 @(_tab == 3 ? "tab-active font-semibold text-primary" : "")" @onclick="() => _tab = 3">Ürün Grubu</a>
        <a role="tab" class="tab flex-1 @(_tab == 2 ? "tab-active font-semibold text-primary" : "")" @onclick="() => _tab = 2">Marka / Tedarikçi</a>
        <a role="tab" class="tab flex-1 @(_tab == 4 ? "tab-active font-semibold text-primary" : "")" @onclick="FiyatSekmesi">Fiyat Sapması</a>
    </div>
}

@if (!_loading && _error is null && _rows.Count > 0 && _tab == 0)
{
    @* ── Filtre + arama ── *@
    <div class="flex flex-wrap items-center gap-1.5 my-3">
        @foreach (var g in _gruplar)
        {
            var aktif = _secili.Contains(g);
            <button class="btn btn-xs gap-1 transition-colors @(aktif ? GrupBtn(g) : "btn-ghost border border-base-300 text-base-content/60")"
                    @onclick="() => GrupTikla(g)">
                <span class="w-1.5 h-1.5 rounded-full @GrupDot(g)"></span>@g
                <span class="opacity-70 tabular-nums">@Say(g)</span>
            </button>
        }
        <button class="btn btn-xs btn-ghost text-base-content/50" @onclick="TumunuTemizle" title="filtreyi temizle"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
        <label class="input input-bordered input-xs flex items-center gap-1.5 w-52 ml-auto">
            <i data-lucide="search" class="w-3.5 h-3.5 opacity-50"></i>
            <input class="grow" placeholder="ürün / marka ara…" @bind="_ara" @bind:event="oninput" />
        </label>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-1.5">
        @if (_odakKat.Length > 0 || _odakMarka.Length > 0 || _odakGrup.Length > 0)
        {
            <span class="badge badge-primary badge-sm gap-1 cursor-pointer" @onclick="OdakTemizle">
                @(_odakKat.Length > 0 ? $"Kategori: {_odakKat}" : _odakGrup.Length > 0 ? $"Grup: {_odakGrup}" : $"Marka: {_odakMarka}") <i data-lucide="x" class="w-3 h-3"></i>
            </span>
        }
        <span class="text-xs text-base-content/50">@Filtreli.Count() / @_rows.Count ürün · satıra tıkla → detay</span>
        <label class="flex items-center gap-1.5 text-xs text-base-content/60 ml-auto cursor-pointer" title="bağlı parası düşük (sezonluk) fazlaları listeden ayır">
            <input type="checkbox" class="toggle toggle-xs toggle-primary" @bind="_sadeceOnemli" />
            düşük-öncelik fazlayı gizle
            @if (_sadeceOnemli && OnemsizSayi > 0)
            {
                <span class="badge badge-ghost badge-xs">@OnemsizSayi gizli</span>
            }
        </label>
        <label class="flex items-center gap-1 text-xs text-base-content/50">
            tolerans
            <input type="number" step="1000" class="input input-bordered input-xs w-24 tabular-nums" @bind="_tolerans" @bind:event="oninput" /> ₺
        </label>
    </div>

    @* ── Yöntem (nasıl okunur) ── *@
    <details class="border border-base-300 rounded-lg mb-2 text-sm">
        <summary class="px-3 py-1.5 cursor-pointer select-none text-base-content/70 flex items-center gap-1.5"><i data-lucide="help-circle" class="w-4 h-4"></i>Nasıl okunur? · yöntem</summary>
        <div class="px-4 py-2 text-xs text-base-content/70 space-y-1 border-t border-base-300">
            <div><b>FAZLA</b> = ay-sonu stok, önümüzdeki sezon (geçen yıl aynı dönem × büyüme) dahil <b>12 aydan uzun</b> sürede erir → ihtiyaçtan çok alım.</div>
            <div><b>Sezonluk bağlı para</b> = (Ay Sonu − Bu Sezon Beklenen) × Birim = sezon sonrası donmuş sermaye. Tolerans altındakiler "düşük öncelik" ayrılır (linear değil → sezonsal ürün şişmez).</div>
            <div><b>Değerlendirme:</b> <span class="text-error">FAZLA / ÖLÜ-ALIM</span> (kritik) · <span class="text-warning">YENİDEN-STOK / İZLE / UZUN-KUYRUK / KÜÇÜK-ALIM</span> (izle) · <span class="text-success">AZ ALMIŞ / NORMAL</span> (sağlıklı) · GENÇ (hüküm için erken).</div>
            <div><b>Tükenir</b> = sezon+büyüme ile ileri yürütme (ANA KARAR); "basit" (Son12÷12) sezonu görmez. Büyüme taban≥100 ürün-YoY, ince ise kategori sezon oranı.</div>
            <div class="text-base-content/50">Kapsam: Hediyelik/Kırtasiye/Oyuncak · alış = irsHrk ehTip 0/10 · ay-sonu anlık fiziki (şube+depo) · <b>e-ticaret hariç</b> (şube satış).</div>
        </div>
    </details>

    @* ── Tablo (sıralanabilir, tıklanabilir satır) ── *@
    <div class="overflow-x-auto border border-base-300 rounded-lg">
        <table class="table table-xs table-pin-rows">
            <thead>
                <tr>
                    <th>Ürün</th><th>Kategori</th><th>Marka</th>
                    @Th("AlisAdet", "Alınan", "Bu ay alınan adet (irsHrk alış — ehTip 0/10). Bu Ay Alınan, Son12'nin kaç katı = kaç yıllık aldın.")
                    @Th("BirimMaliyet", "Birim ₺", "Son alış faturası birim maliyeti (fatura-bazında SUM tutar/SUM adet — bedava satırlar dahil).")
                    @Th("AySonu", "Ay Sonu", "Ay sonu fiziki stok = şube (stokSon) + depo (WMS).")
                    @Th("Son12", "Son12", "Son 12 ay satış adedi (şube). Ana talep göstergesi.")
                    @Th("Buyume", "Büyüme", "Yıllık büyüme = Son12 ÷ Önceki12 (taban≥100 ürün YoY; ince ise kategori sezon oranı). >1 büyüyor, <1 düşüyor.")
                    @Th("TukAy", "Tükenir", "ANA KARAR: eldeki stok kaç ayda biter — geçen yılın aylık deseni × büyüme ile ileri yürütülür (sezon+büyüme dahil). >12 ay = FAZLA şüphesi. boş/hiç = tükenmez.")
                    @Th("BagliPara", "Bağlı ₺", "Fazla stokta donmuş sermaye (SEZONLUK) = (Ay Sonu − Bu Sezon Beklenen) × Birim. Sezon-sonrası kalan; linear değil.")
                    <th title="Sonuç etiketi. FAZLA=ihtiyaçtan çok · ÖLÜ-ALIM=stok vardı satmadı · AZ ALMIŞ=sezon eritir/stockout · İZLE=sınırda/veri-yok · YENİDEN-STOK=restok · GENÇ=erken.">Değerlendirme</th>
                    @Th("RatchetSkor", "Sinyal", "HESAP-SORMA sinyalleri (plan-34). ⚠TEKRAR = talep düşerken sipariş büyüyor (≥3 ayda alım + alım↑ + satış↓) = sistematik, tek kötü ay değil. 📉KURU = stok yokken kaçan satış (karşı-metrik: 'az al' da bir hata). ↩İADE = tedarikçide iade hakkı var → fazla stok donmuş sermaye SAYILMAZ.")
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Filtreli)
                {
                    <tr class="hover cursor-pointer @SatirKenar(r.Grup)" @onclick="() => Git(r.UrunKodu)">
                        <td class="max-w-[280px] truncate text-xs font-medium" title="@r.UrunAd">@r.UrunAd</td>
                        <td class="text-xs text-base-content/70">@r.Kategori</td>
                        <td class="max-w-[110px] truncate text-xs text-base-content/70" title="@r.Marka">@r.Marka</td>
                        <td class="text-right tabular-nums">@Num(r.AlisAdet)</td>
                        <td class="text-right tabular-nums">@Tl(r.BirimMaliyet)</td>
                        <td class="text-right tabular-nums">@Num(r.AySonu)</td>
                        <td class="text-right tabular-nums">@Num(r.Son12)</td>
                        <td class="text-right tabular-nums @(r.Buyume < 0.7m ? "text-error" : r.Buyume >= 2 ? "text-success" : "")">@r.Buyume.ToString("0.0", _tr)</td>
                        <td class="text-right tabular-nums">@TukGoster(r.TukAy)</td>
                        <td class="text-right tabular-nums @(r.BagliPara >= _tolerans ? "text-error font-semibold" : r.BagliPara > 0 ? "text-warning" : "text-base-content/30")">@(r.BagliPara > 0 ? Tl(r.BagliPara) : "—")</td>
                        <td class="text-xs font-semibold whitespace-nowrap @GrupText(r.Grup)">@r.Degerlendirme</td>
                        <td class="whitespace-nowrap text-[11px]">
                            @if (r.Ratchet)
                            {
                                <span class="badge badge-error badge-xs mr-1" title="@($"{r.RatchetAlimAy} ayda alım (sistematik) · son3 alım {Num(r.RatchetAlimSon3)} adet vs satış {Num(r.RatchetSatisSon3)} adet · önceki3 alım {Num(r.RatchetAlimOnc3)} / satış {Num(r.RatchetSatisOnc3)}")">⚠ TEKRAR@(r.RatchetSkor >= 2 ? $" {r.RatchetSkor:0.#}×" : "")</span>
                            }
                            @if (r.RatchetTers)
                            {
                                <span class="badge badge-error badge-outline badge-xs mr-1" title="@($"Sipariş artarken satış düşüyor: alım {Num(r.RatchetAlimOnc3)}→{Num(r.RatchetAlimSon3)}, satış {Num(r.RatchetSatisOnc3)}→{Num(r.RatchetSatisSon3)}")">↓ TERS</span>
                            }
                            @if (r.Stockout)
                            {
                                <span class="badge badge-warning badge-xs mr-1" title="@($"{r.KuruSube} şubede stok yok · tahmini kaçan {Num(r.KayipAdet)} adet (bulunurluk pre-agg)")">📉 KURU</span>
                            }
                            @if (r.IadeHakki)
                            {
                                <span class="badge badge-ghost badge-xs" title="Tedarikçide iade hakkı var (Ayarlar'daki frmIadeKural kodları) → fazla stok geri çevrilebilir, bağlı para 0 sayıldı.">↩ İADE</span>
                            }
                            @if (!r.Ratchet && !r.RatchetTers && !r.Stockout && !r.IadeHakki)
                            {
                                <span class="text-base-content/25">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!_loading && _error is null && _rows.Count > 0 && _tab is 1 or 2 or 3)
{
    var ozet = _tab == 1 ? Ozet(r => r.Kategori) : _tab == 3 ? Ozet(r => r.Grup1) : Ozet(r => r.Marka, 50);
    var baslik = _tab == 1 ? "Kategori" : _tab == 3 ? "Ürün Grubu" : "Marka";
    @if (_tab == 2)
    {
        <div class="text-xs text-base-content/50 mb-1.5">En yüksek alışlı 50 marka</div>
    }
    else if (_tab == 3)
    {
        <div class="text-xs text-base-content/50 mb-1.5">Ürün tipi (silgi, kalemtıraş, kalem, uç…) — bağlı paraya göre</div>
    }
    <div class="overflow-x-auto border border-base-300 rounded-lg">
        <table class="table table-sm table-pin-rows">
            <thead>
                <tr>
                    <th>@baslik</th>
                    <th class="text-right">Ürün</th>
                    <th class="text-right">Alış ₺</th>
                    <th class="text-right">🔴 Fazla</th>
                    <th class="text-right">🔴 Ölü</th>
                    <th class="text-right" title="FAZLA ailesi bağlı para = sezon-sonrası kalan × birim maliyet.">Fazla Bağlı ₺</th>
                    <th class="text-right" title="ÖLÜ-ALIM bağlı para = ay-sonu TAM stok × birim maliyet. Fazla ile aynı tanım değil — ayrı kolon.">Ölü Bağlı ₺</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in ozet)
                {
                    <tr class="hover cursor-pointer" @onclick="() => OdakOzet(o.Ad)">
                        <td class="font-medium max-w-[240px] truncate" title="@o.Ad">@o.Ad <i data-lucide="chevron-right" class="w-3 h-3 inline opacity-40"></i></td>
                        <td class="text-right tabular-nums">@Num(o.Urun)</td>
                        <td class="text-right tabular-nums">@Tl(o.Alis)</td>
                        <td class="text-right tabular-nums @(o.Fazla > 0 ? "text-error font-semibold" : "text-base-content/40")">@Num(o.Fazla)</td>
                        <td class="text-right tabular-nums @(o.Olu > 0 ? "text-error font-semibold" : "text-base-content/40")">@Num(o.Olu)</td>
                        <td class="text-right tabular-nums font-semibold @(o.FazlaBagli > 0 ? "text-error" : "text-base-content/40")">@Tl(o.FazlaBagli)</td>
                        <td class="text-right tabular-nums font-semibold @(o.OluBagli > 0 ? "text-error" : "text-base-content/40")">@Tl(o.OluBagli)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_tab == 4)
{
    <div class="text-xs text-base-content/60 mb-2">
        Aynı ürünü <b>farklı tedarikçiden farklı birim fiyata</b> almak — hesap-sormanın en temiz ekseni
        (karar tamamen alıcının kontrolünde, piyasa artışı tüm tedarikçileri aynı dönemde etkilediği için confound az).
        Son 12 ay alış faturası · tedarikçi başına ≥6 adet · bedava/0-tutarlı satır hariç · %1 altı fark gürültü sayıldı.
        <b>Fazla ödenen</b> = en ucuz tedarikçinin birim fiyatına göre fazladan ödenen tutar.
    </div>
    @if (_fiyatYukleniyor)
    {
        <div class="flex items-center gap-2 text-sm text-base-content/60 py-6">
            <span class="loading loading-spinner loading-sm"></span> Fiyat sapması hesaplanıyor…
        </div>
    }
    else if (_fiyatHata is not null)
    {
        <div class="alert alert-error text-sm">@_fiyatHata</div>
    }
    else if (_fiyat.Count == 0)
    {
        <div class="text-sm text-base-content/60 py-6">Kıyaslanabilir çoklu-tedarikçi alımı bulunamadı.</div>
    }
    else
    {
        <div class="text-[11px] text-base-content/50 mb-1.5">
            @Num(FiyatTemiz.Count) üründe fark · toplam fazla ödenen <b class="text-error">@Tl(FiyatTemiz.Sum(r => r.FazlaOdenen))</b>
            @if (FiyatSuphe > 0)
            {
                <span title="En pahalı/en ucuz oranı 10 katı aşıyor → aynı satılabilir birim değil (paket/koli/bundle farkı veya jenerik 'Muhtelif' SKU). Aşırı-ödeme kanıtı sayılmaz, listeden ayrıldı.">
                    · <b class="text-warning">@Num(FiyatSuphe) satır ölçek-uyumsuz</b> (paket/bundle şüphesi — ayrıldı)
                </span>
            }
            @if (FiyatIliskili > 0)
            {
                <span title="Kıyasın uçlarından biri grup-içi/ilişkili taraf (ODAK-POINT, Bursa Kültür Merkezi, BKM Kitap vb.). Fark alıcı hatası DEĞİL, transfer fiyatlaması konusu — manşet toplamına katılmadı. Liste Ayarlar'daki frmID'lerden okunur.">
                    · <b class="text-info">@Num(FiyatIliskili) satır grup-içi</b> (@Tl(FiyatIliskiliTutar) — transfer fiyatlaması, ayrıldı)
                </span>
            }
        </div>
        <div class="overflow-x-auto border border-base-300 rounded-lg">
            <table class="table table-xs table-pin-rows">
                <thead>
                    <tr>
                        <th>Ürün</th><th>Kategori</th><th>Marka</th>
                        <th class="text-right" title="Kıyasa giren tedarikçi sayısı (≥6 adet alınmış)">Ted.</th>
                        <th class="text-right">Adet</th>
                        <th class="text-right" title="En ucuz tedarikçinin birim fiyatı">En Az ₺</th>
                        <th class="text-right" title="En pahalı tedarikçinin birim fiyatı">En Çok ₺</th>
                        <th class="text-right">Fark %</th>
                        <th class="text-right" title="En ucuza göre fazladan ödenen toplam">Fazla Ödenen ₺</th>
                        <th>En Ucuz</th><th>En Pahalı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FiyatTemiz.Take(200))
                    {
                        <tr class="hover cursor-pointer" @onclick="() => Git(r.UrunKodu)">
                            <td class="max-w-[260px] truncate text-xs font-medium" title="@r.UrunAd">@r.UrunAd</td>
                            <td class="text-xs text-base-content/70">@r.Kategori</td>
                            <td class="max-w-[110px] truncate text-xs text-base-content/70" title="@r.Marka">@r.Marka</td>
                            <td class="text-right tabular-nums">@r.TedarikciSayi</td>
                            <td class="text-right tabular-nums">@Num(r.ToplamAdet)</td>
                            <td class="text-right tabular-nums">@Tl(r.EnAzBirim)</td>
                            <td class="text-right tabular-nums">@Tl(r.EnCokBirim)</td>
                            <td class="text-right tabular-nums @(r.FarkPct >= 10 ? "text-error font-semibold" : r.FarkPct >= 3 ? "text-warning" : "")">@r.FarkPct.ToString("0.0", _tr)</td>
                            <td class="text-right tabular-nums font-semibold @(r.FazlaOdenen >= _tolerans ? "text-error" : "text-warning")">@Tl(r.FazlaOdenen)</td>
                            <td class="max-w-[150px] truncate text-xs text-success" title="@r.EnAzTedarikci">@r.EnAzTedarikci</td>
                            <td class="max-w-[150px] truncate text-xs text-error" title="@($"{r.EnCokTedarikci} · son alım {r.EnCokSonTarih}")">@r.EnCokTedarikci</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (FiyatTemiz.Count > 200)
        {
            <div class="text-[11px] text-base-content/40 mt-1">İlk 200 satır gösteriliyor (@Num(FiyatTemiz.Count) toplam).</div>
        }
    }
}

@code {
    int _tab;
    List<FiyatSapmaRow> _fiyat = new();
    // Ölçek-uyumsuz satırlar (paket/bundle veya jenerik SKU) ana listeden AYRILIR — sayısı görünür (sessiz kırpma yok).
    List<FiyatSapmaRow> FiyatTemiz => _fiyat.Where(r => !r.OlcekSuphesi && !r.IliskiliTaraf).ToList();
    int FiyatIliskili => _fiyat.Count(r => r.IliskiliTaraf && !r.OlcekSuphesi);
    decimal FiyatIliskiliTutar => _fiyat.Where(r => r.IliskiliTaraf && !r.OlcekSuphesi).Sum(r => r.FazlaOdenen);
    int FiyatSuphe => _fiyat.Count(r => r.OlcekSuphesi);
    bool _fiyatYukleniyor;
    string? _fiyatHata;

    /// <summary>Fiyat sapması sekmesi — TIKLANINCA yüklenir (ana sayfayı yavaşlatmaz, plan-34 perf riski).</summary>
    async Task FiyatSekmesi()
    {
        _tab = 4;
        if (_fiyat.Count > 0 || _fiyatYukleniyor) return;
        _fiyatYukleniyor = true; _fiyatHata = null; StateHasChanged();
        try { _fiyat = (await Satinalma.GetFiyatSapmaAsync(_ay0)).ToList(); }
        catch (Exception ex) { _fiyatHata = $"Fiyat sapması hesaplanamadı: {ex.Message}"; }
        finally { _fiyatYukleniyor = false; StateHasChanged(); }
    }
    // Bağlı para İKİ AYRI TANIM: FazlaBagli = sezon-sonrası kalan × maliyet · OluBagli = tam stok × maliyet.
    // Tek kolonda toplamak kıyaslanamaz büyüklükleri karıştırır → ayrı taşınır; Bagli yalnız ÖNCELİK SIRALAMASI için.
    sealed record OzetSatir(string Ad, int Urun, decimal Alis, int Fazla, int Olu, decimal FazlaBagli, decimal OluBagli)
    {
        public decimal Bagli => FazlaBagli + OluBagli;
    }
    IEnumerable<OzetSatir> Ozet(Func<SatinalmaAnalizSatir, string> key, int? top = null)
    {
        var q = _rows.GroupBy(key).Select(g => new OzetSatir(
                string.IsNullOrWhiteSpace(g.Key) ? "—" : g.Key,
                g.Count(), g.Sum(r => (decimal)r.AlisTutar),
                g.Count(r => r.Grup == "FAZLA"), g.Count(r => r.Grup == "ÖLÜ-ALIM"),
                g.Where(r => FazlaAile(r.Grup)).Sum(r => r.BagliPara),
                g.Where(r => r.Grup == "ÖLÜ-ALIM").Sum(r => r.BagliPara)))
            .OrderByDescending(o => o.Bagli);
        return top.HasValue ? q.Take(top.Value) : q;
    }

    static readonly CultureInfo _tr = CultureInfo.GetCultureInfo("tr-TR");
    static readonly string[] _oncelik = { "FAZLA", "ÖLÜ-ALIM", "TREND-HIZLI", "YENİDEN-STOK", "UZUN-KUYRUK", "KÜÇÜK-ALIM", "İZLE", "AZ ALMIŞ", "NORMAL", "GENÇ", "DİĞER" };

    List<(string Deger, string Etiket)> _aylar = new();
    string _ay0 = "";
    bool _loading = true;
    string? _error;
    List<SatinalmaAnalizSatir> _rows = new();
    List<string> _gruplar = new();
    HashSet<string> _secili = new() { "FAZLA", "ÖLÜ-ALIM" };
    string _ara = "";
    string _odakKat = "";      // kategori/marka/grup özet satırından drill → Ürünler'i daralt
    string _odakMarka = "";
    string _odakGrup = "";
    string _sortKey = "BagliPara";   // varsayılan: bağlı paraya göre azalan (en çok donmuş üstte)
    bool _sortAsc;
    int _tolerans;             // materiality eşiği ₺ (Ayarlar'dan; OnInitialized'da set) — altı 'düşük öncelik'
    bool _sadeceOnemli = true; // düşük-öncelikli (bağlı<tolerans) fazlaları gizle

    static bool FazlaAile(string g) => g is "FAZLA" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM";
    static bool ProblemStok(string g) => FazlaAile(g) || g == "ÖLÜ-ALIM";   // fazla + ölü = donmuş sermaye
    // Materiality: bağlı ≥ tolerans → önemli; altı → düşük öncelik (fazla + ölü-alım).
    bool Dusuk(SatinalmaAnalizSatir r) => ProblemStok(r.Grup) && r.BagliPara < _tolerans;
    int OnemsizSayi => _rows.Count(Dusuk);
    int RatchetSayi => _rows.Count(r => r.Ratchet);
    int TersSayi => _rows.Count(r => r.RatchetTers);
    int StockoutSayi => _rows.Count(r => r.Stockout);
    decimal OluBagliToplam => _rows.Where(r => r.Grup == "ÖLÜ-ALIM").Sum(r => r.BagliPara);
    // Tükenir: model 999'u "pratikte tükenmez" sentinel'i olarak üretir — 999,0 ay diye okunmasın.
    string TukGoster(decimal? t) => t is null ? "—" : t >= 999m ? "tükenmez" : t.Value.ToString("0.0", _tr);
    int MateryalSayi => _rows.Count(r => FazlaAile(r.Grup) && r.BagliPara >= _tolerans);
    decimal MateryalBagli => _rows.Where(r => FazlaAile(r.Grup) && r.BagliPara >= _tolerans).Sum(r => r.BagliPara);

    IEnumerable<SatinalmaAnalizSatir> Filtreli
    {
        get
        {
            var q = _rows.Where(r => (_secili.Count == 0 || _secili.Contains(r.Grup))
                          && (_odakKat.Length == 0 || r.Kategori == _odakKat)
                          && (_odakMarka.Length == 0 || r.Marka == _odakMarka)
                          && (_odakGrup.Length == 0 || r.Grup1 == _odakGrup)
                          && !(_sadeceOnemli && Dusuk(r))
                          && (_ara.Length == 0 || r.UrunAd.Contains(_ara, StringComparison.OrdinalIgnoreCase) || r.Marka.Contains(_ara, StringComparison.OrdinalIgnoreCase)));
            if (_sortKey.Length == 0) return q;
            System.Func<SatinalmaAnalizSatir, decimal> k = _sortKey switch
            {
                "AlisAdet" => r => r.AlisAdet,
                "BirimMaliyet" => r => r.BirimMaliyet,
                "AySonu" => r => r.AySonu,
                "Son12" => r => r.Son12,
                "Buyume" => r => r.Buyume,
                "TukAy" => r => r.TukAy ?? -1,
                "StokluAy" => r => r.StokluAy ?? -1,
                "BagliPara" => r => r.BagliPara,
                "RatchetSkor" => r => (decimal)r.RatchetSkor,
                _ => r => 0,
            };
            return _sortAsc ? q.OrderBy(k) : q.OrderByDescending(k);
        }
    }

    RenderFragment Th(string key, string label, string? tip = null) => builder =>
    {
        builder.OpenElement(0, "th");
        builder.AddAttribute(1, "class", "text-right cursor-help select-none hover:text-primary transition-colors whitespace-nowrap");
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => Sort(key)));
        if (tip is not null) builder.AddAttribute(3, "title", tip);
        builder.AddContent(4, label + (_sortKey == key ? (_sortAsc ? " ▲" : " ▼") : ""));
        builder.CloseElement();
    };

    void Sort(string key)
    {
        if (_sortKey == key) _sortAsc = !_sortAsc;
        else { _sortKey = key; _sortAsc = false; }
    }

    void Git(int stkID) => Nav.NavigateTo($"/satinalma/urun/{stkID}");
    void OdakOzet(string ad) { if (_tab == 1) OdakKategori(ad); else if (_tab == 3) OdakGrup(ad); else OdakMarkaSet(ad); }
    void OdakKategori(string kat) { _odakKat = kat; _odakMarka = ""; _odakGrup = ""; _secili.Clear(); _tab = 0; }
    void OdakMarkaSet(string m) { _odakMarka = m; _odakKat = ""; _odakGrup = ""; _secili.Clear(); _tab = 0; }
    void OdakGrup(string g) { _odakGrup = g; _odakKat = ""; _odakMarka = ""; _secili.Clear(); _tab = 0; }
    void OdakTemizle() { _odakKat = ""; _odakMarka = ""; _odakGrup = ""; }

    protected override async Task OnInitializedAsync()
    {
        _tolerans = Ayar.Deger.SatinMaterialite;   // varsayılan tolerans = ayar materiality
        var ilk = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1);
        for (int i = 0; i < 12; i++)
        {
            var d = ilk.AddMonths(-i);
            _aylar.Add((d.ToString("yyyyMM") + "01", d.ToString("MMMM yyyy", _tr)));
        }
        _ay0 = _aylar[0].Deger;
        await Yukle();
    }

    async Task Yukle()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            _fiyat = new(); _fiyatHata = null;   // dönem değişti → fiyat sapması cache'i sıfırla (plan-34)
            _rows = (await Satinalma.GetAnalizAsync(_ay0)).ToList();
            _gruplar = _rows.Select(r => r.Grup).Distinct().OrderBy(g => Array.IndexOf(_oncelik, g)).ToList();
            _secili.IntersectWith(_gruplar);
            if (_secili.Count == 0) _secili = _gruplar.Where(g => g is "FAZLA" or "ÖLÜ-ALIM").ToHashSet();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Alım Analizi yüklenemedi (ay {Ay})", _ay0);
            _error = "Rapor yüklenemedi. Lütfen tekrar deneyin.";
            _rows = new();
        }
        finally { _loading = false; StateHasChanged(); }
    }

    void GrupTikla(string g) { if (!_secili.Add(g)) _secili.Remove(g); }
    void TumunuTemizle() => _secili.Clear();
    int Say(string g) => _rows.Count(r => r.Grup == g);
    // Hüküm verilebilir evren = GENÇ hariç (GENÇ = ilk girişi yeni, karar için erken → sağlık oranını yapay şişirir).
    int HukumEvren => _rows.Count(r => r.Grup != "GENÇ");
    int SaglikPct => HukumEvren == 0 ? 0 : (int)Math.Round(100.0 * (HukumEvren - Say("FAZLA") - Say("ÖLÜ-ALIM") - Say("İZLE")) / HukumEvren);

    static string GrupBtn(string g) => g switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "btn-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "btn-warning",
        "NORMAL" => "btn-success",
        "AZ ALMIŞ" => "btn-neutral",
        _ => "btn-neutral",
    };
    static string GrupDot(string g) => g switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "bg-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "bg-warning",
        "NORMAL" => "bg-success",
        "AZ ALMIŞ" => "bg-neutral",
        _ => "bg-base-content/30",
    };
    static string GrupText(string g) => g switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "text-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "text-warning",
        "NORMAL" => "text-success",
        "AZ ALMIŞ" => "text-base-content/60",
        _ => "text-base-content/50",
    };
    static string SatirKenar(string g) => g switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "border-l-2 border-l-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "border-l-2 border-l-warning",
        _ => "border-l-2 border-l-transparent",
    };

    static string Num(int n) => n.ToString("#,##0", _tr);
    static string Tl(decimal d) => d.ToString("#,##0", _tr) + " ₺";
}
