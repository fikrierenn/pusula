@page "/musteri"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject RefQueries Ref
@inject PerfState Perf
@inject IJSRuntime JS
@inject IcKartService IcKart
@inject ILogger<Musteri> Logger
@inject PersistentComponentState AppState
@rendermode InteractiveServer

<PageTitle>Müşteri — BKM GM</PageTitle>
<div class="flex items-center gap-3 mb-5 flex-wrap"><h1 class="text-2xl font-bold tracking-tight m-0">Müşteri Segmenti (RFM)</h1>
    <span class="text-sm font-semibold text-base-content/50">son 365 gün · @_dun.ToString("dd.MM.yyyy") itibarıyla</span>
    <span class="badge badge-primary badge-sm gap-1 font-semibold"><i data-lucide="receipt" class="w-3.5 h-3.5"></i>Fiş bazlı (perakende · Fatura/Sınav hariç)</span></div>

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else
{
    var ykToplamMusteri = _yk.Sum(r => r.Musteri);
    var ykSadakatMusteri = _yk.Where(r => r.Segment.StartsWith("1") || r.Segment.StartsWith("2")).Sum(r => r.Musteri);
    var etToplamMusteri = _et.Sum(r => r.Musteri);
    var ykToplamCiro = _yk.Sum(r => r.Ciro);
    <AppKpiCarousel Id="mskpi" Items="@(new List<KpiCardData>
    {
        new("Yazarkasa Müşteri", Num(ykToplamMusteri), "from-primary to-primary/80", "son 365 gün · sadakat kartı"),
        new("Şampiyon + Sadık", Num(ykSadakatMusteri), "from-info to-info/80", "YK en değerli 2 segment"),
        new("E-ticaret Müşteri", Num(etToplamMusteri), "from-success to-success/80", "son 365 gün · JOKER"),
        new("YK Ciro (365g)", Tl(ykToplamCiro), "from-warning to-warning/80", "sadakat kartı toplam"),
    })" />

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Yazarkasa — Sadakat Kartı (son 365 gün)</h3>
            <AppRankBars TItem="RfmSegment" Items="_yk" Label="@(r => r.Segment)" Value="@(r => r.Ciro)"
                         ValueText="@(r => $"{Tl(r.Ciro)} · {Num(r.Musteri)} müşteri")" OnRowClick="@(r => OpenDrill("yk", r.Segment))" />
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">E-ticaret — JOKER (son 365 gün)</h3>
            <AppRankBars TItem="RfmSegment" Items="_et" Label="@(r => r.Segment)" Value="@(r => r.Ciro)"
                         ValueText="@(r => $"{Tl(r.Ciro)} · {Num(r.Musteri)} müşteri")" OnRowClick="@(r => OpenDrill("et", r.Segment))" />
        </div>
    </div>
    <p class="text-base-content/50 text-xs mb-2">RFM = Recency (son alış) · Frequency (sıklık) · Monetary (harcama). İki ayrı evren — kimlik köprüsü yok, birleştirilmez. Segment satırına tıkla → ilk 100 müşteri, sonra müşteriye tıkla → iç kart işaretle.</p>

    @if (_stat is not null)
    {
        <h2 class="text-lg font-bold tracking-tight mb-3 mt-2">Müşteri Kazanım &amp; Kart İstatistik</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-1 flex items-center gap-1.5"><i data-lucide="user-plus" class="w-4 h-4 text-success"></i>Aylık Yeni Müşteri Kazanım (13 ay)</h3>
                <div class="text-[11px] text-base-content/50 mb-2">o ay İLK kez alışveriş yapan kart · iç kart hariç</div>
                <AppAreaChart TItem="MusteriKazanim" Items="_stat.Kazanim" Name="Yeni müşteri" Height="120"
                              XValue="@(k => (object)k.Ay[5..])" YValue="@(k => (decimal?)k.Yeni)"
                              OnDataPointSelection="@SeçAy" />
                @{ var sonAy = _stat.Kazanim.Count > 0 ? _stat.Kazanim[^1] : null; }
                @if (sonAy is not null)
                {
                    <div class="text-[11px] text-base-content/50 mt-2">Son ay <b>@AyAd(sonAy.Ay)</b>: <b class="text-success">@Num(sonAy.Yeni)</b> yeni müşteri · 13 ay toplam @Num(_stat.Kazanim.Sum(k => k.Yeni)) · <span class="text-primary">aya tıkla → detay</span></div>
                }
                @if (_selKazAy is not null)
                {
                    <div class="mt-3 border-t border-base-200 pt-3">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-[12px] font-semibold"><i data-lucide="user-plus" class="w-3.5 h-3.5 inline text-success"></i> @AyAd(_selKazAy) — Yeni Müşteriler</span>
                            <button class="btn btn-ghost btn-xs ml-auto" @onclick="() => { _selKazAy = null; _kazDetay = []; }">✕ kapat</button>
                        </div>
                        @if (_kazDetayLoading)
                        {
                            <span class="loading loading-spinner loading-xs text-base-content/40"></span>
                        }
                        else if (_kazDetay.Count == 0)
                        {
                            <div class="text-[11px] text-base-content/50">Veri yok.</div>
                        }
                        else
                        {
                            <AppDataTable TItem="KazanimDetayRow"
                                          Items="@_kazDetay"
                                          Primary="@(r => string.IsNullOrEmpty(r.Ad) ? "(isimsiz)" : r.Ad)"
                                          Sub="@(r => r.Tel)"
                                          MetricMain="@(r => Tl(r.IlkTutar))"
                                          MetricSub="@(r => r.IlkTarih)"
                                          Badge="@(r => ("ilk alış", "bg-success/15 text-success"))" />
                            <div class="text-[11px] text-base-content/50 mt-1">@Num(_kazDetay.Count) müşteri gösteriliyor (max 200) · İlk alış tutarı KDV-hariç</div>
                        }
                    </div>
                }
            </div>
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <div class="flex items-start justify-between gap-2 mb-1">
                    <h3 class="text-sm font-semibold text-base-content/90 flex items-center gap-1.5"><i data-lucide="credit-card" class="w-4 h-4 text-info"></i>Kart Oranı — Mağaza (son @_kartGun g)</h3>
                    <div class="join join-horizontal shrink-0">
                        @foreach (var g in new[] { 7, 30, 90 })
                        {
                            <button class="join-item btn btn-xs @(_kartGun == g ? "btn-primary" : "btn-ghost")" @onclick="() => DeğişKartGun(g)">@g g</button>
                        }
                    </div>
                </div>
                <div class="text-[11px] text-base-content/50 mb-2">kaç fişin kaçı müşteri-kartlı (sadakat tanıma)</div>
                @if (_kartLoading)
                {
                    <span class="loading loading-spinner loading-xs text-base-content/40"></span>
                }
                else
                {
                    var kFis = _kartData.Sum(m => m.Fis); var kKartli = _kartData.Sum(m => m.Kartli);
                    <AppRankBars TItem="MagazaKart" Items="_kartData" Label="@(m => m.Magaza)" Value="@(m => m.Oran)"
                                 ValueText="@(m => $"%{m.Oran} · {Num(m.Kartli)}/{Num(m.Fis)} fiş")" />
                    <div class="text-[12px] font-semibold mt-2 pt-2 border-t border-base-200">Toplam: <b>%@(kFis > 0 ? Math.Round(100m * kKartli / kFis, 1) : 0)</b> kartlı (@Num(kKartli)/@Num(kFis) fiş)</div>
                }
            </div>
            @if (_kazEt.Count > 0)
            {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-1 flex items-center gap-1.5"><i data-lucide="shopping-cart" class="w-4 h-4 text-info"></i>E-Ticaret Yeni Müşteri Kazanım (13 ay)</h3>
                <div class="text-[11px] text-base-content/50 mb-2">JOKER'de İLK sipariş ay bazlı · misafir sipariş hariç · YK'dan bağımsız evren</div>
                <AppAreaChart TItem="MusteriKazanim" Items="_kazEt" Name="Yeni e-tic müşteri" Height="120" Color="var(--in)"
                              XValue="@(k => (object)k.Ay[5..])" YValue="@(k => (decimal?)k.Yeni)" />
                @{ var sonEt = _kazEt.Count > 0 ? _kazEt[^1] : null; }
                @if (sonEt is not null)
                {
                    <div class="text-[11px] text-base-content/50 mt-2">Son ay <b>@AyAd(sonEt.Ay)</b>: <b class="text-info">@Num(sonEt.Yeni)</b> yeni · 13 ay toplam @Num(_kazEt.Sum(k => k.Yeni))</div>
                }
            </div>
            }
        </div>
    }

    @if (_ltv.Count > 0 || _churn is not null)
    {
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
            @if (_ltv.Count > 0)
            {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-1 flex items-center gap-1.5"><i data-lucide="trending-up" class="w-4 h-4 text-primary"></i>Müşteri LTV — Yıllık Değer (son 365g, min 2 alış)</h3>
                <div class="text-[11px] text-base-content/50 mb-2">ort. yıllık ciro · aktif ay · frekans · kartlı vs kartsız karşılaştırma</div>
                <AppDataTable TItem="LtvOzet"
                              Items="@_ltv"
                              Primary="@(r => r.Segment)"
                              MetricMain="@(r => Tl(r.OrtYillikCiro) + "/yıl")"
                              MetricSub="@(r => $"{r.OrtFrekans:0.0} alış/yıl · {r.OrtAktifAy:0.0} ay aktif")"
                              Badge="@(r => (Num(r.Musteri) + " müşteri", r.Segment == "Kartlı" ? "bg-success/15 text-success" : "bg-base-200 text-base-content/60"))" />
                <div class="text-[11px] text-base-content/50 mt-2">İç/mağaza kartı hariç · Aktif ay = ilk→son alış aralığı · Yıllık ciro = toplam/(aktif ay)×12</div>
            </div>
            }
            @if (_churn is not null && _churn.ToplamMusteri > 0)
            {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
                <h3 class="text-sm font-semibold text-base-content/90 mb-1 flex items-center gap-1.5"><i data-lucide="user-minus" class="w-4 h-4 text-error"></i>Tekrar-Alım & Churn — son 365g aktif müşteriler</h3>
                <div class="text-[11px] text-base-content/50 mb-2">aktivasyon = 2+ alış · churn riski = son 90g+ sessiz</div>
                <div class="space-y-3 mt-1">
                    <div>
                        <div class="flex justify-between text-[13px] mb-1"><span class="font-semibold">Aktivasyon (2+ alış)</span><span class="font-bold text-success">%@(_churn.AktivasyonPct.ToString("0.0")) · @Num(_churn.Aktivasyon)</span></div>
                        <div class="h-2 rounded-full bg-base-200"><div class="h-full rounded-full bg-success" style="width:@(Math.Min(100, (int)_churn.AktivasyonPct))%"></div></div>
                    </div>
                    <div>
                        <div class="flex justify-between text-[13px] mb-1"><span class="font-semibold">Churn Riski (90g+ sessiz)</span><span class="font-bold text-error">%@(_churn.ChurnPct.ToString("0.0")) · @Num(_churn.ChurnRisk)</span></div>
                        <div class="h-2 rounded-full bg-base-200"><div class="h-full rounded-full bg-error" style="width:@(Math.Min(100, (int)_churn.ChurnPct))%"></div></div>
                    </div>
                    <div class="text-[11px] text-base-content/50 pt-1 border-t border-base-200">Baz: @Num(_churn.ToplamMusteri) müşteri (son 365g ≥1 alış)</div>
                </div>
            </div>
            }
        </div>
    }

    @if (_kohort.Count > 0)
    {
        var cohortlar = _kohort.Select(r => r.CohortAy).Distinct().OrderBy(a => a).ToList();
        var nMax = _kohort.Max(r => r.N);
        var lookup = _kohort.ToDictionary(r => (r.CohortAy, r.N));
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mb-3 overflow-x-auto">
            <h3 class="text-sm font-semibold text-base-content/90 mb-1">Kohort Retention Matrisi — aylık edinim × N. ay geri dönüş %</h3>
            <div class="text-[11px] text-base-content/50 mb-3">Satır = kazanım ayı · Sütun = kaçıncı ay sonra tekrar alış · Hücre = kohorttaki müşterilerin geri dönüş %'si</div>
            <div class="overflow-x-auto">
                <table class="text-[11px] border-separate border-spacing-[2px] min-w-max">
                    <thead>
                        <tr>
                            <th class="text-left pr-3 text-base-content/60 font-medium pb-1">Kohort</th>
                            <th class="text-center px-1 text-base-content/60 font-medium pb-1">n</th>
                            @for (var n = 1; n <= nMax; n++)
                            {
                                <th class="text-center w-10 text-base-content/50 font-medium pb-1">+@n ay</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ay in cohortlar)
                        {
                            var byt = lookup.TryGetValue((ay, 1), out var r1) ? r1.Buyukluk : _kohort.Where(r => r.CohortAy == ay).Select(r => r.Buyukluk).FirstOrDefault();
                            <tr>
                                <td class="pr-3 text-base-content/70 whitespace-nowrap">@AyAd(ay)</td>
                                <td class="text-center px-1 text-base-content/50">@Num(byt)</td>
                                @for (var n = 1; n <= nMax; n++)
                                {
                                    @if (lookup.TryGetValue((ay, n), out var cell))
                                    {
                                        var pct = byt > 0 ? (int)Math.Round(cell.Donenler * 100m / byt) : 0;
                                        var bg = pct >= 40 ? "bg-success/80 text-white" : pct >= 20 ? "bg-success/30 text-success" : pct >= 10 ? "bg-warning/20 text-warning" : "bg-base-200 text-base-content/50";
                                        <td class="text-center rounded w-10 h-7 @bg">%@pct</td>
                                    }
                                    else
                                    {
                                        <td class="text-center text-base-content/20 w-10">—</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-[11px] text-base-content/50 mt-2">n = kohort büyüklüğü (o ay ilk kez alışveriş yapan müşteri) · İç/mağaza kartı hariç · YK (yazarkasa) bazlı</div>
        </div>
    }

    @if (_icKartlar.Count > 0)
    {
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 mb-3">
            <h3 class="text-sm font-semibold text-base-content/90 mb-2 flex items-center gap-1.5"><i data-lucide="store" class="w-4 h-4 text-error"></i>İç/Mağaza Kartları (@_icKartlar.Count) — RFM + müşteri analizlerinden hariç</h3>
            <div class="flex flex-wrap gap-2">
                @foreach (var k in _icKartlar)
                {
                    <span class="badge badge-outline gap-1 py-3">@k.Ad
                        <button class="text-error hover:text-error/70" title="Geri al (RFM'e dahil et)" @onclick="() => IcKartGeriAl(k.Id)">✕</button>
                    </span>
                }
            </div>
        </div>
    }

    <Modal @bind-Open="_modalOpen" Title="@_modalBaslik">
        @if (_lvl > 1)
        {
            <button class="btn btn-xs btn-ghost gap-1 mb-2" @onclick="GeriDrill"><i data-lucide="chevron-left" class="w-3.5 h-3.5"></i>geri</button>
        }
        @if (_drillLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else if (_lvl == 1)
        {
            @if (_selKanal == "yk")
            {
                <label class="text-base-content/50 text-xs mb-2 block">
                    <input type="checkbox" @bind="_icKart" @bind:after="ReloadCustomersAsync" /> İç/mağaza kartlarını dahil et (599/699, Mağaza, Kumbara)
                </label>
            }
            <AppDataTable TItem="CustomerRow" Items="_drill"
                          Primary="@(c => c.Ad)" Sub="@(c => c.Tel)"
                          MetricMain="@(c => Tl(c.Mon))" MetricSub="@(c => $"{Num(c.Frq)} alış")"
                          Badge="@(c => ($"{c.Rec}g", "bg-base-200 text-base-content/50"))"
                          Details="MusteriDetay" />
        }
        else if (_lvl == 2)
        {
            <div class="text-base-content/50 text-xs mb-2">@(_selKanal == "yk" ? "fiş" : "sipariş") geçmişi (365g, top 100) · tıkla → içerik</div>
            @if (_fisler.Count == 0) { <p class="text-base-content/50 text-sm">Kayıt yok.</p> }
            @foreach (var f in _fisler)
            {
                <div class="flex items-center gap-2 py-2.5 border-b border-base-200 last:border-b-0 cursor-pointer hover:bg-base-200/40 rounded-lg -mx-1.5 px-1.5" @onclick="() => OpenIcerik(f)">
                    <div class="min-w-0 flex-1">
                        <div class="text-[13px] font-semibold text-base-content/85 flex items-center gap-1.5">
                            @f.Tarih
                            @if (f.Tutar < 0) { <span class="badge badge-xs bg-error/15 text-error border-0">iade</span> }
                            @if (f.IndirimTutar > 0) { <span class="badge badge-xs bg-warning/15 text-warning border-0">−@Tl(f.IndirimTutar)</span> }
                        </div>
                        <div class="text-[11px] text-base-content/50">#@f.Ref · @f.Kalem kalem</div>
                    </div>
                    <div class="text-[13px] font-bold tabular-nums whitespace-nowrap @(f.Tutar < 0 ? "text-error" : "")">@Tl(f.Tutar)</div>
                    <i data-lucide="chevron-right" class="w-[18px] h-[18px] text-base-content/40 shrink-0"></i>
                </div>
            }
        }
        else
        {
            var tBrut = _fisIcerik.Sum(u => u.Brut); var tInd = _fisIcerik.Sum(u => u.Indirim); var tNet = _fisIcerik.Sum(u => u.Net);
            <!-- Termal fiş görünümü (monospace, kesik çizgi) — "bildiğin fiş" -->
            <div class="font-mono text-[12px] leading-relaxed max-w-[360px] mx-auto bg-base-100 border border-base-300 rounded-lg px-4 py-3 text-base-content/90">
                <div class="text-center font-bold tracking-wider text-[13px]">BKM KİTAP</div>
                <div class="text-center text-[10px] text-base-content/50">@(_selKanal == "yk" ? "Yazarkasa Fişi" : "E-Ticaret Siparişi")</div>
                <div class="text-center text-base-content/40">════════════════════════</div>
                <div class="flex justify-between text-[10px] text-base-content/55">
                    <span>@(_selKanal == "yk" ? "FİŞ" : "SİP") #@_selFis?.Ref</span><span>@_selFis?.Tarih</span>
                </div>
                <div class="text-base-content/40">- - - - - - - - - - - - - - - - - - - -</div>
                @foreach (var u in _fisIcerik)
                {
                    <div class="mt-1">
                        <div class="truncate">@u.Ad</div>
                        <div class="flex justify-between text-base-content/70">
                            <span>@u.Adet.ToString("0.##") x @Tl(u.Brut / (u.Adet == 0 ? 1 : u.Adet))</span>
                            <span class="tabular-nums">@Tl(u.Brut)</span>
                        </div>
                        @if (u.Indirim > 0)
                        {
                            <div class="flex justify-between text-error text-[11px]"><span class="truncate">&nbsp;&nbsp;@(string.IsNullOrWhiteSpace(u.Kampanya) ? "Manuel indirim" : u.Kampanya)</span><span class="tabular-nums shrink-0">−@Tl(u.Indirim)</span></div>
                        }
                    </div>
                }
                <div class="text-base-content/40 mt-1">- - - - - - - - - - - - - - - - - - - -</div>
                <div class="flex justify-between text-base-content/70"><span>ARA TOPLAM</span><span class="tabular-nums">@Tl(tBrut)</span></div>
                @if (tInd > 0)
                {
                    <div class="flex justify-between text-error"><span>İNDİRİM (%@((100 * tInd / tBrut).ToString("0.0")))</span><span class="tabular-nums">−@Tl(tInd)</span></div>
                }
                <div class="flex justify-between font-bold text-[14px] mt-0.5"><span>TOPLAM</span><span class="tabular-nums">@Tl(tNet)</span></div>
                <div class="text-center text-[9px] text-base-content/40 mt-0.5">(KDV hariç net ciro)</div>
                <div class="text-base-content/40">════════════════════════</div>
                <div class="text-[10px] text-base-content/55">MÜŞTERİ: <span class="font-semibold text-base-content/80">@_selMusteri?.Ad</span></div>
                @if (!string.IsNullOrWhiteSpace(_selMusteri?.Tel)) { <div class="text-[10px] text-base-content/55">TEL: @_selMusteri!.Tel</div> }
                <div class="text-center text-[10px] text-base-content/40 mt-1">@_fisIcerik.Count kalem · @_fisIcerik.Sum(u => u.Adet).ToString("0.##") adet</div>
                <div class="text-center text-base-content/40">★ TEŞEKKÜRLER ★</div>
            </div>
        }
    </Modal>
}

@code {
    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<RfmSegment> _yk = [];
    private IReadOnlyList<RfmSegment> _et = [];
    private DateOnly _dun;
    private MusteriStat? _stat;

    // R-1: kazanım drill (ay seçimi)
    private string? _selKazAy;
    // R-2: kart oranı dönem pill
    private int _kartGun = 30;
    // R-3: e-ticaret kazanım
    private IReadOnlyList<MusteriKazanim> _kazEt = [];
    // R-4: kohort retention
    private IReadOnlyList<KohortRow> _kohort = [];
    // R-6: LTV
    private IReadOnlyList<LtvOzet> _ltv = [];
    // R-7: churn
    private ChurnOzet? _churn;
    private bool _kartLoading;
    private IReadOnlyList<MagazaKart> _kartData = [];
    private bool _kazDetayLoading;
    private IReadOnlyList<KazanimDetayRow> _kazDetay = [];

    private bool _modalOpen;
    private bool _drillLoading;
    private bool _icKart;
    private string _selKanal = "yk";
    private string _selSeg = "";
    private IReadOnlyList<CustomerRow> _drill = [];
    private IReadOnlyList<IcKart> _icKartlar = [];

    // Drill seviyesi: 1=müşteri · 2=fiş listesi · 3=fiş içeriği (plan-17)
    private int _lvl = 1;
    private CustomerRow? _selMusteri;
    private FisRow? _selFis;
    private IReadOnlyList<FisRow> _fisler = [];
    private IReadOnlyList<FisIcerikRow> _fisIcerik = [];
    private string _modalBaslik => _lvl switch
    {
        2 => $"{_selMusteri?.Ad} — {(_selKanal == "yk" ? "Fişler" : "Siparişler")}",
        3 => $"{(_selKanal == "yk" ? "Fiş" : "Sipariş")} #{_selFis?.Ref}",
        _ => $"{_selSeg} — Müşteri Listesi (ilk 100, harcamaya göre)",
    };

    // Müşteri satır-genişlet → fişleri gör + iç kart işaretle (plan-16/17).
    private RenderFragment<CustomerRow> MusteriDetay => c => @<div class="pt-2 flex flex-wrap gap-2">
        <button class="btn btn-xs btn-primary gap-1" @onclick="() => OpenFisler(c)">
            <i data-lucide="receipt" class="w-3 h-3"></i>@(_selKanal == "yk" ? "Fişlerini gör" : "Siparişlerini gör")
        </button>
        @if (_selKanal == "yk")
        {
            <button class="btn btn-xs btn-error btn-outline gap-1" @onclick="() => IcKartIsaretle(c)">
                <i data-lucide="store" class="w-3 h-3"></i>İç/mağaza kartı — RFM'den çıkar
            </button>
        }
    </div>;

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);
        _dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
        _icKartlar = IcKart.Yukle();
        if (AppState.TryTakeFromJson<List<RfmSegment>>("mus_yk", out var yk) &&
            AppState.TryTakeFromJson<List<RfmSegment>>("mus_et", out var et) &&
            AppState.TryTakeFromJson<MusteriStat>("mus_stat", out var stat))
        {
            _yk = yk ?? []; _et = et ?? []; _stat = stat;
            if (AppState.TryTakeFromJson<List<MusteriKazanim>>("mus_kazet", out var ke)) _kazEt = ke ?? [];
            if (AppState.TryTakeFromJson<List<KohortRow>>("mus_kohort", out var ko)) _kohort = ko ?? [];
            if (AppState.TryTakeFromJson<List<LtvOzet>>("mus_ltv", out var ltv)) _ltv = ltv ?? [];
            if (AppState.TryTakeFromJson<ChurnOzet>("mus_churn", out var ch)) _churn = ch;
            _kartData = _stat?.KartOran ?? [];
            _loading = false; StateHasChanged();
            return;
        }
        var sw = PerfState.Start();
        try
        {
            var tRfm   = Ref.GetRfmAsync(_dun);
            var tStat  = Ref.GetMusteriStatAsync(_dun);
            var tKazEt = Ref.GetKazanimEtAsync(_dun);
            var tKohort= Ref.GetKohortAsync(_dun);
            var tLtv   = Ref.GetLtvAsync(_dun);
            var tChurn = Ref.GetChurnAsync(_dun);
            await Task.WhenAll(tRfm, tStat, tKazEt, tKohort, tLtv, tChurn);
            (_yk, _et) = tRfm.Result;
            _stat = tStat.Result;
            _kazEt = tKazEt.Result;
            _kohort = tKohort.Result;
            _ltv = tLtv.Result;
            _churn = tChurn.Result;
            _kartData = _stat?.KartOran ?? [];
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; Perf.Report("Müşteri", sw); StateHasChanged(); }
    }

    private Task PersistData()
    {
        AppState.PersistAsJson("mus_yk", _yk);
        AppState.PersistAsJson("mus_et", _et);
        if (_stat is not null) AppState.PersistAsJson("mus_stat", _stat);
        AppState.PersistAsJson("mus_kazet", _kazEt);
        AppState.PersistAsJson("mus_kohort", _kohort);
        AppState.PersistAsJson("mus_ltv", _ltv);
        if (_churn is not null) AppState.PersistAsJson("mus_churn", _churn);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_yk.Count > 0 || _et.Count > 0)
        {
            try
            {
                var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
                await charts.InvokeVoidAsync("heroDots", "mskpi", "mskpiDots");
            }
            catch { /* prerender — sonraki render'da bağlanır */ }
        }
    }

    // R-1: kazanım grafiğinde ay tıklanınca detay yükle.
    private async Task SeçAy(MusteriKazanim k)
    {
        if (_selKazAy == k.Ay) { _selKazAy = null; _kazDetay = []; return; }  // toggle kapat
        _selKazAy = k.Ay;
        _kazDetayLoading = true;
        StateHasChanged();
        try
        {
            _kazDetay = await Ref.GetKazanimDetayAsync(k.Ay);
        }
        catch (Exception ex) { Logger.LogError(ex, "Kazanım detay yükleme hatası"); _kazDetay = []; }
        finally { _kazDetayLoading = false; StateHasChanged(); }
    }

    // R-2: kart oranı dönem pill değiştir.
    private async Task DeğişKartGun(int gun)
    {
        if (_kartGun == gun) return;
        _kartGun = gun;
        _kartLoading = true;
        StateHasChanged();
        try { _kartData = await Ref.GetKartOranAsync(_dun, gun); }
        catch (Exception ex) { Logger.LogError(ex, "Kart oranı yükleme hatası"); }
        finally { _kartLoading = false; StateHasChanged(); }
    }

    private async Task OpenDrill(string kanal, string seg)
    {
        // Yalnız gerçek RFM segmentleri drill açar (6-Diğer vb. atlanır)
        if (seg.StartsWith("6")) return;
        _selKanal = kanal; _selSeg = seg; _icKart = false; _lvl = 1;
        _modalOpen = true;
        await ReloadCustomersAsync();
    }

    // Drill katman 3: müşteri → fiş/sipariş listesi (plan-17)
    private async Task OpenFisler(CustomerRow c)
    {
        _selMusteri = c; _lvl = 2; _drillLoading = true; _fisler = []; StateHasChanged();
        try { _fisler = await Ref.GetFislerAsync(_selKanal, c.Id); }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _drillLoading = false; StateHasChanged(); }
    }

    // Drill katman 4: fiş → içerik (plan-17)
    private async Task OpenIcerik(FisRow f)
    {
        _selFis = f; _lvl = 3; _drillLoading = true; _fisIcerik = []; StateHasChanged();
        try { _fisIcerik = long.TryParse(f.Ref, out var rid) ? await Ref.GetFisIcerikAsync(_selKanal, rid) : []; }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _drillLoading = false; StateHasChanged(); }
    }

    private void GeriDrill() { if (_lvl > 1) _lvl--; }

    private async Task ReloadCustomersAsync()
    {
        _drillLoading = true; _drill = []; StateHasChanged();
        try
        {
            _drill = _selKanal == "yk"
                ? await Ref.GetYkCustomersAsync(_selSeg, _dun, _icKart)
                : await Ref.GetEtCustomersAsync(_selSeg, _dun);
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _drillLoading = false; StateHasChanged(); }
    }

    private async Task IcKartIsaretle(CustomerRow c)
    {
        if (c.Id <= 0) return;
        IcKart.Ekle(c.Id, c.Ad);
        (_yk, _et) = await Ref.GetRfmAsync(_dun);   // segment toplamları güncellensin
        _icKartlar = IcKart.Yukle();
        await ReloadCustomersAsync();               // drill'den de çıksın
    }

    private async Task IcKartGeriAl(long id)
    {
        IcKart.Sil(id);
        (_yk, _et) = await Ref.GetRfmAsync(_dun);
        _icKartlar = IcKart.Yukle();
        StateHasChanged();
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    private static string AyAd(string yyyyMM) =>
        DateTime.ParseExact(yyyyMM + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            .ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
