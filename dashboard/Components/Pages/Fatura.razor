@page "/fatura"
@using GmDashboard.Data
@using GmDashboard.Models
@inject MuhasebeQueries Muh
@inject NavigationManager Nav
@inject ILogger<Fatura> Logger
@rendermode InteractiveServer

<PageTitle>Fatura — BKM GM</PageTitle>

<div class="mb-4 flex items-center gap-3">
    <button class="btn btn-ghost btn-sm" @onclick="@(() => Nav.NavigateTo("/muhasebe"))">← Kontrol</button>
    <div>
        <div class="text-xs text-base-content/50">Gider / masraf faturası · dbo.fat</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">@(_fat is null ? "Fatura" : $"Fatura {_fat.EvrakNo} · {_fat.Tarih}")</h1>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-error text-sm mb-4"><span>@_error</span></div>
}
else if (_loading)
{
    <p class="text-base-content/40 text-sm py-6 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Fatura yükleniyor…</p>
}
else if (_fat is null)
{
    <div class="alert text-sm"><span>Fatura bulunamadı (eID @Fat).</span></div>
}
else
{
    <div class="bg-base-100 border-2 border-base-300 rounded-lg shadow-sm max-w-4xl mx-auto overflow-hidden">
        @* ── Antet ── *@
        <div class="flex items-start justify-between gap-4 px-6 py-4 border-b-2 border-base-300 bg-base-200/40">
            <div>
                <div class="text-lg font-bold tracking-tight">BKM Kitap Kırtasiye</div>
                <div class="text-xs text-base-content/60">Gider / Masraf Faturası (Tip @_fat.Tip)</div>
            </div>
            <div class="text-right">
                <table class="text-xs border border-base-300">
                    <tr class="border-b border-base-300"><td class="px-2 py-0.5 bg-base-200/60 font-semibold border-r border-base-300">Fatura No</td><td class="px-2 py-0.5 font-mono text-right">@_fat.EvrakNo</td></tr>
                    <tr><td class="px-2 py-0.5 bg-base-200/60 font-semibold border-r border-base-300">Tarih</td><td class="px-2 py-0.5 font-mono text-right">@_fat.Tarih</td></tr>
                </table>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_fat.CariAd))
        {
            <div class="px-6 py-3 border-b border-base-200 flex items-baseline gap-2">
                <span class="text-xs text-base-content/50 uppercase tracking-wide">Satıcı / Cari</span>
                <span class="font-semibold">@_fat.CariAd</span>
                @if (!string.IsNullOrWhiteSpace(_fat.CariKod)) { <span class="text-xs font-mono text-base-content/50">@_fat.CariKod</span> }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_fat.Not))
        {
            <div class="px-6 py-2 text-sm text-base-content/70 border-b border-base-200">Not: <span class="font-medium text-base-content">@_fat.Not</span></div>
        }

        @* ── Kalemler ── *@
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-base-200/50 text-xs text-base-content/60 border-b-2 border-base-300">
                    <th class="text-left px-3 py-2 border-r border-base-300 w-[120px]">Kod</th>
                    <th class="text-left px-3 py-2 border-r border-base-300">Kalem / Ürün</th>
                    <th class="text-right px-3 py-2 border-r border-base-300 w-[80px]">Miktar</th>
                    <th class="text-right px-3 py-2 border-r border-base-300 w-[120px]">Tutar</th>
                    <th class="text-right px-3 py-2 w-[110px]">KDV</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in _fat.Satirlar)
            {
                <tr class="border-b border-base-200 align-top">
                    <td class="px-3 py-1.5 font-mono text-xs whitespace-nowrap border-r border-base-200">@s.Kod</td>
                    <td class="px-3 py-1.5 border-r border-base-200">@s.Urun</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono border-r border-base-200">@Num(s.Adet)</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono border-r border-base-200">@Tl(s.Tutar)</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono @(s.Kdv == 0 ? "text-base-content/20" : "")">@(s.Kdv != 0 ? Tl(s.Kdv) : "")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="border-t border-base-200 font-medium">
                    <td colspan="3" class="px-3 py-1.5 text-right border-r border-base-200 text-base-content/60">Ara Toplam / KDV</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono border-r border-base-200">@Tl(_fat.ToplamTutar)</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono">@Tl(_fat.ToplamKdv)</td>
                </tr>
                <tr class="border-t-2 border-base-300 bg-base-200/40 font-bold">
                    <td colspan="4" class="px-3 py-2 text-right border-r border-base-300">GENEL TOPLAM</td>
                    <td class="px-3 py-2 text-right tabular-nums font-mono">@Tl(_fat.GenelToplam)</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "fat")] public int Fat { get; set; }

    private Models.Fatura? _fat;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        try { _fat = await Muh.GetFaturaAsync(Fat); }
        catch (Exception ex) { Logger.LogError(ex, "Fatura yüklenemedi (eID {Fat})", Fat); _error = $"Yüklenemedi: {ex.Message}"; }
        finally { _loading = false; }
    }

    private static string Tl(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    private static string Num(decimal v) => v.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
