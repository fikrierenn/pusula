@using GmDashboard.Data
@using GmDashboard.Models

@* Satış Analizi ürün tablosu + KULLANICI SEÇMELİ KOLONLAR (plan-42).
   Ayrı bileşen: .razor split = sub-component (code-behind DEĞİL — markup RenderFragment
   içeren @code düz C#'ta derlenmez, file-size-discipline notu). *@

<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px]">
    <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-sm font-semibold m-0">Ürün Listesi</h3>
            <span class="text-xs text-base-content/50">@Sonuc.ToplamSatir.ToString("N0") çeşit</span>
            @if (SiraliGizli is not null)
            {
                @* Sıraladığı kolonu gizlemek SESSİZ kalmaz (Solum'un ölçtüğü tuzak):
                   sıralama devam eder ama görünür bir çip söyler. *@
                <button class="badge badge-warning badge-sm gap-1" @onclick="SiraliKolonuGeriGetir"
                        title="Bu kolona göre sıralı ama kolon gizli — tıkla, geri getir">
                    sıralama: @SiraliGizli (gizli)
                </button>
            }
        </div>
        <div class="flex items-center gap-2">
            <div class="dropdown dropdown-end">
                <button tabindex="0" class="btn btn-xs btn-ghost border-base-300 gap-1">
                    Kolonlar (@Secili.Count/@SatisAnaliziKolonlar.Hepsi.Count)
                </button>
                <div tabindex="0" class="dropdown-content z-[20] mt-1 w-72 max-h-96 overflow-y-auto
                                         bg-base-100 border border-base-300 rounded-xl shadow-lg p-2">
                    <div class="flex items-center justify-between px-1 pb-2 border-b border-base-200 mb-1">
                        <span class="text-xs font-semibold">Görünür kolonlar</span>
                        <button class="btn btn-ghost btn-xs" @onclick="Varsayilana">varsayılan</button>
                    </div>
                    @foreach (var k in SatisAnaliziKolonlar.Hepsi)
                    {
                        <label class="flex items-start gap-2 px-1 py-1 rounded hover:bg-base-200 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-xs mt-0.5"
                                   checked="@Secili.Contains(k.Anahtar)"
                                   @onchange="e => KolonDegis(k.Anahtar, (bool?)e.Value == true)" />
                            <span class="text-xs leading-tight">
                                @k.Baslik
                                @if (k.Ipucu is not null)
                                {
                                    <span class="block text-base-content/40">@k.Ipucu</span>
                                }
                            </span>
                        </label>
                    }
                </div>
            </div>
            @* ⚠ ExcelButton DEĞİL: o bileşen dosyayı base64'e çevirip circuit'ten geçiriyor ve
               275 bin satırda circuit ÇÖKÜYOR (JSDisconnectedException — ölçüldü 09.09; çöken
               circuit sayfayı tümden ölü bırakıyor, satır tıklama bile çalışmıyor).
               Doğrudan indirme bağlantısı: dosya akışta üretilir, boyut sınırı yok. *@
            @* Boyut/süre ÖLÇÜLDÜ 09.09: filtresiz 275.059 satır → 37,4 MB / 22 saniye.
               Kullanıcı ne beklediğini bilsin — sessiz 22 saniye "çalışmadı" gibi okunuyor. *@
            <a class="btn btn-sm btn-outline gap-1" href="@ExcelBaglantisi" target="_blank"
               rel="noopener"
               title="@($"Filtredeki {Sonuc?.ToplamSatir ?? 0:N0} satırın tamamı inecek" + (Sonuc?.ToplamSatir > 50_000 ? " — büyük dosya, 20 saniyeyi aşabilir" : ""))">
                Excel
                @if (Sonuc?.ToplamSatir > 50_000)
                {
                    <span class="text-[10px] opacity-70">@((Sonuc.ToplamSatir / 1000)) bin satır</span>
                }
            </a>
        </div>
    </div>

    @if (Sonuc.SayfaAsildi)
    {
        <div class="alert alert-warning text-sm">
            Bu sayfada kayıt yok ama filtreye uyan @Sonuc.ToplamSatir.ToString("N0") çeşit var.
            <button class="btn btn-xs" @onclick="() => SayfaDegis(1)">Başa dön</button>
        </div>
    }
    else if (Sonuc.Bos)
    {
        <p class="text-sm text-base-content/50 py-6 text-center">Filtreye uyan ürün yok.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table table-xs w-full">
                <thead>
                    <tr class="text-base-content/50">
                        @foreach (var k in GorunurKolonlar)
                        {
                            <th class="@(k.Sayisal ? "text-right" : "")">
                                @if (k.Siralanabilir)
                                {
                                    <button class="link link-hover" @onclick="() => SiralaDegis(k.Anahtar)">
                                        @k.Baslik@(Filtre.Sirala == k.Anahtar ? (Filtre.Azalan ? " ↓" : " ↑") : "")
                                    </button>
                                }
                                else
                                {
                                    @k.Baslik
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Sonuc.Satirlar)
                    {
                        <tr class="hover cursor-pointer" @onclick="() => SatirTikla.InvokeAsync(s.StkId)"
                            title="Ürün detayına git">
                            @foreach (var k in GorunurKolonlar)
                            {
                                <td class="@(k.Sayisal ? "text-right font-mono" : "")">@Hucre(s, k.Anahtar)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between gap-2 mt-3 flex-wrap">
            <span class="text-xs text-base-content/50">
                sayfa @Sonuc.Sayfa / @Sonuc.SayfaSayisi.ToString("N0")
            </span>
            <div class="join">
                <button class="btn btn-xs join-item" disabled="@(Sonuc.Sayfa <= 1)"
                        @onclick="() => SayfaDegis(1)">«</button>
                <button class="btn btn-xs join-item" disabled="@(Sonuc.Sayfa <= 1)"
                        @onclick="() => SayfaDegis(Sonuc.Sayfa - 1)">‹</button>
                <button class="btn btn-xs join-item btn-ghost pointer-events-none">@Sonuc.Sayfa</button>
                <button class="btn btn-xs join-item" disabled="@(Sonuc.Sayfa >= Sonuc.SayfaSayisi)"
                        @onclick="() => SayfaDegis(Sonuc.Sayfa + 1)">›</button>
                <button class="btn btn-xs join-item" disabled="@(Sonuc.Sayfa >= Sonuc.SayfaSayisi)"
                        @onclick="() => SayfaDegis(Sonuc.SayfaSayisi)">»</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SayfaSonucu<SatisAnaliziSatir> Sonuc { get; set; } = default!;
    [Parameter, EditorRequired] public SatisAnaliziFiltre Filtre { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlySet<string> Secili { get; set; } = default!;
    [Parameter] public EventCallback<IReadOnlySet<string>> SeciliDegisti { get; set; }
    [Parameter] public EventCallback<SatisAnaliziFiltre> FiltreDegisti { get; set; }
    [Parameter] public string ExcelBaglantisi { get; set; } = "";
    /// <summary>Satıra tıklanınca ürün drill sayfasına git (kullanıcı isteği 09.09).</summary>
    [Parameter] public EventCallback<int> SatirTikla { get; set; }

    private IEnumerable<KolonTanim> GorunurKolonlar =>
        SatisAnaliziKolonlar.Hepsi.Where(k => Secili.Contains(k.Anahtar));

    /// <summary>Sıralanan kolon gizliyse başlığı; değilse null.</summary>
    private string? SiraliGizli =>
        !Secili.Contains(Filtre.Sirala) ? SatisAnaliziKolonlar.Bul(Filtre.Sirala)?.Baslik : null;

    private async Task KolonDegis(string anahtar, bool acik)
    {
        var yeni = new HashSet<string>(Secili, StringComparer.OrdinalIgnoreCase);
        if (acik) yeni.Add(anahtar); else yeni.Remove(anahtar);
        if (yeni.Count == 0) return;   // kolonsuz tablo çizilmez
        await SeciliDegisti.InvokeAsync(yeni);
    }

    private Task Varsayilana() =>
        SeciliDegisti.InvokeAsync(new HashSet<string>(
            SatisAnaliziKolonlar.VarsayilanAnahtarlar, StringComparer.OrdinalIgnoreCase));

    private async Task SiraliKolonuGeriGetir()
    {
        var yeni = new HashSet<string>(Secili, StringComparer.OrdinalIgnoreCase) { Filtre.Sirala };
        await SeciliDegisti.InvokeAsync(yeni);
    }

    private Task SiralaDegis(string anahtar) => FiltreDegisti.InvokeAsync(
        Filtre with { Sirala = anahtar, Azalan = Filtre.Sirala == anahtar ? !Filtre.Azalan : true, Sayfa = 1 });

    private Task SayfaDegis(int sayfa) => FiltreDegisti.InvokeAsync(Filtre with { Sayfa = sayfa });

    /// <summary>
    /// Hücre metni — ORTAK eşlemeden (<see cref="GmDashboard.Data.SatisAnaliziHucre"/>).
    ///
    /// ⚠ ÖNCE BURADA YEREL BİR KOPYA VARDI VE BAYATLAMIŞTI (düzeltildi 10.09.2026).
    /// Excel ortak eşlemeyi kullanıyordu, ekran bu kopyayı — ikisi çatallandı: kopyada
    /// `sonsatis` hiç yoktu ve yeni `talepdeseni` / `satanay` kolonları `_ => ""` dalına
    /// düşüp ekranda BOŞ görünüyordu (Excel'de doğru geliyordu). Kolon eklenince iki yeri
    /// güncellemek gerektiği hiçbir yerde yazılı değildi → sessiz boş kolon.
    /// `emitter-ayrimi.md`: tek hesap çekirdeği, çoklu emitter — biçim tek yerde.
    /// </summary>
    private static string Hucre(SatisAnaliziSatir s, string anahtar) =>
        GmDashboard.Data.SatisAnaliziHucre.Metin(s, anahtar);
}
