@page "/envanter"
@using GmDashboard.Data
@using GmDashboard.Models
@inject RefQueries Ref
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Envanter — BKM GM</PageTitle>
<div class="flex items-center gap-3 mb-5 flex-wrap"><h1 class="text-2xl font-bold tracking-tight m-0">Envanter & Merchandising</h1>
    <span class="text-sm font-semibold text-base-content/50">stok: anlık · ciro/devir: geçen tam ay · stockout: son 30 gün</span></div>

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor… (envanter sorguları ağır, birkaç saniye)</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_d is not null)
{
    <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-3 mb-4 max-sm:grid-cols-2">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl px-5 py-4"><div class="text-[11px] font-bold uppercase tracking-wide text-base-content/50">Envanter Değeri (Ort.Maliyet)</div><div class="text-[25px] font-extrabold tracking-tight my-1">@Tl(_d.ToplamDeger)</div>
            <div class="text-[12.5px] text-base-content/60">Dergi/Sınav hariç · son snapshot</div></div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">En Hızlı Dönen Kategoriler (yıllık devir)</h3>
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>Kategori</b></td><td class="text-right"><b>Devir</b></td></tr>
                @foreach (var d in _d.Devir.Take(6))
                {
                    <tr class="cursor-pointer hover:bg-primary/5" @onclick="() => OpenUrun(d.Kategori)"><td>@d.Kategori ▸</td><td class="text-right">@d.Devir.ToString("0.0")x</td></tr>
                }
            </table>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Ölü Sermaye — Kilitli Stok (anlık stok, en yüksek ₺)</h3>
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>Kategori</b></td><td class="text-right"><b>Stok ₺</b></td><td class="text-right"><b>Devir</b></td></tr>
                @foreach (var d in _d.Devir.OrderByDescending(x => x.StokTl).Take(6))
                {
                    <tr class="cursor-pointer hover:bg-primary/5" @onclick="() => OpenUrun(d.Kategori)"><td>@d.Kategori ▸</td><td class="text-right">@Tl(d.StokTl)</td>
                        <td class="text-right @(d.Devir < 1.5m ? "text-error" : "text-success")">@d.Devir.ToString("0.0")x</td></tr>
                }
            </table>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">ABC — Ciro Yoğunluğu (Pareto 80/20, geçen ay)</h3>
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>Sınıf</b></td><td class="text-right"><b>Ürün çeşidi</b></td><td class="text-right"><b>Ciro</b></td></tr>
                @foreach (var a in _d.Abc)
                {
                    <tr><td>@AbcAd(a.Sinif)</td><td class="text-right">@Num(a.Adet)</td><td class="text-right">@Tl(a.Ciro)</td></tr>
                }
            </table>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Stokta Yokluk — Son 30g Satılanlarda (hedef &lt;%5)</h3>
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>Kategori</b></td><td class="text-right"><b>Çeşit</b></td><td class="text-right"><b>Yok</b></td><td class="text-right"><b>%</b></td></tr>
                @foreach (var s in _d.Stockout.Take(7))
                {
                    <tr class="cursor-pointer hover:bg-primary/5" @onclick="() => OpenUrun(s.Kategori)"><td>@s.Kategori ▸</td><td class="text-right">@Num(s.Cesit)</td><td class="text-right">@Num(s.Yok)</td>
                        <td class="text-right @(s.Pct > 5 ? "text-error" : "text-success")">%@s.Pct.ToString("0.0")</td></tr>
                }
            </table>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Ciro ↔ Envanter Dengesi (kategori, geçen ay ciro vs güncel stok değeri)</h3>
            <div class="relative h-[220px]"><canvas id="ch_cve"></canvas></div>
            <div class="text-base-content/50 text-[11px]">X = aylık ciro, Y = stok değeri (3 mağaza). Sağ-alt = çok satan/az stok (iyi); sol-üst = az satan/çok stok (ölü sermaye riski).</div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">En Çok Satan Marka / Yayınevi — Top 20 (geçen ay)</h3>
            <div class="grid grid-cols-2 max-md:grid-cols-1 gap-x-7">
                @MarkaTbl(_d.Marka.Take(10), 1)
                @MarkaTbl(_d.Marka.Skip(10).Take(10), 11)
            </div>
        </div>
    </div>

    <Modal @bind-Open="_modalUrun" Title="@(_selKat + " — Ürünler (ilk 100, satışa göre)")">
        @if (_urunLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else
        {
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>#</b></td><td><b>Kod</b></td><td><b>Ürün</b></td><td class="text-right"><b>Satış (adet)</b></td><td class="text-right"><b>Ciro</b></td><td class="text-right"><b>Bakiye</b></td></tr>
                @{ var i = 1; }
                @foreach (var u in _urunler)
                {
                    <tr><td class="text-base-content/40">@i</td><td>@u.Kod</td><td>@u.Ad</td><td class="text-right">@Num(u.Satis)</td><td class="text-right">@Tl(u.Ciro)</td>
                        <td class="text-right @(u.Bakiye <= 0 ? "text-error" : "")">@Num(u.Bakiye)</td></tr>
                    i++;
                }
                @if (_urunler.Count == 0)
                {
                    <tr><td colspan="6" class="text-base-content/50">Ürün bulunamadı.</td></tr>
                }
            </table>
        }
    </Modal>
}

@code {
    private bool _loading = true;
    private string? _error;
    private InventoryData? _d;
    private IReadOnlyList<CveRow> _cve = [];
    private IJSObjectReference? _charts;

    private bool _modalUrun;
    private bool _urunLoading;
    private string _selKat = "";
    private IReadOnlyList<UrunRow> _urunler = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            _d = await Ref.GetInventoryAsync(dun);
            _cve = await Ref.GetCveAsync(dun);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); await DrawAsync(); }
    }

    private async Task DrawAsync()
    {
        if (_cve.Count == 0) return;
        try
        {
            _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _charts.InvokeVoidAsync("scatter", "ch_cve",
                _cve.Select(c => c.Kategori), _cve.Select(c => c.Ciro), _cve.Select(c => c.Env));
        }
        catch { /* ilk prerender — sonraki render'da çizilir */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _d is not null) await DrawAsync();
    }

    private async Task OpenUrun(string kategori)
    {
        _selKat = kategori; _modalUrun = true; _urunLoading = true; _urunler = []; StateHasChanged();
        try { _urunler = await Ref.GetUrunlerAsync(kategori); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _urunLoading = false; StateHasChanged(); }
    }

    private RenderFragment MarkaTbl(IEnumerable<MarkaRow> rows, int start) => @<table class="table table-sm w-full text-[13px]">
        <tr><td><b>#</b></td><td><b>Marka / Yayınevi</b></td><td class="text-right"><b>Ciro</b></td><td class="text-right"><b>Çeşit</b></td><td class="text-right"><b>Ciro/Çeşit</b></td></tr>
        @{ var i = start; }
        @foreach (var m in rows)
        {
            <tr><td class="text-base-content/40">@i</td><td>@m.Ad</td><td class="text-right">@Tl(m.Ciro)</td><td class="text-right">@Num(m.Cesit)</td>
                <td class="text-right">@Tl(m.Cesit > 0 ? m.Ciro / m.Cesit : 0)</td></tr>
            i++;
        }
    </table>;

    private static string AbcAd(string s) => s switch
    {
        "A" => "A — çok satan (ilk %80)",
        "B" => "B — orta (%80-95)",
        "C" => "C — uzun kuyruk (son %5)",
        _ => s,
    };

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
