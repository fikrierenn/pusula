@page "/envanter"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject RefQueries Ref
@inject AyarService Ayar
@inject PerfState Perf
@inject IJSRuntime JS
@inject ILogger<Envanter> Logger
@inject PersistentComponentState AppState
@inject NavigationManager Nav
@rendermode InteractiveServer
@attribute [StreamRendering]
@* B-74: marj (~9s, kanonik maliyet şelalesi) prerender'ı bloklamasın — sayfa WhenAll grubuyla (~1.1s) hemen
   stream'lenir, marj sonradan eklenir. Mobil HTTP'de de çalışır (SignalR gerektirmez, chunked response). *@

<PageTitle>Envanter — BKM GM</PageTitle>
<div class="flex items-center gap-3 mb-5 flex-wrap"><h1 class="text-2xl font-bold tracking-tight m-0">Envanter & Merchandising</h1>
    <span class="text-sm font-semibold text-base-content/50">stok: anlık · ciro/devir: geçen tam ay · stockout: son 30 gün</span></div>

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor… (envanter sorguları ağır, birkaç saniye)</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_d is not null)
{
    <AppKpiCarousel Id="envkpi" Items="@(new List<KpiCardData>
    {
        new("Envanter Değeri", Tl(_d.ToplamDeger), "from-primary to-primary/80", "ort.maliyet · Dergi/Sınav hariç"),
        new("Ort. Devir Hızı", _d.Devir.Count > 0 ? (_d.Devir.Average(x => x.Devir).ToString("0.0") + "x") : "—", "from-info to-info/80", "yıllık devir hızı"),
        new("Stokta Yokluk", _d.Stockout.Count > 0 ? ("%" + _d.Stockout.Average(x => x.Pct).ToString("0.0")) : "—", "from-warning to-warning/80", $"satılanlarda (hedef <%{Ayar.Deger.StokYoklukHedef:0.#})"),
        new("Ölü Stok", Tl(_d.Devir.Where(x => x.Devir < Ayar.Deger.DevirOlu).Sum(x => x.StokTl)), "from-error to-error/80", $"devir<{Ayar.Deger.DevirOlu:0.#}x kilitli ₺", EventCallback.Factory.Create(this, AcOluStok)),
    })" />

    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mb-3 overflow-x-auto">
        <h3 class="text-sm font-semibold text-base-content/90 mb-3">Anlık Stok Dağılımı — Mağaza Bazlı</h3>
        <table class="table table-xs w-full">
            <thead><tr class="text-base-content/50">
                <th></th><th class="text-right">FSM</th><th class="text-right">Özlüce</th><th class="text-right">İst.Yolu</th><th class="text-right">Merkez Depo</th><th class="text-right font-bold">Toplam</th>
            </tr></thead>
            <tbody>
                <tr class="font-semibold border-b border-base-200">
                    <td class="text-base-content/60 text-xs">Toplam Stok (₺)</td>
                    <td class="text-right font-mono">@Tl(_d.FsmStok)</td>
                    <td class="text-right font-mono">@Tl(_d.OzluceStok)</td>
                    <td class="text-right font-mono">@Tl(_d.IstYoluStok)</td>
                    <td class="text-right font-mono">@Tl(_d.DepoStok)</td>
                    <td class="text-right font-mono font-bold">@Tl(_d.FsmStok + _d.OzluceStok + _d.IstYoluStok + _d.DepoStok)</td>
                </tr>
                @if (_d.KategoriStok is { Count: > 0 } kstok)
                {
                    @foreach (var k in kstok)
                    {
                    <tr class="hover:bg-base-200/40">
                        <td class="text-base-content/70 text-xs pl-3">@k.Kategori</td>
                        <td class="text-right font-mono text-xs">@Tl(k.Fsm)</td>
                        <td class="text-right font-mono text-xs">@Tl(k.Ozluce)</td>
                        <td class="text-right font-mono text-xs">@Tl(k.IstYolu)</td>
                        <td class="text-right font-mono text-xs">@Tl(k.Depo)</td>
                        <td class="text-right font-mono text-xs font-medium">@Tl(k.Toplam)</td>
                    </tr>
                    }
                }
            </tbody>
        </table>
        <div class="text-base-content/40 text-[11px] mt-2">Anlık snapshot · Ort.Maliyet · Dergi/Sınav hariç</div>
    </div>

    @if (_d.Trend is { Count: > 0 } trend)
    {
    <div class="grid grid-cols-1 gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-2">Mağaza Bazlı Stok Değeri Seyri — Son 12 Ay (₺, Ort.Maliyet, ay sonu)</h3>
            <AppMultiLineChart TItem="EnvanterAyRow"
                Series="@(new AppMultiLineChart<EnvanterAyRow>.SeriesSpec[] {
                    new("FSM",         trend, r => r.Fsm),
                    new("Özlüce",      trend, r => r.Ozluce),
                    new("İst.Yolu",    trend, r => r.IstYolu),
                    new("Merkez Depo", trend, r => r.Depo),
                })"
                XValue="@(r => (object)r.Ay)"
                Height="240" />
            <div class="text-base-content/50 text-[11px] mt-1">Dergi/Sınav hariç · İst.Yolu 2026'daki artış: Sınav Okulları stoğu · ENVANTER_RAPORU gece job'ı</div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-2">Mağaza Bazlı Stok Adet Seyri — Son 12 Ay (adet, ay sonu)</h3>
            <AppMultiLineChart TItem="EnvanterAyRow"
                Series="@(new AppMultiLineChart<EnvanterAyRow>.SeriesSpec[] {
                    new("FSM",         trend, r => r.FsmAdet),
                    new("Özlüce",      trend, r => r.OzluceAdet),
                    new("İst.Yolu",    trend, r => r.IstYoluAdet),
                    new("Merkez Depo", trend, r => r.DepoAdet),
                })"
                XValue="@(r => (object)r.Ay)"
                YFormatter="function(v){return v==null?'':Math.round(v).toLocaleString('tr-TR')}"
                Height="240" />
            <div class="text-base-content/50 text-[11px] mt-1">Dergi/Sınav hariç · ENVANTER_RAPORU gece job'ı</div>
        </div>
    </div>
    }

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">En Hızlı Dönen Kategoriler (yıllık devir)</h3>
            <AppRankBars TItem="DevirRow"
                         Items="@(_d.Devir.Take(6))"
                         Label="@(d => d.Kategori)"
                         Value="@(d => d.Devir)"
                         ValueText="@(d => $"{d.Devir:0.0}x")"
                         OnRowClick="@(d => OpenUrun(d.Kategori))" />
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Ölü Sermaye — Kilitli Stok (anlık stok, en yüksek ₺)</h3>
            <AppIconRow TItem="DevirRow"
                        Items="@(_d.Devir.OrderByDescending(x => x.StokTl).Take(6))"
                        Name="@(d => d.Kategori)"
                        Sub="@(d => $"devir {d.Devir:0.0}x")"
                        Amount="@(d => Tl(d.StokTl))"
                        Icon="@(_ => "lock")"
                        IconColor="@(d => d.Devir < Ayar.Deger.DevirOlu ? ("bg-error/10", "text-error") : d.Devir < Ayar.Deger.DevirSaglikli ? ("bg-warning/10", "text-warning") : ("bg-base-200", "text-base-content/60"))"
                        OnRowClick="@(d => OpenUrun(d.Kategori, olusSort: true))" />
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">ABC — Ciro Yoğunluğu (Pareto 80/20, geçen ay)</h3>
            <AppDataTable TItem="AbcClass"
                          Items="@(_d.Abc)"
                          Primary="@(a => AbcAd(a.Sinif))"
                          MetricMain="@(a => Tl(a.Ciro))"
                          MetricSub="@(a => $"{Num(a.Adet)} çeşit")"
                          Badge="@(a => a.Sinif switch { "A" => ("A", "badge bg-success/20 text-success"), "B" => ("B", "badge bg-warning/20 text-warning"), _ => ("C", "badge bg-base-200 text-base-content/60") })" />
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Stokta Yokluk — Son 30g Satılanlarda (hedef &lt;%5)</h3>
            <AppRankBars TItem="StockoutRow"
                         Items="@(_d.Stockout.Take(7))"
                         Label="@(s => s.Kategori)"
                         Value="@(s => s.Pct)"
                         ValueText="@(s => $"%{s.Pct:0.0} · {Num(s.Yok)}/{Num(s.Cesit)} çeşit")"
                         OnRowClick="@(s => OpenUrun(s.Kategori))" />
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">Kategori Devir Hızı — düşük = ölü stok riski (geçen ay ciro / güncel stok değeri)</h3>
            <AppRankBars TItem="CveRow"
                         Items="@(_cve.OrderBy(c => c.Env > 0 ? c.Ciro / c.Env : 0))"
                         Label="@(c => c.Kategori)"
                         Value="@(c => c.Env > 0 ? c.Ciro / c.Env : 0m)"
                         ValueText="@(c => $"{(c.Env > 0 ? c.Ciro / c.Env : 0m):0.0}x  ({Tl(c.Env)})")" />
            <div class="text-base-content/50 text-[11px] mt-2">Devir = dönem cirosu / stok değeri. Düşük = yavaş dönen stok. Parantezde güncel stok değeri (3 mağaza).</div>
        </div>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]"><h3 class="text-sm font-semibold text-base-content/90 mb-3.5 flex items-center gap-1.5">En Çok Satan Marka / Yayınevi — Top 20 (geçen ay)</h3>
            @{
                var markaTopTl = _d.Marka.Sum(m => m.Ciro);
            }
            <AppRankBars TItem="MarkaRow"
                         Items="@(_d.Marka.Take(20))"
                         Label="@(m => m.Ad)"
                         Value="@(m => m.Ciro)"
                         ValueText="@(m => $"{Tl(m.Ciro)} · %{(markaTopTl > 0 ? m.Ciro * 100 / markaTopTl : 0):0.0}")" />
        </div>
    </div>

    @if (_hc is not null)
    {
        var hcNet12 = _hc.ToplamSatilan12Ay - _hc.ToplamKullanilan12Ay;
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3">Hediye Çeki — Son 12 Ay</h3>
            <div class="flex flex-col gap-2">
                <div class="flex justify-between items-center"><span class="text-sm text-base-content/60">Satılan (POS)</span><span class="font-bold text-success">@Tl(_hc.ToplamSatilan12Ay)</span></div>
                <div class="flex justify-between items-center"><span class="text-sm text-base-content/60">Kullanılan (ödeme)</span><span class="font-bold text-warning">@Tl(_hc.ToplamKullanilan12Ay)</span></div>
                <div class="divider my-0"></div>
                <div class="flex justify-between items-center"><span class="text-sm font-semibold">Net Yükümlülük</span><span class="font-extrabold @(hcNet12 >= 0 ? "text-error" : "text-success")">@Tl(hcNet12)</span></div>
            </div>
            <div class="text-base-content/50 text-[11px] mt-3">Pozitif = henüz kullanılmamış çek (yükümlülük). EncoreMerkez POS bazlı · e-ticaret VOUCHERCODE hariç.</div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3">Aylık Satılan vs Kullanılan</h3>
            <AppDataTable TItem="HcAyRow" Items="@_hc.Aylar"
                          Primary="@(r => r.Ay)"
                          MetricMain="@(r => Tl(r.SatilanTL))"
                          MetricSub="@(r => $"kull. {Tl(r.KullanilanTL)}")"
                          Badge="@(r => r.SatilanTL >= r.KullanilanTL
                              ? ($"+{Tl(r.SatilanTL - r.KullanilanTL)}", "bg-error/10 text-error")
                              : ($"-{Tl(r.KullanilanTL - r.SatilanTL)}", "bg-success/10 text-success"))" />
        </div>
    </div>
    }

    @if (_marjLoading || _marj.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Kategori Brüt Marj — son 30g (kanonik maliyet: son 5 alış faturası)</h3>
            @if (_marjLoading)
            {
                <p class="text-base-content/40 text-sm py-4 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Marj hesaplanıyor… (maliyet şelalesi ağır, ~40s)</p>
            }
            else
            {
            <AppRankBars TItem="MarjRow"
                         Items="@_marj"
                         Label="@(r => r.Kategori)"
                         Value="@(r => r.MarjPct)"
                         ValueText="@(r => $"%{r.MarjPct:0.0}  ({Tl(r.Ciro - r.Smm)} / {Tl(r.Ciro)})")" />
            <div class="text-base-content/50 text-[11px] mt-2">Marj = (Ciro − SMM) / Ciro. SMM = kanonik maliyet (son 5 alış faturası → ORT_ALIS) × adet. Maliyet verisi yetersiz kategoriler hariç.</div>
            }
        </div>
    </div>
    }


    @if (_rot.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Marka Alış-Satış Dengesi — geçen ay, satış adedine göre Top 30</h3>
            <AppDataTable TItem="MarkaRotasyonRow"
                          Items="@_rot"
                          Primary="@(r => r.Marka)"
                          MetricMain="@(r => Tl(r.SatisCiro))"
                          MetricSub="@(r => $"sat. {Num(r.SatisAdet)} · alış {Num(r.AlisAdet)}")"
                          Badge="@(r => r.AlisAdet > r.SatisAdet
                              ? ($"+{Num(r.AlisAdet - r.SatisAdet)} birikim", "bg-warning/15 text-warning")
                              : ($"-{Num(r.SatisAdet - r.AlisAdet)} erime", "bg-info/15 text-info"))" />
            <div class="text-base-content/50 text-[11px] mt-2">Birikim = alış > satış (stok artıyor). Erime = satış > alış (stok azalıyor). irsHrk ehTip 4/100=satış, 0/10=alış.</div>
        </div>
    </div>
    }

    @if (_tedPerfLoading || _tedPerf.Count > 0)
    {
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0 [grid-column:span_2] max-[900px]:[grid-column:1/-1]">
            <h3 class="text-sm font-semibold text-base-content/90 mb-3.5">Tedarikçi / Yayınevi Performans — son 12 ay (sermaye verimliliği · Top 30 net ciro)</h3>
            @if (_tedPerfLoading)
            {
                <p class="text-base-content/40 text-sm py-4 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Marka devir/iade hesaplanıyor…</p>
            }
            else
            {
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead><tr>
                        <th>Marka / Yayınevi</th>
                        <th class="text-right">Net Ciro</th>
                        <th class="text-right">Stok</th>
                        <th class="text-right">Devir</th>
                        <th class="text-right">İade</th>
                        <th>Sinyal</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var r in _tedPerf)
                    {
                        double dOlu = (double)Ayar.Deger.DevirOlu, dSag = (double)Ayar.Deger.DevirSaglikli;
                        var devirCls = r.DevirHizi is null ? "text-info" : r.DevirHizi < dOlu ? "text-error" : r.DevirHizi < dSag ? "text-warning" : "text-success";
                        var iadeCls = r.IadeOrani > 0.10m ? "text-error font-semibold" : "text-base-content/60";
                        <tr>
                            <td class="font-medium">@r.Marka</td>
                            <td class="text-right">@Tl(r.NetCiro)</td>
                            <td class="text-right text-base-content/60">@Num(r.StokAdet)</td>
                            <td class="text-right font-bold @devirCls">@(r.DevirHizi is null ? "—" : $"{r.DevirHizi.Value:0.0}×")</td>
                            <td class="text-right @iadeCls">@($"%{r.IadeOrani * 100:0.0}")</td>
                            <td>
                                @if (r.DevirHizi is null)
                                {
                                    <span class="badge badge-sm badge-info">stok yok</span>
                                }
                                else if (r.DevirHizi < dOlu)
                                {
                                    <span class="badge badge-sm badge-error">sipariş kes</span>
                                }
                                else if (r.DevirHizi < dSag)
                                {
                                    <span class="badge badge-sm badge-warning">izle</span>
                                }
                                else
                                {
                                    <span class="badge badge-sm badge-success">sağlıklı</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="text-base-content/50 text-[11px] mt-2">Devir = son 12 ay satış adet / anlık stok adet. &lt;1,5× = sermaye tuzağı (sipariş kes), 1,5–3× izle, &gt;3× sağlıklı. İade oranı = iade tutar / brüt satış; &gt;%10 kırmızı. İç-operasyon (Sınav/BKM/Markasız) hariç.</div>
            }
        </div>
    </div>
    }

    <Modal @bind-Open="_modalOluStok" Title="Ölü Stok — 90g Satışsız Ürünler">
        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
            <span class="text-base-content/50 text-xs">Stok değeri büyük önce · S90=0 · YasGun≥90 · Dergi/Sınav/HC hariç</span>
            <a href="/api/olustok-excel" class="btn btn-xs btn-success gap-1" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Excel indir
            </a>
        </div>
        @if (_olusLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else
        {
            <div class="space-y-1">
                @foreach (var r in _olusRows)
                {
                    <div class="flex items-center justify-between gap-2 py-1.5 border-b border-base-200 cursor-pointer hover:bg-base-200/50 rounded px-1"
                         @onclick="() => AcStokHareket(r)">
                        <div class="min-w-0">
                            <div class="text-sm font-medium truncate">@r.Ad</div>
                            <div class="text-xs text-base-content/50">@r.Kategori · Kod @r.Kod · @r.YasGun gün listede</div>
                            <div class="text-xs text-base-content/40">FSM:@r.StokFsm Özl:@r.StokOzl İst:@r.StokIst Dep:@r.StokDepo</div>
                        </div>
                        <div class="text-right shrink-0">
                            <div class="font-bold text-error text-sm">@Tl(r.StokTl)</div>
                            <div class="text-xs text-base-content/50">@Num(r.Bakiye) adet</div>
                        </div>
                    </div>
                }
            </div>
            @if (_olusRows.Count < _olusToplam)
            {
                <div class="mt-3 flex justify-between items-center text-xs text-base-content/40">
                    <span>@_olusRows.Count / @_olusToplam ürün gösteriliyor</span>
                    <button class="btn btn-xs btn-outline" @onclick="OlusStokDahaFazla" disabled="@_olusYukleniyor">
                        @(_olusYukleniyor ? "Yükleniyor…" : "Daha fazla yükle")
                    </button>
                </div>
            }
            else if (_olusRows.Count > 0)
            {
                <div class="mt-3 text-xs text-base-content/40 text-center">Tüm @_olusToplam ürün listelendi</div>
            }
        }
    </Modal>

    <Modal @bind-Open="_modalUrun" Title="@(_selKat + (_olusSort ? " — Ölü Stok" : " — Ürünler"))">
        <div class="text-base-content/50 text-xs mb-2">
            @if (_olusSort)
            { <span>stok/90g satış oranı büyük önce · 3 mağaza + depo dahil · stok = güncel · yeni listelenenler (&lt;90g) hariç</span> }
            else
            { <span>3 mağaza toplam · geçen tam ay · satışa göre ilk 100 · stok = güncel</span> }
        </div>
        @if (_urunLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else
        {
            <AppDataTable TItem="UrunRow" Items="_urunler"
                          OnRowClick="AcStokHareketUrun"
                          Primary="@(u => u.Ad)"
                          Sub="@(u => $"Kod {u.Kod} · FSM:{u.StokFsm} Özl:{u.StokOzl} İst:{u.StokIst} Dep:{u.StokDepo}")"
                          MetricMain="@(u => Tl(u.Ciro))"
                          MetricSub="@(u => $"{Num(u.Satis)} ad · S30:{u.S30} S90:{u.S90} · {(u.YasGun >= 365 ? $"{u.YasGun / 365}y" : $"{u.YasGun}g")} listede")"
                          Badge="@(u => u.Bakiye <= 0
                              ? ($"stok 0", "bg-error/15 text-error")
                              : u.S90 == 0
                              ? ($"stok {Num(u.Bakiye)} · 90g sıfır", "bg-error/15 text-error")
                              : ($"stok {Num(u.Bakiye)} · {(u.Bakiye / (u.S90 / 90m)):0.0}g yeter", u.Bakiye / (u.S90 / 90m) > 180 ? "bg-warning/15 text-warning" : "bg-base-200 text-base-content/50"))" />
        }
    </Modal>
}

@code {
    private bool _loading = true;
    private string? _error;
    private InventoryData? _d;
    private IReadOnlyList<CveRow> _cve = [];
    private IReadOnlyList<MarjRow> _marj = [];
    private bool _marjLoading = true;   // marj ağır (~40s) → ana sayfadan ayrı, arka planda yüklenir
    private IReadOnlyList<MarkaRotasyonRow> _rot = [];
    private IReadOnlyList<TedarikciPerfRow> _tedPerf = [];
    private bool _tedPerfLoading = true;   // B-110: 12-ay marka taraması + stok, arka planda (~3s)
    private HcOzet? _hc;
    private bool _modalUrun;
    private bool _urunLoading;
    private bool _olusSort;   // true = ölü stok sıralaması (stok/S90 büyük önce)
    private string _selKat = "";
    private DateOnly _gAyBas, _gAyBit;   // ürün drill = "geçen tam ay" (sayfa ciro/devir scope'u)
    private IReadOnlyList<UrunRow> _urunler = [];

    private bool _modalOluStok;
    private bool _olusLoading;
    private bool _olusYukleniyor;
    private int _olusToplam;
    private readonly List<OluStokRow> _olusRows = [];

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);

        var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
        var ayBasi = new DateOnly(dun.Year, dun.Month, 1);
        _gAyBas = ayBasi.AddMonths(-1); _gAyBit = ayBasi;

        if (AppState.TryTakeFromJson<InventoryData>("env_d", out var inv) && inv is not null &&
            AppState.TryTakeFromJson<List<CveRow>>("env_cve", out var cve) &&
            AppState.TryTakeFromJson<HcOzet>("env_hc", out var hc) &&
            AppState.TryTakeFromJson<List<MarkaRotasyonRow>>("env_rot", out var rot))
        {
            _d = inv; _cve = cve ?? []; _hc = hc; _rot = rot ?? [];
            _loading = false; StateHasChanged();
        }
        else
        {
            var sw = PerfState.Start();
            try
            {
                var tInv  = Ref.GetInventoryAsync(dun);
                var tCve  = Ref.GetCveAsync(dun);
                var tHc   = Ref.GetHediyeCekiAsync();
                var tRot  = Ref.GetMarkaRotasyonAsync(_gAyBas, _gAyBit);
                await Task.WhenAll(tInv, tCve, tHc, tRot);
                _d    = tInv.Result;
                _cve  = tCve.Result;
                _hc   = tHc.Result;
                _rot  = tRot.Result;
            }
            catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
            finally { _loading = false; Perf.Report("Envanter", sw); StateHasChanged(); }
        }

        // Tedarikçi/yayınevi performans (B-110, ~3s) — marj'dan önce, hızlı görünsün.
        try { _tedPerf = await Ref.GetTedarikciPerformansAsync(DateOnly.FromDateTime(DateTime.Today).AddYears(-1), Ayar.Deger.HaricMarkalarEtkin); }
        catch (Exception ex) { Logger.LogWarning(ex, "Tedarikçi performans alınamadı — kart boş gösterilecek"); }
        finally { _tedPerfLoading = false; StateHasChanged(); }

        // Marj ağır (~40s, kanonik maliyet şelalesi) — sayfa açıldıktan SONRA arka planda yükle.
        try { _marj = await Ref.GetMarjAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Marj (maliyet şelalesi) alınamadı — marj kartı boş gösterilecek"); }  // B-85: sessiz değil
        finally { _marjLoading = false; StateHasChanged(); }
    }

    private Task PersistData()
    {
        if (_d is not null) AppState.PersistAsJson("env_d", _d);
        AppState.PersistAsJson("env_cve", (List<CveRow>)_cve.ToList());
        if (_hc is not null) AppState.PersistAsJson("env_hc", _hc);
        AppState.PersistAsJson("env_rot", (List<MarkaRotasyonRow>)_rot.ToList());
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_d is not null)
        {
            try
            {
                var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
                await charts.InvokeVoidAsync("heroDots", "envkpi", "envkpiDots");
            }
            catch { /* prerender — sonraki render'da bağlanır */ }
        }
    }

    private async Task AcOluStok()
    {
        if (_modalOluStok) return;
        _modalOluStok = true; _olusLoading = true; _olusRows.Clear(); _olusToplam = 0; StateHasChanged();
        try
        {
            var (rows, toplam) = await Ref.GetOluStokAsync(0, 50);
            _olusRows.AddRange(rows);
            _olusToplam = toplam;
        }
        catch (Exception ex) { Logger.LogError(ex, "Ölü stok yükleme hatası"); }
        finally { _olusLoading = false; StateHasChanged(); }
    }

    private async Task OlusStokDahaFazla()
    {
        if (_olusYukleniyor) return;
        _olusYukleniyor = true; StateHasChanged();
        try
        {
            var (rows, _) = await Ref.GetOluStokAsync(_olusRows.Count, 50);
            _olusRows.AddRange(rows);
        }
        catch (Exception ex) { Logger.LogError(ex, "Ölü stok sayfa yükleme hatası"); }
        finally { _olusYukleniyor = false; StateHasChanged(); }
    }

    // Stok hareket = ayrı tam-ekran sayfa (modal-üstü-modal yerine). stkId + ad query ile.
    private void AcStokHareket(OluStokRow r) => GitHareket(r.StkId, r.Ad);
    private void AcStokHareketUrun(UrunRow u) => GitHareket(u.StkId, u.Ad);
    private void GitHareket(int stkId, string ad) =>
        Nav.NavigateTo($"/stok-hareket?stk={stkId}&ad={Uri.EscapeDataString(ad)}");

    private async Task OpenUrun(string kategori, bool olusSort = false)
    {
        _selKat = kategori; _olusSort = olusSort; _modalUrun = true; _urunLoading = true; _urunler = []; StateHasChanged();
        try { _urunler = await Ref.GetUrunlerAsync(kategori, 0, _gAyBas, _gAyBit, olusSort); }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _urunLoading = false; StateHasChanged(); }
    }

    private static string AbcAd(string s) => s switch
    {
        "A" => "A — çok satan (ilk %80)",
        "B" => "B — orta (%80-95)",
        "C" => "C — uzun kuyruk (son %5)",
        _ => s,
    };

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
