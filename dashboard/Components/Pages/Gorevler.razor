@page "/gorevler"
@using GmDashboard.Data
@using GmDashboard.Components.Shared
@inject GorevService Svc
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>BKM Görevler</PageTitle>

<div class="flex items-center gap-3 mb-5 flex-wrap">
    <h1 class="text-2xl font-bold tracking-tight m-0">Görevler</h1>
    <span class="text-sm font-semibold text-base-content/50">@_tumGorevler.Count görev · @AcikSayi açık</span>
    <button class="btn btn-primary ml-auto" @onclick='() => Nav.NavigateTo("asistan")'>+ Asistan'la ekle</button>
</div>

<div class="flex gap-2.5 flex-wrap items-center mb-3.5">
    <select class="select select-bordered select-sm text-[13px]" @bind="_fltDurum" @bind:after="Uygula">
        <option value="">Durum: Hepsi</option>
        <option value="Açık">Açık</option>
        <option value="Kapalı">Kapalı</option>
    </select>
    <select class="select select-bordered select-sm text-[13px]" @bind="_fltOncelik" @bind:after="Uygula">
        <option value="">Öncelik: Hepsi</option>
        <option value="Yüksek">Yüksek</option>
        <option value="Orta">Orta</option>
        <option value="Düşük">Düşük</option>
    </select>
    <input class="input input-bordered input-sm text-[13px]" placeholder="Atanan ara…" @bind="_fltAtanan" @bind:event="oninput" @bind:after="Uygula" />
</div>

<table class="table table-zebra w-full text-[13.5px] bg-base-100 rounded-2xl overflow-hidden shadow-sm">
    <thead>
        <tr>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">#</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">Başlık</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">Öncelik</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">Atanan</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">Durum</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide">Oluşturma</th>
            <th class="text-left bg-base-200 text-base-content/60 text-xs uppercase tracking-wide"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in _filtreli)
        {
            <tr class="cursor-pointer hover:bg-base-200/50 @(g.Durum == "Kapalı" ? "opacity-50 line-through" : "")" @onclick="() => Duzenle(g)">
                <td class="text-base-content/40">@g.Id</td>
                <td>@g.Baslik</td>
                <td><span class="badge badge-sm font-bold border-0 @OncBadge(g.Oncelik)">@g.Oncelik</span></td>
                <td>@(string.IsNullOrEmpty(g.Atanan) ? "—" : g.Atanan)</td>
                <td><span class="badge badge-sm font-bold border-0 @(g.Durum == "Kapalı" ? "badge-ghost" : "badge-info")">@g.Durum</span></td>
                <td class="text-base-content/50">@g.Olusturma</td>
                <td @onclick:stopPropagation="true">
                    <div class="flex gap-1.5">
                        @if (g.Durum != "Kapalı")
                        {
                            <button class="btn btn-xs" @onclick="() => Kapat(g.Id)">Kapat</button>
                        }
                        <button class="btn btn-xs btn-ghost text-error" @onclick="() => Sil(g.Id)">Sil</button>
                    </div>
                </td>
            </tr>
        }
        @if (_filtreli.Count == 0)
        {
            <tr><td colspan="7" class="text-base-content/50 p-[18px] text-center">Görev yok.</td></tr>
        }
    </tbody>
</table>

<Modal @bind-Open="_modalAcik" Title="@($"Görev #{_seciliId} düzenle")">
    <div class="flex flex-col items-stretch gap-2.5 mt-2">
        <label class="text-base-content/50">Başlık</label>
        <input class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" @bind="_eBaslik" />
        <label class="text-base-content/50">Açıklama</label>
        <textarea class="textarea textarea-bordered w-full text-sm resize-y" rows="3" @bind="_eAciklama"></textarea>
        <label class="text-base-content/50">Öncelik</label>
        <select class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" @bind="_eOncelik">
            <option value="Yüksek">Yüksek</option>
            <option value="Orta">Orta</option>
            <option value="Düşük">Düşük</option>
        </select>
        <label class="text-base-content/50">Atanan</label>
        <input class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" @bind="_eAtanan" placeholder="İsim / rol" />
        <label class="text-base-content/50">Durum</label>
        <select class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" @bind="_eDurum">
            <option value="Açık">Açık</option>
            <option value="Kapalı">Kapalı</option>
        </select>
        <div class="flex gap-2 items-center mt-2.5 flex-wrap">
            <button class="btn btn-primary" @onclick="Kaydet">Kaydet</button>
            <button class="btn" @onclick='() => _modalAcik = false'>İptal</button>
        </div>
    </div>
</Modal>

@code {
    private IReadOnlyList<Gorev> _tumGorevler = [];
    private List<Gorev> _filtreli = [];
    private string _fltDurum = "", _fltOncelik = "", _fltAtanan = "";

    private bool _modalAcik;
    private long _seciliId;
    private string _eBaslik = "", _eAciklama = "", _eOncelik = "Orta", _eAtanan = "", _eDurum = "Açık";

    private int AcikSayi => _tumGorevler.Count(g => g.Durum != "Kapalı");

    protected override void OnInitialized() => Yenile();

    private void Yenile()
    {
        _tumGorevler = Svc.Listele(acikOnly: false);
        Uygula();
    }

    private void Uygula()
    {
        _filtreli = _tumGorevler.Where(g =>
            (_fltDurum == "" || g.Durum == _fltDurum) &&
            (_fltOncelik == "" || g.Oncelik.Contains(_fltOncelik)) &&
            (_fltAtanan == "" || (g.Atanan ?? "").Contains(_fltAtanan, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private void Duzenle(Gorev g)
    {
        _seciliId = g.Id;
        _eBaslik = g.Baslik; _eAciklama = g.Aciklama; _eOncelik = NormOnc(g.Oncelik);
        _eAtanan = g.Atanan ?? ""; _eDurum = g.Durum;
        _modalAcik = true;
    }

    private void Kaydet()
    {
        Svc.Guncelle(_seciliId, _eBaslik, _eAciklama, _eOncelik,
            string.IsNullOrWhiteSpace(_eAtanan) ? null : _eAtanan, _eDurum);
        _modalAcik = false;
        Yenile();
    }

    private void Kapat(long id) { Svc.Kapat(id); Yenile(); }
    private void Sil(long id) { Svc.Sil(id); Yenile(); }

    private static string OncSinif(string o) => o.Contains("Yüksek") ? "y" : o.Contains("Düşük") ? "d" : "o";
    private static string OncBadge(string o) => o.Contains("Yüksek") ? "badge-error" : o.Contains("Düşük") ? "badge-success" : "badge-warning";
    private static string NormOnc(string o) => o.Contains("Yüksek") ? "Yüksek" : o.Contains("Düşük") ? "Düşük" : "Orta";
}
