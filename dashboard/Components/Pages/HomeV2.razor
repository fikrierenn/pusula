    {
        try { _tahmin = await Queries.GetTahminAsync(bugun, bugun.Year, bugun.Month, 0); await InvokeAsync(StateHasChanged); }
        catch { }
    }

    private const string GunOzetDerinSistem = """
        Sen BKM Kitap'ın (kitap+kırtasiye + e-ticaret, 3 mağaza: FSM/Özlüce/İst.Yolu) CFO asistanısın.
        Sana günlük pano verisi verilir. 4-6 cümle DERİN ama özlü Türkçe analiz yaz (akıcı paragraf, madde değil):
        - En dikkat çeken artış/düşüşü SEBEP-ODAKLI yorumla (hangi mağaza/kanal, ne kadar — verideki rakamla).
        - ANOMALİ varsa işaretle: bir mağaza diğerlerinden belirgin sapıyorsa, iade oranı yüksekse, online/mağaza dengesi bozuksa.
        - Online vs mağaza dinamiğini değerlendir.
        - SONDA 1 SOMUT aksiyon öner (ölçülebilir, bugüne özel).
        KESİN KURALLAR: SADECE verideki sayıları kullan — RAKAM UYDURMA, toplama/çıkarma YAPMA. Yönü ASLA ters çevirme (veride "ARTIŞ"=arttı). Sayıları verideki biçimde (₺ ve %). Veride olmayan metrik EKLEME.
        """;

    private async Task RefreshOzetAsync(decimal prevToplam, decimal iadeOran)
    {
        if (_data is null) return;
        var gen = ++_ozetGen;
        _ozetCalisiyor = true; await InvokeAsync(StateHasChanged);
        try
        {
            var txt = await Ai.MetinUretAsync(GunOzetDerinSistem, OzetVeri(prevToplam, iadeOran));
            if (gen == _ozetGen && !string.IsNullOrWhiteSpace(txt)) { _ozetMetin = txt; _ozetAI = true; }
        }
        catch { }
        finally { if (gen == _ozetGen) { _ozetCalisiyor = false; await InvokeAsync(StateHasChanged); } }
    }

