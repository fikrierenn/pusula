@page "/tahmin"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject Queries Queries
@inject PerfState Perf
@inject IJSRuntime JS
@inject TahminKayitService Kayit
@inject TakvimService Takvim
@inject ForecastOkuService Motor
@inject ForecastService MotorCalistir
@inject ILogger<Tahmin> Logger
@inject PersistentComponentState AppState
@rendermode InteractiveServer

<PageTitle>BKM Hedef Tahmin</PageTitle>

<div class="flex items-start justify-between gap-2 mb-4 flex-wrap">
    <div class="min-w-0">
        <div class="text-sm italic text-base-content/50">Projeksiyon · YoY taban × MoM ivme</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">Hedef Tahmin</h1>
    </div>
    @if (MotorCalistir.Available)
    {
        <button class="btn btn-sm btn-primary gap-1.5 @(_motorCalisiyor ? "loading" : "")" disabled="@_motorCalisiyor" @onclick="MotorCalistirTetikle">
            @if (!_motorCalisiyor) { <i data-lucide="refresh-cw" class="w-4 h-4"></i> }
            @(_motorCalisiyor ? "Çalışıyor…" : "Tahmini Çalıştır")
        </button>
    }
</div>
@if (_motorMesaj is not null)
{
    <div class="alert @(_motorOk ? "alert-success" : "alert-error") py-2 mb-3 text-sm">@_motorMesaj</div>
}

<!-- Ay seçici (plan-14): −24 … +3 ay. -->
<div class="flex items-center gap-2 mb-4">
    <button class="btn btn-sm btn-circle btn-ghost @(OncekiVar ? "" : "btn-disabled")" disabled="@(!OncekiVar || _loading)" @onclick="() => AyKaydir(-1)" aria-label="Önceki ay">
        <i data-lucide="chevron-left" class="w-5 h-5"></i>
    </button>
    <div class="text-center min-w-[10rem]">
        <div class="text-[15px] font-bold tracking-tight">@AyAd($"{_hedefYil:0000}-{_hedefAy:00}")</div>
        @if (_t is not null && _t.Gelecek) { <div class="text-[10px] font-semibold text-info uppercase tracking-wider">ileri projeksiyon</div> }
        else if (_t is not null && _t.Gecmis) { <div class="text-[10px] font-semibold text-base-content/50 uppercase tracking-wider">geçmiş — backtest</div> }
        else { <div class="text-[10px] font-semibold text-success uppercase tracking-wider">bu ay (canlı)</div> }
    </div>
    <button class="btn btn-sm btn-circle btn-ghost @(SonrakiVar ? "" : "btn-disabled")" disabled="@(!SonrakiVar || _loading)" @onclick="() => AyKaydir(1)" aria-label="Sonraki ay">
        <i data-lucide="chevron-right" class="w-5 h-5"></i>
    </button>
</div>

@if (!_loading && _motorAy is not null && _motorAy.Point is not null)
{
    <!-- Tahmin motoru ensemble (plan-15): 6 model yarışır, öğrenen ağırlık + de-bias + gözlemlenen band. -->
    <div class="rounded-3xl px-5 py-5 mb-5 bg-gradient-to-br from-primary to-primary/80 text-white shadow-lg">
        <div class="flex items-center justify-between gap-2 mb-1">
            <div class="flex items-center gap-2">
                <i data-lucide="brain-circuit" class="w-[18px] h-[18px]"></i>
                <span class="text-[13px] font-bold opacity-90">Tahmin Motoru — Ensemble</span>
            </div>
            <span class="text-[10px] font-bold bg-white/20 rounded-full px-2 py-0.5">@_motorAy.ModelSayisi model · öğrenen</span>
        </div>
        <div class="text-[36px] font-extrabold leading-tight tracking-tight whitespace-nowrap mb-1">@Tl(_motorAy.Point.Value)</div>
        <div class="text-sm opacity-90 mb-1">Senaryo bandı @Tl(_motorAy.Alt!.Value) – @Tl(_motorAy.Ust!.Value)
            @if (_motorAgirlik is not null) { <span>· backtest MAPE ±@_motorAgirlik.Band.EnsembleMape.ToString("0.0")%</span> }
        </div>
        @if (_motorAy.Atlanan.Count > 0)
        {
            <div class="text-[11px] opacity-80">Çalışmayan model: @string.Join(", ", _motorAy.Atlanan) (yetersiz yakın veri)</div>
        }
    </div>

    <!-- Model yarışı + öğrenilen ağırlık (şeffaflık) -->
    <h2 class="text-lg font-bold tracking-tight mb-3">Model Yarışı — Öğrenen Ağırlık</h2>
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
        <div class="grid grid-cols-[1fr_auto_auto_auto_auto] gap-x-3 gap-y-1.5 text-[12px] tabular-nums items-center">
            <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40">Model</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Tahmin</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Ağırlık</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">MAPE</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Bias</div>
            @foreach (var (ad, k) in _motorAy.Modeller.OrderByDescending(m => m.Value.Agirlik))
            {
                var y = _motorAgirlik?.Modeller.GetValueOrDefault(ad);
                <div class="font-semibold text-base-content/85 truncate" title="@ad">@MotorAd(ad)</div>
                <div class="text-right">@Tl(k.Tahmin)</div>
                <div class="text-right font-bold @(k.Agirlik > 0 ? "text-primary" : "text-base-content/30")">%@Math.Round(k.Agirlik * 100)</div>
                <div class="text-right text-base-content/60">@(y is null ? "—" : y.Wmape.ToString("0.0") + "%")</div>
                <div class="text-right @(y is null ? "text-base-content/40" : Math.Abs(y.BiasPct) <= 5 ? "text-success" : "text-warning")">@(y is null ? "—" : y.BiasPct.ToString("+0.0;-0.0;0") + "%")</div>
            }
        </div>
        <div class="text-[10px] text-base-content/45 mt-3">Ağırlık = son 18 ay backtest doğruluğu (recency-ağırlıklı, düşük MAPE→yüksek ağırlık). Bias de-bias edilir. Kaynak: scripts/forecast (rolling-origin). @_motorAgirlik?.Uretim</div>
    </div>

    <!-- Bileşen kırılımı (glm_calendar yorumu) -->
    @if (_motorAy.Bilesen.Count > 0)
    {
        <h2 class="text-lg font-bold tracking-tight mb-3">Bileşen Kırılımı</h2>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
            <div class="text-base-content/50 text-xs mb-3">glm_calendar (trend+mevsim+tatil regresör) ayrışması — neyin ne kadar etkisi (ensemble noktasından bağımsız yorum).</div>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                @foreach (var (ad, v) in _motorAy.Bilesen)
                {
                    <div>
                        <div class="text-[11px] text-base-content/50">@BilesenAd(ad)</div>
                        <div class="text-[14px] font-bold whitespace-nowrap @(v < 0 ? "text-error" : "")">@Tl(v)</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="divider text-[11px] text-base-content/40">aşağısı: klasik yöntem (YoY×ivme) — karşılaştırma + kayıt</div>
}
else if (!_loading)
{
    <div class="alert alert-warning text-[12px] mb-5 py-2">
        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
        Tahmin motoru çıktısı yok (bu ay için). Klasik YoY×ivme gösteriliyor. Motoru çalıştır: <code>python scripts/forecast/run.py</code>
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_t is not null)
{
    <!-- Bu ay tahmin — büyük kart -->
    <div class="rounded-3xl px-5 py-5 mb-5 bg-gradient-to-br from-primary to-primary/80 text-white shadow-lg">
        <div class="flex items-center gap-2 mb-1">
            <i data-lucide="sparkles" class="w-[18px] h-[18px]"></i>
            <span class="text-[13px] font-bold opacity-90">@AyAd(_t.TahminAy) — 3 mağaza</span>
        </div>
        @if (_t.Yeterli)
        {
            <div class="text-[36px] font-extrabold leading-tight tracking-tight whitespace-nowrap mb-1">@Tl(_t.Tahmin)</div>
            <div class="text-sm opacity-90 mb-3">Senaryo bandı @Tl(_t.Alt) – @Tl(_t.Ust) · ivme @Pct(_t.IvmePct)</div>
            <div class="grid grid-cols-3 gap-2 pt-3 border-t border-white/20">
                <div><div class="text-[11px] opacity-75">Geçen yıl aynı ay</div><div class="text-[15px] font-bold whitespace-nowrap">@Tl(_t.YoYTaban)</div></div>
                @if (_t.Gelecek)
                {
                    <div><div class="text-[11px] opacity-75">Gerçekleşme</div><div class="text-[15px] font-bold whitespace-nowrap opacity-70">henüz yok</div></div>
                    <div><div class="text-[11px] opacity-75">Tür</div><div class="text-[15px] font-bold whitespace-nowrap">saf projeksiyon</div></div>
                }
                else if (_t.Gecmis)
                {
                    <div><div class="text-[11px] opacity-75">Gerçekleşen</div><div class="text-[15px] font-bold whitespace-nowrap">@(_t.Gercek is null ? "—" : Tl(_t.Gercek.Value))</div></div>
                    <div><div class="text-[11px] opacity-75">Sapma (gerçek vs tahmin)</div><div class="text-[15px] font-bold whitespace-nowrap">@SapmaMetin(_t.Gercek, _t.Tahmin)</div></div>
                }
                else
                {
                    <div><div class="text-[11px] opacity-75">Bu ay (şu ana dek)</div><div class="text-[15px] font-bold whitespace-nowrap">@Tl(_t.Mtd)</div></div>
                    <div><div class="text-[11px] opacity-75">Doğrusal pace</div><div class="text-[15px] font-bold whitespace-nowrap">@(_t.MtdPace is null ? "—" : Tl(_t.MtdPace.Value))</div></div>
                }
            </div>
        }
        else
        {
            <div class="text-sm opacity-90">Tahmin için yeterli geçmiş yok.</div>
        }
    </div>

    @if (_t.Yeterli)
    {
        <!-- Kaydet / kayıt durumu (plan-14): seçilen ay tahminini sakla, ay sonu gerçekle kıyasla. -->
        <div class="flex items-center gap-2 mb-5 flex-wrap">
            @if (_mevcutKayit is not null)
            {
                <span class="text-[13px] text-base-content/70">Kaydedildi: <b>@Tl(_mevcutKayit.Tahmin)</b> <span class="text-base-content/45">(@_mevcutKayit.KayitTarih)</span></span>
                <button class="btn btn-xs btn-ghost text-error" @onclick="() => KayitSil(_mevcutKayit.Id)">Sil</button>
                <button class="btn btn-xs btn-outline" @onclick="TahminiKaydet">Güncelle</button>
            }
            else
            {
                <button class="btn btn-sm btn-primary gap-1.5" @onclick="TahminiKaydet">
                    <i data-lucide="bookmark-plus" class="w-4 h-4"></i>Bu tahmini kaydet
                </button>
                <span class="text-[11px] text-base-content/45">Ay sonu gerçekle kıyaslamak için.</span>
            }
        </div>

        @if (_etmen is not null)
        {
            <!-- Takvim etmenleri (plan-14): hafta sonu + kayan dini bayram düzeltmesi. Çarpan KAPALI başlar (MAPE kanıtlayınca aç). -->
            <h2 class="text-lg font-bold tracking-tight mb-3">Takvim Etmenleri</h2>
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
                <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="toggle toggle-primary toggle-sm" checked="@_carpanAcik" @onchange="CarpanToggle" />
                        <span class="text-[13px] font-semibold">Etmen çarpanlarını uygula</span>
                    </label>
                    <button class="btn btn-xs btn-ghost gap-1 @(_takvimYenileniyor ? "loading" : "")" disabled="@_takvimYenileniyor" @onclick="TakvimYenile">
                        <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>Tatil verisini yenile
                    </button>
                </div>
                @if (!_carpanAcik)
                {
                    <div class="text-[11px] text-warning mb-3">Çarpan kapalı — tahmin salt YoY×ivme. Birkaç ay kayıt birikip MAPE düşünce aç (plan-14 kararı).</div>
                }
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                    <div><div class="text-[11px] text-base-content/50">Hafta sonu günü</div><div class="text-[14px] font-bold">@_etmen.HaftaSonuSayisi</div><div class="text-[10px] text-base-content/40">çarpan @_etmen.HaftaSonuCarpan.ToString("0.000")</div></div>
                    <div><div class="text-[11px] text-base-content/50">Dini bayram kapalı</div><div class="text-[14px] font-bold">@_etmen.TatilKapaliGun gün</div><div class="text-[10px] text-base-content/40">çarpan @_etmen.BayramDuzeltme.ToString("0.000")</div></div>
                    <div><div class="text-[11px] text-base-content/50">Okul</div><div class="text-[14px] font-bold @(_etmen.OkulAcik ? "text-success" : "text-base-content/50")">@(_etmen.OkulAcik ? "Açık" : "Tatil")</div></div>
                    <div><div class="text-[11px] text-base-content/50">Sınav ayı</div><div class="text-[14px] font-bold @(_etmen.SinavAyi ? "text-info" : "text-base-content/50")">@(_etmen.SinavAyi ? "Evet (LGS/YKS)" : "—")</div></div>
                </div>
                <div class="flex items-center justify-between mt-3 pt-3 border-t border-base-200">
                    <span class="text-[12px] text-base-content/60">Kombine çarpan (hafta sonu × bayram)</span>
                    <span class="text-[15px] font-extrabold tabular-nums @(Carpan == 1m ? "text-base-content/50" : Carpan > 1m ? "text-success" : "text-error")">×@Carpan.ToString("0.000")</span>
                </div>
                @if (!Takvim.CacheVar)
                {
                    <div class="text-[10px] text-base-content/45 mt-2">Tatil verisi henüz çekilmedi — bayram çarpanı nötr (1.0). "Tatil verisini yenile" ile API'den çek.</div>
                }
            </div>
        }

        var kalanGun = DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month) - DateTime.Today.Day;
        var gecenGun = DateTime.Today.Day;
        <!-- Hesap adımları — "çatır çutur hesap" şeffaf: YoY taban → ivme → tahmin + MTD pace -->
        <h2 class="text-lg font-bold tracking-tight mb-3">Hesap Adımları</h2>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
            <!-- 1: YoY taban -->
            <div class="flex items-start gap-3 py-2.5 border-b border-base-200">
                <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 text-[13px] font-extrabold">1</span>
                <div class="min-w-0 flex-1">
                    <div class="text-[13px] font-bold text-base-content/85">Mevsimsel taban — geçen yıl aynı ay</div>
                    <div class="text-[11px] text-base-content/50 mt-0.5">@AyAd(_t.TahminAy) için geçen yılın aynı ayı referans alınır (sınav sezonu mevsimselliğini yansıtır).</div>
                </div>
                <div class="text-[15px] font-extrabold tabular-nums whitespace-nowrap shrink-0">@Tl(_t.YoYTaban)</div>
            </div>
            <!-- 2: MoM ivme -->
            <div class="flex items-start gap-3 py-2.5 border-b border-base-200">
                <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 text-[13px] font-extrabold">2</span>
                <div class="min-w-0 flex-1">
                    <div class="text-[13px] font-bold text-base-content/85">Büyüme ivmesi — son 3 ayın YoY ortalaması</div>
                    <div class="text-[11px] text-base-content/50 mt-0.5">Son 3 ayın geçen yıla göre büyümesi tabana uygulanır.</div>
                </div>
                <div class="text-[15px] font-extrabold tabular-nums whitespace-nowrap shrink-0 @(_t.IvmePct >= 0 ? "text-success" : "text-error")">@Pct(_t.IvmePct)</div>
            </div>
            <!-- 3: Tahmin -->
            <div class="flex items-start gap-3 py-2.5 border-b border-base-200">
                <span class="w-7 h-7 rounded-full bg-success/15 text-success flex items-center justify-center shrink-0 text-[13px] font-extrabold">=</span>
                <div class="min-w-0 flex-1">
                    <div class="text-[13px] font-bold text-base-content/85">Ay sonu tahmini = taban × (1 + ivme)</div>
                    <div class="text-[11px] text-base-content/50 mt-0.5">Senaryo bandı @Tl(_t.Alt) – @Tl(_t.Ust) (ivme ± standart sapma).</div>
                </div>
                <div class="text-[16px] font-extrabold tabular-nums whitespace-nowrap shrink-0 text-primary">@Tl(_t.Tahmin)</div>
            </div>
            @if (!_t.Gelecek && !_t.Gecmis)
            {
                <!-- MTD durum: geçen/kalan gün + doğrusal pace (sadece içinde bulunulan ay) -->
                <div class="rounded-xl bg-base-200/60 px-3.5 py-3 mt-3">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-base-content/45 mb-2">Ayın Durumu (MTD)</div>
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        <div><div class="text-[11px] text-base-content/50">Şu ana dek</div><div class="text-[14px] font-bold whitespace-nowrap">@Tl(_t.Mtd)</div></div>
                        <div><div class="text-[11px] text-base-content/50">Geçen gün</div><div class="text-[14px] font-bold whitespace-nowrap">@gecenGun</div></div>
                        <div><div class="text-[11px] text-base-content/50">Kalan gün</div><div class="text-[14px] font-bold whitespace-nowrap">@kalanGun</div></div>
                        <div><div class="text-[11px] text-base-content/50">Doğrusal pace</div><div class="text-[14px] font-bold whitespace-nowrap">@(_t.MtdPace is null ? "—" : Tl(_t.MtdPace.Value))</div></div>
                    </div>
                    <div class="text-[10px] text-base-content/45 mt-2.5">Doğrusal pace = bugüne dek ciro ÷ geçen gün × ay günü (mevsimsel değil — sadece referans; mevsimsel tahmin yukarıdaki adım 3).</div>
                </div>
            }
        </div>
    }

    <!-- Mağaza bazlı tahmin -->
    <h2 class="text-lg font-bold tracking-tight mb-3">Mağaza Bazlı Tahmin</h2>
    <div class="grid grid-cols-1 gap-2.5 mb-5 lg:grid-cols-3">
        @foreach (var (ad, t) in _magaza)
        {
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-[14px] font-bold text-base-content/90">@ad</span>
                    @if (t.Yeterli)
                    {
                        <span class="text-[11px] font-bold inline-flex items-center gap-0.5 @(t.IvmePct >= 0 ? "text-success" : "text-error")"><i data-lucide="@(t.IvmePct >= 0 ? "trending-up" : "trending-down")" class="w-3 h-3"></i>@Pct(t.IvmePct)</span>
                    }
                </div>
                @if (t.Yeterli)
                {
                    <div class="text-[22px] font-extrabold tracking-tight whitespace-nowrap text-primary">@Tl(t.Tahmin)</div>
                    <div class="text-[11px] text-base-content/55 mt-0.5">band @Tl(t.Alt) – @Tl(t.Ust)</div>
                    <div class="text-[11px] text-base-content/45 mt-1">geçen yıl @Tl(t.YoYTaban) · pace @(t.MtdPace is null ? "—" : Tl(t.MtdPace.Value))</div>
                }
                else
                {
                    <div class="text-base-content/50 text-[13px]">Yeterli geçmiş yok.</div>
                }
            </div>
        }
    </div>

    <!-- Kategori bazlı YoY (plan-13) -->
    @if (_kategori.Count > 0)
    {
        <h2 class="text-lg font-bold tracking-tight mb-3">Kategori — Bu Ay MTD vs Geçen Yıl</h2>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
            <div class="text-base-content/50 text-xs mb-3">İrsHrk net · 3 mağaza · @AyAd(_t!.TahminAy) (MTD) vs geçen yıl aynı dönem</div>
            @foreach (var k in _kategori)
            {
                var yoyRenk = k.YoyPct is null ? "text-base-content/40" : k.YoyPct >= 0 ? "text-success" : "text-error";
                <div class="flex items-center justify-between gap-2 py-1.5 border-b border-base-200 last:border-b-0">
                    <span class="text-[13px] font-semibold text-base-content/85 truncate">@k.Ad</span>
                    <div class="flex items-center gap-3 shrink-0 tabular-nums">
                        <span class="text-[12px] text-base-content/50">@Tl(k.MtdGecenYil)</span>
                        <span class="text-[13px] font-bold">@Tl(k.MtdBuYil)</span>
                        <span class="text-[12px] font-bold @yoyRenk">@(k.YoyPct is null ? "—" : Pct(k.YoyPct.Value))</span>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Kayıtlı tahminler + model doğruluğu (plan-14) -->
    @if (_karsilastirma.Count > 0)
    {
        <h2 class="text-lg font-bold tracking-tight mb-3">Kayıtlı Tahminler — Gerçekle Karşılaştırma</h2>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
            @{
                var degerlendirilen = _karsilastirma.Count(c => c.SapmaPct is not null);
            }
            @if (degerlendirilen > 0)
            {
                <div class="flex items-baseline gap-2 mb-3">
                    <span class="text-[11px] font-bold uppercase tracking-widest text-base-content/45">Model doğruluğu</span>
                    <span class="text-[20px] font-extrabold tabular-nums @(_mape <= 10 ? "text-success" : _mape <= 20 ? "text-warning" : "text-error")">±@_mape.ToString("#,##0.0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))%</span>
                    <span class="text-[11px] text-base-content/45">ort. mutlak sapma · @degerlendirilen tamamlanmış ay</span>
                </div>
            }
            <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-3 gap-y-1.5 text-[12px] tabular-nums">
                <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40">Ay</div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Tahmin</div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Gerçek</div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/40 text-right">Sapma</div>
                @foreach (var c in _karsilastirma)
                {
                    var renk = c.SapmaPct is null ? "text-base-content/40" : Math.Abs(c.SapmaPct.Value) <= 10 ? "text-success" : Math.Abs(c.SapmaPct.Value) <= 20 ? "text-warning" : "text-error";
                    <div class="font-semibold text-base-content/85 truncate">@AyAd($"{c.Kayit.Year:0000}-{c.Kayit.Month:00}")</div>
                    <div class="text-right">@Tl(c.Kayit.Tahmin)</div>
                    <div class="text-right">@(c.Gercek is null ? "bekliyor" : Tl(c.Gercek.Value))</div>
                    <div class="text-right font-bold @renk">@(c.SapmaPct is null ? "—" : c.SapmaPct.Value.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%")</div>
                }
            </div>
            <div class="text-[10px] text-base-content/45 mt-3">Sapma = (gerçek − tahmin) ÷ tahmin. "Bekliyor" = ay henüz tamamlanmadı. MAPE düştükçe model isabetli.</div>
        </div>
    }

    <!-- Aylık seri grafik -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-3">
        <h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="chart-no-axes-column" class="w-[18px] h-[18px] text-primary"></i>Aylık Net Ciro (irsHrk, 25 ay)</h3>
        <AppAreaChart TItem="AylikNokta" Items="_t.Seri" Name="Aylık net" Color="@_pColor" Height="130"
                      XValue="@(x => (object)x.Ay[2..])" YValue="@(x => (decimal?)x.Net)" />
        <div class="text-base-content/50 text-[11px] mt-2">Ağu/Eyl sınav sezonu (mevsimsel zirve) seride görünür — YoY tabanı bunu yansıtır.</div>
    </div>

    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
        <h3 class="text-[14px] font-bold text-base-content/90 mb-2 flex items-center gap-2"><i data-lucide="info" class="w-4 h-4 text-info"></i>Yöntem</h3>
        <p class="text-[12.5px] text-base-content/70 leading-relaxed m-0">
            Tahmin = <b>geçen yıl aynı ay</b> (mevsimsel taban) × <b>son 3 ayın YoY büyüme ivmesi</b>.
            Senaryo bandı = ivme ± standart sapma (muhafazakâr–iyimser). Kaynak: irsHrk net (KDV-hariç, 3 mağaza, tam geçmiş).
            Doğrusal pace = kısmi ayın gün-oranlı kaba projeksiyonu (mevsimsel değil — sadece referans).
        </p>
    </div>
}

@code {
    private bool _loading = true;
    private string? _error;
    private TahminSonuc? _t;
    private List<TahminMagazaItem> _magaza = new();
    private IReadOnlyList<TahminKategori> _kategori = [];
    private string _pColor = "";
    private static readonly (int Id, string Ad)[] _mekanlar = { (1, "FSM"), (4477, "Özlüce"), (4478, "İst.Yolu") };

    private static readonly DateOnly _bugun = DateOnly.FromDateTime(DateTime.Today);
    private int _hedefYil = _bugun.Year;
    private int _hedefAy = _bugun.Month;
    private IReadOnlyList<TahminKayitEntry> _kayitlar = [];
    private TahminKayitEntry? _mevcutKayit;
    private List<TahminKarsilastirma> _karsilastirma = new();
    private decimal _mape;
    private AyEtmen? _etmen;
    private ForecastAy? _motorAy;           // plan-15 motor ensemble (seçili ay)
    private ForecastAgirlik? _motorAgirlik; // plan-15 öğrenen katman (model ağırlık/bias/band)
    private bool _carpanAcik;        // plan-14 kararı: çarpan KAPALI başlar; MAPE kanıtlayınca aç
    private bool _takvimYenileniyor;
    private bool _motorCalisiyor;
    private bool _motorOk;
    private string? _motorMesaj;
    // Kombine çarpan = hafta sonu × bayram düzeltmesi (okul şimdilik 1.0). Kapalıyken 1.0.
    private decimal Carpan => _carpanAcik && _etmen is not null ? _etmen.HaftaSonuCarpan * _etmen.BayramDuzeltme : 1m;
    // Sınır: −24 ay (geçmiş backtest) … +3 ay (ileri projeksiyon). Çok ileri = spekülatif.
    private DateOnly Hedef => new(_hedefYil, _hedefAy, 1);
    private bool OncekiVar => Hedef > new DateOnly(_bugun.Year, _bugun.Month, 1).AddMonths(-24);
    private bool SonrakiVar => Hedef < new DateOnly(_bugun.Year, _bugun.Month, 1).AddMonths(3);

    private PersistingComponentStateSubscription _persistSub;

    protected override async Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);
        if (AppState.TryTakeFromJson<TahminSonuc>("tah_t", out var t) && t is not null &&
            AppState.TryTakeFromJson<List<TahminMagazaItem>>("tah_mag", out var mag) &&
            AppState.TryTakeFromJson<List<TahminKategori>>("tah_kat", out var kat))
        {
            _t = t;
            _magaza = mag ?? [];
            _kategori = kat ?? [];
            _etmen = Takvim.GetAyEtmen(_hedefYil, _hedefAy);
            _motorAy = Motor.Ay(_hedefYil, _hedefAy);
            _motorAgirlik = Motor.Agirlik();
            _loading = false;
            await KayitlariYukle();
            return;
        }
        await Yukle();
    }

    private Task PersistData()
    {
        if (_t is not null) AppState.PersistAsJson("tah_t", _t);
        AppState.PersistAsJson("tah_mag", _magaza);
        AppState.PersistAsJson("tah_kat", (List<TahminKategori>)_kategori.ToList());
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private async Task Yukle()
    {
        _loading = true; _error = null; StateHasChanged();
        var sw = PerfState.Start();
        try
        {
            _etmen = Takvim.GetAyEtmen(_hedefYil, _hedefAy);
            var c = Carpan;
            var tTot = Queries.GetTahminAsync(_bugun, _hedefYil, _hedefAy, 0, c);
            var tMag = _mekanlar.Select(m => Queries.GetTahminAsync(_bugun, _hedefYil, _hedefAy, m.Id, c)).ToArray();
            var tKat = Queries.GetTahminKategoriAsync(_bugun, _hedefYil, _hedefAy);
            await Task.WhenAll(((IEnumerable<Task>)new[] { tTot }).Concat(tMag).Concat(new[] { tKat }));
            _t = tTot.Result;
            _magaza.Clear();
            for (int i = 0; i < _mekanlar.Length; i++) _magaza.Add(new(_mekanlar[i].Ad, tMag[i].Result));
            _kategori = tKat.Result;
            _motorAy = Motor.Ay(_hedefYil, _hedefAy);      // plan-15 motor çıktısı (yoksa null → klasik fallback)
            _motorAgirlik = Motor.Agirlik();
            await KayitlariYukle();
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; Perf.Report("Tahmin", sw); StateHasChanged(); }
    }

    // Kayıtlar + geçmiş ay gerçek karşılaştırması (plan-14). MAPE = tamamlanmış kayıtlardan ort. mutlak sapma.
    private async Task KayitlariYukle()
    {
        _kayitlar = Kayit.Yukle();
        _mevcutKayit = _kayitlar.FirstOrDefault(k => k.Year == _hedefYil && k.Month == _hedefAy && k.MekanId == 0);
        var curMonth = new DateOnly(_bugun.Year, _bugun.Month, 1);
        var liste = new List<TahminKarsilastirma>();
        foreach (var k in _kayitlar.Where(k => k.MekanId == 0).OrderByDescending(k => k.Year * 100 + k.Month).Take(12))
        {
            bool tamam = new DateOnly(k.Year, k.Month, 1).AddMonths(1) <= curMonth;  // ay tümüyle geçti
            decimal? ger = tamam ? await Queries.GetGercekCiroAsync(k.Year, k.Month, 0) : null;
            decimal? sapma = (ger is not null && k.Tahmin != 0) ? Math.Round(100 * (ger.Value - k.Tahmin) / k.Tahmin, 1) : null;
            liste.Add(new TahminKarsilastirma(k, ger, sapma));
        }
        _karsilastirma = liste;
        _mape = _karsilastirma.Where(c => c.SapmaPct is not null).Select(c => Math.Abs(c.SapmaPct!.Value)).DefaultIfEmpty().Average();
    }

    private async Task TahminiKaydet()
    {
        if (_t is null || !_t.Yeterli) return;
        var entry = new TahminKayitEntry(Guid.NewGuid().ToString("N"), _hedefYil, _hedefAy, 0,
            _t.Tahmin, _t.Alt, _t.Ust, _t.IvmePct, _t.YoYTaban, _t.Carpan, DateTime.Now.ToString("dd.MM.yyyy HH:mm"));
        if (Kayit.Kaydet(entry)) await KayitlariYukle();
    }

    private async Task KayitSil(string id)
    {
        if (Kayit.Sil(id)) await KayitlariYukle();
    }

    private async Task AyKaydir(int n)
    {
        var yeni = Hedef.AddMonths(n);
        _hedefYil = yeni.Year; _hedefAy = yeni.Month;
        await Yukle();
    }

    private async Task CarpanToggle()
    {
        _carpanAcik = !_carpanAcik;
        await Yukle();
    }

    private async Task TakvimYenile()
    {
        _takvimYenileniyor = true; StateHasChanged();
        await Takvim.ApidenYenileAsync();
        _takvimYenileniyor = false;
        await Yukle();
    }

    // Forecast motorunu (python run.py) tetikle → bitince çıktı JSON güncel → sayfayı yenile.
    private async Task MotorCalistirTetikle()
    {
        _motorCalisiyor = true; _motorMesaj = null; StateHasChanged();
        var (ok, mesaj, _) = await MotorCalistir.RunAsync();
        _motorOk = ok; _motorMesaj = mesaj; _motorCalisiyor = false;
        if (ok) await Yukle();   // yeni tahmin JSON'unu oku
        else StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-colors.js");
            var c = await theme.InvokeAsync<Dictionary<string, string>>("daisyColors");
            if (c.TryGetValue("p", out var p) && _pColor != p) { _pColor = p; StateHasChanged(); }
        }
        catch { /* tema okunamazsa fallback */ }
    }

    private static string SapmaMetin(decimal? gercek, decimal tahmin)
    {
        if (gercek is null || tahmin == 0) return "—";
        var pct = 100 * (gercek.Value - tahmin) / tahmin;
        return pct.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
    }

    private static string MotorAd(string k) => k switch
    {
        "heuristik" => "Heuristik (YoY×ivme)",
        "glm_calendar" => "GLM (trend+tatil)",
        "seasonal_naive" => "Mevsimsel naif",
        "dow_ewma" => "Gün+EWMA",
        "autoets" => "AutoETS",
        "autoarima" => "AutoARIMA",
        _ => k,
    };

    private static string BilesenAd(string k) => k switch
    {
        "taban_trend" => "Taban + Trend",
        "haftalik" => "Haftalık mevsim",
        "yillik" => "Yıllık mevsim",
        "tatil_okul" => "Tatil + Okul",
        _ => k,
    };

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Pct(decimal v) => v.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
    private static string AyAd(string yyyyMM) =>
        DateTime.ParseExact(yyyyMM + "-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
            .ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
