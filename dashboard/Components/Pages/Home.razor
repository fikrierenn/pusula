@page "/"
@using GmDashboard.Data
@using GmDashboard.Models
@inject Queries Queries
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>BKM GM Dashboard</PageTitle>

<div class="hd">
    <h1>Genel Bakış</h1>
    <span class="tar">@_aralik</span>
    <select class="period" @bind="_period" @bind:after="LoadAsync">
        <option value="gunluk">Günlük (dün)</option>
        <option value="haftalik">Haftalık (son 7 gün)</option>
        <option value="ay">Aylık (MTD)</option>
    </select>
</div>

@if (_loading)
{
    <p class="muted">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="err">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    <div class="big">
        <div><div class="lbl">Toplam Ciro (fiziksel + online)</div><div class="num">@Tl(_data.Toplam)</div>
            <div class="sub">mağaza @Tl(_data.Fiziksel) · online @Tl(_data.Eticaret)</div></div>
        <div><div class="lbl">İşlem</div><div class="num">@Num(_data.Fis)</div>
            <div class="sub">@Num(_data.ESip) online sipariş</div></div>
        <div><div class="lbl">İade</div><div class="num">@Tl(_data.Iade)</div></div>
    </div>

    <div class="grid">
        @foreach (var s in _data.Stores)
        {
            <div class="card clk" @onclick="() => OpenStore(s)">
                <div class="ct">@s.Ad &#9656;</div>
                <div class="cv">@Tl(s.Net)</div>
                <div class="cm">@Num(s.Fis) fiş · sepet @Num(s.Atv) ₺
                    @if (s.GerPct is not null)
                    {
                        <span> · hedef %@s.GerPct</span>
                    }
                </div>
            </div>
        }
        <div class="card card-tot">
            <div class="ct">TOPLAM (3 mağaza)</div>
            <div class="cv">@Tl(_data.Fiziksel)</div>
            <div class="cm">@Num(_data.Fis) fiş · sepet @Num(_data.Fis > 0 ? (int)Math.Round(_data.Fiziksel / _data.Fis) : 0) ₺</div>
        </div>
        <div class="card card-etic clk" @onclick="() => _modalEtic = true">
            <div class="ct">E-ticaret (online) &#9656;</div>
            <div class="cv">@Tl(_data.Eticaret)</div>
            <div class="cm">@Num(_data.ESip) sipariş · sepet @Num(_data.ESip > 0 ? (int)Math.Round(_data.Eticaret / _data.ESip) : 0) ₺</div>
        </div>
    </div>

    <div class="row">
        <div class="panel"><h3>Mağaza Kategori Mix (dönem)</h3><div class="chart-box"><canvas id="ch_kat"></canvas></div></div>
        <div class="panel"><h3>E-ticaret Kanal — NET (dönem)</h3><div class="chart-box"><canvas id="ch_etic"></canvas></div></div>
        <div class="panel"><h3>Son 14 Gün — Fiziksel Net Ciro</h3><div class="chart-box"><canvas id="ch_trend"></canvas></div></div>
    </div>
    <div class="row">
        <div class="panel"><h3>Son 14 Gün — Net Alış (Mal Kabul)</h3><div class="chart-box"><canvas id="ch_alis"></canvas></div>
            <div class="muted" style="font-size:11px">Alış = tedarikçi girişi (ehTip 0+10) − alış iade. Pazar 0 (depo kapalı).</div></div>
    </div>

    <Modal @bind-Open="_modalEtic" Title="E-ticaret — Kanal Dağılımı">
        <div class="muted" style="font-size:12px;margin-bottom:8px">@_aralik · net @Tl(_data.Eticaret) · @Num(_data.ESip) sipariş</div>
        <table>
            <tr><td><b>Kanal</b></td><td class="r"><b>Sipariş</b></td><td class="r"><b>Net Ciro</b></td><td class="r"><b>Sepet</b></td><td class="r"><b>Pay</b></td></tr>
            @foreach (var e in _data.Etic)
            {
                <tr><td>@e.Ad</td><td class="r">@Num(e.Sip)</td><td class="r">@Tl(e.Ciro)</td>
                    <td class="r">@Num(e.Sip > 0 ? (int)Math.Round(e.Ciro / e.Sip) : 0) ₺</td>
                    <td class="r">%@(_data.Eticaret > 0 ? Math.Round(100 * e.Ciro / _data.Eticaret) : 0)</td></tr>
            }
        </table>
    </Modal>

    <Modal @bind-Open="_modalOpen" Title="@(_selStore?.Ad + " — Kategori Dağılımı")">
        @if (_selStore is not null)
        {
            <div class="muted" style="font-size:12px;margin-bottom:8px">@_aralik · net @Tl(_selStore.Net) · @Num(_selStore.Fis) fiş</div>
            <table>
                <tr><td><b>Kategori</b></td><td class="r"><b>Ciro</b></td><td class="r"><b>Pay</b></td></tr>
                @{ var tot = _selStore.Kategori.Sum(k => k.Ciro); }
                @foreach (var k in _selStore.Kategori)
                {
                    <tr><td>@k.Ad</td><td class="r">@Tl(k.Ciro)</td><td class="r">%@(tot > 0 ? Math.Round(100 * k.Ciro / tot) : 0)</td></tr>
                }
            </table>
        }
    </Modal>
}

@code {
    private string _period = "gunluk";
    private bool _loading = true;
    private string? _error;
    private string _aralik = "";
    private PeriodSummary? _data;
    private IReadOnlyList<TrendPoint> _trend = [];
    private IReadOnlyList<TrendPoint> _alis = [];
    private IJSObjectReference? _charts;
    private bool _modalOpen;
    private bool _modalEtic;
    private StoreCard? _selStore;

    private void OpenStore(StoreCard s) { _selStore = s; _modalOpen = true; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var bugun = DateOnly.FromDateTime(DateTime.Today);
            var dun = bugun.AddDays(-1);
            var g2 = bugun;
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            _data = await Queries.GetPeriodAsync(start, endExcl);
            _trend = await Queries.GetTrendAsync(dun);
            _alis = await Queries.GetAlisTrendAsync(dun);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            await DrawChartsAsync();
        }
    }

    private async Task DrawChartsAsync()
    {
        if (_data is null) return;
        try
        {
            _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _charts.InvokeVoidAsync("bar", "ch_kat",
                _data.Kategori.Select(k => k.Ad), _data.Kategori.Select(k => k.Ciro), true);
            await _charts.InvokeVoidAsync("donut", "ch_etic",
                _data.Etic.Select(e => e.Ad), _data.Etic.Select(e => e.Ciro));
            await _charts.InvokeVoidAsync("area", "ch_trend",
                _trend.Select(t => t.Tarih[5..]), _trend.Select(t => t.Net));
            await _charts.InvokeVoidAsync("area", "ch_alis",
                _alis.Select(t => t.Tarih[5..]), _alis.Select(t => t.Net));
        }
        catch { /* ilk prerender'da JS henüz hazır değil — sonraki render'da çizilir */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _data is not null) await DrawChartsAsync();
    }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
