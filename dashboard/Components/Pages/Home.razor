@page "/"
@using GmDashboard.Data
@using GmDashboard.Models
@inject Queries Queries
@inject RefQueries Ref
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>BKM GM Dashboard</PageTitle>

<!-- App-stil başlık: greeting + marka + bildirim + avatar -->
<div class="flex items-start justify-between gap-3 mb-4">
    <div class="min-w-0">
        <div class="text-sm italic text-base-content/50">@Greeting()</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">BKM Genel Bakış</h1>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        <button class="relative w-10 h-10 rounded-xl bg-base-100 border border-base-200 flex items-center justify-center" @onclick='() => Nav.NavigateTo("gorevler")' aria-label="Görevler">
            <i data-lucide="bell" class="w-5 h-5"></i>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-error rounded-full"></span>
        </button>
        <div class="w-10 h-10 rounded-xl bg-primary text-white font-bold text-sm flex items-center justify-center">CFO</div>
    </div>
</div>

<!-- Dönem segment pill (aktif=koyu) + özel takvim -->
<div class="flex gap-2 mb-4 lg:max-w-xl">
    @foreach (var (key, label) in new[] { ("gunluk", "Günlük"), ("haftalik", "Haftalık"), ("ay", "Aylık") })
    {
        <button class="flex-1 rounded-full px-4 py-2.5 text-sm font-semibold transition-colors @(_period == key ? "bg-neutral text-neutral-content shadow-sm" : "bg-base-100 border border-base-200 text-base-content/70")"
                @onclick="() => SetPeriod(key)">@label</button>
    }
    <button class="w-11 shrink-0 rounded-full flex items-center justify-center @(_period == "ozel" ? "bg-neutral text-neutral-content" : "bg-base-100 border border-base-200 text-base-content/70")"
            @onclick='() => SetPeriod("ozel")' aria-label="Özel aralık"><i data-lucide="calendar" class="w-5 h-5"></i></button>
</div>
@if (_period == "ozel")
{
    <div class="flex gap-2 mb-4 flex-wrap">
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBas" @bind:after="LoadAsync" />
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBit" @bind:after="LoadAsync" />
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    var prevToplam = _data.PrevFiziksel + _data.PrevEticaret;
    var islem = _data.Fis + _data.ESip;
    var prevIslem = _data.PrevFis + _data.PrevESip;
    var sepet = islem > 0 ? _data.Toplam / islem : 0;
    var prevSepet = prevIslem > 0 ? prevToplam / prevIslem : 0;
    var magazaAtv = _data.Fis > 0 ? _data.Fiziksel / _data.Fis : 0;
    var oSepet = _data.ESip > 0 ? _data.Eticaret / _data.ESip : 0;
    var iadeOran = _data.Fiziksel > 0 ? Math.Round(100 * _data.Iade / _data.Fiziksel, 1) : 0;
    <!-- Hero KPI carousel — mobil swipe (peek'li scroll-snap), masaüstü 4'lü grid -->
    <div class="mb-1">
        <div id="hero" class="carousel carousel-center w-full gap-3.5 lg:grid lg:grid-cols-4 lg:gap-3 lg:overflow-visible">
            @HeroCard("Toplam Ciro", Tl(_data.Toplam), WowOf(_data.Toplam, prevToplam), "from-primary to-primary/80", "Mağaza", Tl(_data.Fiziksel), "Online", Tl(_data.Eticaret))
            @HeroCard("Toplam İşlem", Num(islem), WowOf(islem, prevIslem), "from-info to-info/80", "Mağaza fiş", Num(_data.Fis), "Online sipariş", Num(_data.ESip))
            @HeroCard("Sepet Ortalama", Tl(sepet), WowOf(sepet, prevSepet), "from-success to-success/80", "Mağaza ATV", Tl(magazaAtv), "Online sepet", Tl(oSepet))
            @HeroCard("İade", Tl(_data.Iade), WowOf(_data.Iade, _data.PrevIade), "from-error to-error/80", "Ciroya oran", $"%{iadeOran}", "Geçen dönem", Tl(_data.PrevIade))
        </div>
        <div id="heroDots" class="flex justify-center items-center gap-1.5 mt-3 mb-4 lg:hidden">
            <span class="hero-dot hero-dot-on"></span><span class="hero-dot"></span><span class="hero-dot"></span><span class="hero-dot"></span>
        </div>
    </div>

    <!-- Mağazalar başlık + tüm kategori drill -->
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-bold tracking-tight m-0">Mağazalar</h2>
        <button class="text-sm font-semibold text-primary flex items-center gap-1" @onclick="() => _modalTot = true">Tümü <i data-lucide="arrow-right" class="w-4 h-4"></i></button>
    </div>

    <!-- İkon-kart mağaza listesi (renkli kare ikon + trend WoW rozet) -->
    <div class="grid grid-cols-1 gap-2.5 mb-5 lg:grid-cols-[repeat(auto-fit,minmax(280px,1fr))]">
        @{ var paletIdx = 0; var palet = new[] { ("bg-success/15", "text-success"), ("bg-info/15", "text-info"), ("bg-warning/15", "text-warning") }; }
        @foreach (var s in _data.Stores)
        {
            var (bg, fg) = palet[paletIdx++ % palet.Length];
            @StoreRow(s.Ad, Tl(s.Net), $"{Num(s.Fis)} fiş · sepet {Num(s.Atv)} ₺", "store", fg, bg, s.Wow, () => Nav.NavigateTo($"magaza/{s.MekanId}"))
        }
    </div>
    <div class="text-[11px] text-base-content/45 mb-5 px-1 flex items-center gap-1">
        <i data-lucide="trending-up" class="w-3.5 h-3.5"></i> Trend oranları @_wowLabel
    </div>

    <!-- E-ticaret özet — gradient info kartı (kategori drill) -->
    <div class="rounded-2xl px-4 py-4 mb-5 bg-gradient-to-br from-info to-info/80 text-white shadow-lg flex items-center gap-3 cursor-pointer transition-transform active:scale-[.98] hover:-translate-y-0.5 hover:shadow-md"
         @onclick="() => _modalEtic = true">
        <div class="w-11 h-11 rounded-2xl bg-white/20 flex items-center justify-center shrink-0"><i data-lucide="globe" class="w-[23px] h-[23px]"></i></div>
        <div class="min-w-0 flex-1">
            <div class="text-[13px] font-bold">E-ticaret (online)</div>
            <div class="text-xs opacity-85 truncate">@Num(_data.ESip) sipariş · sepet @Tl(oSepet)</div>
        </div>
        <div class="text-[18px] font-extrabold whitespace-nowrap shrink-0">@Tl(_data.Eticaret)</div>
    </div>

    @if (_period == "ay" && _hedefMag is not null)
    {
        <h2 class="text-lg font-bold tracking-tight mb-3">Hedefler</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-5">
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0"><h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="target" class="w-[18px] h-[18px] text-primary"></i>Mağaza — Hedef Gerçekleşme (MTD)</h3>
                @{ decimal tNet = 0, tHed = 0; }
                @foreach (var m in _hedefMag)
                {
                    tNet += m.Net; tHed += m.Hedef;
                    @HedefRow(m.Ad, m.Net, m.Hedef, m.GerPct)
                }
                @{ decimal? tGer = tHed > 0 ? Math.Round(100 * tNet / tHed, 1) : null; }
                <div class="flex items-center justify-between pt-2.5 mt-1 border-t-2 border-base-200">
                    <span class="text-sm font-bold">TOPLAM</span>
                    <div class="text-right"><span class="text-sm font-bold @GerRenk(tGer)">@(tGer is null ? "—" : $"%{tGer}")</span>
                        <div class="text-[11px] text-base-content/50">@Tl(tNet) / @Tl(tHed)</div></div>
                </div>
                <div class="text-base-content/50 text-[11px] mt-3">≥%95 yeşil · %85-95 sarı · &lt;%85 kırmızı. Hedef: BKMDATA.Hedef (aylık).</div>
            </div>
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0"><h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="target" class="w-[18px] h-[18px] text-primary"></i>Kategori — Hedef Gerçekleşme (en sapan)</h3>
                @foreach (var k in _hedefKat)
                {
                    @HedefRow(k.Ad, k.Net, k.Hedef, k.GerPct)
                }
                @if (_hedefKat.Count == 0)
                {
                    <div class="text-base-content/50 text-[13px]">Kategori hedefi bulunamadı.</div>
                }
                <div class="text-base-content/50 text-[11px] mt-3">Gerçekleşme artan (en sapan üstte).</div>
            </div>
        </div>
    }

    <h2 class="text-lg font-bold tracking-tight mb-3">Analiz</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0"><h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="chart-pie" class="w-[18px] h-[18px] text-primary"></i>Mağaza Kategori Mix (@_aralik)</h3>
            <AppRankBars TItem="CategorySlice" Items="_data.Kategori"
                         Label="@(k => k.Ad)" Value="@(k => k.Ciro)" ValueText="@(k => Tl(k.Ciro))" /></div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0"><h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="trending-up" class="w-[18px] h-[18px] text-primary"></i>Son 14 Gün — Fiziksel Net Ciro</h3>
            <div class="flex items-center gap-2 mb-2">
                <div class="text-2xl font-extrabold tracking-tight whitespace-nowrap">@Tl(_trend.Count > 0 ? _trend[^1].Net : 0)</div>
                @{ var avgC = _trend.Count > 0 ? _trend.Average(t => t.Net) : 0; var gwC = _trend.Count > 1 ? WowOf(_trend[^1].Net, avgC) : null; }
                @if (gwC is not null)
                {
                    var tc = TrendIco(gwC.Value);
                    <span class="text-xs font-bold inline-flex items-center gap-0.5 @tc.cls" title="14 gün günlük ortalamasına göre"><i data-lucide="@tc.ico" class="w-3.5 h-3.5"></i>@Pct(gwC.Value)</span>
                }
                <div class="text-[11px] text-base-content/45 ml-auto text-right">dün · 14g ort @Tl(avgC)</div>
            </div>
            <AppAreaChart TItem="TrendPoint" Items="_trend" Name="Net Ciro" Color="@_pColor" Height="110"
                          XValue="@(t => (object)t.Tarih[5..])" YValue="@(t => (decimal?)t.Net)" /></div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0"><h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2"><i data-lucide="package" class="w-[18px] h-[18px] text-primary"></i>Son 14 Gün — Net Alış (Mal Kabul)</h3>
            <div class="flex items-center gap-2 mb-2">
                <div class="text-2xl font-extrabold tracking-tight whitespace-nowrap">@Tl(_alis.Count > 0 ? _alis[^1].Net : 0)</div>
                @{ var avgA = _alis.Count > 0 ? _alis.Average(t => t.Net) : 0; var gwA = _alis.Count > 1 ? WowOf(_alis[^1].Net, avgA) : null; }
                @if (gwA is not null)
                {
                    var ta = TrendIco(gwA.Value);
                    <span class="text-xs font-bold inline-flex items-center gap-0.5 @ta.cls" title="14 gün günlük ortalamasına göre"><i data-lucide="@ta.ico" class="w-3.5 h-3.5"></i>@Pct(gwA.Value)</span>
                }
                <div class="text-[11px] text-base-content/45 ml-auto text-right">dün · 14g ort @Tl(avgA)</div>
            </div>
            <AppAreaChart TItem="TrendPoint" Items="_alis" Name="Net Alış" Color="@_pColor" Height="110"
                          XValue="@(t => (object)t.Tarih[5..])" YValue="@(t => (decimal?)t.Net)" />
            <div class="text-base-content/50 text-[11px] mt-2">Alış = tedarikçi girişi (ehTip 0+10) − alış iade. Pazar 0 (depo kapalı).</div></div>
    </div>

    <Modal @bind-Open="_modalTot" Title="TOPLAM — Kategori Dağılımı (3 mağaza)">
        @{
            var birlesik = _data.Stores.SelectMany(s => s.Kategori)
                .GroupBy(k => k.Ad).Select(g => new { Ad = g.Key, Ciro = g.Sum(x => x.Ciro) })
                .OrderByDescending(x => x.Ciro).ToList();
            var totC = birlesik.Sum(x => x.Ciro);
        }
        <div class="text-base-content/50 text-xs mb-2">@_aralik · net @Tl(_data.Fiziksel) · @Num(_data.Fis) fiş</div>
        <table class="table table-sm w-full text-[13px]">
            <tr><td><b>Kategori</b></td><td class="text-right"><b>Ciro</b></td><td class="text-right"><b>Pay</b></td></tr>
            @foreach (var k in birlesik)
            {
                <tr class="cursor-pointer hover:bg-primary/5" @onclick="() => OpenUrun(k.Ad)"><td>@k.Ad ▸</td><td class="text-right">@Tl(k.Ciro)</td><td class="text-right">%@(totC > 0 ? Math.Round(100 * k.Ciro / totC) : 0)</td></tr>
            }
        </table>
    </Modal>

    <Modal @bind-Open="_modalEtic" Title="E-ticaret — Kanal Dağılımı">
        <div class="text-base-content/50 text-xs mb-2">@_aralik · net @Tl(_data.Eticaret) · @Num(_data.ESip) sipariş</div>
        <table class="table table-sm w-full text-[13px]">
            <tr><td><b>Kanal</b></td><td class="text-right"><b>Sipariş</b></td><td class="text-right"><b>Net Ciro</b></td><td class="text-right"><b>Sepet</b></td><td class="text-right"><b>Pay</b></td></tr>
            @foreach (var e in _data.Etic)
            {
                <tr><td>@e.Ad</td><td class="text-right">@Num(e.Sip)</td><td class="text-right">@Tl(e.Ciro)</td>
                    <td class="text-right">@Num(e.Sip > 0 ? (int)Math.Round(e.Ciro / e.Sip) : 0) ₺</td>
                    <td class="text-right">%@(_data.Eticaret > 0 ? Math.Round(100 * e.Ciro / _data.Eticaret) : 0)</td></tr>
            }
        </table>
    </Modal>

    <Modal @bind-Open="_modalUrun" Title="@(_selKat + " — Ürünler (ilk 100, satışa göre)")">
        @if (_urunLoading)
        {
            <p class="text-base-content/50">Yükleniyor…</p>
        }
        else
        {
            <table class="table table-sm w-full text-[13px]">
                <tr><td><b>#</b></td><td><b>Kod</b></td><td><b>Ürün</b></td><td class="text-right"><b>Satış (adet)</b></td><td class="text-right"><b>Ciro</b></td><td class="text-right"><b>Bakiye</b></td></tr>
                @{ var ui = 1; }
                @foreach (var u in _urunler)
                {
                    <tr><td class="text-base-content/40">@ui</td><td>@u.Kod</td><td>@u.Ad</td><td class="text-right">@Num(u.Satis)</td><td class="text-right">@Tl(u.Ciro)</td>
                        <td class="text-right @(u.Bakiye <= 0 ? "text-error" : "")">@Num(u.Bakiye)</td></tr>
                    ui++;
                }
                @if (_urunler.Count == 0)
                {
                    <tr><td colspan="6" class="text-base-content/50">Ürün bulunamadı.</td></tr>
                }
            </table>
        }
    </Modal>
}

@code {
    private string _period = "gunluk";
    private DateTime? _ozelBas = DateTime.Today.AddDays(-7);
    private DateTime? _ozelBit = DateTime.Today.AddDays(-1);
    private bool _loading = true;
    private string? _error;
    private string _aralik = "";
    private string _wowLabel = "önceki döneme göre";   // trend rozetlerinin kıyas tabanı (dönem-bağlı)
    private PeriodSummary? _data;
    private IReadOnlyList<TrendPoint> _trend = [];
    private IReadOnlyList<TrendPoint> _alis = [];
    private IReadOnlyList<HedefMagaza>? _hedefMag;
    private IReadOnlyList<HedefKategori> _hedefKat = [];
    private IJSObjectReference? _charts;
    private string _pColor = "";   // DaisyUI --p (grafik rengi, OnAfterRender'da köprüden)
    private bool _modalEtic;
    private bool _modalTot;
    private bool _modalUrun;
    private bool _urunLoading;
    private string _selKat = "";
    private IReadOnlyList<UrunRow> _urunler = [];

    private async Task OpenUrun(string kategori)
    {
        _selKat = kategori; _modalUrun = true; _urunLoading = true; _urunler = []; StateHasChanged();
        try { _urunler = await Ref.GetUrunlerAsync(kategori); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _urunLoading = false; StateHasChanged(); }
    }

    // Özel aralık: başlangıç ≤ bitiş güvence, endExcl = bitiş+1 gün
    private (DateOnly, DateOnly) OzelAralik()
    {
        var b = DateOnly.FromDateTime(_ozelBas ?? DateTime.Today.AddDays(-7));
        var e = DateOnly.FromDateTime(_ozelBit ?? DateTime.Today.AddDays(-1));
        if (e < b) e = b;
        return (b, e.AddDays(1));
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var bugun = DateOnly.FromDateTime(DateTime.Today);
            var dun = bugun.AddDays(-1);
            var g2 = bugun;
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                "ozel" => OzelAralik(),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            // Geçen-dönem (WoW) penceresi + etiketi. Aylık → geçen ayın AYNI günleri (MTD doğru kıyas);
            // diğerleri hemen önceki eş-uzunluk.
            int len = endExcl.DayNumber - start.DayNumber;
            var (pStart, pEnd, wl) = _period switch
            {
                "ay" => ((DateOnly?)start.AddMonths(-1), (DateOnly?)start.AddMonths(-1).AddDays(len), "geçen ayın aynı günlerine göre"),
                "haftalik" => ((DateOnly?)start.AddDays(-7), (DateOnly?)start, "önceki 7 güne göre"),
                "gunluk" => ((DateOnly?)start.AddDays(-1), (DateOnly?)start, "önceki güne göre"),
                _ => ((DateOnly?)null, (DateOnly?)null, "önceki eş döneme göre"),
            };
            _wowLabel = wl;
            _data = await Queries.GetPeriodAsync(start, endExcl, pStart, pEnd);
            _trend = await Queries.GetTrendAsync(dun);
            _alis = await Queries.GetAlisTrendAsync(dun);
            if (_period == "ay")
                (_hedefMag, _hedefKat) = await Queries.GetHedefAsync(start, endExcl);
            else { _hedefMag = null; _hedefKat = []; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            await DrawChartsAsync();
        }
    }

    private async Task DrawChartsAsync()
    {
        // Tüm Home grafikleri ApexChart (plan-08 Adım 3). Kalan tek JS = heroDots (carousel).
        try
        {
            _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await _charts.InvokeVoidAsync("heroDots", "hero", "heroDots");
        }
        catch { /* ilk prerender'da JS henüz hazır değil — sonraki render'da çağrılır */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // DaisyUI primary'yi grafik rengine köprüle (tema-bağlı, hardcode yok).
            try
            {
                var theme = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-colors.js");
                var c = await theme.InvokeAsync<Dictionary<string, string>>("daisyColors");
                if (c.TryGetValue("p", out var p) && _pColor != p) { _pColor = p; StateHasChanged(); }
            }
            catch { /* tema okunamazsa component fallback'i kullanır */ }
            if (_data is not null) await DrawChartsAsync();
        }
    }

    // Hedef gerçekleşme renk eşiği: ≥%95 yeşil, %85-95 sarı, <%85 kırmızı
    private static string GerRenk(decimal? pct) => pct is null ? "text-base-content/40"
        : pct >= 95 ? "text-success" : pct >= 85 ? "text-warning" : "text-error";
    private static string GerBar(decimal? pct) => pct is null ? "bg-base-300"
        : pct >= 95 ? "bg-success" : pct >= 85 ? "bg-warning" : "bg-error";
    // Progress genişliği — invariant (Türkçe virgül CSS'i bozar), 0-100 clamp.
    private static string BarW(decimal? pct) => Math.Min(Math.Max(pct ?? 0, 0), 100)
        .ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

    // Kompakt hedef satırı (tablo yerine — mobilde taşmaz): ad + % + net/hedef + mini progress.
    private RenderFragment HedefRow(string ad, decimal net, decimal hedef, decimal? pct) => @<div class="py-2 border-b border-base-200 last:border-b-0">
        <div class="flex items-center justify-between gap-2">
            <span class="text-[13px] font-semibold text-base-content/85 truncate">@ad</span>
            <span class="text-[13px] font-bold shrink-0 @GerRenk(pct)">@(pct is null ? "—" : $"%{pct}")</span>
        </div>
        <div class="text-[11px] text-base-content/50 truncate mt-0.5">@Tl(net) / @Tl(hedef)</div>
        <div class="h-1.5 rounded-full bg-base-200 mt-1.5 overflow-hidden">
            <div class="h-full rounded-full @GerBar(pct)" style="width:@BarW(pct)"></div>
        </div>
    </div>;

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));

    // WoW: bir önceki eş-uzunluk döneme göre değişim %. prev=0 → trend yok (null).
    private static decimal? WowOf(decimal cur, decimal prev) => prev > 0 ? Math.Round(100 * (cur - prev) / prev, 1) : null;
    private static string Pct(decimal v) => v.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
    private static (string ico, string cls) TrendIco(decimal pct)
    {
        if (pct == 0) return ("minus", "text-base-content/40");
        return pct > 0 ? ("trending-up", "text-success") : ("trending-down", "text-error");
    }

    // Saate göre selamlama (yerel, tek kullanıcı app).
    private static string Greeting()
    {
        var h = DateTime.Now.Hour;
        return h < 6 ? "İyi geceler 👋" : h < 12 ? "Günaydın 👋" : h < 18 ? "İyi günler 👋" : "İyi akşamlar 👋";
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    // Hero gradient KPI kartı (carousel item). WoW pill sağ-üst, altta ayraçlı 2-kolon stat.
    private RenderFragment HeroCard(string label, string value, decimal? wow, string gradient, string l1, string v1, string l2, string v2) => @<div class="carousel-item w-[86%] lg:w-auto">
        <div class="w-full h-full rounded-3xl px-5 py-5 bg-gradient-to-br @gradient text-white shadow-lg flex flex-col">
            <div class="flex items-start justify-between gap-2">
                <div class="opacity-80 text-[11px] uppercase tracking-wider font-semibold">@label</div>
                @if (wow is not null)
                {
                    <span class="shrink-0 inline-flex items-center gap-0.5 text-[11px] font-bold bg-white/20 rounded-full px-2 py-0.5" title="@_wowLabel">
                        <i data-lucide="@(wow > 0 ? "arrow-up-right" : wow < 0 ? "arrow-down-right" : "minus")" class="w-3 h-3"></i>@Pct(wow.Value)
                    </span>
                }
            </div>
            <div class="text-[34px] font-extrabold leading-tight tracking-tight whitespace-nowrap mt-2 mb-3">@value</div>
            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/20 mt-auto">
                <div><div class="opacity-75 text-[11px]">@l1</div><div class="text-base font-bold whitespace-nowrap">@v1</div></div>
                <div><div class="opacity-75 text-[11px]">@l2</div><div class="text-base font-bold whitespace-nowrap">@v2</div></div>
            </div>
        </div>
    </div>;

    // İkon-kart mağaza satırı (renkli KARE ikon + tutar + altında WoW trend rozeti).
    private RenderFragment StoreRow(string ad, string tutar, string alt, string icon, string iconColor, string iconBg, decimal? wow, Action onClick) => @<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl flex flex-row items-center gap-3 px-4 py-3.5 cursor-pointer transition-transform active:scale-[.98] hover:-translate-y-0.5 hover:shadow-md" @onclick="onClick">
        <div class="@iconBg @iconColor w-12 h-12 rounded-2xl flex items-center justify-center shrink-0">
            <i data-lucide="@icon" class="w-[22px] h-[22px]"></i>
        </div>
        <div class="min-w-0 flex-1">
            <div class="text-[15px] font-bold text-base-content/90 truncate">@ad</div>
            <div class="text-xs text-base-content/55 truncate">@alt</div>
        </div>
        <div class="text-right shrink-0">
            <div class="text-[18px] font-extrabold tracking-tight whitespace-nowrap">@tutar</div>
            @if (wow is not null)
            {
                var t = TrendIco(wow.Value);
                <div class="inline-flex items-center gap-0.5 text-[11px] font-bold mt-0.5 @t.cls" title="@_wowLabel"><i data-lucide="@t.ico" class="w-3 h-3"></i>@Pct(wow.Value)</div>
            }
        </div>
        <i data-lucide="chevron-right" class="w-[18px] h-[18px] text-base-content/30 shrink-0"></i>
    </div>;
}
