@page "/ayarlar"
@using GmDashboard.Data
@using GmDashboard.Models
@inject MuhasebeQueries Muh
@inject AyarService Ayar
@inject IJSRuntime JS
@inject ILogger<Ayarlar> Logger
@rendermode InteractiveServer

<PageTitle>Ayarlar — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">Sistem ayarları · ay kapanış tarihleri</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">Ayarlar</h1>
</div>

<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mb-4 max-w-3xl">
    <h3 class="text-sm font-semibold text-base-content/90 mb-1">Ay Kapanışı (Fin_AyKapanis)</h3>
    <p class="text-[11px] text-base-content/50 mb-4">
        Bu tarihler <a href="/muhasebe" class="link link-hover text-info">Muhasebe / Kontrol</a> panelinin
        kapanış-sonrası müdahale taramasını belirler. Bir döneme tarih girilmezse o dönem taranmaz.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 items-end mb-2">
        <label class="form-control">
            <span class="label-text text-xs mb-1">Yıl</span>
            <input type="number" min="2020" max="2035" class="input input-bordered input-sm" @bind="_yil" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Ay</span>
            <select class="select select-bordered select-sm" @bind="_ay">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">@($"{m:00}")</option>
                }
            </select>
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Kapanış Tarihi</span>
            <input type="date" class="input input-bordered input-sm" @bind="_tarih" />
        </label>
        <button class="btn btn-primary btn-sm" @onclick="Kaydet" disabled="@_kaydediliyor">
            @if (_kaydediliyor) { <span class="loading loading-spinner loading-xs"></span> }
            @(_duzenleMod ? "Güncelle" : "Ekle")
        </button>
    </div>
    <label class="form-control mb-2">
        <span class="label-text text-xs mb-1">Açıklama (opsiyonel)</span>
        <input type="text" maxlength="400" class="input input-bordered input-sm" @bind="_aciklama" placeholder="örn. Mayıs kapanışı" />
    </label>

    @if (_mesaj is not null)
    {
        <div class="alert @(_mesajHata ? "alert-error" : "alert-success") text-sm py-2 mt-1">
            <span>@_mesaj</span>
        </div>
    }
</div>

<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] max-w-3xl">
    <h3 class="text-sm font-semibold text-base-content/90 mb-3">Kayıtlı Kapanışlar (@_liste.Count)</h3>
    @if (_yukleniyor)
    {
        <p class="text-base-content/40 text-sm py-4 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Yükleniyor…</p>
    }
    else if (_liste.Count == 0)
    {
        <p class="text-base-content/50 text-sm py-3">Henüz kapanış kaydı yok.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead><tr>
                    <th>Dönem</th><th>Kapanış</th><th>Açıklama</th><th>Kayıt</th><th class="text-right">İşlem</th>
                </tr></thead>
                <tbody>
                @foreach (var k in _liste)
                {
                    <tr class="hover">
                        <td class="font-medium">@($"{k.DonemAy:00}.{k.DonemYil}")</td>
                        <td>@k.KapanisDT.ToString("dd.MM.yyyy")</td>
                        <td class="max-w-[220px] truncate text-base-content/70" title="@k.Aciklama">@(k.Aciklama ?? "—")</td>
                        <td class="text-xs text-base-content/40">@k.KayitDT.ToString("dd.MM.yyyy")</td>
                        <td class="text-right whitespace-nowrap">
                            <button class="btn btn-ghost btn-xs" @onclick="() => Duzenle(k)">Düzenle</button>
                            <button class="btn btn-ghost btn-xs text-error" @onclick="() => Sil(k)">Sil</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mt-4 max-w-3xl">
    <h3 class="text-sm font-semibold text-base-content/90 mb-1">İş Eşikleri</h3>
    <p class="text-[11px] text-base-content/50 mb-4">Envanter (devir/stockout), Kontrol paneli (risk) ve Tedarikçi scorecard bu değerleri kullanır. Hardcode'dan çıkarıldı.</p>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-3">
        <label class="form-control">
            <span class="label-text text-xs mb-1">Devir — ölü stok eşiği (&lt;)</span>
            <input type="number" step="0.1" min="0" class="input input-bordered input-sm" @bind="_e.DevirOlu" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Devir — sağlıklı eşiği (&gt;)</span>
            <input type="number" step="0.1" min="0" class="input input-bordered input-sm" @bind="_e.DevirSaglikli" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Stokta-yokluk hedefi (%)</span>
            <input type="number" step="0.1" min="0" max="100" class="input input-bordered input-sm" @bind="_e.StokYoklukHedef" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Risk — düşük (info)</span>
            <input type="number" min="0" class="input input-bordered input-sm" @bind="_e.RiskDusuk" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Risk — orta (warning)</span>
            <input type="number" min="0" class="input input-bordered input-sm" @bind="_e.RiskOrta" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Risk — yüksek (error)</span>
            <input type="number" min="0" class="input input-bordered input-sm" @bind="_e.RiskYuksek" />
        </label>
    </div>

    <div class="divider my-1 text-[11px] text-base-content/40">Satınalma — Alım Analizi</div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-3">
        <label class="form-control">
            <span class="label-text text-xs mb-1">Fazla eşiği (tükenme > ay)</span>
            <input type="number" min="1" class="input input-bordered input-sm" @bind="_e.SatinFazlaAy" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Materiality / tolerans (₺)</span>
            <input type="number" min="0" step="500" class="input input-bordered input-sm" @bind="_e.SatinMaterialite" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Min-koli (bu ay alış ≤)</span>
            <input type="number" min="1" class="input input-bordered input-sm" @bind="_e.SatinMinKoli" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Min-stoklu (şube bakiye ≥)</span>
            <input type="number" min="1" class="input input-bordered input-sm" @bind="_e.SatinMinStok" />
        </label>
        <label class="form-control">
            <span class="label-text text-xs mb-1">Sezon-büyüme min taban</span>
            <input type="number" min="1" class="input input-bordered input-sm" @bind="_e.SatinSezonMinTaban" />
        </label>
    </div>
    <label class="form-control mb-3">
        <span class="label-text text-xs mb-1">Hariç marka ID'leri (tedarikçi scorecard dışı — virgüllü)</span>
        <input type="text" class="input input-bordered input-sm font-mono" @bind="_haricMrk" placeholder="0,269,2101,5972,10911" />
    </label>
    <div class="flex items-center gap-3">
        <button class="btn btn-primary btn-sm" @onclick="EsikKaydet" disabled="@_esikKaydediliyor">
            @if (_esikKaydediliyor) { <span class="loading loading-spinner loading-xs"></span> }
            Eşikleri Kaydet
        </button>
        @if (_esikMesaj is not null)
        {
            <span class="text-sm @(_esikHata ? "text-error" : "text-success")">@_esikMesaj</span>
        }
    </div>
</div>

@code {
    private IReadOnlyList<KapanisDonem> _liste = [];
    private int _yil = 2026, _ay = 1;
    private DateTime? _tarih;
    private string? _aciklama;
    private bool _duzenleMod, _kaydediliyor, _yukleniyor = true, _mesajHata;
    private string? _mesaj;

    // İş eşikleri formu (PanelAyarlar immutable → mutable form-model)
    private EsikForm _e = new();
    private string _haricMrk = "";
    private bool _esikKaydediliyor, _esikHata;
    private string? _esikMesaj;

    protected override async Task OnInitializedAsync()
    {
        EsikYukle();
        await YukleAsync();
    }

    private void EsikYukle()
    {
        var a = Ayar.Deger;
        _e = new EsikForm
        {
            DevirOlu = a.DevirOlu, DevirSaglikli = a.DevirSaglikli, StokYoklukHedef = a.StokYoklukHedef,
            RiskDusuk = a.RiskDusuk, RiskOrta = a.RiskOrta, RiskYuksek = a.RiskYuksek,
            SatinFazlaAy = a.SatinFazlaAy, SatinMaterialite = a.SatinMaterialite, SatinMinKoli = a.SatinMinKoli,
            SatinMinStok = a.SatinMinStok, SatinSezonMinTaban = a.SatinSezonMinTaban,
        };
        _haricMrk = string.Join(",", a.HaricMarkalarEtkin);
    }

    private async Task EsikKaydet()
    {
        _esikMesaj = null;
        if (_e.DevirOlu <= 0 || _e.DevirSaglikli <= _e.DevirOlu)
        { _esikMesaj = "Devir: sağlıklı eşiği > ölü eşiği > 0 olmalı."; _esikHata = true; return; }
        if (_e.RiskOrta <= _e.RiskDusuk || _e.RiskYuksek <= _e.RiskOrta)
        { _esikMesaj = "Risk eşikleri artan olmalı (düşük < orta < yüksek)."; _esikHata = true; return; }
        var haric = _haricMrk.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var n) ? n : (int?)null).Where(n => n.HasValue).Select(n => n!.Value).ToArray();
        _esikKaydediliyor = true; StateHasChanged();
        try
        {
            await Ayar.KaydetAsync(new PanelAyarlar(
                _e.DevirOlu, _e.DevirSaglikli, _e.StokYoklukHedef,
                _e.RiskDusuk, _e.RiskOrta, _e.RiskYuksek, haric,
                _e.SatinFazlaAy, _e.SatinMaterialite, _e.SatinMinKoli, _e.SatinMinStok, _e.SatinSezonMinTaban));
            _esikMesaj = "Eşikler kaydedildi."; _esikHata = false;
        }
        catch (Exception ex) { Logger.LogError(ex, "Eşik kaydı hatası"); _esikMesaj = $"Kayıt başarısız: {ex.Message}"; _esikHata = true; }
        finally { _esikKaydediliyor = false; StateHasChanged(); }
    }

    private sealed class EsikForm
    {
        public decimal DevirOlu { get; set; } = 1.5m;
        public decimal DevirSaglikli { get; set; } = 3.0m;
        public decimal StokYoklukHedef { get; set; } = 5.0m;
        public int RiskDusuk { get; set; } = 100;
        public int RiskOrta { get; set; } = 200;
        public int RiskYuksek { get; set; } = 300;
        public int SatinFazlaAy { get; set; } = 12;
        public int SatinMaterialite { get; set; } = 5000;
        public int SatinMinKoli { get; set; } = 24;
        public int SatinMinStok { get; set; } = 3;
        public int SatinSezonMinTaban { get; set; } = 30;
    }

    private async Task YukleAsync()
    {
        _yukleniyor = true; StateHasChanged();
        try { _liste = await Muh.GetKapanisListAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Kapanış listesi yüklenemedi"); _mesaj = "Liste yüklenemedi."; _mesajHata = true; }
        finally { _yukleniyor = false; StateHasChanged(); }
    }

    private async Task Kaydet()
    {
        _mesaj = null;
        if (_tarih is null) { _mesaj = "Kapanış tarihi zorunlu."; _mesajHata = true; return; }
        _kaydediliyor = true; StateHasChanged();
        try
        {
            await Muh.UpsertKapanisAsync(_yil, _ay, _tarih.Value, string.IsNullOrWhiteSpace(_aciklama) ? null : _aciklama.Trim());
            _mesaj = $"{_ay:00}.{_yil} kapanışı kaydedildi."; _mesajHata = false;
            _duzenleMod = false; _aciklama = null; _tarih = null;
            await YukleAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Kapanış kaydı hatası"); _mesaj = $"Kayıt başarısız: {ex.Message}"; _mesajHata = true; }
        finally { _kaydediliyor = false; StateHasChanged(); }
    }

    private void Duzenle(KapanisDonem k)
    {
        _yil = k.DonemYil; _ay = k.DonemAy; _tarih = k.KapanisDT.Date; _aciklama = k.Aciklama;
        _duzenleMod = true; _mesaj = null;
    }

    private async Task Sil(KapanisDonem k)
    {
        var onay = await JS.InvokeAsync<bool>("confirm", $"{k.DonemAy:00}.{k.DonemYil} kapanışı silinsin mi? Bu dönem artık Kontrol taramasına girmez.");
        if (!onay) return;
        try
        {
            await Muh.DeleteKapanisAsync(k.DonemYil, k.DonemAy);
            _mesaj = $"{k.DonemAy:00}.{k.DonemYil} silindi."; _mesajHata = false;
            await YukleAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Kapanış silme hatası"); _mesaj = $"Silme başarısız: {ex.Message}"; _mesajHata = true; StateHasChanged(); }
    }
}
