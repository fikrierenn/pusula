@page "/satis-analizi"
@using GmDashboard.Data
@using GmDashboard.Models
@inject SatisAnaliziQueries Q
@inject SatisAnaliziTabanService Taban
@inject KolonTercihService KolonTercih
@inject NavigationManager Nav
@inject ILogger<SatisAnalizi> Logger
@rendermode InteractiveServer
@attribute [StreamRendering]

<PageTitle>Satış Analizi — BKM GM</PageTitle>

<div class="flex items-center gap-3 mb-2 flex-wrap">
    <h1 class="text-2xl font-bold tracking-tight m-0">Satış Analizi</h1>
    <span class="text-sm font-semibold text-base-content/50">
        stok × 365 günlük satış × geçen sezon (Ağu-Eki) · ürün bazlı
    </span>
</div>

@* ── Tarih seçimi ─────────────────────────────────────────────────────────── *@
<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[14px] mb-3">
    <div class="flex items-end gap-3 flex-wrap">
        <div>
            <label class="block text-xs text-base-content/60 mb-1">Kesim tarihi (son kapalı gün)</label>
            <input type="date" class="input input-bordered input-sm" value="@_kesim.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                   @onchange="KesimDegis" />
            <span class="block text-[11px] text-base-content/40 mt-0.5">
                satış penceresi: @_kesim.AddDays(-364).ToString("dd.MM.yyyy") – @_kesim.ToString("dd.MM.yyyy")
            </span>
        </div>
        <div>
            <label class="block text-xs text-base-content/60 mb-1">Sezon yılı (Ağu-Eki)</label>
            <select class="select select-bordered select-sm" @onchange="SezonDegis">
                @for (var y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                {
                    <option value="@y" selected="@(y == _sezonYil)">@y</option>
                }
            </select>
        </div>
        <button class="btn btn-sm btn-primary" disabled="@_yukleniyor" @onclick="() => Yukle(true)">
            <span class="loading loading-spinner loading-xs @(_yukleniyor ? "" : "hidden")"></span>
            Tabanı yenile
        </button>
        @if (_tabanDurum?.Uretim is { } u)
        {
            <span class="text-xs text-base-content/50 self-center">
                taban: @_tabanDurum.Satir.ToString("N0") satır · @u.ToString("dd.MM HH:mm")
            </span>
        }
    </div>
</div>

@if (_kolonUyari is not null)
{
    @* Kolon tercihi bozulduysa SESSİZ kalmaz — "kolonum kayboldu" sorusu cevapsız bırakılmaz. *@
    <div class="alert alert-info text-xs mb-3 py-2">
        <span>@_kolonUyari</span>
        <button class="btn btn-xs btn-ghost" @onclick="() => _kolonUyari = null">tamam</button>
    </div>
}

@* ── Kapsam bandı — DÖRT BÖLÜM ───────────────────────────────────────────────
   YENİDEN KURULDU 10.09.2026. Kullanıcı: "burası çok fazla ve çok karışık değil mi" —
   haklıydı: 20 madde tek listede birikmişti, başlık hâlâ "7 ölçülmüş sınır" diyordu
   (ekranda YANLIŞ SAYI) ve üç ayrı tür içerik karışmıştı:
     (a) panelin neyi ölçmediği · (b) sayıların ne kadar güvenilir olduğu ·
     (c) eşiklerin nasıl kurulduğu · (d) o gün yapılan düzeltmeler.
   `sunum-dili` kuralı ihlal edilmişti (cümle ≤15 kelime, dipnot ≤2 cümle).
   ⚠ AYRINTI SİLİNMEDİ, TAŞINDI: her ölçümün tam dökümü ilgili ölçüt sabitinin XML
   yorumunda, sema/metrics.yaml'da ve sorgular/2026-09-10-*.sql arşivinde duruyor.
   Ekranda karar için gereken kalıyor. *@
<details class="collapse collapse-arrow bg-warning/15 border border-warning/40 rounded-2xl mb-3">
    <summary class="collapse-title text-xs font-semibold py-2.5 min-h-0 cursor-pointer">
        Bu tablonun sınırları — <b>merkez stok anlık</b> · <b>çeşitlerin %92'si aralıklı talep</b>
        <span class="opacity-60">(4 bölüm · aç)</span>
    </summary>
    <div class="collapse-content text-xs">

        <p class="font-semibold uppercase tracking-wider opacity-60 mt-1 mb-1">
            Panel neyi ölçmez
        </p>
        <ul class="list-disc ml-4 space-y-0.5">
            <li><b>Kişi performansını ölçmez.</b> Kararı kimin verdiği bu veride yok
                (alıcı boyutu yalnız <code>bkm.OneriSiparisTalep</code>'te). Hiçbir sayı
                kişiye atfedilemez.</li>
            <li><b>Merkez stoğu anlık.</b> Geçmiş kesim seçilse bile bugünün WMS değeri —
                WMS geçmiş snapshot tutmuyor.</li>
            <li><b>ODAK stoğu bizim değil.</b> Grup şirketi ama tedarikçi; toplama girmez,
                yalnız "temin edilebilir" sinyali.</li>
            <li><b>Stok tutarı satış fiyatıyla.</b> Bağlanan para değil; maliyetli değer ayrı
                ölçülüyor (kapsam %94,7).</li>
            <li><b>Yolda stok hiçbir mekanda görünmez.</b> Depodan çıkmış, mağaza kabul
                etmemiş mal. Ölçüldü: 1.869 çeşit / 53.602 adet, tamamı son 2 günden.</li>
            <li><b>İade HAKKI veride yok, ama iade DAVRANIŞI ölçülebiliyor.</b>
                <code>urn.alimIadeYok</code> sabit (844.017/844.017 aynı değer) ve
                <code>frm.frmIadeKural</code> 0/1/2 kodunun anlamı belgesiz — ölçüldü
                10.09.2026: üç kodun HEPSİNDE fiilî iade var, komşu Wilson aralıkları
                çakışıyor, kod fiilî davranışı öngörmüyor.
                Vekil olarak tedarikçinin <b>gözlenen 2 yıllık iade oranı</b> kullanılabilir;
                aşırı stok (308,3M ₺) bu orana göre: hiç iade yok %6,7 (20,7M ₺) ·
                %0-2 → %18,5 (56,9M) · %2-10 → %44,7 (137,9M) · %10-25 → %14,6 (45,1M) ·
                %25+ → %0,7 · tedarikçisi bilinmeyen %14,8 (45,6M).
                ⇒ Aşırı stoğun <b>%25,2'si (77,6M ₺)</b> iadesi %2'nin altındaki
                tedarikçilerden: orada "iade ile çözülür" savunması zayıf.
                <span class="opacity-60">⚠ Vekil, hak değil: hakkı olup kullanmayan tedarikçi
                "iade yok" görünür; oran ürün değil TEDARİKÇİ düzeyinde (kullanıcı "her
                kitapta yok iade" demişti); aşırı stok biriken üründe iade yapılmış olabilir
                → oran kısmen sonucun kendisi. Panelde kırılım YAPILMADI, beyan edildi.</span></li>
            <li><b>Merkez için gün-stok hesaplanmıyor.</b> Çıkış sıçramalı (çeşitlerin %67'si
                tek günde) ve tüketici talebi değil: %72 grup şirketi · %16 ODAK · %6 Sınav.</li>
            <li><b>365 günlük satış ile sezon kısmen örtüşür</b> — toplanmaz, çıkarılmaz.</li>
        </ul>

        <p class="font-semibold uppercase tracking-wider opacity-60 mt-3 mb-1">
            Sayılar ne kadar güvenilir
        </p>
        <ul class="list-disc ml-4 space-y-0.5">
            <li><b>Çeşitlerin %91,9'unda gün-stok geçersiz.</b> Talep aralıklı; düzgün talepli
                yalnız %8,1. Aralıklı talepte ortalama, çoğu sıfır olan aylara yayılır. Panel
                o ürünlerde gün-stok basmaz.
                <span class="opacity-60">(Croston 1972 · Syntetos-Boylan 2005)</span></li>
            <li><b>Defter doğruluğu ölçülmüş değil.</b> Ayıklanan 327 çeşit yalnız aritmetik
                olarak imkânsız kayıtlar. Literatürde kayıt-fiziksel uyuşmazlığı SKU'ların
                %50-70'inde; gerçek sapma yalnız fiziksel sayımla bilinir.
                <span class="opacity-60">(DeHoratius &amp; Raman)</span></li>
            <li><b>Kayıp satış tutarları alt sınırdır.</b> Talep vekili geçen yılın satışı; o
                satış da stok tükenince kesilmiş (sağdan sansürlü).
                <span class="opacity-60">(Anupindi/Dada/Gupta 1998)</span></li>
            <li><b>Marj maliyetin yaşını taşır.</b> Satış 365 günlük, maliyet bugünkü. Maliyet
                yaşına göre marj %24,4 (&lt;3 ay) → %63,0 (2+ yıl). Enflasyon ile yavaş devir
                ayrıştırılamıyor; net satışta etkisi %9,3.</li>
            <li><b>Kart tutarları TOPLANMAZ.</b> Üç ayrı taban: stok değeri · kayıp potansiyeli ·
                kâr. Aynı çeşit birden çok kartta olabilir (6.170 çeşit ≥2 kartta; Aşırı Stok ∩
                Ölü Stok 1.842 çeşit / 6,2M ₺). Çelişki değil teşhis.</li>
            <li><b>Devir hızımız sektör hedefinin altında.</b> Kitap 1,28 · Kırtasiye 1,25 ·
                Dergi 5,95; yayınlanmış kitapçı hedefi 3,0-4,0.
                <span class="opacity-60">Kıyas ticari kaynak, akademik ölçüm değil; BKM saf
                kitapçı değil. Eşik bu yüzden sektöre çekilmedi.</span></li>
        </ul>

        <p class="font-semibold uppercase tracking-wider opacity-60 mt-3 mb-1">
            Eşikler nasıl kuruldu
        </p>
        <ul class="list-disc ml-4 space-y-0.5">
            <li><b>Aşırı stok eşiği KATEGORİ BAZLI.</b> Ölçüt: stoğun sonraki 12 ayda satılan
                oranı (yıllık devir) 1,0'ın altına düştüğü kat. Panel geneli <b>3×</b>; ölçümle
                ayrışan iki kategori <b>Kırtasiye 2×</b> (devri 1,25 → eşik sıkılaştı) ve
                <b>Hazırlık Kitapları 8×</b> (devri 3,16 → haksız "aşırı" damgası kalktı).
                Kalan sekizde 3× duruyor: bantları eksik, monoton değil ya da örneklem yetersiz —
                <b>ölçemediğimizi değiştirmiyoruz</b>.</li>
            <li><b>Sezon açığı 0,50</b> — altında önceki yıl talebinin en az %39'u
                gerçekleşmiyor.</li>
            <li><b>Raf kaybı: yılda 5+ satış.</b> Ayraç talep, merkez stoğu değil — merkez
                ekseninde desen monoton bile değildi, o ölçüt reddedildi. Talep kanıtı olmayan
                8.736 çeşit bulunurluk kaybı değil <b>ölü stok</b>.</li>
            <li><b>Talep sınıfı eşikleri dışarıdan</b> (ADI 1,32 · CV² 0,49) — bizim verimizden
                türetilmedi.</li>
            <li><b>Veriden seçilen eşiğin bedeli:</b> ilk üçü aynı veriden seçildi. Bu yöntem
                gruplar arası farkı abartır ve tekrarlanabilirliği düşüktür. Eşikler kohort
                <b>listesi</b> üretir; kesimdeki oran farkı bir <b>etki ölçüsü değildir</b>.
                Trendler Cochran-Armitage ve Wilson aralıklarıyla sınandı.
                <span class="opacity-60">(Altman &amp; Royston 2006)</span></li>
            <li><b>Politika tablosu iptal.</b> <code>bkm.OneriSiparisKtg3Ondeger</code> hedef
                gün-stok tablosu kullanıcı kararıyla iptal edildi (10.09.2026); eşikler artık
                ölçümden gelir, politika tablosundan değil.</li>
            <li><b>Ters nedensellik giderilmedi:</b> alıcı çok satmasını beklediğine çok stok
                koyar.</li>
        </ul>

        <p class="font-semibold uppercase tracking-wider opacity-60 mt-3 mb-1">
            10.09.2026 düzeltmeleri
        </p>
        <ul class="list-disc ml-4 space-y-0.5 pb-1">
            <li><b>Açık sipariş yalnız satın alma.</b> Süzgeç yoktu; gösterilen adedin %86'sı
                satın alma değildi. Uyarı alan 37.168 ürünün 17.139'unda gerçek alış siparişi
                sıfırdı.</li>
            <li><b>Aylık grafikler son 12 tam ay.</b> Eskiden iki yarım ay üretiyordu; grafikten
                okunan yıllık düşüş −%38,5 görünüyordu, gerçek −%20,9. Manşetteki 365 günlük
                satış değişmedi.</li>
            <li><b>Defteri şüpheli kayıtlar kayıp kartlarından çıkarıldı</b> (327 çeşit). Stokta
                Yokluk kartında 49 çeşit 1.972.350 ₺ şişirme yapıyordu. Envanter Değeri kartı bu
                şartı uygulamaz — toplam bilanço tüm evreni gösterir.</li>
            <li><b>Ölü stok POS ile çapraz denetlendi.</b> ERP "satış yok" derken POS'ta satmış
                348 çeşit / 1.686.915 ₺ çıkarıldı. Rafa hiç çıkmamış 895 çeşit / 9,7M ₺ ayrıldı:
                eylemi "iade/imha" değil "rafa çıkar".</li>
            <li><b>Sezonluk raf açığı yalnız tam karşılananları sayar.</b> Merkez eksiği
                karşılamıyorsa eylem transfer değil alımdır (622 çeşit / 5,79M ₺ yanlış
                gruptaydı).</li>
            <li><b>"Gir çık" kartları rakamı bozabilir.</b> Bazı ürünler tek fiyat kartından
                satılıyor, mal girişi o karta yazılmıyor → defter kronik negatife gidiyor
                (stkID 643638: 11 alış hareketine karşı 1.106 satış hareketi). Evrende 313
                çeşit / 931.395 ₺; "Veri kirli" filtresinden görülür.</li>
        </ul>
    </div>
</details>

@if (_hata is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_hata</p>
}
else if (_ozet is null)
{
    <p class="text-base-content/50">
        @(_yukleniyor ? "Taban hazırlanıyor (ilk kesimde ~30 saniye)…" : "Yükleniyor…")
    </p>
}
else
{
    var k = _ozet.Kpi;
    @* ══ KPI ŞERİDİ — 8 KART, 3 GRUP ══════════════════════════════════════════════
       TASARIM 10.09.2026. Kullanıcı: "kpi kartlarını daha iyi yapabilirsin çok çirkinler"
       + Able Pro referansı paylaştı. dashboard-icerik danışması + referanstan alınanlar:

       ALINAN (referans):  sayı ÜSTTE / etiket ALTTA (eskiden tersiydi — etiket önce
                           okunuyordu, sayı ikinci planda) · karşı-metrik RENKLİ DİP ŞERİT
                           (düz ayraç yerine) · zemin sakin beyaz, renk yalnız vurguda.
       ALINMAYAN:          sparkline — KPI TOPLAMINDA zaman serisi yok, çizmek uydurma olur.
                           Nötr gri ikon — 8 kartta yine gürültü kaldı, tamamen kalktı.
       DANIŞMANDAN:        sol kenar vurgusu ÖNERİLDİ ama renk zaten sayıda + dip şeritte;
                           üçüncü kez tekrar etmesi gereksiz → alınmadı.

       NEDEN GRUP: renk en fazla 3 ayrım taşır, 8 taşımaz. Ayrım GRUPTAN gelir. Grup
       başlıkları mobilde (tek kolon, ~8×96px kaydırma) NAVİGASYON işlevi görür — süs değil.
       ⚠ Izgara sabit 4 kolon DEĞİL: 3+2+3 kesimi 4'lü ızgarada ragged satır bırakıyordu. *@
    <div class="mb-4">
        @foreach (var grup in KpiGruplari)
        {
            var kartlar = Kartlar(k).Where(x => x.Grup == grup).ToList();
            if (kartlar.Count == 0) continue;
            <h3 class="text-[11px] uppercase tracking-wider text-base-content/45 font-semibold mt-4 mb-2 first:mt-0">
                @grup
            </h3>
            <div class="grid grid-cols-1 gap-3 @(kartlar.Count == 2 ? "md:grid-cols-2" : "md:grid-cols-3")">
                @foreach (var kart in kartlar)
                {
                    @* ══ ANA SAYFA DİLİYLE HARMAN (10.09.2026) ═══════════════════════════
                       Kullanıcı: "ana sayfadaki kpi kartları daha güzel gibi görünüyor
                       raporda da benzer kartlar kullansak uyumlayarak". dashboard-icerik
                       danışmasıyla ÖĞE ÖĞE karar verildi — kısıtlar pazarlıksız:

                       ANA SAYFADAN ALINAN: rounded-3xl · py-5 dikey ferahlık ·
                         hover:-translate-y-0.5 + hover:shadow-md lift · dip şeritte üst
                         AYRAÇ (border-t) · kahraman kartta 34px sayı ve GRADYAN.
                       ALINMAYAN, gerekçeli:
                         · px-5 → md:grid-cols-3'te kart ~230px; px-5 + 34px sayı 375px'te
                           sıkışıyor. px-4 kaldı.
                         · shadow-lg → border ile birlikte ağır; shadow-sm yeter.
                         · 10 KARTA GRADYAN → 09-10.09'da ölçüldü: "her şey aynı sesle
                           bağırıyor, hiyerarşi yok". Renk en fazla 3 ayrım taşır; ayrım
                           GRUPTAN gelir. Gradyan yalnız KAHRAMAN kartta → ana sayfa hissi
                           gelir, gürültü gelmez, üstelik hiyerarşi GÜÇLENİR (şu ana kadar
                           kahraman yalnız punto ile ayrışıyordu).
                         · DEĞİŞİM ROZETİ → panel tek kesim fotoğrafı, zaman serisi yok.
                           "Evrene oran" ölçülebilir bir sayı AMA ana sayfadaki rozet
                           DEĞİŞİM anlatıyor; aynı görsel dilde farklı anlam yanıltır.
                           Sağ üstte nötr ikon kaldı.
                         · Dip şeritte grid-cols-2 → ikinci hücreye meşru içerik yok. Taban
                           etiketi başlığın ALTINDA kalmalı (sayı → başlık → taban okuma
                           sırası) ve grid tıklama hedefini bölerdi. Ana sayfada iki metrik
                           var çünkü orada iki gerçek alt-kırılım (Mağaza/Online).
                         · CAROUSEL → 10 kart = 10 swipe ve grup başlıkları kaybolur; onlar
                           mobilde navigasyon işlevi taşıyor.
                       ⚠ Kahraman kart gradyanlı olduğu için İÇ RENKLER beyaza uyarlanır
                       (ikon/başlık/taban/alt/dip şerit) — yoksa base-content tokenları
                       gradyan üstünde okunmaz. *@
                    <div class="@(kart.Kahraman
                                    ? "bg-gradient-to-br from-primary to-primary/80 text-white shadow-md"
                                    : "bg-base-100 border border-base-300 shadow-sm hover:border-base-content/20")
                                rounded-3xl overflow-hidden flex flex-col min-w-0
                                transition-all hover:-translate-y-0.5 hover:shadow-lg">
                        @* ÜST BLOK — tıklanınca listeyi o kohorta filtreler. *@
                        <button type="button"
                                class="text-left px-4 py-5 min-w-0 @(kart.Durum is null ? "cursor-default" : "active:scale-[.98]")"
                                @onclick="() => KartTikla(kart.Durum, kart.OdakVar, kart.MinYas)">
                            @* Sayı ÜSTTE (Able Pro düzeni) · tabular-nums: rakamlar hizalı,
                               kolonlar arası kıyas mümkün. TlKisa sayesinde taşma riski yok.
                               İkon sağ üstte, NÖTR — sayının hizasını bozmasın diye float değil
                               ayrı akışta (absolute konumlandırma yok, kart relative değil). *@
                            <span class="float-right -mt-0.5 @(kart.Kahraman ? "text-white/35" : "text-base-content/25")">
                                @Ikon(kart.Ikon)
                            </span>
                            <span class="block font-extrabold tabular-nums tracking-tight leading-none
                                         @(kart.Kahraman ? "text-[34px] text-white" : $"text-[26px] text-{kart.Vurgu}")">
                                @kart.Deger
                            </span>
                            @if (kart.IkinciDeger is not null)
                            {
                                @* İKİNCİ TABAN — ana sayının hemen altında, SABİT konum.
                                   Küçük ve soluk: ana sayının hiyerarşisini bozmaz ama aynı
                                   kohortun öteki parası tek bakışta okunur. *@
                                <span class="block text-[11px] tabular-nums mt-1
                                             @(kart.Kahraman ? "text-white/70" : "text-base-content/45")">
                                    @kart.IkinciEtiket <b class="font-semibold">@kart.IkinciDeger</b>
                                </span>
                            }
                            <span class="block text-[11px] uppercase tracking-wider font-semibold mt-2
                                         @(kart.Kahraman ? "text-white/75" : "text-base-content/55")">
                                @kart.Baslik
                            </span>
                            @* B4 (10.09 denetimi): ŞERİT TOPLANABİLİR GÖRÜNÜYORDU. Üç ayrı
                               taban yan yana duruyor — stok değeri (elimizdeki malın etiketi),
                               kayıp potansiyeli (olmayan satış) ve kâr. Toplamı anlamsız;
                               ölçüldü: 6.170 çeşit ≥2 kartta, K8∩K3 1.842 çeşit / 6,2M ₺ iki
                               kartta birden. Taban artık her kartta yazılı. *@
                                            <span class="block text-[10px] mt-0.5 @(kart.Kahraman ? "text-white/55" : "text-base-content/35")">
                                @kart.Taban
                                @if (kart.Sahip is not null)
                                {
                                    @* B-172(g) SAHİP ROZETİ — kohortu KİM kapatacak. Sağa yaslı,
                                       tabanla aynı satırda: yer kazanır, okuma sırasını bozmaz. *@
                                    <span class="float-right font-semibold uppercase tracking-wider
                                                 @(kart.Kahraman ? "text-white/70" : "text-base-content/45")">
                                        @kart.Sahip
                                    </span>
                                }
                            </span>
                            <span class="block text-[11px] leading-snug mt-0.5 @(kart.Kahraman ? "text-white/70" : "text-base-content/50")">
                                @kart.Alt
                            </span>
                        </button>
                        @* DİP ŞERİT = karşı-metrik. AYNI KARTTA kalmak zorunda
                           (satinalma-danisman şartı: karşı-metrik yan yana, ayrı karta
                           konunca çift ayrılabiliyor). Şeridin rengi kartın vurgusunun
                           soluk hali — okunur, bağırmıyor.
                           ÜST AYRAÇ ana sayfadan alındı (border-t): önce yalnız arka plan
                           rengiyle ayrışıyordu, ayraç yapıyı netleştiriyor. *@
                        @* 12.09.2026: eski iki-alanlı `Cift*` alanları SİLİNDİ — 11 kartın
                           hepsi Kirilim kullanıyor. İki tanım biçimi bırakmak, ileride birine
                           eklenen kolonun ötekinde görünmemesi demekti (emitter-ayrımı). *@
                        @if (kart.Kirilim is { Count: > 0 } seritler)
                        {
                            <div class="mt-auto border-t @(kart.Kahraman ? "border-white/25" : "border-base-300")">
                                @foreach (var (k2, i2) in seritler.Select((x, i) => (x, i)))
                                {
                                    <button type="button"
                                            class="w-full px-4 py-2.5 flex items-baseline gap-2 text-left min-w-0
                                                   active:scale-[.98] transition-all
                                                   @(i2 > 0 ? (kart.Kahraman ? "border-t border-white/15" : "border-t border-base-300/60") : "")
                                                   @(kart.Kahraman
                                                        ? "bg-white/15 hover:bg-white/25"
                                                        : $"bg-{kart.Vurgu}/10 hover:bg-{kart.Vurgu}/20")"
                                            @onclick="() => KartTikla(k2.Durum, k2.OdakVar, null)">
                                        @* Başlık — alt kümeyse "↳" ile: bu satır ana sayının İÇİNDEN. *@
                                        <span class="text-[10px] uppercase tracking-wider font-semibold
                                                     min-w-0 flex-1 truncate
                                                     @(kart.Kahraman ? "text-white/75" : "text-base-content/55")">
                                            @(k2.AltKume ? "↳ " : "")@k2.Baslik
                                        </span>
                                        @* Çeşit — SOLUK ve değerden AYRI kolonda; eskiden başlık
                                           metnine gömülüydü ve değerle karışıyordu. *@
                                        @if (k2.Cesit is not null)
                                        {
                                            <span class="text-[10px] tabular-nums shrink-0
                                                         @(kart.Kahraman ? "text-white/55" : "text-base-content/40")">
                                                @k2.Cesit
                                            </span>
                                        }
                                        <span class="text-sm font-bold tabular-nums shrink-0">@k2.Deger</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* GÜVEN SATIRI — KPI ŞERİDİNİN ALTINDA (kurul kararı 10.09): sarı alarm kutusu
       olarak ŞERİDİN ÜSTÜNDEYDİ ve kullanıcı henüz hiçbir metrik görmeden dikkatini
       çalıyordu. 356/275.384 = %0,13 — kutu bunu fazla ağırlıklandırıyor. Doğru sıra:
       ne ölçüldüğünü gör → sonra ne kadar güvenilir olduğunu oku.
       ⚠ ADI "kirli" DEĞİL: ölçüldü 09.09 (stkID 1739183) — negatif mağaza stoğu çoğu
       zaman veri kiri DEĞİL, transfer kabulünün gecikmesi + geriye dönük kayıt
       (`irsHrk.hrkTarih` ile `ehTrhS` ayrışıyor). "Kirli" demek overclaim olurdu. *@
    @* ══ TALEP DESENİ ŞERİDİ (10.09.2026) ═════════════════════════════════════════
       Bu bir KPI kartı DEĞİL, bir GEÇERLİLİK BEYANI: panelin hız metrikleri (gün-stok,
       günlük ortalama satış) yalnız düzgün/değişken talepte anlamlı. Kart yapmadım çünkü
       bir "kayıp" ya da "bağlı sermaye" ölçmüyor — hangi ölçümün NEREDE geçerli olduğunu
       söylüyor. Eşikler YAYINLANMIŞ (ADI 1,32 · CV² 0,49), veriden türetilmedi. *@
    <div class="rounded-xl bg-base-200/60 border border-base-300 px-4 py-3 mb-3 text-[11px]">
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
            <span class="uppercase tracking-wider font-semibold text-base-content/55">
                Talep deseni · hız metrikleri nerede geçerli
            </span>
            <button type="button" class="hover:underline text-left"
                    @onclick="() => KartTikla(SatisDurumFiltre.DuzgunTalep, null, null)">
                <b class="text-success">@k.DuzgunTalepCesit.ToString("N0")</b> çeşit düzgün/değişken
                <span class="text-base-content/45">(@TlKisa(k.DuzgunTalepTutar))</span>
            </button>
            <button type="button" class="hover:underline text-left"
                    @onclick="() => KartTikla(SatisDurumFiltre.AraliklıTalep, null, null)">
                <b class="text-warning">@k.ArelikliTalepCesit.ToString("N0")</b> çeşit aralıklı/sıçramalı
                <span class="text-base-content/45">(@TlKisa(k.ArelikliTalepTutar))</span>
            </button>
            <span class="text-base-content/45">
                Gün-stok yalnız ilk grupta hesaplanır; aralıklı talepte ortalama çoğu
                <b>sıfır</b> olan aylara yayılır (Syntetos/Boylan/Croston 2005).
            </span>
        </div>
    </div>
    @if (k.VeriKirliCesit > 0)
    {
        <button type="button" class="flex items-center gap-2 text-xs text-base-content/60 hover:text-base-content mb-3"
                @onclick="() => KartTikla(SatisDurumFiltre.VeriKirli, null, null)">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-warning shrink-0"></span>
            <span>
                <b>@k.VeriKirliCesit.ToString("N0") çeşit doğrulanamıyor</b>
                (negatif stok ya da fiyat 0 · @Tl(k.VeriKirliTutar)) —
                negatif stok her zaman veri kiri değil, transfer kabulü gecikmişse de böyle görünür.
                <span class="underline">listele</span>
            </span>
        </button>
    }

    @* ── Kategori kırılımı ──────────────────────────────────────────────── *@
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mb-3 overflow-x-auto">
        <h3 class="text-sm font-semibold mb-3">Kategori Kırılımı</h3>
        <table class="table table-xs w-full">
            <thead><tr class="text-base-content/50">
                <th>Kategori3</th><th class="text-right">Çeşit</th><th class="text-right">Stok</th>
                <th class="text-right">Tutar</th><th class="text-right">Satış 365g</th>
                <th class="text-right">Sezon</th><th class="text-right">Gün-Stok</th>
                <th class="text-right">Stoksuz</th><th class="text-right">Aşırı ₺</th>
            </tr></thead>
            <tbody>
            @foreach (var r in _ozet.Kategori3)
            {
                <tr class="hover cursor-pointer @(_filtre.Kategori3 == r.Ad ? "bg-base-200" : "")"
                    @onclick="() => KategoriSec(r.Ad)">
                    <td class="font-semibold">@r.Ad</td>
                    <td class="text-right font-mono">@r.Cesit.ToString("N0")</td>
                    <td class="text-right font-mono">@r.Stok.ToString("N0")</td>
                    <td class="text-right font-mono">@Tl(r.Tutar)</td>
                    <td class="text-right font-mono">@r.Satis365.ToString("N0")</td>
                    <td class="text-right font-mono">@r.Sezon.ToString("N0")</td>
                    <td class="text-right font-mono @(r.GunStok > 400 ? "text-error" : "")">
                        @(r.GunStok?.ToString("N0") ?? "—")
                    </td>
                    <td class="text-right font-mono">@r.StoksuzCesit.ToString("N0")</td>
                    <td class="text-right font-mono">@Tl(r.AsiriTutar)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @* ── ODAK temin süresi: "5 günde gelen mal için ne kadar stok?" ─────── *@
    @if (_temin is { Count: > 0 })
    {
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] mb-3 overflow-x-auto">
            <div class="flex items-baseline gap-2 mb-3 flex-wrap">
                <h3 class="text-sm font-semibold m-0">Aşırı Stok × ODAK Temin Süresi</h3>
                <span class="text-xs text-base-content/50">
                    ODAK'ta da bulunan aşırı stok — tedarikçiden gelme süresine göre
                </span>
            </div>
            <table class="table table-xs w-full">
                <thead><tr class="text-base-content/50">
                    <th>Temin</th><th class="text-right">Çeşit</th><th class="text-right">Stok Tutarı</th>
                    <th class="text-right">Pay</th><th class="text-right">ODAK adet</th>
                </tr></thead>
                <tbody>
                @{ var teminToplam = _temin.Sum(x => x.Tutar); }
                @foreach (var t in _temin)
                {
                    <tr class="hover">
                        <td class="font-semibold @(t.Sira <= 5 ? "text-error" : "")">@t.Ad</td>
                        <td class="text-right font-mono">@t.Cesit.ToString("N0")</td>
                        <td class="text-right font-mono">@Tl(t.Tutar)</td>
                        <td class="text-right font-mono">
                            @(teminToplam > 0 ? "%" + (t.Tutar / teminToplam * 100).ToString("N1") : "—")
                        </td>
                        <td class="text-right font-mono">@t.OdakStok.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @* ── Filtreler ─────────────────────────────────────────────────────── *@
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[14px] mb-3">
        <div class="flex items-end gap-2 flex-wrap">
            <div>
                <label class="block text-xs text-base-content/60 mb-1">Ara (ad / barkod / stkID)</label>
                <input type="text" class="input input-bordered input-sm w-56" value="@_filtre.Arama"
                       @onchange="AramaDegis" placeholder="örn. kalem, 9789..." />
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">Kategori3</label>
                <select class="select select-bordered select-sm" @onchange="Kategori3Degis">
                    <option value="">(hepsi)</option>
                    @* Kırılım tablosu TUTARA göre sıralı (büyük yük üstte); combo İSME göre
                       (kullanıcı isteği 09.09) — combo'da isimle aranır, tutarla değil. *@
                    @foreach (var r in _ozet.Kategori3.OrderBy(x => x.Ad, StringComparer.CurrentCulture))
                    {
                        <option value="@r.Ad" selected="@(_filtre.Kategori3 == r.Ad)">@r.Ad</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">Mağaza</label>
                <select class="select select-bordered select-sm" @onchange="MekanDegis">
                    <option value="0" selected="@(_filtre.Mekan == 0)">(hepsi)</option>
                    <option value="1" selected="@(_filtre.Mekan == 1)">FSM</option>
                    <option value="4477" selected="@(_filtre.Mekan == 4477)">Özlüce</option>
                    <option value="4478" selected="@(_filtre.Mekan == 4478)">İst.Yolu</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">Durum</label>
                @* Seçenekler ENUM'DAN üretilir — elle liste tutulmaz (yeni durum eklenince
                   ekranda kendiliğinden çıkar; eski elle yazılı liste 3 üyeyi kaçırıyordu). *@
                <select class="select select-bordered select-sm" @onchange="DurumDegis">
                    @foreach (var d in Enum.GetValues<SatisDurumFiltre>())
                    {
                        <option value="@d" selected="@(_filtre.Durum == d)">@DurumAdlari.Ad(d)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">
                    Taze stok
                    <span class="text-base-content/40" title="Son N günde mal kabulü olan ürünler değerlendirmeden çıkar — yeni gelen mal aşırı/hareketsiz sayılmaz">ⓘ</span>
                </label>
                <select class="select select-bordered select-sm" @onchange="TazeDegis">
                    <option value="0" selected="@(_filtre.TazeGunHaric == 0)">dahil (hepsi)</option>
                    <option value="30" selected="@(_filtre.TazeGunHaric == 30)">son 30 günü hariç tut</option>
                    <option value="60" selected="@(_filtre.TazeGunHaric == 60)">son 60 günü hariç tut</option>
                    <option value="90" selected="@(_filtre.TazeGunHaric == 90)">son 90 günü hariç tut</option>
                    <option value="180" selected="@(_filtre.TazeGunHaric == 180)">son 180 günü hariç tut</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">ODAK'ta</label>
                <select class="select select-bordered select-sm" @onchange="OdakDegis">
                    <option value="" selected="@(_filtre.OdakVar is null)">(hepsi)</option>
                    <option value="true" selected="@(_filtre.OdakVar == true)">var (hızlı temin)</option>
                    <option value="false" selected="@(_filtre.OdakVar == false)">yok (gerçek risk)</option>
                </select>
            </div>
            <div>
                <label class="block text-xs text-base-content/60 mb-1">Sayfa boyu</label>
                <select class="select select-bordered select-sm" @onchange="BoyDegis">
                    @foreach (var b in new[] { 25, 50, 100, 200 })
                    {
                        <option value="@b" selected="@(_filtre.SayfaBoyu == b)">@b</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (_liste is not null)
    {
        <SatisAnaliziTablo Sonuc="_liste" Filtre="_filtre" Secili="_secili"
                           SeciliDegisti="KolonlarDegisti" FiltreDegisti="FiltreDegisti"
                           ExcelBaglantisi="@ExcelBaglantisi()" SatirTikla="UrunAc" />
    }
}

@code {
    private const string EkranAdi = "satis-analizi";

    private DateOnly _kesim = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
    private int _sezonYil = DateTime.Today.Year - 1;

    private SatisAnaliziFiltre _filtre = default!;
    private SatisAnaliziOzet? _ozet;
    private IReadOnlyList<TeminKirilim>? _temin;
    private SayfaSonucu<SatisAnaliziSatir>? _liste;
    private TabanDurum? _tabanDurum;
    private IReadOnlySet<string> _secili = SatisAnaliziKolonlar.VarsayilanAnahtarlar;
    private string? _kolonUyari;
    private bool _ilkYukleme = true;   // ilk yüklemede URL'den gelen sayfa korunur
    private string _kullanici = "gm";
    private bool _yukleniyor;
    private string? _hata;

    protected override async Task OnInitializedAsync()
    {
        _filtre = new SatisAnaliziFiltre(_kesim, _sezonYil);
        // URL'de filtre varsa uygula — drill'den "Listeye dön" ile geliniyorsa kullanıcı
        // bıraktığı görünüme döner (kullanıcı bildirimi 09.09: ayarlar sıfırlanıyordu).
        FiltreyiUrldenAl();
        var tercih = await KolonTercih.OkuAsync(_kullanici, EkranAdi);
        _secili = tercih.Secili;
        _kolonUyari = tercih.DusenAnahtarlar.Count == 0 ? null
            : tercih.VarsayilanaDondu
                ? $"Kayıtlı kolon tercihiniz artık geçerli değil ({string.Join(", ", tercih.DusenAnahtarlar)}) — varsayılan kolonlara dönüldü."
                : $"Kayıtlı tercihinizdeki {tercih.DusenAnahtarlar.Count} kolon artık yok ({string.Join(", ", tercih.DusenAnahtarlar)}) — listeden çıkarıldı.";
        await Yukle();
    }

    private async Task Yukle(bool zorla = false)
    {
        _yukleniyor = true; _hata = null;
        try
        {
            // ⚠ Sayfa=1'e SIFIRLAMA yalnız kullanıcı filtre değiştirdiğinde doğru; ilk
            // yüklemede URL'den gelen sayfayı ezmemeli (drill'den 3. sayfaya dönmek gibi).
            _filtre = _ilkYukleme
                ? _filtre with { Kesim = _kesim, SezonYil = _sezonYil }
                : _filtre with { Kesim = _kesim, SezonYil = _sezonYil, Sayfa = 1 };
            _ilkYukleme = false;
            _tabanDurum = await Taban.HazirlaAsync(_kesim, _sezonYil, zorla);
            _ozet = await Q.GetOzetAsync(_filtre);
            _temin = await Q.GetTeminKirilimAsync(_filtre);
            _liste = await Q.GetListeAsync(_filtre);
        }
        catch (Exception ex)
        {
            // Kullanıcıya generic mesaj, detay log'a (security-principles §6).
            Logger.LogError(ex, "Satış Analizi yüklenemedi (kesim {Kesim}, sezon {Sezon})", _kesim, _sezonYil);
            _hata = "Beklenmedik bir hata oluştu. Lütfen sistem yöneticisine bildirin.";
        }
        finally { _yukleniyor = false; }
    }

    private async Task ListeYenile()
    {
        try { _liste = await Q.GetListeAsync(_filtre); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Satış Analizi listesi yenilenemedi");
            _hata = "Beklenmedik bir hata oluştu. Lütfen sistem yöneticisine bildirin.";
        }
    }

    private async Task KesimDegis(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var d)) { _kesim = d; await Yukle(); }
    }

    private async Task SezonDegis(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y)) { _sezonYil = y; await Yukle(); }
    }

    private Task FiltreDegisti(SatisAnaliziFiltre f) { _filtre = f; return ListeYenile(); }

    private Task KategoriSec(string ad)
    {
        _filtre = _filtre with { Kategori3 = _filtre.Kategori3 == ad ? null : ad, Sayfa = 1 };
        return ListeYenile();
    }

    private Task AramaDegis(ChangeEventArgs e)
    {
        _filtre = _filtre with { Arama = e.Value?.ToString(), Sayfa = 1 };
        return ListeYenile();
    }

    private Task Kategori3Degis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _filtre = _filtre with { Kategori3 = string.IsNullOrWhiteSpace(v) ? null : v, Sayfa = 1 };
        return ListeYenile();
    }

    private Task MekanDegis(ChangeEventArgs e)
    {
        _filtre = _filtre with { Mekan = int.TryParse(e.Value?.ToString(), out var m) ? m : 0, Sayfa = 1 };
        return ListeYenile();
    }

    private Task DurumDegis(ChangeEventArgs e)
    {
        var d = Enum.TryParse<SatisDurumFiltre>(e.Value?.ToString(), out var v) ? v : SatisDurumFiltre.Hepsi;
        _filtre = _filtre with { Durum = d, Sayfa = 1 };
        return ListeYenile();
    }

    private Task BoyDegis(ChangeEventArgs e)
    {
        _filtre = _filtre with { SayfaBoyu = int.TryParse(e.Value?.ToString(), out var b) ? b : 50, Sayfa = 1 };
        return ListeYenile();
    }

    /// <summary>
    /// KPI kartı — bir ana metrik + (varsa) KARŞI-METRİK aynı kartta. İkisi ayrı tıklanabilir.
    /// </summary>
    /// <summary>
    /// KPI kartı. TASARIM KARARI 10.09.2026 (dashboard-icerik danışması + kullanıcının
    /// paylaştığı Able Pro referansı; kullanıcı: "kpi kartlarını daha iyi yapabilirsin çok
    /// çirkinler").
    ///
    /// ÇIKARILANLAR ve NEDENİ:
    /// · <c>Gradyan</c> + <c>text-white</c> — 7 kartın 5'i doygun kırmızı/sarıydı, her şey
    ///   aynı sesle bağırıyordu. Dahası beyaz ayraç + 10px karşı-metrik başlığı doygun
    ///   zeminde okunmuyordu: tasarım kendi en kritik parçasıyla (karşı-metrik = adalet
    ///   mekanizması) kavga ediyordu. renk-standardi "özelleştirme minimum" diyor;
    ///   7 el-seçimi gradyan maksimum özelleştirmeydi.
    /// · <c>Ikon</c> string'i + <c>Ikon()</c> SVG üreticisi — dekoratifti ("Aşırı Stok"
    ///   yanındaki katman ikonu hiçbir şey söylemiyor). Referanstaki gibi NÖTR gri ikon
    ///   denendi ama 8 kartta gürültü kaldı → tamamen kalktı.
    ///
    /// GELENLER:
    /// · <c>Grup</c> — 8 kart tek şeritte okunmuyor. Renk en fazla 3 ayrım taşır, 8 taşımaz;
    ///   ayrım GRUPTAN gelir: "BAĞLI SERMAYE" · "BULUNURLUK KAYBI" · "İÇ KAYNAKLA ÇÖZÜLÜR".
    /// · <c>Vurgu</c> — DaisyUI token, YALNIZ 3 şiddet: error (riskte/ölü para) ·
    ///   warning (karar bekliyor) · primary/success (nötr olgu / sağlıklı).
    /// · <c>Kahraman</c> — tek kart büyük tipografi. Yedi kahraman = kahraman yok.
    /// </summary>
    private sealed record KpiKart(
        string Grup, string Baslik, string Deger, string Alt, string Vurgu, string Ikon,
        SatisDurumFiltre? Durum = null, bool? OdakVar = null, int? MinYas = null,
        string Taban = "stok değeri",
        // İKİLİ TABAN (12.09.2026, kullanıcı: "hem maliyet hem üst fiyat olmalı her şeyde").
        // Aynı kohort iki farklı parayla ölçülür ve İKİSİ DE karar taşır:
        //   · maliyet = bağlanan/bağlanacak para (stok kartlarında ANA sayı)
        //   · satış fiyatı = o malın ciro karşılığı (kayıp kartlarında ANA sayı)
        // Fark ikisinin arasındaki brüt kârdır. Önce ikinci sayı alt açıklama METNİNE
        // gömülüydü → her kartta farklı yerde çıkıyordu ve taranamıyordu. Artık sayının
        // HEMEN ALTINDA sabit konumda.
        // ⚠ ALT SINIR: birim maliyeti bilinmeyen çeşit 0 sayılır (kapsam ~%95).
        string? IkinciDeger = null, string? IkinciEtiket = null,
        // B-172(g): KOHORTUN SAHİBİ. Danışman itirazı — "ölü stok → iade/imha" satınalma+finans,
        // "raf bulunurluk → transfer" operasyon işidir; 8.736 çeşit el değiştirdi ve panelde
        // kimin işi olduğu YAZILI DEĞİLDİ. Sahipsiz kohort toplantıda kimseye düşmez.
        // null = eylem kartı değil (nötr olgu/ölçüm) — sahip uydurulmaz.
        string? Sahip = null,
        // ⚠ KIRILIM ŞERİDİ (12.09.2026, kullanıcı: "bunu bu detayda daha anlaşılır bir kart
        // tasarımı ile yapmak daha mantıklı" + "diğerleri de öyle muhtemelen").
        // Eski dip şerit İKİ ALANLI idi (başlık · değer) ve çeşit sayısı başlık METNİNİN içine
        // gömülüydü → "43.715 çeşit" ile "52,7 milyon ₺" yan yana düşünce hangisinin hangisiyle
        // eşleştiği OKUNMUYORDU (kullanıcı birebir sordu). Şerit artık ÜÇ KOLON: başlık · çeşit ·
        // değer; ve BİRDEN ÇOK satır alabiliyor, böylece alt kohortlar yan yana değil ALT ALTA.
        IReadOnlyList<KpiKirilim>? Kirilim = null,
        bool Kahraman = false);

    /// <summary>
    /// Dip şeridin BİR SATIRI. <c>AltKume</c> = bu satır ana sayının İÇİNDEN bir dilim
    /// (ekranda "↳" ile gösterilir); false ise ayrı bir ölçü/karşı-metrik.
    /// <c>Cesit</c> null olabilir — her karşı-metriğin çeşit karşılığı yok (adet/oran olanlar).
    /// </summary>
    private sealed record KpiKirilim(
        string Baslik, string? Cesit, string Deger,
        SatisDurumFiltre? Durum = null, bool? OdakVar = null, bool AltKume = false);

    /// <summary>
