    /// <summary>
    /// KPI kartına (ya da karşı-metrik satırına) tıkla → listeyi o kohorta filtrele.
    /// Kullanıcı isteği 09.09: "üstüne tıklayınca liste gelmeli".
    /// </summary>
    private async Task KartTikla(SatisDurumFiltre? durum, bool? odakVar, int? minYas)
    {
        if (durum is null) return;
        _filtre = _filtre with
        {
            Durum = durum.Value,
            OdakVar = odakVar,
            MinYasYil = minYas ?? 0,
            Kategori1 = null,
            Sayfa = 1,
        };
        await ListeYenile();
    }

    /// <summary>
    /// KPI ikonları — INLINE SVG. `<i data-lucide>` KULLANILMIYOR: lucide `<i>` düğümünü `<svg>`
    /// ile değiştiriyor, Blazor kendi diff'inde onu bulamayınca circuit çöküyor (29.08 dersi).
    /// İçerik sabit ve bize ait (kullanıcı verisi yok) → MarkupString güvenli.
    /// </summary>

    /// <summary>
    /// KPI ikonları — INLINE SVG. <c>&lt;i data-lucide&gt;</c> KULLANILMIYOR: lucide o düğümü
    /// <c>&lt;svg&gt;</c> ile değiştiriyor, Blazor kendi diff'inde bulamayınca circuit çöküyor
    /// (coding-discipline, 29.08 dersi). İçerik sabit ve bize ait → MarkupString güvenli.
    ///
    /// ⚠ NÖTR RENK (<c>text-base-content/25</c>), kartın vurgu rengiyle BOYANMAZ: renk zaten
    /// sayıda ve dip şeritte: üçüncü kez tekrar edince ikon gürültüye dönüşüyordu. Danışman
    /// "ikonu tamamen at" demişti; kullanıcı geri istedi (10.09) — soluk ve tek renk olarak
    /// döndü, tarama kolaylığı sağlıyor, dikkat çalmıyor.
    /// </summary>
    private static MarkupString Ikon(string ad)
    {
        const string bas = """<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">""";
        var govde = ad switch
        {
            // kutu — stok değeri
            "kutu" => """<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>""",
            // yükselen çizgi — kâr
            "kar" => """<path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/>""",
            // arşiv — hareketsiz
            "arsiv" => """<rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>""",
            // takvim — sezon (SON TARİHİ olan tek kart)
            "takvim" => """<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>""",
            // uyarı — stoksuz
            "uyari" => """<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>""",
            // boş raf — rafı boş, depoda var
            "raf" => """<path d="M2 20h20"/><path d="M4 20V8h6v12"/><path d="M14 20v-6h6v6"/><path d="M4 8 12 3l8 5"/>""",
            // katman — aşırı stok
            "katman" => """<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m6.08 9.5-3.48 1.58a1 1 0 0 0 0 1.83l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83L17.92 9.5"/>""",
            // iki yönlü ok — transfer
            "transfer" => """<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>""",
            // paket — rafa çıkmamış
            "paket" => """<path d="M16.5 9.4 7.5 4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>""",
            // sepet — sipariş ihtiyacı (satınalma)
            "sepet" => """<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>""",
            _ => """<circle cx="12" cy="12" r="9"/>""",
        };
        return new MarkupString(bas + govde + "</svg>");
    }

    private Task TazeDegis(ChangeEventArgs e)
    {
        _filtre = _filtre with { TazeGunHaric = int.TryParse(e.Value?.ToString(), out var g) ? g : 0, Sayfa = 1 };
        return Yukle();   // taze filtresi KPI'yı da değiştirir → özet yeniden alınır
    }

    private Task OdakDegis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        _filtre = _filtre with
        {
            OdakVar = string.IsNullOrEmpty(v) ? null : bool.TryParse(v, out var b) ? b : null,
            Sayfa = 1,
        };
        return ListeYenile();
    }

    /// <summary>
    /// Ürün drill sayfasını aç. TÜM filtre durumu <c>geri</c> parametresinde taşınır ki
    /// "Listeye dön" aynı görünüme dönsün.
    ///
    /// ⚠ Eski sürüm yalnız kesim+sezon taşıyordu VE panel query'den hiçbir şey okumuyordu →
    /// geri dönünce her şey sıfırlanıyordu (kullanıcı bildirimi 09.09: "detaya girip çıkıyorum
    /// seçtiğim ayarlar sıfırlanıyor" · "taşınırsa geri geldiğinde ilk hali oluyor, mantıkta
    /// sorun var"). Haklıydı: taşımak tek başına yetmez, geri okumak da gerekir.
    /// </summary>
    private void UrunAc(int stkId)
    {
        var q = _filtre.SorguDizesi();
        Nav.NavigateTo($"/satis-analizi/urun/{stkId}?kesim={_kesim:yyyy-MM-dd}&sezon={_sezonYil}" +
                       $"&geri={Uri.EscapeDataString(q)}");
    }

    /// <summary>
    /// URL'deki filtre durumunu uygula (drill'den geri dönüş + paylaşılan bağlantı).
    /// Bozuk değer sessizce yutulmaz — kullanıcıya yazılır.
    /// </summary>
    private void FiltreyiUrldenAl()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            new Uri(Nav.Uri).Query);
        if (q.Count == 0) return;

        var sozluk = q.ToDictionary(x => x.Key, x => x.Value.ToString() ?? "");
        _filtre = SatisAnaliziFiltre.Coz(sozluk, _kesim, _sezonYil, out var atlanan);
        _kesim = _filtre.Kesim;
        _sezonYil = _filtre.SezonYil;
        if (atlanan.Count > 0)
            _kolonUyari = $"Bağlantıdaki bazı değerler okunamadı ({string.Join(", ", atlanan)}) — " +
                     "o filtreler varsayılanda kaldı.";
    }

    private async Task KolonlarDegisti(IReadOnlySet<string> yeni)
    {
        _secili = yeni;
        await KolonTercih.YazAsync(_kullanici, EkranAdi, yeni);
    }

    /// <summary>
    /// Excel indirme bağlantısı — filtre + seçili kolonlar query'de taşınır.
    /// Dosya endpoint'te akışta üretilir (circuit'ten GEÇMEZ; 275 bin satırda çöküyordu).
    /// Hücre eşlemesi ortak <see cref="SatisAnaliziHucre"/>'de — ekran ve Excel ayrışmasın.
    /// </summary>
    private string ExcelBaglantisi() =>
        $"/api/satis-analizi-excel?{_filtre.SorguDizesi()}&kolon={Uri.EscapeDataString(string.Join(",", _secili))}";


    private static string Tl(decimal v) => v.ToString("N0") + " ₺";

    /// <summary>
    /// KISA PARA BİÇİMİ — KPI kartları için. <c>sunum-dili.md</c>: "Büyük tutar:
    /// 990.400.000 ₺ değil → 990 milyon TL". 13 karakterlik dizeleri göz KIYASLAYAMAZ;
    /// 8 kartlık şeritte kıyas mümkün olsun diye kısaltılır. Tam hane tabloda ve drill'de.
    /// Negatif değer de doğru biçimlenir (mutlak değere kısaltma uygulanır, işaret korunur).
    /// </summary>
    private static string TlKisa(decimal v)
    {
        var m = Math.Abs(v);
        var isaret = v < 0 ? "−" : "";
        return m >= 1_000_000_000m ? $"{isaret}{m / 1_000_000_000m:N2} milyar ₺"
             : m >= 1_000_000m     ? $"{isaret}{m / 1_000_000m:N1} milyon ₺"
             : m >= 1_000m         ? $"{isaret}{m / 1_000m:N0} bin ₺"
             : $"{isaret}{m:N0} ₺";
    }
