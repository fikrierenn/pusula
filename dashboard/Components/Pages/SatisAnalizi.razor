        new("İÇ KAYNAKLA ÇÖZÜLÜR", "Rafa Çıkmamış Envanter", TlKisa(k.RafsizTutar),
            $"{k.RafsizCesit:N0} çeşit · mağaza rafına hiç girmemiş",
