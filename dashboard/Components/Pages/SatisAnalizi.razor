    /// <summary>
    /// Ürün drill sayfasını aç. TÜM filtre durumu <c>geri</c> parametresinde taşınır ki
    /// "Listeye dön" aynı görünüme dönsün.
    ///
    /// ⚠ Eski sürüm yalnız kesim+sezon taşıyordu VE panel query'den hiçbir şey okumuyordu →
    /// geri dönünce her şey sıfırlanıyordu (kullanıcı bildirimi 09.09: "detaya girip çıkıyorum
    /// seçtiğim ayarlar sıfırlanıyor" · "taşınırsa geri geldiğinde ilk hali oluyor, mantıkta
    /// sorun var"). Haklıydı: taşımak tek başına yetmez, geri okumak da gerekir.
    /// </summary>
    private void UrunAc(int stkId)
    {
        var q = _filtre.SorguDizesi();
        Nav.NavigateTo($"/satis-analizi/urun/{stkId}?kesim={_kesim:yyyy-MM-dd}&sezon={_sezonYil}" +
                       $"&geri={Uri.EscapeDataString(q)}");
    }

    /// <summary>
    /// URL'deki filtre durumunu uygula (drill'den geri dönüş + paylaşılan bağlantı).
    /// Bozuk değer sessizce yutulmaz — kullanıcıya yazılır.
    /// </summary>
    private void FiltreyiUrldenAl()
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
            new Uri(Nav.Uri).Query);
        if (q.Count == 0) return;

        var sozluk = q.ToDictionary(x => x.Key, x => x.Value.ToString() ?? "");
        _filtre = SatisAnaliziFiltre.Coz(sozluk, _kesim, _sezonYil, out var atlanan);
        _kesim = _filtre.Kesim;
        _sezonYil = _filtre.SezonYil;
        if (atlanan.Count > 0)
            _kolonUyari = $"Bağlantıdaki bazı değerler okunamadı ({string.Join(", ", atlanan)}) — " +
                     "o filtreler varsayılanda kaldı.";
    }

    private async Task KolonlarDegisti(IReadOnlySet<string> yeni)
    {
        _secili = yeni;
        await KolonTercih.YazAsync(_kullanici, EkranAdi, yeni);
    }

    /// <summary>
    /// Excel indirme bağlantısı — filtre + seçili kolonlar query'de taşınır.
    /// Dosya endpoint'te akışta üretilir (circuit'ten GEÇMEZ; 275 bin satırda çöküyordu).
    /// Hücre eşlemesi ortak <see cref="SatisAnaliziHucre"/>'de — ekran ve Excel ayrışmasın.
    /// </summary>
    private string ExcelBaglantisi() =>
        $"/api/satis-analizi-excel?{_filtre.SorguDizesi()}&kolon={Uri.EscapeDataString(string.Join(",", _secili))}";


    private static string Tl(decimal v) => v.ToString("N0") + " ₺";

    /// <summary>
    /// KISA PARA BİÇİMİ — KPI kartları için. <c>sunum-dili.md</c>: "Büyük tutar:
    /// 990.400.000 ₺ değil → 990 milyon TL". 13 karakterlik dizeleri göz KIYASLAYAMAZ;
    /// 8 kartlık şeritte kıyas mümkün olsun diye kısaltılır. Tam hane tabloda ve drill'de.
    /// Negatif değer de doğru biçimlenir (mutlak değere kısaltma uygulanır, işaret korunur).
    /// </summary>
    private static string TlKisa(decimal v)
    {
        var m = Math.Abs(v);
        var isaret = v < 0 ? "−" : "";
        return m >= 1_000_000_000m ? $"{isaret}{m / 1_000_000_000m:N2} milyar ₺"
             : m >= 1_000_000m     ? $"{isaret}{m / 1_000_000m:N1} milyon ₺"
             : m >= 1_000m         ? $"{isaret}{m / 1_000m:N0} bin ₺"
             : $"{isaret}{m:N0} ₺";
    }
}
