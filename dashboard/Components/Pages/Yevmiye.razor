@page "/yevmiye-fis"
@using GmDashboard.Data
@using GmDashboard.Models
@inject MuhasebeQueries Muh
@inject NavigationManager Nav
@inject ILogger<Yevmiye> Logger
@rendermode InteractiveServer

<PageTitle>Yevmiye Fişi — BKM GM</PageTitle>

<div class="mb-4 flex items-center gap-3">
    <button class="btn btn-ghost btn-sm" @onclick="@(() => Nav.NavigateTo("/muhasebe"))">← Kontrol</button>
    <div>
        <div class="text-xs text-base-content/50">Yevmiye fişi · mhs.mhsFis</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">@(_fis is null ? "Yevmiye Fişi" : $"Fiş {_fis.YevmiyeNo} · {_fis.Tarih}")</h1>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-error text-sm mb-4"><span>@_error</span></div>
}
else if (_loading)
{
    <p class="text-base-content/40 text-sm py-6 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Fiş yükleniyor…</p>
}
else if (_fis is null)
{
    <div class="alert text-sm"><span>Fiş bulunamadı (fisbID @Fis · şirket @Sirket).</span></div>
}
else
{
    <div class="bg-base-100 border-2 border-base-300 rounded-lg shadow-sm max-w-4xl mx-auto overflow-hidden">

        @* ── Antet ── *@
        <div class="flex items-start justify-between gap-4 px-6 py-4 border-b-2 border-base-300 bg-base-200/40">
            <div>
                <div class="text-lg font-bold tracking-tight">BKM Kitap Kırtasiye</div>
                <div class="text-xs text-base-content/60">Mahsup / Yevmiye Fişi</div>
            </div>
            <div class="text-right text-sm">
                <table class="text-xs border border-base-300">
                    <tr class="border-b border-base-300"><td class="px-2 py-0.5 bg-base-200/60 font-semibold border-r border-base-300">Yevmiye No</td><td class="px-2 py-0.5 font-mono text-right">@_fis.YevmiyeNo</td></tr>
                    <tr><td class="px-2 py-0.5 bg-base-200/60 font-semibold border-r border-base-300">Tarih</td><td class="px-2 py-0.5 font-mono text-right">@_fis.Tarih</td></tr>
                </table>
                @if (!string.IsNullOrWhiteSpace(Kapanis))
                {
                    <div class="text-error font-semibold text-xs mt-1">Ay Kapanışı: @Kapanis</div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_fis.FisAd) || _fis.FaturaEID is not null)
        {
            <div class="px-6 py-2 text-sm text-base-content/70 border-b border-base-200 flex items-center justify-between gap-3">
                @if (!string.IsNullOrWhiteSpace(_fis.FisAd))
                {
                    <span>Açıklama: <span class="font-medium text-base-content">@_fis.FisAd</span></span>
                }
                else { <span></span> }
                @if (_fis.FaturaEID is not null)
                {
                    <button class="btn btn-sm btn-outline btn-primary whitespace-nowrap"
                            @onclick="@(() => Nav.NavigateTo($"/fatura?fat={_fis.FaturaEID}{KapanisQs}"))">
                        🧾 Faturayı Aç@(string.IsNullOrWhiteSpace(_fis.FaturaNo) ? "" : $" ({_fis.FaturaNo})")
                    </button>
                }
            </div>
        }

        @* ── Defter satırları ── *@
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-base-200/50 text-xs text-base-content/60 border-b-2 border-base-300">
                    <th class="text-left px-3 py-2 border-r border-base-300 w-[120px]">Hesap Kodu</th>
                    <th class="text-left px-3 py-2 border-r border-base-300">Hesap Adı / Açıklama</th>
                    <th class="text-right px-3 py-2 border-r border-base-300 w-[130px]">Borç</th>
                    <th class="text-right px-3 py-2 w-[130px]">Alacak</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in _fis.Satirlar)
            {
                <tr class="border-b border-base-200 align-top">
                    <td class="px-3 py-1.5 font-mono text-xs whitespace-nowrap border-r border-base-200">@s.HspKod</td>
                    <td class="px-3 py-1.5 border-r border-base-200">
                        <div class="font-medium">@s.HspAd</div>
                        @if (!string.IsNullOrWhiteSpace(s.UstAd)) { <div class="text-[11px] text-base-content/40">↳ @s.UstAd</div> }
                        @if (!string.IsNullOrWhiteSpace(s.Aciklama)) { <div class="text-[11px] text-base-content/50">@s.Aciklama</div> }
                    </td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono border-r border-base-200 @(s.Borc == 0 ? "text-base-content/20" : "")">@(s.Borc != 0 ? Tl(s.Borc) : "")</td>
                    <td class="px-3 py-1.5 text-right tabular-nums font-mono @(s.Alacak == 0 ? "text-base-content/20" : "")">@(s.Alacak != 0 ? Tl(s.Alacak) : "")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr class="border-t-2 border-base-300 bg-base-200/40 font-bold">
                    <td colspan="2" class="px-3 py-2 text-right border-r border-base-300">TOPLAM</td>
                    <td class="px-3 py-2 text-right tabular-nums font-mono border-r border-base-300">@Tl(_fis.ToplamBorc)</td>
                    <td class="px-3 py-2 text-right tabular-nums font-mono">@Tl(_fis.ToplamAlacak)</td>
                </tr>
            </tfoot>
        </table>

        @* ── Denge + imza ── *@
        <div class="px-6 py-2 text-[11px] border-t border-base-200 @(_fis.Denge < 0.5m ? "text-success" : "text-error font-semibold")">
            @(_fis.Denge < 0.5m ? "✓ Borç = Alacak — fiş dengeli" : "⚠ Denge bozuk · fark " + Tl(_fis.Denge))
        </div>
        @* ── Kayıt bilgisi (kim / ne zaman) ── *@
        <div class="grid grid-cols-3 gap-4 px-6 pt-4 pb-5 text-xs border-t border-base-200">
            <div>
                <div class="text-base-content/50 mb-0.5">Giren</div>
                <div class="font-medium">@(string.IsNullOrWhiteSpace(_fis.Giren) ? "—" : _fis.Giren)</div>
                <div class="text-base-content/40 font-mono">@_fis.GirisT</div>
            </div>
            <div>
                <div class="text-base-content/50 mb-0.5">Son Değiştiren</div>
                <div class="font-medium">@(string.IsNullOrWhiteSpace(_fis.Degistiren) ? "—" : _fis.Degistiren)</div>
                <div class="text-base-content/40 font-mono">@_fis.DegisT</div>
            </div>
            <div>
                <div class="text-base-content/50 mb-0.5">Onaylayan</div>
                <div class="font-medium">@(string.IsNullOrWhiteSpace(_fis.Onaylayan) ? "—" : _fis.Onaylayan)</div>
                <div class="text-base-content/40 font-mono">@_fis.OnayT</div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "fis")] public int Fis { get; set; }
    [SupplyParameterFromQuery(Name = "sirket")] public int Sirket { get; set; }
    [SupplyParameterFromQuery(Name = "kapanis")] public string? Kapanis { get; set; }

    private YevmiyeFis? _fis;
    private bool _loading = true;
    private string? _error;
    private string KapanisQs => string.IsNullOrWhiteSpace(Kapanis) ? "" : $"&kapanis={Uri.EscapeDataString(Kapanis)}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        try { _fis = await Muh.GetYevmiyeFisAsync(Fis, Sirket); }
        catch (Exception ex) { Logger.LogError(ex, "Yevmiye fişi yüklenemedi (fis {Fis})", Fis); _error = $"Yüklenemedi: {ex.Message}"; }
        finally { _loading = false; }
    }

    private static string Tl(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
