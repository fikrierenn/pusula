@page "/satinalma/urun/{StkId:int}"
@using GmDashboard.Data
@using GmDashboard.Models
@using System.Globalization
@inject SatinalmaQueries Satinalma
@inject AyarService Ayar
@inject IJSRuntime JS
@inject ILogger<SatinalmaUrunDetay> Logger
@rendermode InteractiveServer

<PageTitle>@(_ozet?.UrunAd ?? "Ürün") — Alım Detayı</PageTitle>

<div class="mb-3">
    <a href="/satinalma/analiz" class="text-xs link link-hover text-base-content/60 inline-flex items-center gap-1"><i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Alım Analizi</a>
</div>

@if (_loading)
{
    <div class="flex items-center gap-3 py-10 text-base-content/50 text-sm"><span class="loading loading-spinner loading-md"></span> Yükleniyor…</div>
}
else if (_error is not null)
{
    <div class="alert alert-error text-sm"><i data-lucide="alert-triangle" class="w-4 h-4"></i><span>@_error</span></div>
}
else if (_ozet is null)
{
    <div class="text-base-content/50 text-sm py-10">Ürün bulunamadı (kod @StkId).</div>
}
else
{
    @* ── Başlık (resim + ad) ── *@
    <div class="mb-4 flex items-center gap-4">
        @if (!string.IsNullOrEmpty(_ozet.ResimUrl))
        {
            <img src="@_ozet.ResimUrl" alt="@_ozet.UrunAd" loading="lazy" referrerpolicy="no-referrer"
                 class="w-20 h-20 rounded-lg object-contain border border-base-300 bg-base-100 shrink-0 cursor-zoom-in hover:border-primary transition-colors"
                 title="büyütmek için tıkla" @onclick="() => _resimAcik = true"
                 onerror="this.style.display='none'" />
        }
        <div class="min-w-0">
            <div class="flex items-center gap-2 text-xs mb-1">
                <span class="badge badge-sm badge-ghost">@_ozet.Kategori</span>
                <span class="badge badge-sm badge-ghost">@_ozet.Marka</span>
                <span class="text-base-content/40">kod @_ozet.UrunKodu</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight m-0">@_ozet.UrunAd</h1>
        </div>
    </div>

    @* ── TEŞHİS (KANONİK sezonlu model — Alım Analizi çekirdeği, naif ortalama DEĞİL) ── *@
    <div class="rounded-xl border @Kenar p-4 mb-5">
        <div class="flex items-start gap-3">
            <div class="rounded-lg @IkonBg p-2.5 shrink-0"><i data-lucide="@Ikon" class="w-6 h-6"></i></div>
            <div class="flex-1 min-w-0">
                <div class="font-bold text-lg @Txt leading-tight flex items-center gap-2 flex-wrap">
                    @(_analiz?.Degerlendirme ?? "Sezonlu model verisi yok")
                    @if (_analiz?.BulkKanal == true)
                    {
                        <span class="badge badge-warning gap-1" title="Bu ürünün son-12-ay satışının %@(System.Math.Round(_analiz.BulkOran*100))'i toptan/bulk (tek büyük hareket). Retail forecast toplam talebi eksik gösterir — toptan sipariş geldiğinde stok temizlenir.">
                            <i data-lucide="package" class="w-3.5 h-3.5"></i>TOPTAN KANAL %@(System.Math.Round(_analiz.BulkOran*100))
                        </span>
                    }
                </div>
                <div class="text-sm text-base-content/70 mt-0.5">@Yorum</div>
                @if (_analiz?.BulkKanal == true)
                {
                    <details class="mt-1">
                        <summary class="text-warning text-[11px] leading-relaxed cursor-pointer">⚠ Son 12 ayın %@(System.Math.Round(_analiz.BulkOran*100))'i TOPTAN (retail @Num(_analiz.RetailSon12) / ham @Num(_analiz.Son12)). Bu ürün toptan hareket ediyor — FAZLA "retail hızına" göredir; düzenli toptan/okul siparişi alıyorsa stok o kanalla temizlenir. <span class="underline">Toptan hareketleri gör →</span></summary>
                        @if (_bulk.Count > 0)
                        {
                            <div class="overflow-x-auto border border-warning/30 rounded-lg mt-1.5 max-w-md">
                                <table class="table table-xs">
                                    <thead><tr><th>Tarih</th><th>Yer</th><th>Evrak</th><th class="text-right">Adet (tek hareket)</th></tr></thead>
                                    <tbody>
                                    @foreach (var b in _bulk)
                                    {
                                        <tr><td class="whitespace-nowrap text-xs">@b.Tarih.ToString("dd.MM.yy")</td><td class="text-xs">@b.MekanAd</td><td class="text-xs text-base-content/60">@b.EvrakNo</td><td class="text-right tabular-nums font-medium text-warning">@Num(b.Adet)</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                            <div class="text-[10px] text-base-content/40 mt-1">Bulk = SEVK/FATURA belgeleri (depo D01… merkez sevk, kurumsal fatura). POS satışı HARİÇ (günlük-toplam, gerçek retail). Evrak-no = irsaliye belgesi.</div>
                        }
                    </details>
                }
            </div>
        </div>
        @if (_analiz is not null)
        {
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mt-4">
                <div><div class="text-xs text-base-content/50">Eldeki Stok</div><div class="text-lg font-bold">@Num(_ozet.ToplamStok)</div><div class="text-[11px] text-base-content/40">şube @Num(_ozet.SubeStok)·depo @Num(_ozet.DepoStok)</div></div>
                <div><div class="text-xs text-base-content/50">Talep Eğilimi</div><div class="text-lg font-bold @EgilimCls">@EgilimIbare</div><div class="text-[11px] text-base-content/40">@EgilimAltyazi (×@_analiz.Buyume.ToString("0.00", _tr))</div></div>
                <div><div class="text-xs text-base-content/50">Geçen Sezon · @SezonLbl @SezonYil</div><div class="text-lg font-bold text-warning">@Num(_analiz.GySezon)</div><div class="text-[11px] text-base-content/40">forecast tabanı</div></div>
                <div><div class="text-xs text-base-content/50">Bu Sezon Beklenen</div><div class="text-lg font-bold">@Num(_analiz.BeklenenSezon)</div><div class="text-[11px] text-base-content/40">@(FloorAktif ? "son3 retail momentum (floor)" : _analiz.Buyume < 1 ? "geçen sezon (düşüş çift saymaz)" : "geçen sezon×büyüme")</div></div>
                <div><div class="text-xs text-base-content/50">Sezon Sonrası Kalan</div><div class="text-lg font-bold @(_analiz.SezonKalan > _analiz.GySezon ? "text-error" : _analiz.SezonKalan <= 0 ? "text-success" : "")">@Num(_analiz.SezonKalan)</div><div class="text-[11px] text-base-content/40">sezonlu tükenme @(_analiz.TukAy is null ? "—" : _analiz.TukAy >= 999 ? "hiç" : _analiz.TukAy.Value.ToString("0.0", _tr) + " ay")</div></div>
            </div>

            @* ── Model Girdileri: hesabı besleyen HAM döneler + büyüme kaynağı (şeffaflık) ── *@
            <details class="mt-3 border border-base-300 rounded-lg bg-base-200/40">
                <summary class="text-xs font-medium text-base-content/70 px-3 py-2 cursor-pointer select-none flex items-center gap-1.5">
                    <i data-lucide="function-square" class="w-3.5 h-3.5 text-primary"></i>Model Girdileri — büyüme ×@_analiz.Buyume.ToString("0.00", _tr) nereden?
                    <span class="badge badge-sm @KaynakBadgeCls">@KaynakEtiket</span>
                </summary>
                <div class="px-3 pb-3 pt-1 text-xs space-y-2">
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-base-content/80">
                        <div class="bg-base-100 rounded p-2"><div class="text-base-content/50 text-[11px]">Geçen sezon (@SezonLbl @SezonYil)</div><div class="font-bold tabular-nums">@Num(_analiz.GySezon)</div></div>
                        <div class="bg-base-100 rounded p-2"><div class="text-base-content/50 text-[11px]">Önceki yıl sezon</div><div class="font-bold tabular-nums">@Num(_analiz.GySezonOnc)</div><div class="text-[10px] text-base-content/40">büyüme paydası</div></div>
                        <div class="bg-base-100 rounded p-2"><div class="text-base-content/50 text-[11px]">Son 12 ay</div><div class="font-bold tabular-nums">@Num(_analiz.Son12)</div></div>
                        <div class="bg-base-100 rounded p-2"><div class="text-base-content/50 text-[11px]">Önceki 12 ay</div><div class="font-bold tabular-nums">@Num(_analiz.Onc12)</div></div>
                        <div class="bg-base-100 rounded p-2 @(FloorAktif ? "ring-1 ring-success" : "")"><div class="text-base-content/50 text-[11px]">Son 3 Ay Retail</div><div class="font-bold tabular-nums @(FloorAktif ? "text-success" : "")">@Num(_analiz.RetailSon3)</div><div class="text-[10px] text-base-content/40">bulk hariç @(FloorAktif ? "· FLOOR aktif" : "")</div></div>
                    </div>
                    @if (FloorAktif)
                    {
                        <div class="text-success text-[11px] leading-relaxed">✓ Beklenen, sezonluk-taban yerine <b>son3ay retail-momentum</b>'dan geldi (@Num(_analiz.RetailSon3) retail / 3 × sezon-ay = @Num(_analiz.BeklenenSezon)). Ürün son aylarda gerçekten satıyor (bulk hariç) → sezonluk-taban anomalik düşük olsa da FAZLA temkinli.</div>
                    }
                    <div class="text-base-content/70 leading-relaxed">@KaynakAciklama</div>
                </div>
            </details>

            @* ── Şube-bazlı sezon: forecast tabanı kuru şubelerle bastırıldı mı? ── *@
            @if (_subeSezon.Count > 0)
            {
                <details class="mt-2 border border-base-300 rounded-lg bg-base-200/40" open="@KuruBastirma">
                    <summary class="text-xs font-medium text-base-content/70 px-3 py-2 cursor-pointer select-none flex items-center gap-1.5">
                        <i data-lucide="store" class="w-3.5 h-3.5 text-primary"></i>Geçen Yıl @SezonYil @SezonLbl Sezonu — Şube Stok Durumu (forecast tabanı)
                        @if (KuruBastirma)
                        {
                            <span class="badge badge-sm badge-warning">taban bastırılmış olabilir</span>
                        }
                    </summary>
                    <div class="px-3 pb-3 pt-1 text-xs space-y-2">
                        <div class="overflow-x-auto">
                            <table class="table table-xs">
                                <thead><tr><th>Şube</th><th class="text-right">@SezonYil Sezon Satış</th><th class="text-right">@SezonYil Sezon Max Raf Stok</th><th>Durum</th></tr></thead>
                                <tbody>
                                @foreach (var s in _subeSezon)
                                {
                                    <tr>
                                        <td class="font-medium">@s.Ad</td>
                                        <td class="text-right tabular-nums">@Num(s.Satis)</td>
                                        <td class="text-right tabular-nums">@Num(s.MaxStok)</td>
                                        <td>@if (s.Kuru) { <span class="text-error font-medium">● kuru (stok yok)</span> } else { <span class="text-success">● stok vardı</span> }</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-base-content/70 leading-relaxed">@SubeSezonAciklama</div>
                    </div>
                </details>
            }
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        @* ── Alış faturaları ── *@
        <div>
            <h2 class="text-sm font-semibold mb-2 flex items-center gap-1.5"><i data-lucide="receipt-text" class="w-4 h-4 text-primary"></i>Alış Faturaları <span class="text-xs text-base-content/50 font-normal">(son @_fatura.Count)</span></h2>
            @if (_fatura.Count == 0)
            {
                <div class="text-base-content/50 text-sm py-4 border border-base-300 rounded-lg text-center">Alış faturası yok.</div>
            }
            else
            {
                <div class="overflow-x-auto border border-base-300 rounded-lg">
                    <table class="table table-xs">
                        <thead><tr><th>Tarih</th><th>Belge</th><th>Tedarikçi</th><th class="text-right">Adet</th><th class="text-right">Tutar ₺</th><th class="text-right">Birim ₺</th></tr></thead>
                        <tbody>
                        @foreach (var f in _fatura)
                        {
                            <tr class="hover">
                                <td class="whitespace-nowrap text-xs">@f.Tarih.ToString("dd.MM.yy")</td>
                                <td class="text-xs text-base-content/60">@f.BelgeNo</td>
                                <td class="max-w-[150px] truncate text-xs" title="@f.Tedarikci">@f.Tedarikci</td>
                                <td class="text-right tabular-nums">@Num(f.Adet)</td>
                                <td class="text-right tabular-nums">@Tl(f.Tutar)</td>
                                <td class="text-right tabular-nums font-semibold">@Tl(f.Birim)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ── Aylık satış grafiği + tablo ── *@
        <div>
            <h2 class="text-sm font-semibold mb-2 flex items-center gap-1.5"><i data-lucide="bar-chart-3" class="w-4 h-4 text-info"></i>Aylık Satış <span class="text-xs text-base-content/50 font-normal">(son 24 ay · şube + e-tic)</span></h2>
            <div class="border border-base-300 rounded-lg p-3 mb-2">
                <div style="height:200px"><canvas id="satisChart"></canvas></div>
                <div class="flex items-center gap-3 text-[11px] text-base-content/50 mt-1.5 justify-center">
                    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-primary"></span>normal ay</span>
                    <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-warning"></span>@SezonLbl</span>
                </div>
            </div>
            <details class="border border-base-300 rounded-lg">
                <summary class="text-xs text-base-content/60 px-3 py-1.5 cursor-pointer select-none">Aylık döküm (tablo)</summary>
                <div class="overflow-x-auto">
                    <table class="table table-xs">
                        <thead><tr><th>Ay</th><th class="text-right">Şube</th><th class="text-right">E-tic</th><th class="text-right">Toplam</th></tr></thead>
                        <tbody>
                        @foreach (var a in _satis)
                        {
                            <tr class="hover @(a.Toplam == 0 ? "opacity-40" : "")">
                                <td class="whitespace-nowrap text-xs">@a.Ay</td>
                                <td class="text-right tabular-nums">@Num(a.Sube)</td>
                                <td class="text-right tabular-nums text-info">@Num(a.Etic)</td>
                                <td class="text-right tabular-nums font-semibold">@Num(a.Toplam)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        </div>
    </div>

    @* ── Resim büyütme (lightbox) ── *@
    @if (_resimAcik && !string.IsNullOrEmpty(_ozet.ResimUrl))
    {
        <div class="fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-6 cursor-zoom-out" @onclick="() => _resimAcik = false">
            <img src="@BuyukUrl" alt="@_ozet.UrunAd" referrerpolicy="no-referrer"
                 class="max-h-[88vh] max-w-[88vw] rounded-lg bg-base-100 shadow-2xl"
                 onerror="this.onerror=null;this.src='@_ozet.ResimUrl'" />
        </div>
    }
}

@code {
    [Parameter] public int StkId { get; set; }

    static readonly CultureInfo _tr = CultureInfo.GetCultureInfo("tr-TR");
    bool _loading = true;
    string? _error;
    SatinalmaUrunOzet? _ozet;
    List<SatinalmaFaturaSatir> _fatura = new();
    List<SatinalmaAySatis> _satis = new();
    List<SatinalmaSubeSezon> _subeSezon = new();
    List<SatinalmaBulkHareket> _bulk = new();

    SatinalmaAnalizSatir? _analiz;   // KANONİK sezonlu model (tek-ürün, Alım Analizi çekirdeği)

    // SABİT sezon (kaymaz — tarih kayar) — SatinalmaSezon tek kaynak. En yakın gelen sezon (Okul/Ara Tatil/Sömestr/Yaz).
    readonly (string SEZb, string SEZe, string PSEZb, string PSEZe, string Ad, string[] AylarMM) _sez =
        SatinalmaSezon.Hesapla(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-1).ToString("yyyyMMdd"));
    string SezonLbl => _sez.Ad;          // ör "Okul (Ağu-Eki)"
    string SezonYil => _sez.SEZb.Length >= 4 ? _sez.SEZb.Substring(0, 4) : "";   // geçen-yıl sezon yılı (ör "2025")
    string[] SezonMM => _sez.AylarMM;    // bu-yıl sezon ayları → chart highlight (warning)

    bool _resimAcik;
    string BuyukUrl => string.IsNullOrEmpty(_ozet?.ResimUrl) ? "" : _ozet!.ResimUrl.Replace("-K.jpg", "-B.jpg");

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var tOzet = Satinalma.GetUrunOzetAsync(StkId);
            var tFat = Satinalma.GetFaturaDetayAsync(StkId);
            var tSat = Satinalma.GetAySatisAsync(StkId);
            var tAnaliz = Satinalma.GetUrunAnalizAsync(StkId);
            var tSube = Satinalma.GetSubeSezonAsync(StkId);
            var tBulk = Satinalma.GetBulkHareketAsync(StkId, Ayar.Deger.SatinRetailCap);
            await Task.WhenAll(tOzet, tFat, tSat, tAnaliz, tSube, tBulk);
            _ozet = await tOzet;
            _fatura = (await tFat).ToList();
            _satis = (await tSat).ToList();
            _analiz = await tAnaliz;
            _subeSezon = (await tSube).ToList();
            _bulk = (await tBulk).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ürün alım detayı yüklenemedi (stkID {Id})", StkId);
            _error = "Detay yüklenemedi. Lütfen tekrar deneyin.";
        }
        finally { _loading = false; StateHasChanged(); }
    }

    string Yorum
    {
        get
        {
            var a = _analiz;
            if (a is null) return "Sezonlu model verisi hesaplanamadı.";
            var s = a.Grup switch
            {
                "ÖLÜ-ALIM" => $"Son 12 ayda hiç satış yok; buna rağmen ~{a.StokluAy} ay şube stoğu vardı (az da olsa, satabilirdi) → 'ölü'. Bu dönem yine alım yapılmış. Miktar/bağlı-para küçükse öncelik düşük.",
                "YENİDEN-STOK" => "Stoksuzdu (eski talep vardı), yeniden stoklanmış — ölü değil, izlemek yeterli.",
                "GENÇ" => "Yeni ürün — tam bir yıllık/sezonluk geçmişi yok, hüküm için erken.",
                "AZ ALMIŞ" or "TREND-HIZLI" => $"Geçen {SezonLbl} sezonunda {Num(a.GySezon)} sattı; bu sezon ~{Num(a.BeklenenSezon)} bekleniyor. Eldeki stok sezonu zor karşılar (sezon sonrası {Num(a.SezonKalan)}) — stockout riski, az alınmış.",
                "FAZLA" => $"Geçen sezon {Num(a.GySezon)} sattı; büyümeyle bu sezon ~{Num(a.BeklenenSezon)} bekleniyor ama sezon sonrası hâlâ ~{Num(a.SezonKalan)} kalır — ihtiyaçtan fazla.",
                _ => $"Geçen {SezonLbl} sezonunda {Num(a.GySezon)} sattı · büyüme ×{a.Buyume.ToString("0.0", _tr)} → bu sezon ~{Num(a.BeklenenSezon)} bekleniyor · sezon sonrası ~{Num(System.Math.Max(0, a.SezonKalan))} kalır.",
            };
            if (KuruBastirma)
                s += $" ⚠ Ama geçen sezon {KuruSubeAd} stoksuzdu → gerçek talep bu sayının üstünde olabilir; kararı temkinli yorumla.";
            return s;
        }
    }

    // ── Şube-bazlı sezon: forecast tabanı kuru şubelerle bastırıldı mı? ──
    // Bastırma = EN AZ bir şube kuru (stok yok) VE EN AZ bir şube stoklu (yani talep sinyali asimetrik, sıfır-toplam değil).
    bool KuruBastirma => _subeSezon.Count > 0 && _subeSezon.Any(x => x.Kuru) && _subeSezon.Any(x => !x.Kuru);
    string KuruSubeAd => string.Join(", ", _subeSezon.Where(x => x.Kuru).Select(x => x.Ad));
    string StokluSubeAd => string.Join(", ", _subeSezon.Where(x => !x.Kuru).Select(x => x.Ad));
    string SubeSezonAciklama
    {
        get
        {
            if (_subeSezon.Count == 0) return "";
            if (KuruBastirma)
                return $"Geçen yıl ({SezonYil}) {SezonLbl} sezonunda {KuruSubeAd} raf stoğu yoktu → o şube(ler)de satış imkânsızdı. Sadece {StokluSubeAd} stokluydu. "
                     + $"Yani sezon satışı (forecast tabanı {Num(_analiz?.GySezon ?? 0)}) gerçek talebin ALTINDA — tam dağıtımla daha yüksek olurdu. FAZLA/beklenen sayısını buna göre temkinli oku.";
            if (_subeSezon.All(x => x.Kuru))
                return $"Geçen yıl ({SezonYil}) {SezonLbl} sezonunda TÜM şubeler kuruydu → sezon satışı stok yokluğundan bastırılmış; talep tabanı güvenilmez (stok gelince gerçek talep görülür).";
            return $"Geçen yıl ({SezonYil}) {SezonLbl} sezonunda tüm aktif şubelerde stok vardı → sezon satışı gerçek talebi yansıtır (stok-kısıtı yok).";
        }
    }

    // Talep eğilimi (büyüme g → ±% yön) — "0.8" yerine "↓ %16 düşüş".
    string EgilimIbare
    {
        get
        {
            var g = _analiz?.Buyume ?? 1m;
            if (g > 1.05m) return $"↑ %{System.Math.Round((g - 1) * 100)} artış";
            if (g < 0.95m) return $"↓ %{System.Math.Round((1 - g) * 100)} düşüş";
            return "→ sabit";
        }
    }
    string EgilimCls
    {
        get { var g = _analiz?.Buyume ?? 1m; return g > 1.05m ? "text-success" : g < 0.95m ? "text-error" : "text-base-content/60"; }
    }

    // Retail-momentum FLOOR aktif mi (beklenen sezonluk-taban yerine son3 retail'den mi geldi)?
    bool FloorAktif
    {
        get
        {
            if (_analiz is null) return false;
            var floor = _analiz.RetailSon3 / 3.0 * _sez.AylarMM.Length;
            var seasonal = _analiz.GySezon * System.Math.Max(1.0, (double)_analiz.Buyume);
            return floor > seasonal && floor > 0;
        }
    }

    // Büyüme kaynağı (3-katman: sezon/ürün/kategori) — etiket + renk + hangi tabana göre.
    string EgilimAltyazi => _analiz?.BuyumeKaynak switch
    {
        "sezon" => "kendi sezon YoY'una göre",
        "ürün" => "kendi yıllık (sezon-dışı) YoY'una göre",
        "kategori" => "kategori büyümesine göre (kendi verisi yetersiz)",
        _ => "geçmişe göre",
    };
    string KaynakEtiket => _analiz?.BuyumeKaynak switch
    {
        "sezon" => "SEZON", "ürün" => "YILLIK", "kategori" => "KATEGORİ", _ => "—",
    };
    string KaynakBadgeCls => _analiz?.BuyumeKaynak switch
    {
        "sezon" => "badge-success", "ürün" => "badge-info", "kategori" => "badge-warning", _ => "badge-ghost",
    };
    // Hangi tier neden ateşlendi — HAM sayılarla (SEZMIN=30 önceki-yıl-sezon tabanı, 100 yıllık-payda eşiği).
    string KaynakAciklama
    {
        get
        {
            var a = _analiz; if (a is null) return "";
            var g = a.Buyume.ToString("0.00", _tr);
            return a.BuyumeKaynak switch
            {
                "sezon" => $"Önceki-yıl sezon tabanı {Num(a.GySezonOnc)} ≥ 30 → ürünün KENDİ sezon büyümesi kullanıldı: {Num(a.GySezon)} ÷ {Num(a.GySezonOnc)} = ×{g}.",
                "ürün" => $"Sezon tabanı ({Num(a.GySezonOnc)}) 30 altında kaldı; yıllık sezon-dışı taban ({Num(a.Onc12 - a.GySezonOnc)}) ≥ 100 → yıllık YoY: ({Num(a.Son12)}−{Num(a.GySezon)}) ÷ ({Num(a.Onc12)}−{Num(a.GySezonOnc)}) = ×{g}.",
                "kategori" => $"Ürünün kendi tabanı ince (önceki-yıl sezon {Num(a.GySezonOnc)} < 30 VE yıllık sezon-dışı {Num(a.Onc12 - a.GySezonOnc)} < 100) → güvenilir kendi-büyümesi çıkmadı, kategori büyümesi ×{g} kullanıldı. Bu ürüne özel bir talep sinyali DEĞİL.",
                _ => $"Büyüme ×{g}.",
            };
        }
    }

    string Txt => _analiz?.Grup switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "text-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "text-warning",
        "AZ ALMIŞ" or "NORMAL" => "text-success",
        _ => "text-base-content/60",
    };
    string Kenar => _analiz?.Grup switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "border-error/40 bg-error/5",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "border-warning/40 bg-warning/5",
        "AZ ALMIŞ" or "NORMAL" => "border-success/40 bg-success/5",
        _ => "border-base-300",
    };
    string IkonBg => _analiz?.Grup switch
    {
        "FAZLA" or "ÖLÜ-ALIM" => "bg-error/10 text-error",
        "TREND-HIZLI" or "YENİDEN-STOK" or "İZLE" or "UZUN-KUYRUK" or "KÜÇÜK-ALIM" => "bg-warning/10 text-warning",
        "AZ ALMIŞ" or "NORMAL" => "bg-success/10 text-success",
        _ => "bg-base-200 text-base-content/50",
    };
    string Ikon => _analiz?.Grup switch
    {
        "FAZLA" => "alert-triangle", "ÖLÜ-ALIM" => "skull", "AZ ALMIŞ" => "trending-down",
        "İZLE" => "eye", "YENİDEN-STOK" => "rotate-ccw", "NORMAL" => "check-circle", "GENÇ" => "sprout",
        _ => "help-circle",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _satis.Count == 0) return;
        try
        {
            var charts = await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");
            await charts.InvokeVoidAsync("barSez", "satisChart",
                _satis.Select(s => s.Ay).ToArray(), _satis.Select(s => s.Toplam).ToArray(),
                SezonMM);   // kayan önümüz-sezon ayları ayrı renk (warning)
        }
        catch { /* prerender / import başarısız → tablo yeter */ }
    }

    static string Num(int n) => n.ToString("#,##0", _tr);
    static string Tl(decimal d) => d.ToString("#,##0.##", _tr) + " ₺";
}
