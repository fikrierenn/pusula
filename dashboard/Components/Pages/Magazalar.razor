@page "/magazalar"
@using GmDashboard.Data
@using GmDashboard.Models
@implements IDisposable
@inject Queries Queries
@inject GunKarsilastirQueries GunQ
@inject PerfState Perf
@inject ILogger<Magazalar> Logger
@inject PersistentComponentState AppState
@rendermode InteractiveServer

@* Mağazalar — 3 mağaza yan yana karşılaştırma. Her kart <a href="magaza/{id}"> (B-48 SSR-güvenli).
   Dönem query param (d) — masaüstü pills interaktif, mobilde varsayılan. *@

<PageTitle>Mağazalar — Karşılaştırma</PageTitle>

<div class="flex items-center gap-2 mb-4">
    <a href="@($"")" class="w-9 h-9 rounded-xl bg-base-100 border border-base-200 flex items-center justify-center shrink-0 no-underline text-base-content" aria-label="Geri"><i data-lucide="chevron-left" class="w-5 h-5"></i></a>
    <div class="min-w-0">
        <div class="text-xs text-base-content/50">3 mağaza yan yana · @_wowLabel</div>
        <h1 class="text-2xl font-bold tracking-tight m-0 truncate">Mağazalar — Karşılaştırma</h1>
    </div>
</div>
<AppPeriodPills Period="_period" PeriodChanged="SetPeriod" Busy="_loading" CssClass="mb-4 lg:max-w-xl" />
@if (_period == "ozel")
{
    <div class="flex gap-2 mb-4 flex-wrap">
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBas" @bind:after="LoadAsync" />
        <input type="date" class="input input-bordered input-sm text-sm font-semibold" @bind="_ozelBit" @bind:after="LoadAsync" />
    </div>
}

@if (_loading)
{
    <p class="text-base-content/50">Yükleniyor…</p>
}
else if (_error is not null)
{
    <p class="text-error font-semibold">Veri alınamadı: @_error</p>
}
else if (_data is not null)
{
    var enYuksek = _data.Stores.Count > 0 ? _data.Stores.Max(s => s.Net) : 0m;
    <div class="text-base-content/50 text-xs mb-3">@_aralik · mağazaya dokun → detay</div>
    <div class="grid grid-cols-1 gap-2.5 mb-5 lg:grid-cols-3">
        @{ var paletIdx = 0; var palet = new[] { ("bg-success/15", "text-success"), ("bg-info/15", "text-info"), ("bg-warning/15", "text-warning") }; }
        @foreach (var s in _data.Stores)
        {
            var (bg, fg) = palet[paletIdx++ % palet.Length];
            var lider = enYuksek > 0 && s.Net == enYuksek;
            <a href="@($"magaza/{s.MekanId}")" class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 no-underline text-base-content transition-transform active:scale-[.98] hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center gap-2.5 mb-3">
                    <div class="@bg @fg w-11 h-11 rounded-2xl flex items-center justify-center shrink-0"><i data-lucide="store" class="w-[22px] h-[22px]"></i></div>
                    <div class="min-w-0 flex-1">
                        <div class="text-[15px] font-bold text-base-content/90 truncate">@s.Ad</div>
                        @if (lider)
                        {
                            <div class="text-[10px] font-bold text-success inline-flex items-center gap-0.5"><i data-lucide="crown" class="w-3 h-3"></i>en yüksek ciro</div>
                        }
                    </div>
                    <i data-lucide="chevron-right" class="w-[18px] h-[18px] text-base-content/30 shrink-0"></i>
                </div>
                <div class="text-[26px] font-extrabold tracking-tight whitespace-nowrap mb-0.5">@Tl(s.Net)</div>
                @if (s.Wow is not null)
                {
                    var t = TrendIco(s.Wow.Value);
                    <div class="inline-flex items-center gap-0.5 text-[12px] font-bold mb-3 @t.cls" title="@_wowLabel"><i data-lucide="@t.ico" class="w-3.5 h-3.5"></i>@Pct(s.Wow.Value)</div>
                }
                else
                {
                    <div class="text-[12px] text-base-content/40 mb-3">trend yok</div>
                }
                <div class="grid grid-cols-3 gap-2 pt-3 border-t border-base-200">
                    <div><div class="text-[10px] text-base-content/50">Fiş</div><div class="text-[14px] font-bold whitespace-nowrap">@Num(s.Fis)</div></div>
                    <div><div class="text-[10px] text-base-content/50">Sepet</div><div class="text-[14px] font-bold whitespace-nowrap">@Num(s.Atv) ₺</div></div>
                    <div><div class="text-[10px] text-base-content/50">İade</div><div class="text-[14px] font-bold whitespace-nowrap">@Tl(s.Iade)</div></div>
                </div>
                @if (_period == "ay" && s.GerPct is not null)
                {
                    <div class="flex items-center justify-between gap-2 mt-3 pt-3 border-t border-base-200">
                        <span class="text-[11px] text-base-content/50">Hedef (MTD)</span>
                        <span class="text-[13px] font-bold @GerRenk(s.GerPct)">%@s.GerPct</span>
                    </div>
                }
            </a>
        }
    </div>
    <!-- Karşılaştırma bar (bu dönem vs geçen dönem). prevNet = Net/(1+Wow%). plan-13. -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-w-0 mb-5">
        <h3 class="text-[15px] font-bold tracking-tight text-base-content/90 mb-3 flex items-center gap-2">
            <i data-lucide="bar-chart-2" class="w-[18px] h-[18px] text-primary"></i>Mağaza Karşılaştırma
        </h3>
        <div style="height:160px">
            <ApexChart TItem="StoreCard" Options="_barOpts" Height="160">
                <ApexPointSeries TItem="StoreCard" Items="_data.Stores" Name="Bu dönem" SeriesType="SeriesType.Bar"
                                 XValue="@(s => (object)s.Ad)" YValue="@(s => (decimal?)s.Net)" />
                <ApexPointSeries TItem="StoreCard" Items="_data.Stores.Where(s => s.Wow is not null).ToList()" Name="Geçen dönem" SeriesType="SeriesType.Bar"
                                 XValue="@(s => (object)s.Ad)" YValue="@(s => (decimal?)Math.Round(s.Net / (1 + s.Wow!.Value / 100), 0))" />
            </ApexChart>
        </div>
    </div>

    <div class="flex gap-2 mb-5">
        <a href="@($"toplam?d={_period}")" class="flex-1 inline-flex items-center justify-center gap-1.5 text-[13px] font-semibold py-2.5 rounded-xl bg-base-100 border border-base-200 no-underline text-primary transition-colors hover:bg-base-200/40"><i data-lucide="chart-pie" class="w-4 h-4"></i>Kategori dağılımı</a>
    </div>
}


@*  ── GÜN KARŞILAŞTIRMA (12.09.2026, GMY isteği) ─────────────────────────────
    "geçen yıl okul açılışı öncesi hafta sonu mağaza bazlı cumartesi pazar cirosu lazım,
     bugün de İstanbul Yolu Sınav ve Sınav hariç ciro" → "aynısını altına müşteri sayısı"
    Excel ikizi: scripts/hafta_sonu_magaza_ciro_excel.py (AYNI iş mantığı).
    ⚠ Tasarım GMY tarafından onaylandı: üstte CİRO, altta MÜŞTERİ SAYISI, aynı satırlar.     *@
<div class="card bg-base-100 border border-base-300 rounded-2xl p-[18px] mt-5">
    <div class="flex flex-wrap items-end gap-3 mb-1">
        <div class="min-w-0">
            <h3 class="text-sm font-semibold m-0">Gün Karşılaştırma</h3>
            <div class="text-[11px] text-base-content/50">kasa tarafı · KDV dahil · iade kaynağına yazıldı</div>
        </div>
        <div class="flex gap-2 items-end ml-auto flex-wrap">
            <label class="text-[11px] text-base-content/50">
                Gün<input type="date" class="input input-bordered input-sm text-sm block" @bind="_gun" @bind:after="GunYukle" />
            </label>
            <label class="text-[11px] text-base-content/50">
                Kıyas<input type="date" class="input input-bordered input-sm text-sm block" @bind="_kiyas" @bind:after="GunYukle" />
            </label>
        </div>
    </div>

    @if (_gunHata is not null)
    {
        <div class="alert alert-error text-sm mt-2"><span>@_gunHata</span></div>
    }
    else if (_gunVeri is null)
    {
        <p class="text-base-content/50 text-sm mt-2">Yükleniyor…</p>
    }
    else
    {
        @foreach (var (baslik, ciro) in new[] { ("CİRO (₺)", true), ("MÜŞTERİ SAYISI (fiş)", false) })
        {
            <div class="text-[11px] uppercase tracking-wider text-base-content/45 font-semibold mt-4 mb-1">@baslik</div>
            <div class="overflow-x-auto">
                <table class="table table-xs w-full">
                    <thead>
                        <tr class="text-base-content/50">
                            <th>Mağaza</th>
                            <th class="text-right">@_kiyas.ToString("ddd dd.MM.yy", _tr)</th>
                            <th class="text-right">@_gun.ToString("ddd dd.MM.yy", _tr)</th>
                            <th class="text-right">Fark</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (etiket, mag, sinav) in _satirlar)
                        {
                            var a = Bul(_gunVeri.Kiyas, mag, sinav, ciro);
                            var b = Bul(_gunVeri.Bugun, mag, sinav, ciro);
                            var fark = a == 0 ? (decimal?)null : (b - a) / a * 100m;
                            <tr>
                                <td class="whitespace-nowrap">@etiket</td>
                                <td class="text-right tabular-nums">@Say(a)</td>
                                <td class="text-right tabular-nums font-semibold">@Say(b)</td>
                                <td class="text-right tabular-nums @(fark is null ? "text-base-content/40" : fark >= 0 ? "text-success" : "text-error")">
                                    @(fark is null ? "—" : Pct(fark.Value))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="text-[11px] text-base-content/50 leading-snug mt-3 space-y-1">
            <div>
                Müşteri sayısı = <b>fiş sayısı</b>. Tekil müşteri değil — kartsız satış anonimdir.
            </div>
            @*  ⚠ Varsayılan kıyas −364 gün = aynı HAFTA GÜNÜ. Sezon başında bu YANILTIR:
                okul açılışı yıldan yıla kayıyor (2025-26 → 08.09.2025 · 2026-27 → 14.09.2026,
                6 gün). Ölçülen sonuç: −364 günlük varsayılanla Sınav farkı +%435,9 çıkıyor,
                çünkü kıyas günü açılıştan SONRAKİ cumartesi. Uyarı ekranda durmalı — yoksa
                okuyan bu oranı gerçek büyüme sanır.                                            *@
            <div class="text-warning">
                Kıyas günü varsayılanı <b>aynı hafta günü</b> (−364). Okul açılışı yıldan yıla
                kayar (2025 → 08.09 · 2026 → 14.09); sezon başında takvim kıyası yanıltır.
                Okul-hizalı kıyas için kıyas tarihini <b>elle seç</b>.
            </div>
            <div>
                İade kaynağına yazıldı: Sınav iadesi Sınav'dan, perakende iadesi perakendeden
                düşüldü. Başka mağazada kesilen iade o mağazanın cirosuna yazılır.
                @if (_belirsiz > 0)
                {
                    <span class="text-warning">Kaynağı çözülemeyen iade @Tl(_belirsiz) — hiçbir kanaldan düşülmedi.</span>
                }
            </div>
            @if (_gunVeri.KesimDk < 24 * 60)
            {
                <div class="text-error">
                    @_gun.ToString("dd.MM.yyyy") henüz kapanmadı — iki gün de
                    <b>@($"{_gunVeri.KesimDk / 60:00}:{_gunVeri.KesimDk % 60:00}")</b>'a kadar toplandı (adil kıyas).
                    Kasa→ERP aktarımı saatte bir; bu tablo <b>kasa</b> tarafındandır.
                </div>
            }
        </div>
    }
</div>

@code {
    // ── GÜN KARŞILAŞTIRMA ──────────────────────────────────────────────────────
    private static readonly System.Globalization.CultureInfo _tr =
        System.Globalization.CultureInfo.GetCultureInfo("tr-TR");

    private DateOnly _gun = DateOnly.FromDateTime(DateTime.Today);
    // Varsayılan kıyas: BİR YIL ÖNCEKİ AYNI HAFTA GÜNÜ (takvim günü değil).
    // ⚠ Okul açılışı yıldan yıla kayıyor (2025-26 → 08.09.2025 · 2026-27 → 14.09.2026, 6 gün);
    // takvim günü kıyası sezon başında YANILTIR. Hafta günü hizası daha yakın bir vekildir,
    // ama okul-hizalı kıyas isteyen tarihi ELLE seçmelidir (arşiv: okul-hizali-ciro-tahmini).
    private DateOnly _kiyas = DateOnly.FromDateTime(DateTime.Today).AddDays(-364);
    private GunKarsilastirSonuc? _gunVeri;
    private string? _gunHata;
    private decimal _belirsiz;

    // (etiket, mağaza adı parçası, Sınav satırı mı)
    private static readonly (string, string, bool)[] _satirlar =
    [
        ("FSM", "FSM", false),
        ("Özlüce", "ÖZLÜCE", false),
        ("İst.Yolu (Sınav hariç)", "IST YOLU", false),
        ("İst.Yolu — Sınav", "IST YOLU", true),
    ];

    private async Task GunYukle()
    {
        _gunVeri = null; _gunHata = null; StateHasChanged();
        try
        {
            // Kapanmamış gün varsa İKİ GÜN DE aynı dakikaya kadar toplanır — yoksa kıyas yanıltır.
            var kesim = GunKarsilastirQueries.BugunIcinKesim(_gun)
                        ?? GunKarsilastirQueries.BugunIcinKesim(_kiyas);
            _gunVeri = await GunQ.GetirAsync(_gun, _kiyas, kesim);
            _belirsiz = _gunVeri.Bugun.Sum(x => x.IadeBelirsiz) + _gunVeri.Kiyas.Sum(x => x.IadeBelirsiz);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gün karşılaştırma hatası");
            _gunHata = "Gün karşılaştırma alınamadı.";   // ayrıntı log'a, kullanıcıya generic
        }
        finally { StateHasChanged(); }
    }

    /// <summary>Satırın değeri. Sınav satırı da MAĞAZA süzgeçlidir (kanal mağazaya bağlandı).</summary>
    private static decimal Bul(IReadOnlyList<GunMagazaSatir> v, string mag, bool sinav, bool ciro)
        => v.Where(x => x.Magaza.Contains(mag, StringComparison.OrdinalIgnoreCase))
            .Sum(x => ciro ? (sinav ? x.SinavDahil : x.PerakendeDahil)
                           : (sinav ? x.SinavBelge : x.Fis));

    private static string Say(decimal n) => n.ToString("#,##0", _tr);

    [SupplyParameterFromQuery(Name = "d")] public string? Donem { get; set; }

    private string _period = "gunluk";
    private DateTime? _ozelBas = DateTime.Today.AddDays(-7);
    private DateTime? _ozelBit = DateTime.Today.AddDays(-1);
    private bool _loading = true;
    private string? _error;
    private string _aralik = "";
    private string _wowLabel = "önceki döneme göre";
    private PeriodSummary? _data;
    private static readonly string[] _gecerliDonem = { "gunluk", "haftalik", "ay", "ozel" };

    // Özel aralık: başlangıç ≤ bitiş güvence, endExcl = bitiş+1 gün
    private (DateOnly, DateOnly) OzelAralik()
    {
        var b = DateOnly.FromDateTime(_ozelBas ?? DateTime.Today.AddDays(-7));
        var e = DateOnly.FromDateTime(_ozelBit ?? DateTime.Today.AddDays(-1));
        if (e < b) e = b;
        return (b, e.AddDays(1));
    }

    private readonly ApexChartOptions<StoreCard> _barOpts = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        Colors = new List<string> { "#4f46e5", "#94a3b8" },
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 4, BarHeight = "60%" } },
        DataLabels = new DataLabels
        {
            Enabled = true,
            Formatter = "function(v){return v==null?'':Math.abs(v)>=1e6?(v/1e6).toLocaleString('tr-TR',{maximumFractionDigits:1})+'M':Math.round(v).toLocaleString('tr-TR')}",
            Style = new DataLabelsStyle { FontSize = "10px", Colors = new List<string> { "#475569" } },
            OffsetX = 18,
        },
        Grid = new Grid { Show = false },
        Legend = new Legend { Show = true, Position = LegendPosition.Bottom, FontSize = "11px" },
        Xaxis = new XAxis { AxisBorder = new AxisBorder { Show = false }, AxisTicks = new AxisTicks { Show = false } },
        Tooltip = new Tooltip { Enabled = true },
    };

    private PersistingComponentStateSubscription _persistSub;

    protected override Task OnInitializedAsync()
    {
        _persistSub = AppState.RegisterOnPersisting(PersistData);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Donem) && _gecerliDonem.Contains(Donem)) _period = Donem;
        if (AppState.TryTakeFromJson<string>("mags_period", out var p) && p == _period &&
            AppState.TryTakeFromJson<PeriodSummary>("mags_data", out var d) && d is not null &&
            AppState.TryTakeFromJson<string>("mags_aralik", out var ar) &&
            AppState.TryTakeFromJson<string>("mags_wowlabel", out var wl))
        {
            _data = d; _aralik = ar ?? ""; _wowLabel = wl ?? "";
            _loading = false; StateHasChanged();
            return;
        }
        await LoadAsync();
    }

    /// <summary>
    /// Gün karşılaştırması YALNIZ etkileşimli ilk render'da çekilir.
    /// ⚠ <c>OnParametersSetAsync</c>'e konmuştu ve ÇALIŞMIYORDU: kalıcı durum (prerender
    /// state) bulunduğunda o metot erken <c>return</c> ediyor ve çağrı atlanıyordu —
    /// bölüm ekranda sonsuza dek "Yükleniyor…" kalıyordu. Ayrıca prerender'da da
    /// koşmasın: sorgu iki kez gider.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _gunVeri is null && _gunHata is null) await GunYukle();
    }

    private Task PersistData()
    {
        AppState.PersistAsJson("mags_period", _period);
        if (_data is not null) AppState.PersistAsJson("mags_data", _data);
        AppState.PersistAsJson("mags_aralik", _aralik);
        AppState.PersistAsJson("mags_wowlabel", _wowLabel);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSub.Dispose();

    private async Task LoadAsync()
    {
        var sw = PerfState.Start();
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var dun = DateOnly.FromDateTime(DateTime.Today).AddDays(-1);
            var g2 = dun.AddDays(1);
            (DateOnly start, DateOnly endExcl) = _period switch
            {
                "haftalik" => (dun.AddDays(-6), g2),
                "ay" => (new DateOnly(dun.Year, dun.Month, 1), g2),
                "ozel" => OzelAralik(),
                _ => (dun, g2),
            };
            var son = endExcl.AddDays(-1);
            _aralik = start == son ? son.ToString("dd.MM.yyyy") : $"{start:dd.MM.yyyy} – {son:dd.MM.yyyy}";
            // WoW penceresi + etiketi — Home ile aynı (geçen ayın aynı günleri / önceki eş-uzunluk).
            int len = endExcl.DayNumber - start.DayNumber;
            var (pStart, pEnd, wl) = _period switch
            {
                "ay" => ((DateOnly?)start.AddMonths(-1), (DateOnly?)start.AddMonths(-1).AddDays(len), "geçen ayın aynı günlerine göre"),
                "haftalik" => ((DateOnly?)start.AddDays(-7), (DateOnly?)start, "önceki 7 güne göre"),
                "ozel" => ((DateOnly?)start.AddDays(-len), (DateOnly?)start, "önceki eş döneme göre"),
                _ => ((DateOnly?)start.AddDays(-1), (DateOnly?)start, "önceki güne göre"),
            };
            _wowLabel = wl;
            _data = await Queries.GetPeriodAsync(start, endExcl, pStart, pEnd);
        }
        catch (Exception ex) { Logger.LogError(ex, "Veri yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; Perf.Report("Mağazalar", sw); StateHasChanged(); }
    }

    private async Task SetPeriod(string p) { if (_period == p) return; _period = p; await LoadAsync(); }

    private static string Tl(decimal n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
    private static string Num(int n) => n.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    private static string Pct(decimal v) => v.ToString("+#,##0.0;-#,##0.0;0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + "%";
    private static (string ico, string cls) TrendIco(decimal pct)
    {
        if (pct == 0) return ("minus", "text-base-content/40");
        return pct > 0 ? ("trending-up", "text-success") : ("trending-down", "text-error");
    }
    private static string GerRenk(decimal? pct) => pct is null ? "text-base-content/40"
        : pct >= 95 ? "text-success" : pct >= 85 ? "text-warning" : "text-error";
}
