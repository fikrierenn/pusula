@page "/baskisi-yok"
@using GmDashboard.Data
@using GmDashboard.Models
@inject EticQueries Etic
@inject IJSRuntime JS
@inject ILogger<BaskisiYok> Logger
@rendermode InteractiveServer

<PageTitle>Baskısı Yok Siparişler — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">E-ticaret · JOKER BASKISIYOK</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">Baskısı Yok Yapılan Siparişler</h1>
</div>

<div class="flex flex-wrap items-center gap-2 mb-4">
    <span class="text-xs text-base-content/50">Tarih</span>
    <input type="date" class="input input-bordered input-sm" @bind="_bas" @bind:after="Yukle" />
    <span class="text-base-content/40">–</span>
    <input type="date" class="input input-bordered input-sm" @bind="_bit" @bind:after="Yukle" />
    <button class="btn btn-sm btn-ghost" @onclick="Bugun">Bugün</button>
    <button class="btn btn-sm btn-ghost" @onclick="Son7">Son 7 gün</button>
    <button class="btn btn-sm btn-ghost" @onclick="BuAy">Bu ay</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-error text-sm mb-4"><span>@_error</span></div>
}
else if (_loading)
{
    <p class="text-base-content/40 text-sm py-6 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Yükleniyor…</p>
}
else
{
    @* KPI özet şeridi (sistem standardı — AppKpiCarousel) *@
    @if (_kpi is not null)
    {
        <AppKpiCarousel Id="bskkpi" Items="@(new List<KpiCardData>
        {
            new("Çeşit", Num(_kpi.Cesit), "from-info to-info/80", "farklı barkod"),
            new("Adet", Num(_kpi.Adet), "from-primary to-primary/80", "baskısız adet"),
            new("Tutar", Tl(_kpi.Tutar), "from-success to-success/80", "toplam"),
            new("Sipariş", Num(_kpi.Siparis), "from-warning to-warning/80", "etkilenen sipariş"),
        })" />
    }

    @* Grafikler (KPI altı) — Saat × Gün ısı haritası + gün gecikmesi *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-3 mb-4">
        @* Isı haritası (2 sütun) *@
        <div class="bg-base-100 border border-base-300 rounded-lg p-3 lg:col-span-2">
            <div class="text-sm font-semibold mb-3 flex items-center gap-1.5"><i data-lucide="calendar-clock" class="w-4 h-4 text-primary"></i>Yoğunluk — Saat × Gün <span class="text-xs text-base-content/50 font-normal">(adet)</span></div>
            @if (_heat.Count > 0)
            {
                var maxF = _heat.Max(h => h.Fis);
                var sMin = _heat.Min(h => h.Saat);
                var sMax = _heat.Max(h => h.Saat);
                var map = _heat.GroupBy(h => (h.Gun, h.Saat)).ToDictionary(g => g.Key, g => g.Sum(x => x.Fis));
                var gunAd = new[] { "Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz" };
                <div class="overflow-x-auto -mx-1 px-1">
                    <div class="inline-grid gap-0.5" style="grid-template-columns:32px repeat(@(sMax - sMin + 1), 22px)">
                        <div></div>
                        @for (int s = sMin; s <= sMax; s++)
                        {
                            <div class="text-[9px] text-base-content/45 text-center leading-[14px]">@s</div>
                        }
                        @for (int g = 0; g < 7; g++)
                        {
                            var gi = g;
                            <div class="text-[10px] font-semibold text-base-content/60 leading-[22px] pr-1 @(gi >= 5 ? "text-primary" : "")">@gunAd[gi]</div>
                            @for (int s = sMin; s <= sMax; s++)
                            {
                                var f = map.GetValueOrDefault((gi, s), 0);
                                var op = maxF > 0 && f > 0 ? Math.Max(0.08, Math.Round((double)f / maxF, 2)) : 0;
                                <div class="rounded-[3px] h-[22px] @(f > 0 ? "bg-primary" : "bg-base-200")" style="@(f > 0 ? $"opacity:{op.ToString(System.Globalization.CultureInfo.InvariantCulture)}" : "")" title="@gunAd[gi] @s:00 · @Num(f) adet"></div>
                            }
                        }
                    </div>
                </div>
                <div class="text-base-content/50 text-[11px] mt-2.5">Koyu = yoğun. Hangi gün/saatte baskısız işlem zirve — personel/vardiya planı.</div>
            }
            else { <p class="text-base-content/40 text-sm py-3">Kayıt yok.</p> }
        </div>
        @* Gün gecikmesi (1 sütun) *@
        <div class="bg-base-100 border border-base-300 rounded-lg p-3">
            <div class="text-sm font-semibold mb-2">Sipariş→Baskısı Yok <span class="text-xs text-base-content/50">— kaç gün sonra (adet)</span></div>
            @if (_gecikme.Count > 0)
            {
                <AppAreaChart TItem="BaskisiYokGecikme" Items="_gecikme" Name="Adet" Color="@_pColor" Height="180"
                              XValue="@(g => (object)g.Kova)" YValue="@(g => (decimal?)g.Adet)" />
            }
            else { <p class="text-base-content/40 text-sm py-3">Kayıt yok.</p> }
        </div>
    </div>

    @* Kullanıcı özeti *@
    <div class="bg-base-100 border border-base-300 rounded-lg p-3 mb-4">
        <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold">Gün Özeti <span class="text-xs text-base-content/50">— @_ozet.Count gün</span></div>
            <ExcelButton FileName="baskisi-yok-ozet" SheetName="Ozet" Rows="OzetExcel" />
        </div>
        <div class="overflow-x-auto">
            <table class="table table-xs">
                <thead><tr>
                    <th>Gün</th><th class="text-right">Barkod</th><th class="text-right">Sipariş</th><th class="text-right">Miktar</th><th class="text-right">Tutar</th>
                </tr></thead>
                <tbody>
                @foreach (var o in _ozet)
                {
                    <tr class="hover">
                        <td class="font-mono text-xs whitespace-nowrap">@o.Gun</td>
                        <td class="text-right">@Num(o.BarkodSayi)</td>
                        <td class="text-right">@Num(o.SipSayi)</td>
                        <td class="text-right">@Num(o.Miktar)</td>
                        <td class="text-right tabular-nums font-semibold">@Tl(o.Tutar)</td>
                    </tr>
                }
                </tbody>
                @if (_ozet.Count > 0)
                {
                    <tfoot><tr class="border-t-2 border-base-300 bg-base-200/40 font-bold">
                        <td class="text-right">TOPLAM</td>
                        <td class="text-right">@Num(_ozet.Sum(o => o.BarkodSayi))</td>
                        <td class="text-right">@Num(_ozet.Sum(o => o.SipSayi))</td>
                        <td class="text-right">@Num(_ozet.Sum(o => o.Miktar))</td>
                        <td class="text-right tabular-nums">@Tl(_ozet.Sum(o => o.Tutar))</td>
                    </tr></tfoot>
                }
            </table>
        </div>
        @if (_ozet.Count == 0) { <p class="text-base-content/40 text-sm py-3">Bu gün için kayıt yok.</p> }
    </div>

    @* Ürün detayı *@
    <div class="bg-base-100 border border-base-300 rounded-lg p-3">
        <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold">Ürün Detayı <span class="text-xs text-base-content/50">— @_detay.Count satır</span></div>
            <ExcelButton FileName="baskisi-yok-detay" SheetName="Detay" Rows="DetayExcel" />
        </div>
        <div class="overflow-x-auto">
            <table class="table table-xs">
                <thead><tr>
                    <th>Kullanıcı</th><th>Barkod</th><th>Kod</th><th>Ürün</th><th>Marka</th><th>Grup</th>
                    <th class="text-right">Miktar</th><th class="text-right">Tutar</th>
                </tr></thead>
                <tbody>
                @foreach (var d in _detay)
                {
                    <tr class="hover align-top">
                        <td class="text-xs whitespace-nowrap">@d.Kullanici</td>
                        <td class="font-mono text-[11px] whitespace-nowrap">@d.Barkod</td>
                        <td class="font-mono text-[11px] whitespace-nowrap">@d.Kod</td>
                        <td class="max-w-[280px] truncate text-xs" title="@d.Ad">@d.Ad</td>
                        <td class="max-w-[120px] truncate text-xs" title="@d.Marka">@d.Marka</td>
                        <td class="text-xs">@d.Grup</td>
                        <td class="text-right">@Num(d.Miktar)</td>
                        <td class="text-right tabular-nums">@Tl(d.Tutar)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (_detay.Count == 0) { <p class="text-base-content/40 text-sm py-3">Bu gün için kayıt yok.</p> }
    </div>

    @* Grup dağılımı *@
    <div class="bg-base-100 border border-base-300 rounded-lg p-3 mt-4">
        <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold">Ürün Grubu Dağılımı <span class="text-xs text-base-content/50">— @_grup.Count grup</span></div>
            <ExcelButton FileName="baskisi-yok-grup" SheetName="Grup" Rows="GrupExcel" />
        </div>
        <div class="overflow-x-auto">
            <table class="table table-xs">
                <thead><tr><th>Grup</th><th class="text-right">Çeşit</th><th class="text-right">Adet</th><th class="text-right">Tutar</th></tr></thead>
                <tbody>
                @foreach (var g in _grup)
                {
                    <tr class="hover">
                        <td>@g.Grup</td>
                        <td class="text-right">@Num(g.Cesit)</td>
                        <td class="text-right">@Num(g.Adet)</td>
                        <td class="text-right tabular-nums">@Tl(g.Tutar)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (_grup.Count == 0) { <p class="text-base-content/40 text-sm py-3">Kayıt yok.</p> }
    </div>

}

@code {
    private DateTime _bas = DateTime.Today.AddDays(-6);   // varsayılan son 7 gün (bugün çoğu sabah boş)
    private DateTime _bit = DateTime.Today;
    private IReadOnlyList<BaskisiYokOzet> _ozet = [];
    private IReadOnlyList<BaskisiYokDetay> _detay = [];
    private BaskisiYokKpi? _kpi;
    private IReadOnlyList<BaskisiYokGrup> _grup = [];
    private IReadOnlyList<HeatCell> _heat = [];
    private IReadOnlyList<BaskisiYokGecikme> _gecikme = [];
    private bool _loading = true;
    private string? _error;
    private string _pColor = "";   // DaisyUI --p grafik rengi (tema köprüsü, hardcode yok)

    protected override async Task OnInitializedAsync() => await Yukle();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var theme = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-colors.js");
            var c = await theme.InvokeAsync<Dictionary<string, string>>("daisyColors");
            if (c.TryGetValue("p", out var p) && _pColor != p) { _pColor = p; StateHasChanged(); }
        }
        catch { /* tema okunamazsa component fallback */ }
    }

    private async Task Bugun() { _bas = DateTime.Today; _bit = DateTime.Today; await Yukle(); }
    private async Task Son7()  { _bit = DateTime.Today; _bas = DateTime.Today.AddDays(-6); await Yukle(); }
    private async Task BuAy()  { _bit = DateTime.Today; _bas = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); await Yukle(); }

    private async Task Yukle()
    {
        _loading = true; _error = null; StateHasChanged();
        if (_bit < _bas) (_bas, _bit) = (_bit, _bas);   // ters girilirse düzelt
        var start = DateOnly.FromDateTime(_bas);
        var endExcl = DateOnly.FromDateTime(_bit).AddDays(1);   // bitiş dahil
        try
        {
            _kpi = await Etic.GetBaskisiYokKpiAsync(start, endExcl);
            _ozet = await Etic.GetBaskisiYokOzetAsync(start, endExcl);
            _detay = await Etic.GetBaskisiYokDetayAsync(start, endExcl);
            _grup = await Etic.GetBaskisiYokGrupAsync(start, endExcl);
            _heat = await Etic.GetBaskisiYokHeatAsync(start, endExcl);
            _gecikme = await Etic.GetBaskisiYokGecikmeAsync(start, endExcl);
        }
        catch (Exception ex) { Logger.LogError(ex, "Baskısı yok yüklenemedi ({Bas}-{Bit})", start, endExcl); _error = $"Yüklenemedi: {ex.Message}"; }
        finally { _loading = false; }
    }

    private Task<IEnumerable<IDictionary<string, object?>>> OzetExcel() =>
        Task.FromResult<IEnumerable<IDictionary<string, object?>>>(_ozet.Select(o => new Dictionary<string, object?>
        {
            ["Gün"] = o.Gun, ["Barkod"] = o.BarkodSayi, ["Sipariş"] = o.SipSayi, ["Miktar"] = o.Miktar, ["Tutar"] = o.Tutar,
        }));

    private Task<IEnumerable<IDictionary<string, object?>>> DetayExcel() =>
        Task.FromResult<IEnumerable<IDictionary<string, object?>>>(_detay.Select(d => new Dictionary<string, object?>
        {
            ["Tarih"] = d.Tarih, ["Kullanıcı"] = d.Kullanici, ["Barkod"] = d.Barkod, ["Kod"] = d.Kod,
            ["Ürün"] = d.Ad, ["Marka"] = d.Marka, ["Grup"] = d.Grup, ["Miktar"] = d.Miktar, ["Tutar"] = d.Tutar,
        }));

    private Task<IEnumerable<IDictionary<string, object?>>> GrupExcel() =>
        Task.FromResult<IEnumerable<IDictionary<string, object?>>>(_grup.Select(g => new Dictionary<string, object?>
        {
            ["Grup"] = g.Grup, ["Çeşit"] = g.Cesit, ["Adet"] = g.Adet, ["Tutar"] = g.Tutar,
        }));

    private static string Tl(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
    private static string Num(int v) => v.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"));
}
