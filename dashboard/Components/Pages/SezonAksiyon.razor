@page "/sezon-aksiyon"
@using GmDashboard.Data
@using GmDashboard.Models
@using System.Globalization
@inject SezonAksiyonQueries Q
@inject NavigationManager Nav
@inject ILogger<SezonAksiyon> Logger
@rendermode InteractiveServer

<PageTitle>Sezon Sipariş Listesi</PageTitle>

@*  ══ SEZON SİPARİŞ LİSTESİ ═════════════════════════════════════════════════════════
    GMY 14.09.2026: "satınalma ile paylaşıp aksiyon alınacak liste"
    GMY 15.09.2026: "toplam sezon da satılacak miktarı da yazalım bir yere, şu ana kadar
                     satılanı çıkartıp ihtiyacı bulalım; depoda o kadar varsa sorun yok,
                     yoksa sipariş lazım"

    YÖNTEM — SEZON PAYI: geçen sezonun yüzde kaçı okul açılmadan önce satılmışsa, bu
    sezonun okul öncesi satışı o orana bölünür → toplam sezon tahmini; ondan bugüne
    kadar satılan düşülür → sezonun kalanında satılacak.

    NE ÇIKARILDI ve NEDEN (geri eklemeden önce oku):
      · BÜYÜME KUTUSU — satinalma-danisman 15.09.2026: "tek kadran hem AÇIK'ı büyütüp
        hem FAZLA'yı küçültüyor; bir parametre, iki savunma." Hacmi artık ürünün bu
        sezonki KENDİ satışı taşıyor; çevrilecek kadran kalmadı.
      · PENCERE SEÇİCİ — pencere artık OKUL AÇILIŞINA hizalı ve iki yıl için de eşit
        uzunlukta türetiliyor. Serbest pencere, takvim hizasına geri dönüş demekti
        (ölçüldü: tahmin %23,5 düşük çıkıyordu).
      · "Sezon yılı" kutusu — ÖLÇÜLDÜ: her kesimde tek sezon yılı var; kesimle gelir.

    Üç emitter tek çekirdek: bu sayfa · scripts/sezon_aksiyon_listesi_excel.py ·
    sorgular/2026-09-15-sezon-aksiyon-listesi.sql — İŞ MANTIĞI AYNI.                       *@

<div class="max-w-[1500px] mx-auto px-3 py-4">

    <h1 class="text-lg font-semibold m-0">Sezon Sipariş Listesi</h1>
    <p class="text-xs text-base-content/50 m-0 mt-0.5 mb-3">
        Okul öncesi pencere — geçen sezon
        @_filtre.GecenPencere.Bas.ToString("dd.MM.yy") – @_filtre.GecenPencere.Son.ToString("dd.MM.yy")
        · bu sezon
        @_filtre.BuPencere.Bas.ToString("dd.MM.yy") – @_filtre.BuPencere.Son.ToString("dd.MM.yy")
        (@_filtre.PencereGun gün, eşit). Pencere <b>okul açılışına</b> hizalı, takvime değil.
    </p>

    @* ── SÜZGEÇLER — tek satır ──────────────────────────────────────────────────── *@
    <div class="flex flex-wrap gap-2 items-center mb-4">
        @if (_kesimler.Count > 0)
        {
            <select class="select select-bordered select-sm text-sm"
                    value="@_filtre.Kesim.ToString("yyyy-MM-dd")" @onchange="KesimDegis">
                @foreach (var (k, _) in _kesimler)
                {
                    <option value="@k.ToString("yyyy-MM-dd")">@k.ToString("dd.MM.yyyy")</option>
                }
            </select>
        }
        else
        {
            <span class="text-error text-sm">taban boş</span>
        }

        <select class="select select-bordered select-sm text-sm"
                value="@(_filtre.Durum ?? "")" @onchange="DurumDegis">
            <option value="">tüm durumlar</option>
            <option value="siparis">yalnız SİPARİŞ VER</option>
            <option value="depodan">yalnız DEPODAN GÖNDER</option>
            <option value="fazla">yalnız FAZLA VAR</option>
            <option value="olu">yalnız ÖLÜ STOK</option>
        </select>

        <select class="select select-bordered select-sm text-sm"
                value="@(_filtre.Kategori3 ?? "")" @onchange="KategoriDegis">
            <option value="">tüm kategoriler</option>
            @foreach (var k in _kategoriler)
            {
                <option value="@k">@k</option>
            }
        </select>

        <select class="select select-bordered select-sm text-sm"
                value="@(_filtre.Grup ?? "")" @onchange="GrupDegis">
            <option value="">tüm ürün grupları</option>
            @foreach (var g in _gruplar)
            {
                <option value="@g">@g</option>
            }
        </select>

        <input type="search" class="input input-bordered input-sm text-sm grow min-w-[10rem]"
               value="@_filtre.Arama" @onchange="AramaDegis" placeholder="ürün adı, stok kodu veya barkod ara" />

        @if (_filtre.Durum is not null || _filtre.Kategori3 is not null
             || _filtre.Grup is not null || !string.IsNullOrWhiteSpace(_filtre.Arama))
        {
            <button class="btn btn-sm btn-ghost" @onclick="SuzgecTemizle">temizle</button>
        }
    </div>

    @*  ⚠ PENCERE KURULAMIYORSA KOŞMAZ. Okul açılış tarihi tanımlı değilse sessizce
        takvime düşmek yanlış rakam üretirdi — hesap yapılmaz, sebep yazılır.          *@
    @if (!_filtre.AcilisTanimli)
    {
        <div class="alert alert-error text-sm mb-4">
            <span>
                ÖLÇÜLEMEDİ — @_filtre.SezonYil veya @_filtre.Kesim.Year yılı için okul açılış
                tarihi tanımlı değil. Pencere okul açılışına hizalanır; tarih olmadan hesap
                kurulmaz (takvime düşmek tahmini %23,5 saptırıyordu).
                Tanım yeri: <code>SezonAksiyonFiltre.OkulAcilis</code>.
            </span>
        </div>
    }
    else if (!_filtre.PencereYeterli)
    {
        <div class="alert alert-error text-sm mb-4">
            <span>
                ÖLÇÜLEMEDİ — okul öncesi pencere @_filtre.PencereGun gün; 14 günün altında
                oran güvenilmez.
            </span>
        </div>
    }
    @*  ⚠ TABAN KAPISI. Sezon payı girdileri o kesim için yazılmamışsa hesap
        KURULMAZ. ISNULL(...,0) ile devam etmek her ürünü "talebi yok" gösterir ve
        ekran sessizce "sipariş yok" der — hata vermeden. *@
    else if (_tabanEksik is { } te)
    {
        <div class="alert alert-error text-sm mb-4">
            <span>
                ÖLÇÜLEMEDİ — bu kesimde @te.ToString("N0", _tr) üründe sezon payı girdileri
                yazılmamış. Taban bu kolonlar eklenmeden doldurulmuş olabilir; Satış Analizi
                sayfasından kesimi <b>yeniden hazırlayın</b>. Eksik girdiyi sıfır sayıp devam
                etmek "sipariş yok" diye yanlış rakam üretirdi.
            </span>
        </div>
    }
    else if (_hata is not null)
    {
        <div class="alert alert-error text-sm mb-4"><span>@_hata</span></div>
    }
    else if (_ozet is null)
    {
        <div class="flex items-center gap-2 text-sm text-base-content/50 py-10 justify-center">
            <span class="loading loading-spinner loading-sm"></span> Yükleniyor…
        </div>
    }
    else
    {
        var k = _ozet.Kpi;

        @*  ── DÖRT KART ────────────────────────────────────────────────────────────
            ⚠ TUTARLAR TOPLANMAZ: sipariş ₺ SATIŞ fiyatıyla (kaçacak ciro), fazla ve
              ölü ₺ MALİYETLE (bağlı sermaye). Her kartta tabanı yazılı.
            "DEPODAN GÖNDER" tutarsızdır: mal zaten elimizde, para harcanmıyor —
              o yüzden o kartta ₺ değil ADET büyük yazar.                              *@
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3 mb-2">

            <button type="button" @onclick='() => DurumSec("siparis")'
                    class="text-left rounded-3xl bg-base-100 border border-base-300 shadow-sm px-5 py-5
                           transition-all hover:-translate-y-0.5 hover:shadow-lg active:scale-[.98]
                           @(_filtre.Durum == "siparis" ? "border-error" : "hover:border-base-content/20")">
                <span class="block font-extrabold tabular-nums tracking-tight leading-none
                             text-[30px] text-error">@Tl(k.SiparisTutar)</span>
                <span class="block text-[11px] uppercase tracking-wider font-semibold mt-2
                             text-base-content/55">SİPARİŞ VER</span>
                <span class="block text-[10px] text-base-content/35 mt-0.5">
                    satış fiyatı · kaçacak ciro, kâr değil
                </span>
                <span class="block text-[11px] tabular-nums mt-1 text-base-content/45">
                    @Say(k.SiparisUrun) ürün · @Say(k.SiparisAdet) adet
                </span>
            </button>

            <button type="button" @onclick='() => DurumSec("depodan")'
                    class="text-left rounded-3xl bg-base-100 border border-base-300 shadow-sm px-5 py-5
                           transition-all hover:-translate-y-0.5 hover:shadow-lg active:scale-[.98]
                           @(_filtre.Durum == "depodan" ? "border-info" : "hover:border-base-content/20")">
                <span class="block font-extrabold tabular-nums tracking-tight leading-none
                             text-[30px] text-info">@Say(k.DepodanAdet)</span>
                <span class="block text-[11px] uppercase tracking-wider font-semibold mt-2
                             text-base-content/55">DEPODAN GÖNDER</span>
                <span class="block text-[10px] text-base-content/35 mt-0.5">
                    adet · mal elimizde, sipariş gerekmiyor
                </span>
                <span class="block text-[11px] tabular-nums mt-1 text-base-content/45">
                    @Say(k.DepodanUrun) ürün · rafı boş olan şube var
                </span>
            </button>

            <button type="button" @onclick='() => DurumSec("fazla")'
                    class="text-left rounded-3xl bg-base-100 border border-base-300 shadow-sm px-5 py-5
                           transition-all hover:-translate-y-0.5 hover:shadow-lg active:scale-[.98]
                           @(_filtre.Durum == "fazla" ? "border-warning" : "hover:border-base-content/20")">
                <span class="block font-extrabold tabular-nums tracking-tight leading-none
                             text-[30px] text-warning">@Tl(k.FazlaTutar)</span>
                <span class="block text-[11px] uppercase tracking-wider font-semibold mt-2
                             text-base-content/55">FAZLA VAR</span>
                <span class="block text-[10px] text-base-content/35 mt-0.5">
                    maliyet · gelecek sezona kalacak
                </span>
                <span class="block text-[11px] tabular-nums mt-1 text-base-content/45">
                    @Say(k.FazlaUrun) ürün · @Say(k.FazlaAdet) adet
                </span>
            </button>

            @*  ÖLÜ STOK — iki sezondur satmayan ama stoğu duran ürün. FAZLA'dan AYRI:
                eylemi farklı (indirimle dönmez; iade / elden çıkarma). Önceki modelde
                FAZLA'nın içindeydi ve tek başına 20,6M ₺ tutuyordu (ölçüldü).           *@
            <button type="button" @onclick='() => DurumSec("olu")'
                    class="text-left rounded-3xl bg-base-100 border border-base-300 shadow-sm px-5 py-5
                           transition-all hover:-translate-y-0.5 hover:shadow-lg active:scale-[.98]
                           @(_filtre.Durum == "olu" ? "border-neutral" : "hover:border-base-content/20")">
                <span class="block font-extrabold tabular-nums tracking-tight leading-none
                             text-[30px] text-base-content/70">@Tl(k.OluTutar)</span>
                <span class="block text-[11px] uppercase tracking-wider font-semibold mt-2
                             text-base-content/55">ÖLÜ STOK</span>
                <span class="block text-[10px] text-base-content/35 mt-0.5">
                    maliyet · iki sezondur satmıyor
                </span>
                <span class="block text-[11px] tabular-nums mt-1 text-base-content/45">
                    @Say(k.OluUrun) ürün · @Say(k.OluAdet) adet
                </span>
            </button>
        </div>

        <p class="text-[11px] text-base-content/45 mb-4">
            @Say(k.Cesit) çeşit tarandı · @Say(k.YeterliUrun)'ünde stok yeterli.
            @if (k.MaliyetiYok > 0)
            {
                <span>
                    ⚠ @Say(k.MaliyetiYok) üründe maliyet kaydı yok ya da şüpheli — adet sayılır,
                    paraya girmez: fazla ve ölü stok tutarı <b>alt sınırdır</b>.
                </span>
            }
        </p>

        @* ── KATEGORİ ────────────────────────────────────────────────────────────── *@
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-[18px] mb-4">
            <h3 class="text-sm font-semibold m-0 mb-2">Kategoriye Göre</h3>
            <div class="overflow-x-auto">
                <table class="table table-xs w-full">
                    <thead>
                        <tr class="text-base-content/50">
                            <th>Kategori</th>
                            <th class="text-right">Çeşit</th>
                            <th class="text-right">Sipariş ürün</th>
                            <th class="text-right">Sipariş adet</th>
                            <th class="text-right">Sipariş ₺</th>
                            <th class="text-right">Fazla ürün</th>
                            <th class="text-right">Fazla ₺</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _ozet.Kategoriler)
                        {
                            <tr class="hover cursor-pointer" @onclick="() => KategoriSec(c.Kategori)">
                                <td class="whitespace-nowrap">@c.Kategori</td>
                                <td class="text-right tabular-nums text-base-content/50">@Say(c.Cesit)</td>
                                <td class="text-right tabular-nums">@Say(c.SiparisUrun)</td>
                                <td class="text-right tabular-nums">@Say(c.SiparisAdet)</td>
                                <td class="text-right tabular-nums text-error">@Tl(c.SiparisTutar)</td>
                                <td class="text-right tabular-nums">@Say(c.FazlaUrun)</td>
                                <td class="text-right tabular-nums text-warning">@Tl(c.FazlaTutar)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ── ÜRÜN LİSTESİ ────────────────────────────────────────────────────────── *@
        <div class="card bg-base-100 border border-base-300 rounded-2xl p-[18px] mb-4">
            <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-sm font-semibold m-0">Ürünler</h3>
                    <span class="text-xs text-base-content/50">
                        @(_liste?.ToplamSatir.ToString("N0", _tr) ?? "…") çeşit ·
                        şube şube oran/tahmin ayrıntısı <b>Excel</b>'de
                    </span>
                </div>
                @* ⚠ ExcelButton DEĞİL: base64 circuit'ten geçince büyük listede çöküyor
                   (ölçüldü 09.09, Satış Analizi). Doğrudan indirme bağlantısı akışta yazar. *@
                <a class="btn btn-sm btn-outline" target="_blank" rel="noopener"
                   href="@($"/api/sezon-aksiyon-excel?{_filtre.SorguDizesi()}")">Excel</a>
            </div>

            @if (_liste is null)
            {
                <div class="flex items-center gap-2 text-sm text-base-content/50 py-6 justify-center">
                    <span class="loading loading-spinner loading-sm"></span> Yükleniyor…
                </div>
            }
            else if (_liste.SayfaAsildi)
            {
                <div class="alert alert-warning text-sm">
                    Bu sayfada kayıt yok ama @_liste.ToplamSatir.ToString("N0", _tr) çeşit var.
                    <button class="btn btn-xs" @onclick="() => SayfaDegis(1)">Başa dön</button>
                </div>
            }
            else if (_liste.Bos)
            {
                <p class="text-sm text-base-content/50 py-6 text-center">Süzgece uyan ürün yok.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table table-xs w-full">
                        <thead>
                            <tr class="text-base-content/50">
                                @* ⚠ Başlık sırası = gövdedeki <td> sırası. İkisi ayrışırsa başlık
                                   yanlış kolonu adlandırır ve HATA VERMEZ. *@
                                @foreach (var kol in Kolonlar)
                                {
                                    <th class="@(kol.Sag ? "text-right" : "")">
                                        <button class="link link-hover" @onclick="() => SiralaDegis(kol.Anahtar)">
                                            @kol.Baslik@(_filtre.Sirala == kol.Anahtar
                                                ? (_filtre.Azalan ? " ↓" : " ↑") : "")
                                        </button>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _liste.Satirlar)
                            {
                                <tr class="hover cursor-pointer" @onclick="() => UrunAc(s.StkId)"
                                    title="Ürün detayına git">
                                    <td class="max-w-[24rem] truncate" title="@s.StkAd">@s.StkAd</td>
                                    <td class="whitespace-nowrap text-base-content/60">@s.Kategori3</td>
                                    <td class="whitespace-nowrap text-base-content/40">@s.Kat1</td>
                                    <td class="text-right tabular-nums">@Say(s.SezonToplam)</td>
                                    @*  Geçen sezon stoğu bittiyse gözlenen satış TALEP DEĞİL, rafın
                                        bittiği yerdir: oran 1'e yaklaşır ve talep EKSİK ölçülür.
                                        Bayrak GÖRÜNÜR bırakıldı — düzeltme uygulanmadı, backtest
                                        kötüleşiyordu (%18,5 → %48,5).                              *@
                                    <td class="text-right tabular-nums @(s.StoksuzKaldi ? "text-warning" : "")"
                                        title="@(s.StoksuzKaldi ? "Geçen sezon stok tükenmiş — oran SANSÜRLÜ, talep alt sınır" : "")">
                                        @Say(s.GecenOkulOncesi)@(s.StoksuzKaldi ? "*" : "")
                                    </td>
                                    <td class="text-right tabular-nums">@Say(s.BuOkulOncesi)</td>
                                    <td class="text-right tabular-nums">@Say(s.BuBugune)</td>
                                    <td class="text-right tabular-nums">@Say(s.TahminToplam)</td>
                                    <td class="text-right tabular-nums font-semibold">@Say(s.KalanToplam)</td>
                                    <td class="text-right tabular-nums">@Say(s.MagazaStok)</td>
                                    <td class="text-right tabular-nums">@Say(s.MerkezStok)</td>
                                    @*  Şube şube eksik — hangi rafın boş olduğu ekranda görünsün.
                                        Tam zincir (oran → tahmin → kalan → stok) Excel'de.         *@
                                    <td class="text-right tabular-nums text-[11px] whitespace-nowrap
                                               @(s.EksikToplam > 0 ? "" : "text-base-content/25")">
                                        @s.EksikFsm / @s.EksikOzl / @s.EksikIst
                                    </td>
                                    <td class="text-right tabular-nums @(s.EksikToplam > 0 ? "font-semibold" : "text-base-content/25")">
                                        @(s.EksikToplam > 0 ? Say(s.EksikToplam) : "—")
                                    </td>
                                    <td class="whitespace-nowrap">
                                        <span class="badge badge-sm @DurumRenk(s.Sinif)">@s.DurumAd</span>
                                    </td>
                                    <td class="text-right tabular-nums @(s.Siparis > 0 ? "text-error font-semibold" : "text-base-content/25")">
                                        @(s.Siparis > 0 ? Say(s.Siparis) : "—")
                                    </td>
                                    <td class="whitespace-nowrap text-[11px] text-base-content/50">@s.Nereden</td>
                                    <td class="text-right tabular-nums">@Tl(s.Tutar)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between gap-2 mt-3 flex-wrap">
                    <span class="text-xs text-base-content/50">
                        sayfa @_liste.Sayfa / @_liste.SayfaSayisi.ToString("N0", _tr)
                    </span>
                    <div class="join">
                        <button class="btn btn-xs join-item" disabled="@(_liste.Sayfa <= 1)"
                                @onclick="() => SayfaDegis(1)">«</button>
                        <button class="btn btn-xs join-item" disabled="@(_liste.Sayfa <= 1)"
                                @onclick="() => SayfaDegis(_liste.Sayfa - 1)">‹</button>
                        <button class="btn btn-xs join-item btn-ghost pointer-events-none">@_liste.Sayfa</button>
                        <button class="btn btn-xs join-item" disabled="@(_liste.Sayfa >= _liste.SayfaSayisi)"
                                @onclick="() => SayfaDegis(_liste.Sayfa + 1)">›</button>
                        <button class="btn btn-xs join-item" disabled="@(_liste.Sayfa >= _liste.SayfaSayisi)"
                                @onclick="() => SayfaDegis(_liste.SayfaSayisi)">»</button>
                    </div>
                </div>
            }
        </div>

        @* ── SINIRLAR — KAPALI başlar. Silinmedi: silmek yanıltmak olurdu. ───────── *@
        <details class="collapse collapse-arrow bg-base-200/50 border border-base-300 rounded-2xl">
            <summary class="collapse-title text-sm font-semibold min-h-0 py-3">
                Hesap nasıl kuruldu, neyi söylemez
            </summary>
            <div class="collapse-content text-[11px] leading-relaxed text-base-content/70">
                <ul class="list-disc pl-5 space-y-1">
                    <li><b>Yöntem — sezon payı.</b> Oran = geçen sezon okul öncesi satılan ÷ geçen
                        sezon toplamı. Tahmin = bu sezon okul öncesi satılan ÷ oran. Kalan ihtiyaç
                        = tahmin − bu sezon bugüne kadar satılan. Sipariş = şubelerin toplam eksiği
                        − merkez depo stoğu.</li>
                    <li><b>Büyüme parametresi YOK.</b> Hacmi ürünün bu sezonki kendi satışı taşır;
                        oran yalnız "sezonun neresindeyiz" sorusunu yanıtlar. Önceki modelde tek
                        bir büyüme kadranı vardı ve aynı hamleyle hem açığı büyütüp hem fazlayı
                        siliyordu.</li>
                    <li><b>Hesap şube düzeyinde kurulur</b>, ürün satırı üç şubenin toplamıdır.
                        Ölçüldü (Kırtasiye, 20.218 çeşit): ürün düzeyinde ayrı hesap varken şube
                        eksikleri toplamı ile sipariş adedi 4.922 çeşitte uyuşmuyordu, fark
                        133.594 adet. Ayrıca şube payı geçen yıldan alınınca ürünlerin %53,9'unda
                        en çok satan şube değişiyordu.</li>
                    <li><b>Pencere okul açılışına hizalı</b> (11.09.2023 · 09.09.2024 · 08.09.2025 ·
                        14.09.2026), takvime değil. Ölçüldü: takvim hizasıyla Kırtasiye sezon
                        tahmini 521.262, açılış hizasıyla 643.912 — %23,5 fark. İki pencere eşit
                        uzunluktadır ve açılıştan bir gün önce biter.</li>
                    <li><b>Kullanılan oran satır bazlı.</b> Geçen sezon satışı 30 adedin altındaysa
                        ürünün kendi ölçümü zayıf sayılır ve alt kategori ortalaması kullanılır
                        (o da yoksa 0,60). Alt sınır 0,05 / üst sınır 1,00: payda sıfıra
                        yaklaşırsa bölme tahmini sonsuza götürüyordu.</li>
                    <li><b>⚠ Sansür.</b> Geçen sezon stoğu bitmiş üründe gözlenen satış gerçek
                        talebin altındadır; oran 1'e yaklaşır ve talep eksik ölçülür. Ölçüldü
                        (Kırtasiye): stoksuz kalanların oran medyanı 0,821, stoğu olanların 0,588.
                        Bayrak listede yıldızla görünür; <b>düzeltme uygulanmadı</b> — kategori
                        oranına düşürmek backtest'te kötüleştiriyordu (%18,5 → %48,5).</li>
                    <li><b>Backtest:</b> 2024 oranıyla 2025 sezonu tahmin edildi — Kırtasiye 1.445
                        çeşit, medyan mutlak hata %16,3, yanlılık +%2,1 (yansız). ⚠ O yıl okul
                        kayması 1 gündü, bu yıl 6 gün; backtest bu riski sınayamaz.</li>
                    <li><b>Ürünün sezon payı düşükse yöntem zayıftır</b> — ürün sezonluk değildir.
                        Ölçüldü (Kırtasiye): medyan 0,500, %38,7'si 0,40 altında ve sipariş
                        tutarının %28,7'si o ürünlerden geliyor.</li>
                    <li><b>Sipariş yalnız merkez depodan karşılanamayanı kapsar.</b> Mağazalar
                        arası aktarma varsayılmaz — GMY: "mağazalar arası değil, depoda veya
                        ODAK'ta varsa mümkün; diğer türlü hayal."</li>
                    <li><b>Sezon dışı talep sipariş tetiklemez.</b> GMY: "kritik olan bizim için
                        sezonda yoka düşmemek; sezon sonrası sipariş verilebilir, sorun değil."</li>
                    <li><b>İki tutar toplanmaz:</b> sipariş ₺ satış fiyatıyla, fazla/ölü ₺
                        maliyetle. Siparişteki tutar kaybedilen <b>cirodur</b>, kaybedilen kâr
                        değil — marj ölçülmedi, ikame hesaba katılmadı.</li>
                    <li><b>Fazla ve ölü ₺ alt sınırdır</b> — @(k.MaliyetiYok > 0
                        ? $"{k.MaliyetiYok:N0} üründe" : "bazı ürünlerde") maliyet kaydı yok ya da
                        şüpheli (maliyet &gt; satış fiyatı); adet sayılır, paraya girmez.</li>
                    <li><b>Açık sipariş düşülmedi.</b> ERP'de "kapalı" durumu 24.02.2025'ten beri
                        yazılmıyor; kapatılmamış alış siparişi adedinin %86,4'ü bir yıldan eski
                        (ölçüldü 14.09.2026). Netleme yapılsaydı liste hayalet siparişle yanıltırdı.</li>
                    <li><b>Depo stoğu WMS'ten</b> — ERP defteriyle çelişebilir; fiziksel sayım
                        yapılmadan kesin sayılmaz.</li>
                    <li><b>Tek gün fotoğrafı</b> (@_filtre.Kesim.ToString("dd.MM.yyyy")).
                        Alıcı (satınalmacı) boyutu veride yok — bu bir görev listesidir,
                        kişiye atıf değildir.</li>
                </ul>
            </div>
        </details>
    }
</div>

@code {
    private static readonly CultureInfo _tr = CultureInfo.GetCultureInfo("tr-TR");

    private SezonAksiyonFiltre _filtre = new(
        DateOnly.FromDateTime(DateTime.Today.AddDays(-1)), DateTime.Today.Year - 1);
    private IReadOnlyList<(DateOnly Kesim, int SezonYil)> _kesimler = [];
    private IReadOnlyList<string> _kategoriler = [];
    private IReadOnlyList<string> _gruplar = [];
    private SezonAksiyonOzet? _ozet;
    private SayfaSonucu<SezonAksiyonSatir>? _liste;
    private string? _hata;
    /// <summary>Sezon payı girdisi eksik satır sayısı — null ise kapı açık.</summary>
    private int? _tabanEksik;

    private sealed record Kolon(string Anahtar, string Baslik, bool Sag);

    /// <summary>
    /// Kolon sırası = gövdedeki &lt;td&gt; sırası. Başlıklar TARİHLİ üretilir
    /// (GMY 15.09.2026: "kolonların içinde tarihler de olsun kafa karışmasın") —
    /// bu yüzden sabit dizi değil, filtreden türeyen bir metot.
    /// </summary>
    private IEnumerable<Kolon> Kolonlar
    {
        get
        {
            var (gp, gps) = _filtre.GecenPencere;
            var (bp, bps) = _filtre.BuPencere;
            var (bt, bts) = _filtre.BuSezon;
            string T(DateOnly d) => d.ToString("dd.MM.yy");
            yield return new("urun", "Ürün", false);
            yield return new("kategori", "Kategori", false);
            yield return new("grup", "Ürün grubu", false);
            yield return new("sezon", $"Geçen sezon toplam 01.08–31.10.{_filtre.SezonYil % 100:00}", true);
            yield return new("gecenoncesi", $"Geçen sezon okul öncesi {T(gp)}–{T(gps)}", true);
            yield return new("buoncesi", $"Bu sezon okul öncesi {T(bp)}–{T(bps)}", true);
            yield return new("bubugune", $"Bu sezon bugüne kadar {T(bt)}–{T(bts)}", true);
            yield return new("tahmin", "Bu sezon toplam satacak", true);
            yield return new("kalan", "Sezonun kalanında satacak", true);
            yield return new("magaza", $"Mağaza stok {T(_filtre.Kesim)}", true);
            yield return new("depo", $"Depo stok {T(_filtre.Kesim)}", true);
            yield return new("eksik", "Eksik FSM / Özlüce / İst.Yolu", true);
            yield return new("eksik", "Toplam eksik", true);
            yield return new("durum", "Durum", false);
            yield return new("siparis", "Sipariş adet", true);
            yield return new("odak", "Nereden", false);
            yield return new("tutar", "₺", true);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Kesim listesi ÖNCE: varsayılan "dün" tabanda olmayabilir → boş ekran sanılırdı.
        // Sezon yılı da buradan gelir; kullanıcıya sorulmaz (kesim başına tek değer).
        try
        {
            _kesimler = await Q.GetKesimlerAsync();
            if (_kesimler.Count > 0)
            {
                var v = _kesimler.FirstOrDefault(x => x.Kesim == _filtre.Kesim);
                if (v.Kesim == default) v = _kesimler[0];
                _filtre = _filtre with { Kesim = v.Kesim, SezonYil = v.SezonYil };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kesim listesi alınamadı");
            _hata = "Kesim listesi alınamadı. Lütfen sistem yöneticisine bildirin.";
            return;
        }
        await Yukle();
    }

    private async Task Yukle(bool secenekDe = true)
    {
        _hata = null;
        _tabanEksik = null;
        _ozet = null;
        _liste = null;
        StateHasChanged();
        // ⚠ Pencere kurulamıyorsa SORGU ÇALIŞTIRILMAZ. Ekran sebebini yazar; sessizce
        //   takvime düşmek yanlış rakam üretirdi.
        if (!_filtre.PencereYeterli) { StateHasChanged(); return; }
        try
        {
            // ⚠ KAPI ÖNCE: eksik girdiyle koşan sorgu hata vermez, YANLIŞ RAKAM verir.
            var (hazir, _, eksik) = await Q.SezonPayiHazirAsync(_filtre);
            _tabanEksik = hazir ? null : eksik;
            if (!hazir) { StateHasChanged(); return; }

            var ozetGorev = Q.GetOzetAsync(_filtre);
            var listeGorev = Q.GetListeAsync(_filtre);
            if (secenekDe) (_kategoriler, _gruplar) = await Q.GetSecenekleriAsync(_filtre);
            _ozet = await ozetGorev;
            _liste = await listeGorev;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sezon sipariş listesi alınamadı ({Filtre})", _filtre);
            _hata = "Liste alınamadı. Lütfen sistem yöneticisine bildirin.";
        }
        finally { StateHasChanged(); }
    }

    private Task Uygula(SezonAksiyonFiltre yeni, bool secenekDe = false)
    {
        _filtre = yeni with { Sayfa = 1 };
        return Yukle(secenekDe);
    }

    private Task KesimDegis(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var d))
            return Task.CompletedTask;
        var v = _kesimler.FirstOrDefault(x => x.Kesim == d);
        return Uygula(_filtre with
        {
            Kesim = d,
            SezonYil = v.Kesim == default ? _filtre.SezonYil : v.SezonYil,
        }, secenekDe: true);
    }

    private Task DurumDegis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        return Uygula(_filtre with { Durum = string.IsNullOrWhiteSpace(v) ? null : v });
    }

    private Task KategoriDegis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        // Kategori değişince ürün grubu listesi de daralır → seçenekler yenilenir,
        // eski grup seçimi bırakılmaz (aksi hâlde boş liste "veri yok" sanılırdı).
        return Uygula(_filtre with
        {
            Kategori3 = string.IsNullOrWhiteSpace(v) ? null : v,
            Grup = null,
        }, secenekDe: true);
    }

    private Task GrupDegis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        return Uygula(_filtre with { Grup = string.IsNullOrWhiteSpace(v) ? null : v });
    }

    private Task AramaDegis(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        return Uygula(_filtre with { Arama = string.IsNullOrWhiteSpace(v) ? null : v.Trim() });
    }

    private Task DurumSec(string durum) =>
        Uygula(_filtre with { Durum = _filtre.Durum == durum ? null : durum });

    private Task KategoriSec(string kategori) =>
        Uygula(_filtre with
        {
            Kategori3 = _filtre.Kategori3 == kategori ? null : kategori,
            Grup = null,
        }, secenekDe: true);

    private Task SuzgecTemizle() =>
        Uygula(_filtre with { Durum = null, Kategori3 = null, Grup = null, Arama = null },
               secenekDe: true);

    private Task SiralaDegis(string anahtar) => Uygula(_filtre with
    {
        Sirala = anahtar,
        Azalan = _filtre.Sirala == anahtar ? !_filtre.Azalan : true,
    });

    private Task SayfaDegis(int sayfa)
    {
        _filtre = _filtre with { Sayfa = sayfa };
        return Yukle(secenekDe: false);
    }

    private void UrunAc(int stkId) =>
        Nav.NavigateTo($"/satis-analizi/urun/{stkId}?kesim={_filtre.Kesim:yyyy-MM-dd}"
                       + $"&sezon={_filtre.SezonYil}&geri={Uri.EscapeDataString("/sezon-aksiyon")}");

    /// <summary>Durum rozeti rengi — anlam sabit (renk-standardi: DaisyUI token).</summary>
    private static string DurumRenk(int sinif) => sinif switch
    {
        SezonAksiyonSinif.Siparis => "badge-error",
        SezonAksiyonSinif.Depodan => "badge-info",
        SezonAksiyonSinif.Fazla => "badge-warning",
        SezonAksiyonSinif.Olu => "badge-neutral",
        _ => "badge-ghost",
    };

    private static string Say(long n) => n.ToString("N0", _tr);

    private static string Tl(decimal? n) => n is null or 0 ? "—" : n.Value.ToString("N0", _tr) + " ₺";
}
