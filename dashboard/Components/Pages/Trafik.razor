@page "/trafik"
@using GmDashboard.Data
@using GmDashboard.Models
@inject TrafikQueries TrafikSvc
@inject ILogger<Trafik> Logger
@rendermode InteractiveServer

<PageTitle>Trafik & Kasiyer — BKM GM</PageTitle>

<div class="mb-4">
    <div class="text-xs text-base-content/50">Kapı sayacı × POS fiş × PDKS personel · şu an FSM</div>
    <h1 class="text-2xl font-bold tracking-tight m-0">Trafik &amp; Kasiyer Analizi</h1>
</div>

<div class="flex flex-wrap items-center gap-2 mb-4">
    <span class="text-xs text-base-content/50">Tarih</span>
    <input type="date" class="input input-bordered input-sm" @bind="_bas" @bind:after="Yukle" />
    <span class="text-base-content/40">–</span>
    <input type="date" class="input input-bordered input-sm" @bind="_bit" @bind:after="Yukle" />
    <button class="btn btn-sm btn-ghost" @onclick="BuHafta">Bu hafta</button>
    <button class="btn btn-sm btn-ghost" @onclick="BuAy">Bu ay</button>
    <button class="btn btn-sm btn-ghost" @onclick="Son4Hafta">Son 4 hafta</button>
</div>

@if (_error is not null)
{
    <div class="alert alert-error text-sm mb-4"><span>@_error</span></div>
}
else if (_loading)
{
    <p class="text-base-content/40 text-sm py-6 flex items-center gap-2">
        <span class="loading loading-spinner loading-sm"></span> Yükleniyor…
    </p>
}
else
{
    @* KPI şeridi *@
    @if (_kpi is not null)
    {
        var conv = _kpi.Ziyaretci > 0 ? Math.Round(100.0 * _kpi.Fis / _kpi.Ziyaretci, 1) : 0;
        var perZiy = _kpi.Ziyaretci > 0 ? (int)(_kpi.Net / _kpi.Ziyaretci) : 0;
        <AppKpiCarousel Id="trafikkpi" Items="@(new List<KpiCardData>
        {
            new("Ziyaretçi",      Fmt(_kpi.Ziyaretci),         "from-info to-info/80",          "kapı girişi"),
            new("Fiş",            Fmt(_kpi.Fis),                "from-primary to-primary/80",    "satış işlemi"),
            new("Dönüşüm",        conv.ToString("F1") + "%",    "from-success to-success/80",    "fiş / ziyaretçi"),
            new("₺/Ziyaretçi",   FmtTl(perZiy),               "from-warning to-warning/80",    "ortalama"),
            new("Aktif Personel", Fmt(_kpi.Kasiyer),            "from-secondary to-secondary/80","dönem boyunca"),
        })" />
    }

    @* 3 Heatmap *@
    @if (_heat.Count > 0)
    {
        var map = _heat.ToDictionary(h => (h.Gun, h.Saat));
        var sMin = _heat.Min(h => h.Saat);
        var sMax = _heat.Max(h => h.Saat);
        string[] gunAd = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"];

        var pdksMap = _pdks.ToDictionary(p => (p.Gun, p.Saat));

        @* Personel–Trafik uyum haritası: renk=karne (kırmızı az personel / yeşil dengeli / mavi atıl), koyuluk=o saatin yoğunluğu *@
        <div class="bg-base-100 border border-base-300 rounded-lg p-3 mb-3">
            <div class="text-sm font-semibold mb-1">Personel – Trafik Uyumu</div>
            <div class="text-xs text-base-content/50 mb-2">Her hücre: o saatte gelen müşteriye karşı çalışan personel yeterli mi? Koyu = yoğun saat.</div>
            <div class="flex items-center gap-3 flex-wrap mb-2">
                <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm bg-error"></span><span class="text-xs text-base-content/70">Çok müşteri / az personel (riskli)</span></span>
                <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm bg-success"></span><span class="text-xs text-base-content/70">Dengeli</span></span>
                <span class="flex items-center gap-1"><span class="inline-block w-3 h-3 rounded-sm bg-info"></span><span class="text-xs text-base-content/70">Az müşteri / çok personel (atıl)</span></span>
            </div>
            @{
                var maxZ = _heat.Max(h => h.Ziyaretci);
                var maxP = _pdks.Count > 0 ? _pdks.Max(p => p.Personel) : 0;
                <div class="overflow-x-auto pb-1">
                    <div class="inline-grid gap-0.5" style="@($"grid-template-columns:32px repeat({sMax - sMin + 1}, 26px)")">
                        <div></div>
                        @for (int s = sMin; s <= sMax; s++)
                        {
                            <div class="text-[9px] text-base-content/40 text-center leading-4">@s</div>
                        }
                        @for (int g = 0; g < 7; g++)
                        {
                            int gi = g;
                            <div class="text-[10px] text-base-content/60 flex items-center h-[30px]">@gunAd[gi]</div>
                            @for (int s = sMin; s <= sMax; s++)
                            {
                                int si = s;
                                var cell = map.GetValueOrDefault((gi, si));
                                int vz = cell?.Ziyaretci ?? 0;
                                int vp = pdksMap.GetValueOrDefault((gi, si))?.Personel ?? 0;
                                double zN = maxZ > 0 ? (double)vz / maxZ : 0;
                                double pN = maxP > 0 ? (double)vp / maxP : 0;
                                double mis = zN - pN;                        // + = personel az, - = personel fazla
                                string hue = mis >= 0.15 ? "bg-error" : mis <= -0.15 ? "bg-info" : "bg-success";
                                double yog = Math.Max(zN, pN);               // hücre yoğunluğu (göz yoğun saate gitsin)
                                string op = (yog > 0 ? Math.Max(0.10, Math.Round(yog, 2)) : 0.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                string karne = mis >= 0.15 ? "PERSONEL AZ" : mis <= -0.15 ? "personel fazla" : "dengeli";
                                <div class="rounded-[3px] h-[30px] @(vz == 0 && vp == 0 ? "bg-base-200" : hue)"
                                     style="opacity:@op"
                                     title="@gunAd[gi] @(si):00 — Ziyaretçi:@vz / Personel:@vp → @karne"></div>
                            }
                        }
                    </div>
                </div>
            }
            @* Ham veri raporu — modal grid *@
            <div class="mt-2 pt-2 border-t border-base-200 flex justify-end">
                <button class="btn btn-xs btn-ghost gap-1" @onclick="() => _showRapor = true">
                    <i data-lucide="table" class="w-3.5 h-3.5"></i> Veri tablosu
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-base-100 border border-base-300 rounded-lg p-4 mb-3 text-base-content/40 text-sm">
            Bu dönem için heatmap verisi yok.
        </div>
    }

    @* Saatlik ham veri modalı: gün×saat — Ziyaretçi / Fiş / Kasiyer / PDKS personel *@
    @if (_showRapor && _heat.Count > 0)
    {
        var pdksMapR = _pdks.ToDictionary(p => (p.Gun, p.Saat));
        string[] gunAdR = ["Pzt", "Sal", "Çar", "Per", "Cum", "Cmt", "Paz"];
        var satirlar = _heat
            .OrderBy(h => h.Gun).ThenBy(h => h.Saat)
            .Select(h => (h.Gun, h.Saat, h.Ziyaretci, h.Fis, h.Kasiyer,
                          Personel: pdksMapR.GetValueOrDefault((h.Gun, h.Saat))?.Personel ?? 0))
            .ToList();
        <div class="modal modal-open" @onclick="() => _showRapor = false">
            <div class="modal-box max-w-3xl max-h-[85vh]" @onclick:stopPropagation="true">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-bold text-base">Saatlik Ham Veri — Gün × Saat</h3>
                    <button class="btn btn-sm btn-circle btn-ghost" @onclick="() => _showRapor = false">✕</button>
                </div>
                <div class="text-xs text-base-content/50 mb-2">Dönem ortalaması (haftagünü × saat). Ziyaretçi=kapı · Fiş/Kasiyer=POS · Personel=PDKS vardiya.</div>
                <div class="overflow-auto max-h-[65vh]">
                    <table class="table table-xs table-pin-rows">
                        <thead><tr>
                            <th>Gün</th>
                            <th class="text-right">Saat</th>
                            <th class="text-right text-info">Ziyaretçi</th>
                            <th class="text-right text-primary">Fiş</th>
                            <th class="text-right text-warning">Kasiyer</th>
                            <th class="text-right text-success">Personel</th>
                            <th class="text-right">Ziy/Personel</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var r in satirlar)
                        {
                            <tr class="hover">
                                <td class="font-semibold">@gunAdR[r.Gun]</td>
                                <td class="text-right tabular-nums">@r.Saat:00</td>
                                <td class="text-right tabular-nums text-info">@Fmt(r.Ziyaretci)</td>
                                <td class="text-right tabular-nums text-primary">@Fmt(r.Fis)</td>
                                <td class="text-right tabular-nums text-warning">@r.Kasiyer</td>
                                <td class="text-right tabular-nums text-success font-semibold">@r.Personel</td>
                                <td class="text-right tabular-nums text-base-content/60">@(r.Personel > 0 ? (r.Ziyaretci / r.Personel).ToString("N0") : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Personel tablosu *@
    <div class="bg-base-100 border border-base-300 rounded-lg p-3">
        <div class="text-sm font-semibold mb-2 flex items-center gap-1.5">
            <i data-lucide="badge-check" class="w-4 h-4 text-primary"></i>
            Satış Personeli — Dönem Performansı
            <span class="text-xs text-base-content/50 font-normal">(@_personel.Count kişi)</span>
        </div>
        @if (_personel.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="table table-xs">
                    <thead><tr>
                        <th>Personel</th>
                        <th class="text-right">Fiş</th>
                        <th class="text-right">Net ₺</th>
                        <th class="text-right">ATV</th>
                        <th class="text-right">Çalıştığı Gün</th>
                        <th class="text-right">Mesai</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var p in _personel)
                    {
                        <tr class="hover">
                            <td class="font-semibold">@p.Ad</td>
                            <td class="text-right tabular-nums">@Fmt(p.Fis)</td>
                            <td class="text-right tabular-nums font-semibold">@FmtTl(p.Net)</td>
                            <td class="text-right tabular-nums text-base-content/70">@FmtTl(p.Atv)</td>
                            <td class="text-right tabular-nums">@p.CalistigiGun g</td>
                            <td class="text-right tabular-nums text-base-content/60">@p.IlkSaat:00–@p.SonSaat:00</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr class="border-t-2 border-base-300 bg-base-200/40 font-bold">
                        <td>TOPLAM</td>
                        <td class="text-right">@Fmt(_personel.Sum(p => p.Fis))</td>
                        <td class="text-right">@FmtTl(_personel.Sum(p => p.Net))</td>
                        <td></td><td></td><td></td>
                    </tr></tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="text-base-content/40 text-sm py-3">Kayıt yok.</p>
        }
    </div>
}

@code {
    DateOnly _bas = DateOnly.FromDateTime(DateTime.Today.AddDays(-27));
    DateOnly _bit = DateOnly.FromDateTime(DateTime.Today.AddDays(1));

    TrafikKpi? _kpi;
    List<TrafikHeat> _heat = [];
    List<TrafikPersonel> _personel = [];
    List<TrafikPdksHeat> _pdks = [];
    bool _loading = true;
    bool _showRapor;
    string? _error;

    protected override async Task OnInitializedAsync() => await Yukle();

    async Task Yukle()
    {
        _loading = true; _error = null; StateHasChanged();
        try
        {
            var t1 = TrafikSvc.GetKpiAsync(_bas, _bit);
            var t2 = TrafikSvc.GetHeatAsync(_bas, _bit);
            var t3 = TrafikSvc.GetPersonelAsync(_bas, _bit);
            var t4 = TrafikSvc.GetPdksPersonelAsync(_bas, _bit);
            await Task.WhenAll(t1, t2, t3, t4);
            _kpi      = t1.Result;
            _heat     = (List<TrafikHeat>)t2.Result;
            _personel = (List<TrafikPersonel>)t3.Result;
            _pdks     = (List<TrafikPdksHeat>)t4.Result;
        }
        catch (Exception ex) { Logger.LogError(ex, "Trafik yükleme hatası"); _error = ex.Message; }
        finally { _loading = false; StateHasChanged(); }
    }

    void BuHafta()
    {
        var t = DateTime.Today;
        _bas = DateOnly.FromDateTime(t.AddDays(-(int)t.DayOfWeek == 0 ? 6 : (int)t.DayOfWeek - 1));
        _bit = DateOnly.FromDateTime(t.AddDays(1));
        _ = Yukle();
    }
    void BuAy()     { var t = DateTime.Today; _bas = new DateOnly(t.Year, t.Month, 1); _bit = DateOnly.FromDateTime(t.AddDays(1)); _ = Yukle(); }
    void Son4Hafta(){ _bas = DateOnly.FromDateTime(DateTime.Today.AddDays(-27)); _bit = DateOnly.FromDateTime(DateTime.Today.AddDays(1)); _ = Yukle(); }

    static string Fmt(int v)      => v.ToString("N0");
    static string FmtTl(decimal v) => v.ToString("N0") + " ₺";
    static string FmtTl(int v)     => v.ToString("N0") + " ₺";
}
