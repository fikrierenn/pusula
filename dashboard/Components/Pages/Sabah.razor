@page "/sabah"
@using Markdig
@using GmDashboard.Data
@using GmDashboard.Data.Asistan
@inject SabahService SabahSvc
@inject AsistanService Ai
@inject AsistanBellekService Bellek
@rendermode InteractiveServer

<PageTitle>Sabah Brifingi</PageTitle>

<div class="max-w-[860px] mx-auto flex flex-col gap-4">

    @* ── Başlık ── *@
    <div class="flex items-center gap-2 flex-wrap">
        <i data-lucide="@(_veri?.IsPazartesi == true ? "calendar-range" : "sunrise")" class="w-7 h-7 text-warning"></i>
        <h1 class="text-2xl font-bold tracking-tight m-0">
            @(_veri?.IsPazartesi == true ? "Pazartesi Brifingi" : "Sabah Brifingi")
        </h1>
        <span class="text-sm text-base-content/50">@(_veri?.Tarih.ToString("dd.MM.yyyy dddd") ?? "—")</span>
        <button class="btn btn-sm btn-ghost ml-auto gap-1.5" @onclick="YenileAsync" disabled="@_yukleniyor">
            <i data-lucide="refresh-cw" class="w-4 h-4 @(_yukleniyor ? "animate-spin" : "")"></i>Yenile
        </button>
    </div>

    @* ── Hata ── *@
    @if (_hata is not null)
    {
        <div class="alert alert-error text-sm">Veri alınamadı: @_hata</div>
    }

    @* ── Bağlam notu ── *@
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
        <div class="flex items-start gap-3">
            <i data-lucide="message-circle" class="w-4 h-4 text-info mt-2 shrink-0"></i>
            <div class="flex-1 flex gap-2">
                <textarea class="textarea textarea-bordered textarea-sm flex-1 resize-none text-sm"
                          rows="2"
                          placeholder="Bugün bağlam notu… (örn: okullar tatile girdi, karne hediyesi kampanyası devam ediyor)"
                          @bind="_baglamNotu" @bind:event="oninput"
                          disabled="@_yukleniyor"></textarea>
                @if (!string.IsNullOrWhiteSpace(_baglamNotu))
                {
                    <button class="btn btn-info btn-sm self-end gap-1" @onclick="BaglamKaydetVeYenile" disabled="@_yukleniyor">
                        <i data-lucide="zap" class="w-3.5 h-3.5"></i>Uygula
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Yükleniyor ── *@
    @if (_yukleniyor)
    {
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-6">
            <div class="flex items-center gap-3 text-base-content/60">
                <span class="loading loading-spinner loading-sm"></span>
                <span class="text-sm">Veri çekiliyor ve AI analiz yapıyor…</span>
            </div>
        </div>
    }
    else if (_brief is not null)
    {
        @* ── Brief ── *@
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5">
            <article class="prose prose-sm max-w-none">
                @((MarkupString)Markdig.Markdown.ToHtml(_brief, _md))
            </article>
        </div>

        @* ── Ham veri ── *@
        @if (_veri is not null)
        {
            <details class="collapse collapse-arrow bg-base-100 border border-base-200 rounded-2xl">
                <summary class="collapse-title text-sm font-medium">Ham veri (AI'ye gönderilen)</summary>
                <div class="collapse-content">
                    <pre class="text-xs text-base-content/70 whitespace-pre-wrap">@SabahService.VeriMetni(_veri)</pre>
                </div>
            </details>
        }

        @* ── Genius Bellek özeti ── *@
        @if (_bellekOzet is not null)
        {
            <details class="collapse collapse-arrow bg-base-100 border border-base-200 rounded-2xl">
                <summary class="collapse-title text-sm font-medium flex items-center gap-2">
                    <i data-lucide="brain" class="w-4 h-4 text-secondary"></i>Genius belleğinden analize katkılar
                </summary>
                <div class="collapse-content">
                    <pre class="text-xs text-base-content/60 whitespace-pre-wrap">@_bellekOzet</pre>
                </div>
            </details>
        }

        @* ── Evaluation ── *@
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5">
            <h2 class="text-base font-semibold mb-3 m-0 flex items-center gap-2">
                <i data-lucide="check-circle-2" class="w-4 h-4 text-primary"></i>Gün sonu değerlendirmesi
            </h2>

            @if (_evalYorum is not null)
            {
                @* Eval kaydedildi + AI yorum *@
                <div class="alert alert-success text-sm py-2 mb-3">Değerlendirme kaydedildi — Genius belleğine işlendi.</div>
                <div class="card bg-base-200 rounded-xl p-4">
                    <p class="text-xs font-semibold text-base-content/50 mb-1 uppercase tracking-wide">AI öğrenme notu</p>
                    <article class="prose prose-sm max-w-none text-sm">
                        @((MarkupString)Markdig.Markdown.ToHtml(_evalYorum, _md))
                    </article>
                </div>
            }
            else if (_evalKaydedildi && _evalYorumYukleniyor)
            {
                <div class="alert alert-success text-sm py-2 mb-3">Değerlendirme kaydedildi.</div>
                <div class="flex items-center gap-2 text-sm text-base-content/50">
                    <span class="loading loading-dots loading-xs"></span>AI öğrenme notu hazırlanıyor…
                </div>
            }
            else if (!_evalKaydedildi)
            {
                <div class="flex flex-col gap-3">
                    @EvalSatir("1. Yeni bir şey öğrendim mi?",  _eval1, v => _eval1 = v)
                    @EvalSatir("2. Listeden aksiyon aldım mı?", _eval2, v => _eval2 = v)
                    @EvalSatir("3. IGNORE doğru muydu?",        _eval3, v => _eval3 = v)
                    <button class="btn btn-primary btn-sm self-start mt-1 gap-1.5"
                            @onclick="EvalKaydetAsync"
                            disabled="@(_eval1 is null || _eval2 is null || _eval3 is null)">
                        <i data-lucide="save" class="w-4 h-4"></i>Kaydet
                    </button>
                </div>
            }
        </div>
    }

</div>

@code {
    private static readonly MarkdownPipeline _md = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    private SabahVeri? _veri;
    private string?    _brief;
    private string?    _bellekOzet;
    private string?    _hata;
    private bool       _yukleniyor = true;
    private string     _baglamNotu = "";

    private bool? _eval1, _eval2, _eval3;
    private bool  _evalKaydedildi;
    private bool  _evalYorumYukleniyor;
    private string? _evalYorum;

    protected override async Task OnInitializedAsync() => await YukleAsync();

    private async Task YenileAsync()
    {
        _brief = null; _veri = null; _hata = null; _bellekOzet = null;
        _eval1 = _eval2 = _eval3 = null;
        _evalKaydedildi = false; _evalYorum = null; _evalYorumYukleniyor = false;
        await YukleAsync();
    }

    private async Task BaglamKaydetVeYenile()
    {
        if (string.IsNullOrWhiteSpace(_baglamNotu)) return;
        var tarih = DateOnly.FromDateTime(DateTime.Today).AddDays(-1).ToString("dd.MM.yyyy");
        Bellek.Yaz("ekle", $"Bağlam ({tarih}): {_baglamNotu.Trim()}", "gercek");
        _brief = null; _hata = null; _bellekOzet = null;
        _eval1 = _eval2 = _eval3 = null;
        _evalKaydedildi = false; _evalYorum = null; _evalYorumYukleniyor = false;
        await YukleAsync();
    }

    private async Task YukleAsync()
    {
        _yukleniyor = true;
        StateHasChanged();
        try
        {
            _veri = await SabahSvc.GetAsync();
            if (_veri.Hata is not null) { _hata = _veri.Hata; return; }

            if (!Ai.Hazir) { _brief = "*(Asistan yapılandırılmamış — LLM key yok. Ham veri aşağıda.)*"; return; }

            // Genius belleğini prompt'a enjekte et
            var bellekMetni = Bellek.Aktif ? Bellek.Snapshot().Metin : null;
            if (bellekMetni is { Length: > 10 })
                _bellekOzet = bellekMetni;

            var talimat = BuildTalimat(_veri.IsPazartesi, bellekMetni, _baglamNotu);
            _brief = await Ai.MetinUretAsync(talimat, SabahService.VeriMetni(_veri));
        }
        catch (Exception ex) { _hata = ex.Message; }
        finally { _yukleniyor = false; StateHasChanged(); }
    }

    private async Task EvalKaydetAsync()
    {
        if (_eval1 is null || _eval2 is null || _eval3 is null || _veri is null) return;
        var tarih = _veri.Tarih.ToString("dd.MM.yyyy");

        if (_eval1 == true)  Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: yeni sinyal öğrendim (analiz çalıştı)", "gercek");
        if (_eval1 == false) Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: yeni şey öğrenmedim (sakin gün veya sinyal zayıf)", "gercek");
        if (_eval2 == true)  Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: liste aksiyon üretti — sinyal değerli", "gercek");
        if (_eval2 == false) Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: liste aksiyon üretmedi", "gercek");
        if (_eval3 == true)  Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: IGNORE doğruydu — susturulan sinyal gerçekten önemsizdi", "gercek");
        if (_eval3 == false) Bellek.Yaz("ekle", $"Sabah brifingi {tarih}: IGNORE yanlıştı — sinyal kalitesini gözden geçir", "gercek");

        _evalKaydedildi = true;
        _evalYorumYukleniyor = true;
        StateHasChanged();

        // AI öğrenme notu — eval sonuçlarına göre ne öğrenildi?
        if (Ai.Hazir)
        {
            try
            {
                var evalOzet = $"""
                    Tarih: {tarih}
                    Yeni şey öğrendim: {(_eval1 == true ? "Evet" : "Hayır")}
                    Aksiyon aldım: {(_eval2 == true ? "Evet" : "Hayır")}
                    IGNORE doğruydu: {(_eval3 == true ? "Evet" : "Hayır")}
                    Brifingteki analiz özeti: {_brief?.Split('\n').Take(5).Aggregate((a, b) => a + " " + b)}
                    """;
                _evalYorum = await Ai.MetinUretAsync(EvalYorumTalimat, evalOzet);
            }
            catch { _evalYorum = null; }
        }
        _evalYorumYukleniyor = false;
        StateHasChanged();
    }

    private RenderFragment EvalSatir(string Soru, bool? Cevap, Action<bool> CevapSecildi) => __builder =>
    {
        <div class="flex items-center gap-3">
            <span class="text-sm flex-1">@Soru</span>
            <button class="btn btn-xs @(Cevap == true ? "btn-success" : "btn-ghost opacity-50")"
                    @onclick="() => { CevapSecildi(true); StateHasChanged(); }">Evet</button>
            <button class="btn btn-xs @(Cevap == false ? "btn-error" : "btn-ghost opacity-50")"
                    @onclick="() => { CevapSecildi(false); StateHasChanged(); }">Hayır</button>
        </div>;
    };

    private static string BuildTalimat(bool isPazartesi, string? bellekMetni, string baglamNotu = "")
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(isPazartesi ? SabahTalimatPazartesi : SabahTalimatGunluk);

        if (!string.IsNullOrWhiteSpace(baglamNotu))
        {
            sb.AppendLine();
            sb.AppendLine("=== BUGÜN BAĞLAM NOTU (kullanıcı girdi — analizde öncelikli dikkate al) ===");
            sb.AppendLine(baglamNotu.Trim());
        }

        if (bellekMetni is { Length: > 10 })
        {
            sb.AppendLine();
            sb.AppendLine("=== GENİUS BELLEK (geçmiş sinyaller ve öğrenimler) ===");
            sb.AppendLine(bellekMetni);
            sb.AppendLine("Yukarıdaki bellekten ilgili olanları analizinde referans al. 'Geçmişte X gördük, bugün Y' bağlantısı kur.");
        }
        return sb.ToString();
    }

    private const string SabahTalimatGunluk = """
        Sen BKM Kitap Sabah Dikkat Listesi asistanısın. Verilen ciro + stockout + MTD projeksiyon verisini
        yöneticinin 5 dakikada okuyabileceği derin MIMBAL analizi olarak sun.

        FORMAT (sabit):
        **Tek satır sağlık:** [toplam ciro ₺] · WoW [%] · MTD [%] ([gerçekleşen]/[hedef] ₺)

        **MTD Durumu:** [projeksiyon yorumu — yetişiyor mu? günlük pace yeterli mi? kaç ₺ açık/önde?]

        ## 🔴 BUGÜN AKSİYON (0–3 madde)
        Her madde için şablonu doldur:
        - **Ne:** [değişen şey]
        - **Neden bu ACT:** [hedef üstünde / beklemek maliyetli / kontrol edilebilir]
        - **Muhtemel sebep:** [hipotez veya "bilmiyorum, incele"] — Korelasyonu nedensellik yapma
        - **Etki:** [₺ veya % tahmin]
        - **Sahip / Sonraki adım / Ne zamana kadar:**
        - **Güven:** yüksek / orta / düşük

        ## 🟡 İZLE (0–3 madde)
        Neden izle, ne tetiklerse ACT'e geçer?

        ## ⚪ BOŞVER (bilinen/susturulan)
        Her biri tek satır: [kategori/konu] — [susturma gerekçesi]

        STOCKOUT DEĞERLENDİRME:
        - [KRİTİK] (>%10): ACT veya İZLE — hangisi ve neden?
        - [DİKKAT] (%5-10): İZLE — trend artıyor mu?
        - [OK] (<%5): BOŞVER — tek satır gerekçe
        - Elektronik [KRİTİK/DİKKAT] görürsen: spot-mal artefaktı riski → önce drill-down öner, doğrudan ACT değil

        SİNYAL KALİTESİ KURALLARI:
        - Akademi, Hazırlık, Sınav Kıyafet stockout = sezon-bağlı → her zaman BOŞVER
        - Süregelen bilinen sapma ACT olmaz — sadece DEĞİŞİM aksiyon gerektirir
        - Gerçek ACT yoksa 0 madde yaz, yer doldurma yok
        - Bilmiyorsan → "bilmiyorum, incele" — uydurma

        Türkçe. Sayılar tr-TR (₺ N0). 5 dakika okuma sınırı.
        """;

    private const string SabahTalimatPazartesi = """
        Sen BKM Kitap Pazartesi Sabah Brifingi asistanısın. Bu brifing hem dünkü (Pazar) ciro hem de
        geçen haftanın (Pazartesi–Pazar) performansını kapsar. Yöneticinin haftaya doğru başlaması için
        derinlikli bir haftalık değerlendirme + yeni haftanın ajandası sun.

        FORMAT (sabit):

        **Pazar özeti:** [dünkü toplam ₺] · WoW [%]
        **Haftalık özet (Pzt–Paz):** [hafta toplamı ₺] · HoH [%]
        **MTD Durumu:** [projeksiyon yorumu]

        ## 📊 HAFTALIK DEĞERLENDİRME
        - Hangi mağaza haftayı nasıl kapattı? Öne çıkan / geri kalan var mı?
        - HoH sapması anlamlı mı? Muhtemel sebep (tatil/kampanya/mevsim/bilinmiyor)
        - MTD pace yeterli mi? Aya ne kadar açık/önde giriliyor?

        ## 🔴 BU HAFTA AKSİYON (0–3 madde)
        Her madde:
        - **Ne:** [konu]
        - **Neden bu hafta:** [aciliyet / etki]
        - **Muhtemel sebep:** [hipotez veya "bilmiyorum, incele"]
        - **Etki:** [₺ veya % tahmin]
        - **Sahip / Adım / Süre / Güven:**

        ## 🟡 İZLE (0–3 madde)
        Bu hafta takip edilecek, henüz ACT değil

        ## ⚪ BOŞVER (bilinen/susturulan)
        Tek satır gerekçeli

        STOCKOUT DEĞERLENDİRME (haftalık lens):
        - [KRİTİK] (>%10): Bu hafta sipariş verilmeli mi? Sahip kim?
        - [DİKKAT] (%5-10): Trend ne yönde? Geçen haftaya göre kötüleşti mi?
        - [OK] (<%5): BOŞVER
        - Elektronik için her zaman spot-mal notu ekle

        SİNYAL KALİTESİ KURALLARI:
        - Akademi, Hazırlık, Sınav Kıyafet = sezon-bağlı → BOŞVER
        - Süregelen sapma ACT olmaz — sadece değişim aksiyon
        - Gerçek ACT yoksa 0 yaz
        - Bilmiyorsan → "bilmiyorum, incele"

        Türkçe. Sayılar tr-TR. 5 dakika okuma.
        """;

    private const string EvalYorumTalimat = """
        BKM Kitap Sabah Brifingi değerlendirmesi tamamlandı. Aşağıdaki değerlendirme sonuçlarına
        göre 2-3 cümleyle öğrenme notunu yaz:
        - Eğer aksiyon alındıysa: sinyal değerliydi, sürdür
        - Eğer yeni şey öğrenilmediyse: sinyal zayıf mı yoksa sakin gün mü?
        - Eğer IGNORE yanlıştıysa: hangi tür sinyal gözden kaçıyor?
        Kısa, somut, eylem odaklı. "Guru tavsiyesi" verme — sadece gözlem.
        Türkçe. Maksimum 3 cümle.
        """;
}
