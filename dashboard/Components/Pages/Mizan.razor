@page "/mizan"
@using GmDashboard.Data
@using GmDashboard.Models
@inject MizanQueries Miz
@inject PerfState Perf
@inject ILogger<Mizan> Logger
@rendermode InteractiveServer

<PageTitle>Mizan / Finans — BKM GM</PageTitle>

<div class="mb-4 flex items-end justify-between flex-wrap gap-2">
    <div>
        <div class="text-xs text-base-content/50">Genel muhasebe kesin mizanı · ana → alt → en alt · @(_yil) dönemi (kapanış öncesi)</div>
        <h1 class="text-2xl font-bold tracking-tight m-0">Mizan / Finans</h1>
    </div>
    <div class="flex items-center gap-2">
        <select class="select select-bordered select-sm text-sm font-semibold" @bind="_sirketId" @bind:after="LoadAsync">
            @foreach (var d in _donemler)
            {
                <option value="@d.SirketId">@d.Yil</option>
            }
        </select>
        <select class="select select-bordered select-sm text-sm font-semibold" @bind="_ay" @bind:after="LoadAsync">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m">@_aylar[m - 1]@(m == 12 ? " (tüm yıl)" : "")</option>
            }
        </select>
        <div class="join">
            <button class="join-item btn btn-sm @(_kumule ? "btn-primary" : "btn-ghost border border-base-300")" @onclick="() => SetMod(true)" title="Yıl başından seçili aya kümülatif bakiye">Kümüle</button>
            <button class="join-item btn btn-sm @(!_kumule ? "btn-primary" : "btn-ghost border border-base-300")" @onclick="() => SetMod(false)" title="Yalnız seçili ayın hareketi">Tek ay</button>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-error text-sm mb-4"><span>Mizan yüklenemedi: @_error</span></div>
}
else if (_loading)
{
    <p class="text-base-content/40 text-sm py-6 flex items-center gap-2"><span class="loading loading-spinner loading-sm"></span> Mizan hesaplanıyor…</p>
}
else if (_sonuc is not null)
{
    var o = _sonuc.Ozet;
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
            <div class="text-xs text-base-content/50 mb-1">Nakit pozisyon</div>
            <div class="text-xl font-bold @(o.Nakit >= 0 ? "text-success" : "text-error")">@Tl(o.Nakit)</div>
            <div class="text-[11px] text-base-content/40 mt-1">100 kasa + 101 al.çek + 102 banka + 108</div>
            <div class="text-[11px] text-base-content/50 mt-0.5">Verilen çek (103): <span class="text-warning font-medium">@Tl(o.VerilenCek)</span></div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
            <div class="text-xs text-base-content/50 mb-1">Alıcılar (120)</div>
            <div class="text-xl font-bold">@Tl(o.Alicilar)</div>
            <div class="text-[11px] text-base-content/40 mt-1">net alacak (borç bakiyesi)</div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
            <div class="text-xs text-base-content/50 mb-1">Satıcılar (320)</div>
            <div class="text-xl font-bold">@Tl(o.Saticilar)</div>
            <div class="text-[11px] text-base-content/40 mt-1">ödenecek (alacak bakiyesi)</div>
        </div>
        <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
            <div class="text-xs text-base-content/50 mb-1">KDV net</div>
            <div class="text-xl font-bold @(o.KdvNet > 0 ? "text-warning" : "")">@Tl(o.KdvNet)</div>
            <div class="text-[11px] text-base-content/40 mt-1">391 hesaplanan − 191 indirilecek</div>
        </div>
    </div>

    <div class="text-[11px] mb-3 flex items-center gap-2 flex-wrap">
        @{ var fark = Math.Abs(o.ToplamBorc - o.ToplamAlacak); }
        <span class="badge badge-sm @(fark < 0.5m ? "badge-success" : "badge-error") badge-outline">@(fark < 0.5m ? "✓ denge" : "⚠ denge bozuk")</span>
        <span class="text-base-content/50">Toplam Borç @Tl(o.ToplamBorc) · Alacak @Tl(o.ToplamAlacak)</span>
        <span class="text-base-content/40">· "Kapanış" fişi hariç (kesin mizan) · satıra tıkla → alt kırılım</span>
    </div>

    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px]">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
            <span class="text-xs text-base-content/50">Kırılım:</span>
            <div class="join">
                @foreach (var s in _seviyeler)
                {
                    <button class="btn btn-xs join-item @(_acikSeviye == s.Deger ? "btn-primary" : "btn-ghost border-base-300")"
                            @onclick="() => _acikSeviye = s.Deger">@s.Ad</button>
                }
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-sm table-pin-rows">
                <thead><tr>
                    <th>Hesap</th><th>Ad</th>
                    <th class="text-right">Borç</th><th class="text-right">Alacak</th><th class="text-right">Bakiye</th>
                </tr></thead>
                <tbody>
                @foreach (var k in _sonuc.Agac)
                {
                    <MizanDugum Node="k" AcikSeviye="_acikSeviye" />
                }
                </tbody>
            </table>
        </div>
        <div class="text-base-content/50 text-[11px] mt-2">Bakiye = Borç − Alacak (pozitif = borç bakiyesi/varlık · negatif = alacak bakiyesi/kaynak). 590 Dönem Kârı kapanış-öncesi (revizyon sonrası güncel).</div>
    </div>
}

@code {
    private IReadOnlyList<(int SirketId, int Yil)> _donemler = [];
    private MizanSonuc? _sonuc;
    private bool _loading = true;
    private string? _error;
    private int _sirketId;
    private int _yil => _sirketId + MizanQueries.YilOffset;
    private int _acikSeviye = 3;   // minimum: 3 (1·10·100 ana hesap hep görünür)
    private int _ay = 12;          // üst ay sınırı (12 = tüm yıl)
    private bool _kumule = true;   // true = Oca→ay kümülatif · false = yalnız seçili ay (hareket)
    private static readonly (string Ad, int Deger)[] _seviyeler =
        [("Ana hesap", 3), ("Alt hesap", 4), ("Tüm kırılım", 6)];
    private static readonly string[] _aylar = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _donemler = await Miz.GetDonemlerAsync();
            _sirketId = _donemler.Count > 0 ? _donemler[0].SirketId : 6;
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Mizan dönem listesi alınamadı"); _sirketId = 6; }
        await LoadAsync();
    }

    private async Task SetMod(bool kumule) { _kumule = kumule; await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        var sw = PerfState.Start();
        try { _sonuc = await Miz.GetSonucAsync(_sirketId, _ay, _kumule ? 1 : _ay); }
        catch (Exception ex) { Logger.LogError(ex, "Mizan yükleme hatası"); _error = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _loading = false; Perf.Report("Mizan", sw); StateHasChanged(); }
    }

    private static string Tl(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) + " ₺";
}
