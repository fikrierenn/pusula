@page "/asistan"
@using GmDashboard.Data
@using GmDashboard.Components.Shared
@inject LlmService Llm
@inject GorevService Gorevler
@rendermode InteractiveServer

<PageTitle>BKM Asistan</PageTitle>

<div class="flex items-center gap-3 mb-5 flex-wrap">
    <h1 class="text-2xl font-bold tracking-tight m-0">Asistan</h1>
    <span class="text-sm font-semibold text-base-content/50">Not → görev taslağı → kaydet / ata</span>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3 mb-3">
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
        <h3>Yeni Not</h3>
        <textarea class="textarea textarea-bordered w-full text-sm resize-y" rows="3" placeholder="Kısa bir not yaz… (örn: özlüce vitrin yenilensin ramazan teması bütçe ayrılsın)"
                  @bind="_not" @bind:event="oninput" disabled="@_busy"></textarea>
        <div class="flex gap-2 items-center mt-2.5 flex-wrap">
            <button class="btn btn-primary" @onclick="GonderAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_not))">Gönder</button>
            @if (_busy)
            {
                <span class="text-base-content/50 italic">@_busyMesaj</span>
            }
        </div>
        @if (_hata is not null)
        {
            <p class="text-error font-semibold">@_hata</p>
        }

        @if (_taslak is not null)
        {
            <div class="card bg-base-200/40 border border-base-200 rounded-xl p-4 mt-3.5">
                <pre class="m-0 whitespace-pre-wrap text-[13.5px] leading-relaxed text-base-content/90">@_taslak</pre>
                <div class="flex gap-2 items-center mt-2.5 flex-wrap">
                    <button class="btn btn-primary gap-1.5" @onclick="KaydetAsync" disabled="@_busy"><i data-lucide="check" class="w-4 h-4"></i>Kaydet</button>
                    <button class="btn gap-1.5" @onclick="() => _ataAcik = !_ataAcik" disabled="@_busy"><i data-lucide="user" class="w-4 h-4"></i>Kişiye Ata</button>
                    <button class="btn gap-1.5" @onclick="() => _duzeltAcik = !_duzeltAcik" disabled="@_busy"><i data-lucide="pencil" class="w-4 h-4"></i>Düzelt</button>
                    <button class="btn btn-ghost btn-sm text-error gap-1.5" @onclick="Iptal" disabled="@_busy"><i data-lucide="x" class="w-4 h-4"></i>İptal</button>
                </div>

                @if (_ataAcik)
                {
                    <div class="flex gap-2 mt-2 flex-wrap">
                        <input class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" placeholder="İsim / rol" @bind="_atanan" disabled="@_busy" />
                        <button class="btn btn-primary" @onclick="AtaKaydetAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_atanan))">Kaydet ve Ata</button>
                    </div>
                }
                @if (_duzeltAcik)
                {
                    <div class="flex gap-2 mt-2 flex-wrap">
                        <input class="input input-bordered input-sm flex-1 min-w-[160px] text-[13px]" placeholder="Düzeltme (örn: bütçeyi 50 bin TL yap)" @bind="_duzeltme" disabled="@_busy" />
                        <button class="btn btn-primary" @onclick="DuzeltAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_duzeltme))">Uygula</button>
                    </div>
                }
            </div>
        }

        @if (_sonMesaj is not null)
        {
            <p class="text-success font-semibold mt-3">@_sonMesaj</p>
        }
    </div>

    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-[18px] min-w-0">
        <h3>Açık Görevler (@_gorevler.Count)</h3>
        <AppDataTable TItem="Gorev" Items="_gorevler"
                      Primary="@(g => g.Baslik)"
                      Sub="@(g => $"#{g.Id} · {(string.IsNullOrEmpty(g.Atanan) ? "atanmadı" : g.Atanan)}")"
                      Badge="@(g => (g.Oncelik, OncTone(g.Oncelik)))">
            <Details Context="g">
                <div class="flex items-center justify-end">
                    <button class="btn btn-sm" @onclick="() => KapatAsync(g.Id)">Kapat</button>
                </div>
            </Details>
        </AppDataTable>
    </div>
</div>

@code {
    private string _not = "";
    private string? _taslak;
    private string _atanan = "";
    private string _duzeltme = "";
    private bool _ataAcik, _duzeltAcik;
    private bool _busy;
    private string _busyMesaj = "";
    private string? _hata;
    private string? _sonMesaj;
    private IReadOnlyList<Gorev> _gorevler = [];

    protected override void OnInitialized() => Yenile();

    private void Yenile() => _gorevler = Gorevler.Listele(acikOnly: true);

    private async Task GonderAsync()
    {
        if (string.IsNullOrWhiteSpace(_not)) return;
        _hata = null; _sonMesaj = null; _ataAcik = false; _duzeltAcik = false;
        await Uret(_not, null);
    }

    private async Task DuzeltAsync()
    {
        if (string.IsNullOrWhiteSpace(_duzeltme) || _taslak is null) return;
        var d = _duzeltme; _duzeltAcik = false;
        await Uret(_not, d);
        _duzeltme = "";
    }

    private async Task Uret(string not, string? duzeltme)
    {
        _busy = true;
        _busyMesaj = Llm.Loaded ? "Taslak üretiliyor…" : "Model yükleniyor… (ilk seferde ~20 sn)";
        StateHasChanged();
        try
        {
            _taslak = await Task.Run(() => Llm.TaslakUret(not, duzeltme));
        }
        catch (Exception ex) { _hata = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task KaydetAsync() => await Kaydet(null);
    private async Task AtaKaydetAsync() { await Kaydet(_atanan); _atanan = ""; _ataAcik = false; }

    private async Task Kaydet(string? atanan)
    {
        if (_taslak is null) return;
        try
        {
            var id = await Task.Run(() => Gorevler.Kaydet(_taslak, atanan));
            _sonMesaj = atanan is null ? $"Görev #{id} kaydedildi." : $"Görev #{id} kaydedildi ve {atanan} kişisine atandı.";
            _taslak = null; _not = "";
            Yenile();
        }
        catch (Exception ex) { _hata = ex.Message; }
    }

    private void Iptal()
    {
        _taslak = null; _ataAcik = false; _duzeltAcik = false; _sonMesaj = null;
    }

    private async Task KapatAsync(long id)
    {
        await Task.Run(() => Gorevler.Kapat(id));
        Yenile();
        StateHasChanged();
    }

    private static string OncSinif(string o) => o.Contains("Yüksek") ? "y" : o.Contains("Düşük") ? "d" : "o";
    // Öncelik solid pill tonu (AppDataTable Badge — plain span).
    private static string OncTone(string o) => o.Contains("Yüksek") ? "bg-error/15 text-error" : o.Contains("Düşük") ? "bg-success/15 text-success" : "bg-warning/15 text-warning";
}
