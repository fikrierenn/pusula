@page "/asistan"
@using System.Text.Json
@using GmDashboard.Data
@using GmDashboard.Data.Asistan
@using Microsoft.AspNetCore.Components.Web
@inject AsistanService Ai
@inject GorevService Gorevler
@inject TakvimMailAraclar TakvimMail
@inject GoogleAuthService GAuth
@inject GorusmeService Gorusmeler
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>BKM Asistan</PageTitle>

<div class="flex flex-col gap-3 max-w-[820px] mx-auto">

    @* ── Başlık ── *@
    <div class="flex items-center gap-2 flex-wrap">
        <img src="/img/genius.svg" alt="Genius" class="w-9 h-9 -my-1" />
        <h1 class="text-2xl font-bold tracking-tight m-0">Genius</h1>
        <span class="text-sm text-base-content/50">Sor, not bırak, toplantı kur — lambadan çıktım, emrindeyim</span>
        <div class="ml-auto flex items-center gap-2">
            @if (!Ai.Hazir)
            {
                <span class="badge badge-warning gap-1">LLM yapılandırılmamış</span>
            }
            @if (Gorusmeler.Aktif)
            {
                @if (_gecmisListe.Count > 0)
                {
                    <div class="dropdown dropdown-end">
                        <button tabindex="0" class="btn btn-sm btn-ghost gap-1.5" title="Geçmiş konuşmalar"><i data-lucide="history" class="w-4 h-4"></i>Geçmiş</button>
                        <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box shadow border border-base-200 w-64 z-10 max-h-80 overflow-auto flex-nowrap">
                            @foreach (var g in _gecmisListe)
                            {
                                <li><a @onclick="() => GorusmeYukle(g.Id)" class="@(g.Id == _gorusmeId ? "active" : "")">
                                    <span class="truncate">@g.Baslik</span><span class="text-xs text-base-content/40">@g.Guncelleme</span>
                                </a></li>
                            }
                        </ul>
                    </div>
                }
                <button class="btn btn-sm btn-primary gap-1.5" @onclick="YeniGorusme" disabled="@_busy" title="Yeni konuşma"><i data-lucide="plus" class="w-4 h-4"></i>Yeni</button>
            }
        </div>
    </div>

    @* ── Google bağlantı durumu (Faz-2: Gmail+Takvim) ── *@
    @if (GAuth.Yapilandirilmis && !_googleBagli)
    {
        <div class="alert bg-base-100 border border-base-300 rounded-2xl py-2.5 flex items-center gap-2">
            <i data-lucide="calendar" class="w-5 h-5 text-primary"></i>
            <span class="text-sm flex-1">Takvim ve mail için Google hesabını bağla.</span>
            <a class="btn btn-sm btn-primary gap-1.5" href="/auth/google"><i data-lucide="link" class="w-4 h-4"></i>Google'a bağlan</a>
        </div>
    }
    @if (_googleMesaj is not null)
    {
        <div class="alert @(_googleMesaj.Contains("bağlandı") ? "alert-success" : "alert-error") py-2 text-sm">@_googleMesaj</div>
    }

    @* ── Konuşma akışı ── *@
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4 min-h-[320px]">

        @if (_mesajlar.Count == 0)
        {
            @* Boş ekran — karşılama + hızlı öneri çipleri *@
            <div class="flex flex-col items-center text-center gap-4 py-8">
                <img src="/img/genius.svg" alt="Genius" class="w-28 h-28" />
                <p class="text-base-content/60 max-w-sm m-0">Selam, ben <b>Genius</b>. Bir <b>veri sorusu</b> sor, bir <b>iş/not</b> yaz, ya da <b>toplantı/mail</b> de — gerisini ben hallederim.</p>
                <div class="flex flex-wrap gap-2 justify-center">
                    @foreach (var ornek in Ornekler)
                    {
                        <button class="btn btn-sm btn-outline rounded-full gap-1.5 normal-case"
                                @onclick="() => CipGonder(ornek.Metin)" disabled="@_busy">
                            <i data-lucide="@ornek.Ikon" class="w-3.5 h-3.5"></i>@ornek.Metin
                        </button>
                    }
                </div>
            </div>
        }

        <div class="flex flex-col gap-3">
            @foreach (var (m, idx) in _mesajlar.Select((m, i) => (m, i)))
            {
                @if (m.Rol == Rol.Kullanici)
                {
                    <div class="chat chat-end">
                        <div class="chat-bubble chat-bubble-primary text-sm">@m.Metin</div>
                    </div>
                }
                else if (m.Rol == Rol.Cevap)
                {
                    <div class="chat chat-start">
                        <div class="chat-bubble bg-base-200 text-base-content max-w-[92%]">
                            <pre class="m-0 whitespace-pre-wrap font-sans text-[13.5px] leading-relaxed">@m.Metin</pre>
                            @if (m.Iz is { Count: > 0 })
                            {
                                <div class="flex gap-1 items-center mt-2 flex-wrap opacity-70">
                                    <span class="text-[11px] text-base-content/40">kaynak:</span>
                                    @foreach (var a in m.Iz)
                                    {
                                        <span class="badge badge-xs badge-ghost font-mono">@a</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (m.Secenekler is { Count: > 0 } && idx == _mesajlar.Count - 1)
                    {
                        <div class="flex gap-2 flex-wrap mt-1 ml-1">
                            @foreach (var sec in m.Secenekler)
                            {
                                <button class="btn btn-sm btn-outline btn-primary rounded-full" @onclick="() => CipGonder(sec)" disabled="@_busy">@sec</button>
                            }
                        </div>
                    }
                }
                else if (m.Rol == Rol.Oneri && m.Oneri is { } o)
                {
                    var (ikon, etiket) = OneriBaslik(o.Tip);
                    <div class="chat chat-start">
                        <div class="chat-bubble bg-base-100 border border-base-300 text-base-content max-w-[94%] p-0 overflow-hidden">
                            <div class="p-3.5">
                                <div class="flex items-center gap-1.5 mb-2 text-primary">
                                    <i data-lucide="@ikon" class="w-4 h-4"></i><span class="font-semibold text-sm">@etiket</span>
                                </div>
                                <pre class="m-0 whitespace-pre-wrap font-sans text-[13.5px] leading-relaxed text-base-content/90">@o.Ozet</pre>
                            </div>
                            @if (idx == _mesajlar.Count - 1 && _pendingOneri is not null)
                            {
                                <div class="bg-base-200/50 px-3.5 py-2.5 flex flex-col gap-2">
                                    <div class="flex gap-2 flex-wrap">
                                        @if (o.Tip == "gorev")
                                        {
                                            <button class="btn btn-sm btn-primary gap-1.5" @onclick="() => KaydetGorev(null)" disabled="@_busy"><i data-lucide="check" class="w-4 h-4"></i>Kaydet</button>
                                            <button class="btn btn-sm gap-1.5" @onclick="() => { _ataAcik = !_ataAcik; _duzeltAcik = false; }" disabled="@_busy"><i data-lucide="user-plus" class="w-4 h-4"></i>Ata</button>
                                        }
                                        else if (o.Tip == "etkinlik")
                                        {
                                            <button class="btn btn-sm btn-primary gap-1.5" @onclick="OnaylaEtkinlik" disabled="@_busy"><i data-lucide="calendar-check" class="w-4 h-4"></i>Onayla & Oluştur</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-primary gap-1.5" @onclick="() => GonderMail(false)" disabled="@_busy"><i data-lucide="send" class="w-4 h-4"></i>Gönder</button>
                                            <button class="btn btn-sm gap-1.5" @onclick="() => GonderMail(true)" disabled="@_busy"><i data-lucide="save" class="w-4 h-4"></i>Taslağa kaydet</button>
                                        }
                                        <button class="btn btn-sm gap-1.5" @onclick="() => { _duzeltAcik = !_duzeltAcik; _ataAcik = false; }" disabled="@_busy"><i data-lucide="pencil" class="w-4 h-4"></i>Düzelt</button>
                                        <button class="btn btn-sm btn-ghost text-error gap-1.5" @onclick="Iptal" disabled="@_busy"><i data-lucide="x" class="w-4 h-4"></i>İptal</button>
                                    </div>
                                    @if (_ataAcik && o.Tip == "gorev")
                                    {
                                        <div class="flex gap-2 flex-wrap">
                                            <input class="input input-bordered input-sm flex-1 min-w-[160px]" placeholder="İsim / rol (örn: Mağaza müdürü)" @bind="_atanan" disabled="@_busy" />
                                            <button class="btn btn-sm btn-primary" @onclick="() => KaydetGorev(_atanan)" disabled="@(_busy || string.IsNullOrWhiteSpace(_atanan))">Kaydet ve Ata</button>
                                        </div>
                                    }
                                    @if (_duzeltAcik)
                                    {
                                        <div class="flex gap-2 flex-wrap">
                                            <input class="input input-bordered input-sm flex-1 min-w-[160px]" placeholder="Düzeltme (örn: saati 15:00 yap)" @bind="_duzeltme" disabled="@_busy" />
                                            <button class="btn btn-sm btn-primary" @onclick="DuzeltAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_duzeltme))">Uygula</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
                else // Sistem
                {
                    <div class="flex justify-center">
                        <div class="badge badge-success gap-1.5 py-3 px-3">
                            <i data-lucide="check-circle" class="w-4 h-4"></i>@m.Metin
                            @if (m.GorevId is { } gid)
                            {
                                <button class="underline ml-1" @onclick='() => Nav.NavigateTo("gorevler")'>Görevlerde aç</button>
                            }
                        </div>
                    </div>
                }
            }

            @if (_busy)
            {
                <div class="chat chat-start">
                    <div class="chat-bubble bg-base-200 text-base-content/60 italic flex items-center gap-2">
                        <span class="loading loading-dots loading-sm"></span>@_busyMesaj
                    </div>
                </div>
            }
            @if (_hata is not null)
            {
                <p class="text-error font-semibold text-sm">@_hata</p>
            }
        </div>
    </div>

    @* ── Giriş çubuğu ── *@
    <div class="flex gap-2 items-center sticky bottom-2">
        <input class="input input-bordered flex-1 shadow-sm" placeholder="Soru veya not yaz…  (örn: dün ciro? / vitrin yenilensin)"
               @bind="_girdi" @bind:event="oninput" @onkeydown="OnKey" disabled="@(_busy || !Ai.Hazir)" />
        <button class="btn btn-primary btn-circle shadow" @onclick="Gonder" disabled="@(_busy || !Ai.Hazir || string.IsNullOrWhiteSpace(_girdi))" title="Gönder">
            <i data-lucide="send" class="w-5 h-5"></i>
        </button>
    </div>

    @* ── Açık görevler ── *@
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-4">
        <div class="flex items-center gap-2 mb-2">
            <i data-lucide="list-checks" class="w-5 h-5 text-primary"></i>
            <h3 class="m-0 text-base font-semibold">Açık Görevler (@_gorevler.Count)</h3>
            <button class="btn btn-xs btn-ghost ml-auto gap-1" @onclick='() => Nav.NavigateTo("gorevler")'>Tümü<i data-lucide="arrow-right" class="w-3.5 h-3.5"></i></button>
        </div>
        @if (_gorevler.Count == 0)
        {
            <p class="text-base-content/40 text-sm m-0">Açık görev yok.</p>
        }
        else
        {
            <div class="flex flex-col divide-y divide-base-200">
                @foreach (var g in _gorevler)
                {
                    <div class="flex items-center gap-2 py-2">
                        <span class="badge badge-sm @OncTone(g.Oncelik)">@g.Oncelik</span>
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-sm truncate">@g.Baslik</div>
                            <div class="text-xs text-base-content/40">#@g.Id · @(string.IsNullOrEmpty(g.Atanan) ? "atanmadı" : g.Atanan)</div>
                        </div>
                        <button class="btn btn-xs gap-1" @onclick="() => KapatAsync(g.Id)" disabled="@_busy"><i data-lucide="check" class="w-3.5 h-3.5"></i>Kapat</button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private enum Rol { Kullanici, Cevap, Oneri, Sistem }
    private sealed record ChatMesaj(Rol Rol, string? Metin = null, IReadOnlyList<string>? Iz = null, long? GorevId = null, AsistanOneri? Oneri = null, IReadOnlyList<string>? Secenekler = null);

    private readonly List<ChatMesaj> _mesajlar = [];
    private readonly List<LlmTur> _gecmis = [];        // konuşma sürekliliği (bağlam)
    private string _girdi = "";
    private bool _busy;
    private string _busyMesaj = "Düşünüyorum…";
    private string? _hata;

    // Aktif öneri (onay bekleyen görev/etkinlik/mail) + kaynağı
    private AsistanOneri? _pendingOneri;
    private string _pendingNot = "";
    private bool _ataAcik, _duzeltAcik;
    private string _atanan = "", _duzeltme = "";

    private bool _googleBagli;
    private string? _googleMesaj;
    private IReadOnlyList<Gorev> _gorevler = [];

    // Görüşme kalıcılığı (session)
    private long _gorusmeId;
    private IReadOnlyList<GorusmeBilgi> _gecmisListe = [];

    private static readonly (string Metin, string Ikon)[] Ornekler =
    [
        ("Dün ciro ne kadar?", "trending-up"),
        ("Bu hafta en çok satan kategori?", "bar-chart-3"),
        ("Bekleyen kargo sayısı?", "truck"),
        ("Özlüce vitrin yenilensin, ramazan teması", "lightbulb"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Yenile();
        // Görüşme geri yükle (restart/yenileme sonrası kaldığın yerden) veya yeni başlat.
        if (Gorusmeler.Aktif)
        {
            var son = Gorusmeler.Son();
            if (son is not null) { _gorusmeId = son.Id; YukleJson(son); }
            else _gorusmeId = Gorusmeler.Olustur();
            _gecmisListe = Gorusmeler.Listele();
        }
        if (GAuth.Yapilandirilmis) _googleBagli = await GAuth.BagliMiAsync();
        // OAuth callback dönüşü (?google=ok|hata)
        var uri = new Uri(Nav.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("google", out var g))
            _googleMesaj = g == "ok" ? "Google hesabın bağlandı — artık takvim ve mail kullanabilirim." : "Google bağlantısı tamamlanamadı, tekrar dener misin?";
    }

    private void Yenile() => _gorevler = Gorevler.Listele(acikOnly: true);

    // Kayıtlı görüşmeyi belleğe yükle (display + LLM bağlamı). Son mesaj öneri ise onay butonlarını geri getir.
    private void YukleJson(Gorusme g)
    {
        _mesajlar.Clear(); _gecmis.Clear(); _pendingOneri = null; _ataAcik = _duzeltAcik = false;
        try
        {
            if (!string.IsNullOrWhiteSpace(g.MesajlarJson))
                _mesajlar.AddRange(JsonSerializer.Deserialize<List<ChatMesaj>>(g.MesajlarJson!) ?? []);
            if (!string.IsNullOrWhiteSpace(g.GecmisJson))
                _gecmis.AddRange(JsonSerializer.Deserialize<List<LlmTur>>(g.GecmisJson!) ?? []);
        }
        catch (Exception ex) { _hata = "Görüşme yüklenemedi: " + ex.Message; }
        var son = _mesajlar.LastOrDefault();
        if (son is { Rol: Rol.Oneri, Oneri: not null }) _pendingOneri = son.Oneri;
    }

    // Görüşmeyi DB'ye kaydet (her tur sonrası). Başlık = ilk kullanıcı mesajı.
    private void Kaydet()
    {
        if (!Gorusmeler.Aktif || _gorusmeId <= 0) return;
        var ilk = _mesajlar.FirstOrDefault(m => m.Rol == Rol.Kullanici)?.Metin;
        var baslik = string.IsNullOrWhiteSpace(ilk) ? "Yeni konuşma" : (ilk!.Length > 60 ? ilk[..60] : ilk);
        Gorusmeler.Guncelle(_gorusmeId, baslik, JsonSerializer.Serialize(_mesajlar), JsonSerializer.Serialize(_gecmis));
        _gecmisListe = Gorusmeler.Listele();
    }

    private void YeniGorusme()
    {
        if (!Gorusmeler.Aktif) return;
        _mesajlar.Clear(); _gecmis.Clear(); _pendingOneri = null; _ataAcik = _duzeltAcik = false; _hata = null; _girdi = "";
        _gorusmeId = Gorusmeler.Olustur();
        _gecmisListe = Gorusmeler.Listele();
    }

    private void GorusmeYukle(long id)
    {
        var g = Gorusmeler.Getir(id);
        if (g is null) return;
        _gorusmeId = g.Id; _hata = null; YukleJson(g);
    }

    private static (string Ikon, string Etiket) OneriBaslik(string tip) => tip switch
    {
        "etkinlik" => ("calendar-clock", "Takvim etkinliği"),
        "mail"     => ("mail", "Mail taslağı"),
        _          => ("clipboard-list", "Görev taslağı"),
    };

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await Gonder();
    }

    private async Task CipGonder(string metin) { _girdi = metin; await Gonder(); }

    private async Task Gonder()
    {
        var metin = _girdi.Trim();
        if (metin.Length == 0 || _busy || !Ai.Hazir) return;
        _girdi = ""; _hata = null; _googleMesaj = null;
        // Yeni mesaj geldiyse önceki önerinin butonları kapanır (statik kalır)
        _pendingOneri = null; _ataAcik = _duzeltAcik = false;
        _mesajlar.Add(new(Rol.Kullanici, metin));

        _pendingNot = metin;
        _busy = true; _busyMesaj = "Düşünüyorum…";
        StateHasChanged();
        try
        {
            // Tek akış: LLM niyeti+bağlamı yönetir. Taslak önerirse onay kartı, yoksa düz cevap.
            var cevap = await Ai.SorAsync(metin, _gecmis);
            EkleCevap(cevap, metin);
        }
        catch (Exception ex) { _hata = "İşlem tamamlanamadı: " + ex.Message; }
        finally { _busy = false; Kaydet(); StateHasChanged(); }
    }

    private async Task DuzeltAsync()
    {
        if (string.IsNullOrWhiteSpace(_duzeltme)) return;
        var d = _duzeltme; _duzeltme = ""; _duzeltAcik = false;
        _busy = true; _busyMesaj = "Düzeltiyorum…"; StateHasChanged();
        try
        {
            // Takip mesajı — LLM bağlamdaki öneriyi revize edip yeniden önerir.
            var cevap = await Ai.SorAsync($"Önerdiğin öneriyi şöyle düzelt: {d}", _gecmis);
            EkleCevap(cevap, _pendingNot);
        }
        catch (Exception ex) { _hata = ex.Message; }
        finally { _busy = false; Kaydet(); StateHasChanged(); }
    }

    // SorAsync sonucunu akışa ekle: öneri → onay kartı; değilse düz cevap balonu.
    private void EkleCevap(AsistanCevap cevap, string kaynakNot)
    {
        if (cevap.Oneri is not null)
        {
            _pendingOneri = cevap.Oneri; _pendingNot = kaynakNot; _ataAcik = _duzeltAcik = false;
            _mesajlar.Add(new(Rol.Oneri, Oneri: cevap.Oneri));
        }
        else
        {
            _mesajlar.Add(new(Rol.Cevap, cevap.Metin, cevap.AracIzi, Secenekler: cevap.Secenekler));
        }
    }

    // ── Görev önerisi onayı ──
    private async Task KaydetGorev(string? atanan)
    {
        if (_pendingOneri is not { Tip: "gorev" } o) return;
        try
        {
            var id = await Task.Run(() => Gorevler.Kaydet(o.Ozet, string.IsNullOrWhiteSpace(atanan) ? null : atanan));
            if (id > 0)
            {
                _mesajlar.Add(new(Rol.Sistem, atanan is null ? $"Görev #{id} kaydedildi" : $"Görev #{id} kaydedildi · {atanan}", GorevId: id));
                _pendingOneri = null; _ataAcik = false; _atanan = ""; Yenile(); Kaydet();
            }
            else { _hata = "Görev kaydedilemedi."; }
        }
        catch (Exception ex) { _hata = ex.Message; }
    }

    // ── Etkinlik önerisi onayı → Google Takvim'de oluştur ──
    private async Task OnaylaEtkinlik()
    {
        if (_pendingOneri is not { Tip: "etkinlik" } o) return;
        _busy = true; _busyMesaj = "Etkinlik oluşturuluyor…"; StateHasChanged();
        try
        {
            var (ok, mesaj) = await TakvimMail.EtkinlikOlustur(o.Veri);
            _mesajlar.Add(new(ok ? Rol.Sistem : Rol.Cevap, mesaj));
            if (ok) _pendingOneri = null;
        }
        catch (Exception ex) { _hata = ex.Message; }
        finally { _busy = false; Kaydet(); StateHasChanged(); }
    }

    // ── Mail önerisi onayı → gönder veya taslağa kaydet ──
    private async Task GonderMail(bool taslakOnly)
    {
        if (_pendingOneri is not { Tip: "mail" } o) return;
        _busy = true; _busyMesaj = taslakOnly ? "Taslak kaydediliyor…" : "Mail gönderiliyor…"; StateHasChanged();
        try
        {
            var (ok, mesaj) = await TakvimMail.MailGonder(o.Veri, taslakOnly);
            _mesajlar.Add(new(ok ? Rol.Sistem : Rol.Cevap, mesaj));
            if (ok) _pendingOneri = null;
        }
        catch (Exception ex) { _hata = ex.Message; }
        finally { _busy = false; Kaydet(); StateHasChanged(); }
    }

    private void Iptal() { _pendingOneri = null; _ataAcik = _duzeltAcik = false; }

    private async Task KapatAsync(long id)
    {
        await Task.Run(() => Gorevler.Kapat(id));
        Yenile(); StateHasChanged();
    }

    private static string OncTone(string o) =>
        o.Contains("Yüksek") ? "badge-error" : o.Contains("Düşük") ? "badge-success" : "badge-warning";
}
