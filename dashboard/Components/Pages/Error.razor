@page "/Error"
@using System.Diagnostics

<PageTitle>Hata</PageTitle>

<h1 class="text-error">Beklenmedik bir hata oluştu.</h1>
<h2 class="text-base-content/70">İsteğiniz işlenirken bir sorun yaşandı. Lütfen tekrar deneyin; sürerse sistem yöneticisine bildirin.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>İstek No:</strong> <code>@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
