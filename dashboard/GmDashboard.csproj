<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Tailwind/DaisyUI CSS'i .NET build'inden önce derle.
       npm/node_modules yoksa hata vermeden geçer; wwwroot/app.css commit'li kalır. -->
  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('node_modules')">
    <Exec Command="npm run build:css" ContinueOnError="true" />
  </Target>

  <!-- Okul takvimi (MEB) referans verisi — output'a kopyala (TakvimService data/'dan okur). plan-14 -->
  <ItemGroup>
    <Content Update="data\okul-takvimi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ortak altyapi kutuphanesi (plan 48 Adim 2) — Db/SqlErrorClassifier/VardiyaQueries.
         Vardiya uygulamasi da ayni projeye referans verir; kod cogaltilmaz. -->
    <ProjectReference Include="..\lib\Bkm.Shared\Bkm.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.74.0.4154" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.74.0.4162" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="Markdig" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="MiniExcel" Version="1.35.0" />
  </ItemGroup>

</Project>
