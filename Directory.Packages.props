    <!-- Güvenlik sabitlemesi (17.10.2026): Microsoft.Data.SqlClient 7.0.1 dolaylı olarak
         System.Security.Cryptography.Pkcs 9.0.13 getiriyor — GHSA-846f-f764-76mx (yüksek), GHSA-2fmv-rv2c-59x7 (orta).
         Doğrudan başvuru dolaylı sürümü geçersiz kılar. SqlClient düzeltilmiş sürümü getirince bu satır kaldırılır. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
