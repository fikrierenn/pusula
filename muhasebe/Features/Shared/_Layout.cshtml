@{
    var yol = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool Aktif(string p) => yol.StartsWith(p, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Muhasebe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/favicon.ico" />
</head>
<body class="bg-slate-50 text-slate-800 antialiased">
    <div class="flex min-h-screen">
        <aside class="w-56 shrink-0 bg-slate-900 text-slate-200 flex flex-col">
            <div class="px-5 py-4 text-lg font-semibold text-white border-b border-slate-700">
                Otonom Muhasebe
            </div>
            <nav class="flex-1 px-2 py-3 space-y-1 text-sm">
                <a href="/" class="block px-3 py-2 rounded-lg @(yol == "/Dashboard/Index" || yol == "/" ? "bg-slate-700 text-white" : "hover:bg-slate-800")">Genel Bakış</a>
                <a href="/banka-ekstresi" class="block px-3 py-2 rounded-lg @(Aktif("/BankaEkstresi") ? "bg-slate-700 text-white" : "hover:bg-slate-800")">Banka Eşleştirme</a>
            </nav>
            <div class="px-4 py-3 text-xs text-slate-500 border-t border-slate-700">Salt-okuma · öneri</div>
        </aside>
        <main class="flex-1 min-w-0">
            <div class="max-w-6xl mx-auto px-6 py-6">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>
