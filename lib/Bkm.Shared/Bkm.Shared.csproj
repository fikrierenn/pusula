<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ortak altyapı: birden çok BKM uygulamasının paylaştığı bağlantı fabrikası,
       SQL hata sınıflandırıcı ve vardiya okuma yüzü (plan 48 Adım 2).
       Hesap BURADA DEĞİL — bkm.sp_Vrd_KisiGunDoldur içinde (emitter-ayrimi.md).
       Auth BURADA DEĞİL — her uygulama kendi kullanıcı tablosunu taşır. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bkm.Shared</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- DAPPER BOĞAZI DERLEYİCİYE ZORLATILIR (plan 48 / V-10).
         Yapı (VrdSql) V-09'da kuruldu ama C# ondan geçmeye ZORLAMIYORDU:
         biri doğrudan `cn.QueryAsync` yazabilirdi ve yalnız bir metin kapısı
         görürdü. Bu paket onu DERLEME HATASINA çevirir.
         Muafiyetler `.editorconfig`te (VrdSql.cs + AuditTrail.cs), gerekçeleriyle.
         ⚠ KAPSAM: yalnız bu proje. `vardiya-app`in Dapper kullanımı kimlik/seed
           tarafındadır, kapsamlı tablo okumaz — oraya ban konmadı ve bu bilinçli. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sürümler dashboard/GmDashboard.csproj ile AYNI tutulur; ayrışırsa
         NU1605 downgrade uyarısı çıkar (sessiz değil). -->
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
