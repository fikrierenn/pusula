# SQL Server Connection
# Birden fazla veritabanı için virgülle ayır
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourPassword
MSSQL_DATABASE=master

# Güvenlik — hangi veritabanlarına erişime izin veriliyor
ALLOWED_DATABASES=BKM,YonetIQ,DerinSISBkm,DerinSISBkmCrm,DerinSISBkmWeb,BKMDATA

# Sorgu limitleri
MAX_ROWS=1000
QUERY_TIMEOUT_MS=30000

# Yazma izni (varsayılan: false — sadece SELECT)
ALLOW_WRITE=false

# Multi-statement (`SELECT 1; UPDATE Foo`) varsayılan reddedilir.
# DOS / state pollution riski — production'da true yapma.
ALLOW_MULTI_STATEMENT=false

# Trusted Connection (Windows Auth) kullanmak için:
# MSSQL_TRUSTED=true

# ─── Transport ─────────────────────────────────────────
# stdio : Claude Code Desktop / aynı makinedeki CLI (varsayılan)
# http  : Claude.ai Workspace (cowork) / uzak sandbox için HTTP+SSE
MCP_TRANSPORT=stdio

# HTTP modunda dinlenecek adres
MCP_HOST=0.0.0.0
MCP_PORT=3333
MCP_PATH=/mcp

# HTTP modu için Bearer token — boş bırakma, cowork connector'ı da aynı token'ı gönderir
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
